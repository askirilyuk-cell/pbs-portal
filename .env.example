# ============================================================================
#  Портал ИСМ ПБС — производственный модуль · переменные окружения
#  Скопируйте в .env и подставьте секреты.  .env в git НЕ коммитим.
# ============================================================================

# --- Базовый путь данных на NAS (Synology) ---------------------------------
# На DS725+ общая папка docker/ лежит в /volume1/docker
DATA_ROOT=/volume1/docker

# --- Часовой пояс ----------------------------------------------------------
TZ=Europe/Kaliningrad

# --- PostgreSQL (общий сервер, несколько БД) -------------------------------
POSTGRES_USER=pbs
POSTGRES_PASSWORD=ЗАМЕНИТЕ_надёжный_пароль_БД
# Имена БД создаются автоматически init-скриптом scripts/postgres-init
POSTGRES_DB=nocodb
N8N_DB=n8n
METABASE_DB=metabase

# --- NocoDB ----------------------------------------------------------------
# Сильный случайный ключ (openssl rand -hex 32). Меняет шифрование токенов — не теряйте.
NC_AUTH_JWT_SECRET=ЗАМЕНИТЕ_случайный_hex_32
# Публичный URL (для ссылок в письмах/вебхуках). Пока — IP NAS.
NC_PUBLIC_URL=http://192.168.1.10:8080
NOCODB_PORT=8080

# --- n8n -------------------------------------------------------------------
N8N_PORT=5678
N8N_HOST=192.168.1.10
N8N_PROTOCOL=http
# Логин админа n8n (Basic Auth на входе в UI)
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=ЗАМЕНИТЕ_пароль_n8n
# Ключ шифрования учётных данных n8n (32+ символа). Не теряйте — иначе credentials не расшифруются.
N8N_ENCRYPTION_KEY=ЗАМЕНИТЕ_случайный_32+_символа

# --- Gotenberg -------------------------------------------------------------
GOTENBERG_PORT=3001

# --- Metabase --------------------------------------------------------------
METABASE_PORT=3000

# --- Сервисные адреса внутри docker-сети (использует n8n / render-pz) -------
# Не меняйте без необходимости — это имена сервисов в compose-сети pbs.
NOCODB_INTERNAL_URL=http://nocodb:8080
GOTENBERG_INTERNAL_URL=http://gotenberg:3000

# --- Для n8n workflow (заполнить ПОСЛЕ шага 2: токен NocoDB + id базы) -------
# NC_TOKEN — API-токен NocoDB (UI → Account → Tokens).
# NC_BASE_ID — id базы «Производство ПБС» из nocodb/.state/schema-map.json (поле baseId).
# После заполнения: docker compose up -d n8n  (перезапуск с новым окружением).
NC_TOKEN=
NC_BASE_ID=
