{
  "manifest_version": "0.3",
  "name": "pbs-portal",
  "display_name": "Портал ИСМ ПБС",
  "version": "1.4.0",
  "description": "Работа с порталом ИСМ ПБС из Claude: закупки, продажи, техподготовка и цех (оборудование, инструмент, карты наладки, МК, металл, задания, ПЗ, КД), файлы. Права — как у вас в портале.",
  "author": {
    "name": "ПБС"
  },
  "server": {
    "type": "node",
    "entry_point": "server/index.js",
    "mcp_config": {
      "command": "node",
      "args": [
        "${__dirname}/server/index.js"
      ],
      "env": {
        "PORTAL_TOKEN": "${user_config.token}",
        "PORTAL_MCP_URL": "${user_config.portal_url}"
      }
    }
  },
  "user_config": {
    "token": {
      "type": "string",
      "title": "Личный токен портала",
      "description": "Выдаёт администратор портала (Настройки → Доступ для ИИ). Начинается с pis_",
      "sensitive": true,
      "required": true
    },
    "portal_url": {
      "type": "string",
      "title": "Адрес MCP портала",
      "description": "Обычно менять не нужно. Работает в сети офиса или при включённом Tailscale.",
      "default": "http://nas-pbs:4173/mcp",
      "required": false
    }
  },
  "tools": [
    {
      "name": "znz_search",
      "description": "Найти заявки на закупку"
    },
    {
      "name": "znz_get",
      "description": "Карточка заявки на закупку"
    },
    {
      "name": "znz_create",
      "description": "Создать заявку на закупку с позициями"
    },
    {
      "name": "znz_add_position",
      "description": "Добавить позицию в заявку"
    },
    {
      "name": "znz_update_position",
      "description": "Изменить позицию заявки"
    },
    {
      "name": "znz_set_source",
      "description": "Указать источник заявки (ПЗ/ЗП)"
    },
    {
      "name": "suppliers_search",
      "description": "Найти поставщика"
    },
    {
      "name": "invoice_update",
      "description": "Изменить счёт / общий счёт"
    },
    {
      "name": "zp_search",
      "description": "Найти запросы заказчиков"
    },
    {
      "name": "zp_get",
      "description": "Карточка запроса заказчика"
    },
    {
      "name": "zp_create",
      "description": "Зарегистрировать запрос заказчика"
    },
    {
      "name": "zp_update",
      "description": "Обновить запрос (статус, ответственный, сумма КП, примечание)"
    },
    {
      "name": "zp_set_kp_result",
      "description": "Зафиксировать результат КП"
    },
    {
      "name": "counterparties_search",
      "description": "Найти контрагента"
    },
    {
      "name": "counterparty_create",
      "description": "Завести контрагента"
    },
    {
      "name": "counterparty_add_contact",
      "description": "Добавить контактное лицо контрагенту"
    },
    {
      "name": "counterparty_update_contact",
      "description": "Изменить контактное лицо"
    },
    {
      "name": "znz_files",
      "description": "Файлы заявки на закупку"
    },
    {
      "name": "znz_attach_file",
      "description": "Приложить файл к заявке на закупку"
    },
    {
      "name": "zp_files",
      "description": "Файлы запроса заказчика"
    },
    {
      "name": "zp_attach_file",
      "description": "Приложить файл к запросу заказчика"
    },
    {
      "name": "equipment_search",
      "description": "Найти оборудование"
    },
    {
      "name": "equipment_get",
      "description": "Карточка оборудования"
    },
    {
      "name": "tools_search",
      "description": "Найти инструмент и оснастку"
    },
    {
      "name": "tool_get",
      "description": "Карточка инструмента"
    },
    {
      "name": "tool_catalog_search",
      "description": "Каталог державок, пластин, кулачков"
    },
    {
      "name": "setup_cards_search",
      "description": "Найти карты наладки"
    },
    {
      "name": "setup_card_get",
      "description": "Карта наладки"
    },
    {
      "name": "setup_card_link",
      "description": "Привязать КН к операции МК"
    },
    {
      "name": "routes_search",
      "description": "Найти маршрутные карты"
    },
    {
      "name": "route_get",
      "description": "Маршрутная карта"
    },
    {
      "name": "metal_search",
      "description": "Остатки металла и заготовки"
    },
    {
      "name": "tasks_search",
      "description": "Задания участков"
    },
    {
      "name": "task_update",
      "description": "Отметить ход задания"
    },
    {
      "name": "orders_search",
      "description": "Производственные заказы (ПЗ)"
    },
    {
      "name": "kd_search",
      "description": "Найти КД"
    },
    {
      "name": "tool_move",
      "description": "Движение инструмента"
    },
    {
      "name": "tool_save",
      "description": "Завести/изменить позицию инструмента"
    }
  ],
  "compatibility": {
    "platforms": [
      "darwin",
      "win32"
    ],
    "runtimes": {
      "node": ">=18.0.0"
    }
  }
}
