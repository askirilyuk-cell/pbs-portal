# BFF портала ИСМ ПБС. Скопируйте в .env (он в .gitignore) и заполните.
# Без NC_TOKEN/schema-map сервер работает в MOCK-режиме (демо-данные).
PORT=4173
# LIVE-режим: токен NocoDB (xc-token) — держится ТОЛЬКО на сервере
NC_URL=http://nocodb:8080
NC_TOKEN=
# Для кнопок печати (внутри pbs-net на NAS):
GOTENBERG_URL=http://pbs-gotenberg:3000

# --- 1С-коннектор, этап 1 (черновики кооперации) ----------------------------
# Портал ТОЛЬКО читает 1С и создаёт НЕпроведённые черновики. Провести / изменить /
# удалить документ он не умеет технически (белый список методов GET+POST).
# Значения заполняются в «Настройках» портала (пишутся в portal/.runtime.json,
# который в .gitignore) либо здесь, в .env. В git креды НЕ кладём.
ONEC_URL=https://<хост>/<база>/odata/standard.odata
ONEC_LOGIN=
ONEC_PASSWORD=
# ЗАЩИТА: 1 (или пусто) = dry-run, запись в 1С запрещена. 0 = разрешить создание
# черновиков (и черновиков контрагентов). Снимать только после согласования с владельцем.
ONEC_DRY_RUN=1
# Склад для «Отчёта производства за смену» (решение владельца от 27.07.2026).
# Резолвится в 1С ПО НАИМЕНОВАНИЮ, точное совпадение. Пусто = «Склад производство».
# Неизвестное имя = понятный отказ со списком складов базы, а не пустой склад в документе.
ONEC_WAREHOUSE=Склад производство
