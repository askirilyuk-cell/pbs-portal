# BFF портала ИСМ ПБС. Скопируйте в .env (он в .gitignore) и заполните.
# Без NC_TOKEN/schema-map сервер работает в MOCK-режиме (демо-данные).
PORT=4173
# LIVE-режим: токен NocoDB (xc-token) — держится ТОЛЬКО на сервере
NC_URL=http://nocodb:8080
NC_TOKEN=
# Для кнопок печати (внутри pbs-net на NAS):
GOTENBERG_URL=http://pbs-gotenberg:3000
# Канонический адрес портала: ссылки в чат Bitrix + цель 302 с неканонического хоста.
# Строго http(s)://хост[:порт], без пути. Пусто → канонического редиректа нет.
PORTAL_BASE=http://nas-pbs:4173
# Жёсткий стоп канонического редиректа (0/off/false/no), если он вдруг мешает.
CANONICAL_HOST_REDIRECT=1
# Доверять X-Forwarded-Host/Proto. ВКЛЮЧАТЬ ТОЛЬКО когда порт портала закрыт снаружи
# и запросы идут через обратный прокси (Caddy). Иначе заголовок подделывается curl'ом.
TRUST_PROXY=0
