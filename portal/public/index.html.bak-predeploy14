    // thumbs:true рисует превью-миниатюры для картинок (opt-in; прочие вызовы не затрагивает).
    function fileDropzone(mount, opts){
      opts=opts||{}; let arr=[]; const isImg=(f)=>/^image\//.test(f.type||'');
      const thumbUrl=(f)=>{ if(!f.__dzUrl&&isImg(f)){ try{ f.__dzUrl=URL.createObjectURL(f); }catch{} } return f.__dzUrl; };
      const dropUrl=(f)=>{ if(f.__dzUrl){ try{ URL.revokeObjectURL(f.__dzUrl); }catch{} f.__dzUrl=null; } };
      mount.innerHTML=`<div data-dz style="border:2px dashed #b9cbe0;border-radius:8px;background:#f7faff;padding:16px;display:flex;flex-direction:column;align-items:center;gap:6px;text-align:center;cursor:pointer;transition:border-color .15s,background .15s">
          <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="#2E75B6" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 16V6M8 10l4-4 4 4"/><path d="M5 16v2.5A1.5 1.5 0 0 0 6.5 20h11a1.5 1.5 0 0 0 1.5-1.5V16"/></svg>
          <div style="font-size:13.5px;font-weight:600;color:#1f3a52">Перетащите файлы сюда или нажмите для выбора</div>
          <div style="font-size:11.5px;color:#5b6b7a">${esc(opts.note||'Любые файлы')}</div>
          <input data-inp type="file" multiple ${opts.accept?`accept="${esc(opts.accept)}"`:''} hidden></div>
        <div data-list style="margin-top:7px;display:${opts.thumbs?'flex':'flex'};${opts.thumbs?'flex-wrap:wrap;gap:8px':'flex-direction:column;gap:4px'}"></div>`;
      const dz=mount.querySelector('[data-dz]'), inp=mount.querySelector('[data-inp]'), list=mount.querySelector('[data-list]');
      const add=(fl)=>{ for(const f of fl){ if(!arr.some(x=>x.name===f.name&&x.size===f.size&&x.lastModified===f.lastModified)) arr.push(f); } render(); };
      function render(){
        if(opts.thumbs){
          list.innerHTML=arr.map((f,i)=>{ const u=thumbUrl(f);
            return `<div style="position:relative;width:78px;display:flex;flex-direction:column;gap:3px;align-items:center">
              <div style="width:78px;height:78px;border:1px solid #e2e8f0;border-radius:4px;background:#fff;display:flex;align-items:center;justify-content:center;overflow:hidden">
                ${u?`<img src="${u}" alt="${esc(f.name)}" style="width:100%;height:100%;object-fit:cover">`:`<span style="font-size:10.5px;font-weight:700;color:#5b6b7a;text-transform:uppercase">${esc((f.name.split('.').pop()||'файл').slice(0,4))}</span>`}
                <span data-rm="${i}" title="Убрать" style="position:absolute;top:2px;right:2px;width:18px;height:18px;line-height:16px;text-align:center;background:rgba(15,23,42,.72);color:#fff;border-radius:50%;font-size:11px;font-weight:700;cursor:pointer">✕</span>
              </div>
              <span class="ell" title="${esc(f.name)}" style="max-width:78px;font-size:10.5px;color:#5b6b7a">${esc(f.name)}</span></div>`; }).join('');
        } else {
          list.innerHTML=arr.map((f,i)=>`<div style="display:flex;align-items:center;gap:8px;background:#fff;border:1px solid #e2e8f0;border-radius:2px;padding:5px 9px;font-size:12.5px">
            <span class="ell" title="${esc(f.name)}" style="flex:1;color:#334155">${esc(f.name)}</span>
            <span style="color:#5b6b7a;white-space:nowrap">${fsize(f.size)}</span>
            <span data-rm="${i}" style="cursor:pointer;color:#7d93ab;font-weight:700">✕</span></div>`).join('');
        }
        list.querySelectorAll('[data-rm]').forEach(el=>el.onclick=(e)=>{ e.stopPropagation(); const f=arr[+el.dataset.rm]; if(f)dropUrl(f); arr.splice(+el.dataset.rm,1); render(); });
      }
      dz.onclick=()=>inp.click();
      inp.onchange=()=>{ add(inp.files); inp.value=''; };
      ['dragenter','dragover'].forEach(ev=>dz.addEventListener(ev,(e)=>{ e.preventDefault(); e.stopPropagation(); dz.style.borderColor='#2E75B6'; dz.style.background='#eef4fb'; }));
      ['dragleave','dragend','drop'].forEach(ev=>dz.addEventListener(ev,(e)=>{ e.preventDefault(); e.stopPropagation(); dz.style.borderColor='#b9cbe0'; dz.style.background='#f7faff'; }));
      dz.addEventListener('drop',(e)=>{ if(e.dataTransfer&&e.dataTransfer.files&&e.dataTransfer.files.length) add(e.dataTransfer.files); });
      return { files:()=>arr.slice(), clear:()=>{ arr.forEach(dropUrl); arr=[]; render(); } };
    }
