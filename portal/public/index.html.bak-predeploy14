    // ── Вкладка «Дефицит» (позиции ≤ мин → кнопка «Создать ЗнЗ», реюз /api/procurement/znz/create) ──
    function mtDefBody(host){
      const sig=(MT&&MT.signals)||[]; const live=MT&&MT.mode==='live';
      host.innerHTML=`<div class="filters"><span style="font-size:12.5px;color:var(--sub)">Позиции ≤ минимального запаса (по доступному) — сигнал на закупку</span><span style="margin-left:auto"></span>${srcChip(live)}</div>
        <div id="mtdefgrid" style="margin-top:var(--gap)"></div>`;
      const gh=host.querySelector('#mtdefgrid');
      if(!sig.length){ gh.innerHTML='<div class="card pad" style="color:var(--sub);font-size:13px">Дефицита нет — все позиции выше минимального запаса.</div>'; return; }
      erpGrid(gh,{key:'mt-def',rows:sig,rowClass:()=>'row-def',cols:[
        {key:'code',label:'Код',w:104,cls:'code',cell:r=>esc(r.code),sortVal:r=>r.code},
        {key:'grade',label:'Марка',w:130,cls:'nw',cell:r=>`<b>${esc(r.grade||'—')}</b>`,sortVal:r=>r.grade},
        {key:'rs',label:'Тип · размер',cls:'ell',cell:r=>esc(((r.rollType?r.rollType+' ':'')+(r.size||''))||'—'),sortVal:r=>r.rollType+r.size},
