    // ── Карточка поставщика + ЛОП (#s5, Ф.3–К/Ф.5–К) ──
    function openSupplierCard(viewHost,id){
      const s=(PROC.suppliers||[]).find(x=>x.id===id); if(!s){renderProcurement(viewHost);return;}
      const evals=(PROC.evaluations||[]).filter(e=>e.supplier===s.name).sort((a,b)=>String(b.date).localeCompare(String(a.date)));
      const latest=evals.find(e=>e.price!=null)||evals[0]||null;
      const deliveries=(PROC.requests||[]).filter(r=>r.supplier===s.name).sort((a,b)=>String(b.numZnz).localeCompare(String(a.numZnz),'ru'));
      const L=ropLetter(s), col=ropColor(L);
