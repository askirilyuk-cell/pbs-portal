      const hi=(text,q)=>{ const t=String(text||''); if(!q)return esc(t); const i=norm(t).indexOf(norm(q)); if(i<0)return esc(t); return esc(t.slice(0,i))+'<b style="color:#1F4E79">'+esc(t.slice(i,i+q.length))+'</b>'+esc(t.slice(i+q.length)); };
