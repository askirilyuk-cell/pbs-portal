            <div id="wr-newbox" style="grid-column:span 12;display:none;background:#f7faff;border:1px solid #cfe0f5;border-radius:2px;padding:10px 11px">
              <div style="${G}">
                <div style="grid-column:span 7">${FLAB('Наименование новой позиции',true)}<input id="wr-name" style="${FINP}" placeholder="напр. Электрод УОНИ-13/55 ⌀4"></div>
                <div style="grid-column:span 5">${FLAB('Код 1С (пусто → «ждёт код 1С»)')}<input id="wr-code1c" style="${FINP}" placeholder="МЦ-…"></div>
                <div style="grid-column:span 7">${FLAB('Марка / ГОСТ')}<input id="wr-grade" style="${FINP}"></div>
                <div style="grid-column:span 5">${FLAB('Мин. остаток')}<input id="wr-min" type="number" step="any" style="${FINP}"></div>
              </div>
            </div>
            <div style="grid-column:span 4">${FLAB('Кол-во',true)}<input id="wr-qty" type="number" step="any" style="${FINP}"></div>
            <div style="grid-column:span 4">${FLAB('Цена учётная, ₽')}<input id="wr-price" type="number" step="any" style="${FINP}"></div>
            <div style="grid-column:span 4">${FLAB('Дата')}<input id="wr-date" type="date" value="${whYmd()}" style="${FINP}"></div>
            <div style="grid-column:span 4">${FLAB('Партия / плавка')}<input id="wr-batch" style="${FINP}"></div>
            <div style="grid-column:span 4">${FLAB('Срок годности (FEFO, §4.6)')}<input id="wr-expiry" type="date" style="${FINP}"></div>
