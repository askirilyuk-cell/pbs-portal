          </div>
          <div data-sk="mode" style="font-size:11.5px;color:#5b6b7a;margin-bottom:6px"></div>
          <canvas data-sk="cv" width="${CW}" height="${CH}" style="width:100%;max-width:${CW}px;height:auto;border:1px solid #e2e8f0;border-radius:3px;background:#fcfdff;cursor:crosshair;touch-action:none"></canvas>
          <div style="display:flex;flex-wrap:wrap;gap:8px;align-items:center;margin-top:9px">
