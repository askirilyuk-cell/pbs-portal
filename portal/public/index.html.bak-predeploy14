      else { details=`
        ${kv('Наименование',esc(it.name),'color:var(--ink);font-weight:600')}
        ${kv('Тип',esc(it.type))}
        ${kv('Категория',esc(it.category))}
        ${code1cKv}
        ${kv('Подкатегория',esc(it.subcategory))}
