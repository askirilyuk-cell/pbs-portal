    function whCreateZnz(s){ if(!s)return; const d=s.znzDraft||{};
      toast(`Черновик ЗнЗ (${d.form||'Ф.6–К'}) подготовлен: ${s.name}${d.qtyNeeded?` · потребность ≈ ${whQty(d.qtyNeeded,s.unit)}`:''}. Фактическое создание ЗнЗ (мост склад→закупка, связь ЗКЗ/ЗнЗ) — следующий этап (TODO).`,'info'); }
    // K-42: отношение остаток/мин (для сортировки «Остаток» — дефицит наверху) и ячейка остатка с маркером ▼ (дальтоники)
    function whDefRatio(i){ const min=Number(i.minStock)||0, bal=Number(i.balance)||0; if(min<=0) return bal>0?1e9:1e8; return bal/min; }
    function whBalCell(i){ const q=whQty(i.balance,i.unit); if(i.customerOwned) return `<b style="color:var(--navy)">${q}</b>`; if(i.belowMin) return `<b class="c-red" style="font-weight:800">▼ ${q}</b>`; return `<b style="color:var(--ink)">${q}</b>`; }
    // K-42: реестр склада — единая таблица erpGrid + master-detail (карточка позиции справа, deep-link #warehouse/<код>)
    function whGrid(){
      const gh=document.getElementById('wgrid'); if(!gh)return;
      const items=(WH&&WH.items)||[], signals=(WH&&WH.signals)||[];
      let rows=items.slice();
      if(whFilter==='own')rows=rows.filter(i=>i.own);
      else if(whFilter==='dav')rows=rows.filter(i=>i.customerOwned);
      else if(whFilter==='def')rows=rows.filter(i=>i.belowMin);
      rows.sort((a,b)=>whDefRatio(a)-whDefRatio(b));   // дефицит наверху (по отношению остаток/мин)
      if(!rows.length){ gh.innerHTML='<div class="card pad" style="color:var(--sub);font-size:13px">'+((WH&&WH.mode==='live')?'Нет позиций по фильтру.':'Раздел «Склад» ещё не наполнен (таблицы появятся после APPLY).')+'</div>'; whShowDetail(null); return; }
      if(!whSelCode||!rows.some(r=>r.code===whSelCode)) whSelCode=rows[0].code;
      const live=WH&&WH.mode==='live';
      const cols=[
        {key:'code',label:'Код',w:106,cls:'code',cell:i=>esc(i.code),sortVal:i=>i.code},
        {key:'name',label:'Наименование',cls:'ell',cell:i=>`<span title="${esc(i.name||'')}" style="font-weight:600;color:var(--ink)">${esc(i.name||'—')}</span>`,sortVal:i=>i.name},
        {key:'grade',label:'Марка / ГОСТ',w:150,cls:'nw c-gray',cell:i=>esc(i.grade||'—'),sortVal:i=>i.grade},
        {key:'balance',label:'Остаток',w:120,align:'right',cls:'nw',cell:whBalCell,sortVal:i=>whDefRatio(i)},
        {key:'minStock',label:'Мин.',w:90,align:'right',cls:'nw c-gray',cell:i=>whQty(i.minStock,i.unit),sortVal:i=>Number(i.minStock)||0},
        {key:'unit',label:'ЕИ',w:58,cls:'nw c-gray',cell:i=>esc(i.unit||'—'),sortVal:i=>i.unit},
        {key:'storage',label:'Место',w:130,cls:'nw c-gray',cell:i=>esc(i.storage||'—'),sortVal:i=>i.storage},
        {key:'owner',label:'Владелец',w:126,cls:'nw',cell:i=>i.customerOwned?`<span class="badge" style="color:#7c3aed;background:#f5f3ff;border:1px solid #ddd6fe">давальч.</span>`:'<span class="c-gray">собств.</span>',sortVal:i=>i.customerOwned?1:0},
        {key:'act',label:'',w:92,cls:'nw',cell:i=>i.belowMin?`<button class="tbtn amber" data-znz="${esc(i.code)}" style="padding:3px 9px;font-size:11.5px">ЗнЗ →</button>`:'',sortVal:i=>0},
      ];
      erpGrid(gh,{key:'wh-items',cols,rows,rowKey:i=>i.code,selKey:whSelCode,rowClass:i=>(i.belowMin&&!i.customerOwned)?'row-def':'',
        onRow:i=>{ whSelCode=i.code; try{history.replaceState(null,'','#warehouse/'+encodeURIComponent(i.code));}catch{} whShowDetail(i.code); },
        onEnter:i=>{ whSelCode=i.code; whShowDetail(i.code); },
        info:`${srcChip(live)}<span>Позиций: <b style="color:var(--ink)">${rows.length}</b></span><span class="c-gray">клик / ↑↓ — карточка</span>`});
