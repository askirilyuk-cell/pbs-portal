        <div class="tbl-wrap"><table class="dt"><colgroup>${cols.map(c=>`<col${c.w?` style="width:${c.w}"`:''}>`).join('')}</colgroup>
        <thead><tr>${cols.map(c=>`<th${c.align?` style="text-align:${c.align}"`:''}><span class="lbl">${esc(c.label)}</span><span class="col-rsz"></span></th>`).join('')}</tr></thead>
        <tbody></tbody></table></div>`;
      const tbl=el.querySelector('table'), tbody=tbl.tBodies[0], ths=[...tbl.tHead.rows[0].cells];
      // бриф п.1: сумму ширин колонок отдаём в --tbl-min; min-width применяется ТОЛЬКО ≤760px (CSS), на десктопе гибкие колонки сжимаются
