          <div style="${G}">
            <div style="grid-column:span 12">${FLAB('Акт входного контроля-основание (Ф.3–Д.1)',true)}
              ${acts.length?`<select id="wr-act" style="${FINP}"><option value="">— выбрать принятый акт —</option>${actOpts}</select>`
                :`<input id="wr-act" style="${FINP}" placeholder="№ акта Ф.3–Д.1 (в статусе «принято»)"><div style="font-size:11px;color:#b45309;margin-top:4px">Принятых актов Ф.3–Д.1 не найдено — введите № вручную (бэкенд проверит статус «принято»).</div>`}
