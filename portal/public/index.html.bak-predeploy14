    // ── K-18 Конструктор МК (создание/редактирование маршрута + операции + компоненты) ──
    let RTCAT=null;
    async function loadRtCat(){ if(!RTCAT){ try{RTCAT=await (await fetch('/api/routes/catalog')).json();}catch(e){RTCAT={opTypes:[],warning:String(e.message||e)};} } return RTCAT; }
    // K-34: реестр КД (проекты ОКР + документы КД) для привязки чертежей к МК
    async function loadKdRegistry(){ if(!DESIGN){ try{DESIGN=await (await fetch('/api/design')).json();}catch(e){DESIGN={projects:[],kd:[]};} } return DESIGN; }
    // K-41: реестр оборудования (для датлиста «Оборудование» в конструкторе МК) — кэш EQ переиспользуется
    async function loadEquipReg(){ if(!EQ){ try{EQ=await (await fetch('/api/equipment')).json();}catch(e){EQ={mode:'mock',items:[]};} } return EQ; }
    // URL просмотра чертежа КД — тот же вьюер, что в реестре КД (выпущенный PDF из записей 03-КД)
    const kdViewUrl=(d)=>d&&d.rel?`/api/design/kd/file?rel=${encodeURIComponent(d.rel)}`:`/api/design/kd/file?doc=${encodeURIComponent(d&&d.doc||'')}`;
    async function genRouteTasks(host,routeId){
      if(!confirm('Сгенерировать карты задач Ф.14 по этому маршруту для всех привязанных позиций ПЗ?\n\nЗадачи с уже существующим № не дублируются.'))return;
      try{ const r=await fetch('/api/routes/generate-tasks',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({id:routeId})}); const j=await r.json().catch(()=>({})); if(!r.ok||j.error)throw new Error(j.error||('HTTP '+r.status));
        const det=(j.positions||[]).map(p=>`${p.pz}/${p.pos}: +${p.created}`).join('; ');
        toast(`Ф.14: создано ${j.created}, пропущено ${j.skipped}${det?' · '+det:''}`,'ok');
        openRouteCard(host,routeId);
      }catch(e){ toast('Генерация не удалась: '+(e.message||e),'err'); }
    }
    async function openRouteBuilder(host,routeId){
      const cat=await loadRtCat();
      if(!cat||!cat.opTypes||(cat.mode==='mock')){ alert('Конструктор МК доступен только в LIVE-режиме (нужен токен NocoDB в «Настройках»).'); return; }
      const reg=await loadKdRegistry();
      const kdProjects=(reg&&reg.projects)||[], kdDocs=(reg&&reg.kd)||[];
      // K-41: подсказки «Оборудование» из реестра оборудования (msgy62a5ogq340b) — свободный ввод + датлист
      const eqReg=await loadEquipReg();
      const escA=(s)=>esc(s).replace(/"/g,'&quot;');
      const eqSeen=new Set(), eqOpts=[];
      ((eqReg&&eqReg.items)||[]).forEach(it=>{
        const nm=String(it.name||'').trim(), md=String(it.model||'').trim();
        if(nm&&!eqSeen.has(nm.toLowerCase())){ eqSeen.add(nm.toLowerCase()); eqOpts.push(`<option value="${escA(nm)}" label="${escA([it.invNo,md,it.category].filter(Boolean).join(' · '))}">`); }
        if(md&&!eqSeen.has(md.toLowerCase())){ eqSeen.add(md.toLowerCase()); eqOpts.push(`<option value="${escA(md)}" label="${escA([nm,it.invNo].filter(Boolean).join(' · '))}">`); }
      });
      const eqDatalist=`<datalist id="rb-equip-list">${eqOpts.join('')}</datalist>`;
      let init={route:{type:'КОМ',name:'',designation:'',productType:'',revision:'',statusMk:'Черновик',projectDecNo:'',kdDrawings:[]},operations:[]};
      if(routeId!=null){ try{ const d=await (await fetch('/api/route/edit?id='+encodeURIComponent(routeId))).json(); if(d&&d.route)init=d; }catch(e){} }
      let kdSel=((init.route&&init.route.kdDrawings)||[]).slice();
      const ist='width:100%;padding:7px 9px;border:1px solid #cfd8e3;border-radius:6px;font:inherit;font-size:13px;background:#fff';
      const lbl=(t,req)=>`<div style="font-size:11px;color:#5b6b7a;font-weight:600;margin-bottom:4px">${esc(t)}${req?' <span style="color:var(--red)">*</span>':''}</div>`;
      const opt=(arr,def)=>arr.map(o=>`<option${String(o)===String(def)?' selected':''}>${esc(o)}</option>`).join('');
      const otOpt=(def)=>`<option value="">— выбрать тип операции —</option>`+cat.opTypes.map(t=>`<option value="${t.id}"${String(t.id)===String(def)?' selected':''}>${esc((t.code?t.code+' · ':'')+t.name)}</option>`).join('');
      modal.style.width='min(1040px,97vw)';
      modal.innerHTML=`<div class="mh"><b>${routeId!=null?'Редактирование маршрутной карты':'Новая маршрутная карта (Ф.13)'}</b><span class="op">${routeId!=null?esc(init.route.mk||''):'№ МК присвоится автоматически'}</span><button class="x" id="mx" aria-label="Закрыть">✕</button></div>
        <div class="mb">
          ${eqDatalist}
          <div class="card pad">
            <div class="sec-h" style="margin-bottom:10px">Реквизиты маршрута</div>
            <div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:12px 18px">
              <div>${lbl('Тип МК',true)}<select id="rb-type" style="${ist}">${opt(cat.mkTypes,init.route.type)}</select></div>
              <div style="grid-column:2/4">${lbl('Наименование изделия / компонента',true)}<input id="rb-name" style="${ist}" value="${esc(init.route.name)}" placeholder="напр. Втулка биметаллическая 2ДТ.180"></div>
              <div>${lbl('Изделие / обозначение (чертёж)')}<input id="rb-desig" style="${ist}" value="${esc(init.route.designation)}" placeholder="2ДТ.180.00.00"></div>
              <div>${lbl('Тип продукции')}<select id="rb-prod" style="${ist}"><option value="">— не указан —</option>${opt(cat.productTypes,init.route.productType)}</select></div>
              <div>${lbl('Ревизия')}<input id="rb-rev" style="${ist}" value="${esc(init.route.revision)}" placeholder="A"></div>
              <div>${lbl('Статус МК')}<select id="rb-status" style="${ist}">${opt(cat.statuses,init.route.statusMk)}</select></div>
            </div>
          </div>
          <div class="card pad" style="margin-top:var(--gap)">
            <div class="row" style="margin-bottom:10px"><span class="sec-h">Чертежи КД (реестр)</span><span class="spacer"></span><span style="font-size:11.5px;color:var(--sub)">свяжите МК с чертежами проекта ОКР — с просмотром выпущенного PDF</span></div>
            <div style="max-width:460px">${lbl('Проект разработки (ОКР)')}<select id="rb-proj" style="${ist}"><option value="">— не выбран —</option>${kdProjects.map(p=>`<option value="${esc(p.decNo)}"${p.decNo===(init.route.projectDecNo||'')?' selected':''}>ПБС.${esc(p.decNo)} · ${esc(p.name||'')}</option>`).join('')}</select></div>
            <div id="rb-kdlist" style="margin-top:10px"></div>
            <div id="rb-kdsel" style="margin-top:10px"></div>
          </div>
          <div class="card pad" style="margin-top:var(--gap)">
            <div class="row" style="margin-bottom:10px"><span class="sec-h">Операции маршрута</span><span class="spacer"></span><span style="font-size:11.5px;color:var(--sub)">порядок — стрелками ↑ ↓ · тип операции задаёт участок / РИ / параметры</span></div>
            <div id="rb-ops" style="display:flex;flex-direction:column;gap:10px"></div>
            <button id="rb-addop" class="tbtn" style="margin-top:10px">+ Операция</button>
          </div>
          <div id="rb-err" style="margin-top:10px;color:var(--red);font-size:12.5px"></div>
          <div style="margin-top:var(--gap);display:flex;gap:8px;justify-content:flex-end">
            <button class="tbtn" id="rb-cancel">Отмена</button>
            <button class="tbtn primary" id="rb-save">${routeId!=null?'Сохранить изменения':'Создать МК'}</button>
          </div>
        </div>`;
      modal.classList.add('open'); mscrim.classList.add('open');
      document.getElementById('mx').onclick=closeModal; document.getElementById('rb-cancel').onclick=closeModal;
      // ── K-34 привязка чертежей КД: список документов выбранного проекта + чипы выбранного ──
      const kdByProj=(dec)=>kdDocs.filter(k=>k.projectNo===dec||(dec&&String(k.docNo).includes(dec)));
      const kdRelOf=(k)=>(k.files&&k.files[0])?k.files[0].rel:'';
      const renderKdSel=()=>{ const box=document.getElementById('rb-kdsel'); if(!box)return;
        if(!kdSel.length){ box.innerHTML='<div style="font-size:11.5px;color:var(--sub)">Чертежи не привязаны.</div>'; return; }
        box.innerHTML='<div style="font-size:11px;color:#5b6b7a;font-weight:600;margin-bottom:5px">Привязано ('+kdSel.length+'):</div>'+kdSel.map(d=>`<span style="display:inline-flex;align-items:center;gap:7px;font-size:11.5px;background:#eef4fb;border:1px solid #cdd7e3;border-radius:4px;padding:2px 7px;margin:0 5px 5px 0"><span class="code" style="font-family:monospace">${esc(String(d.doc).replace('ПБС.',''))}</span><a href="${kdViewUrl(d)}" target="_blank" rel="noopener" title="Открыть выпущенный PDF" style="color:var(--blue);text-decoration:none;font-weight:600">Просмотр</a><button data-kdrem="${esc(d.doc)}" title="Отвязать" style="border:0;background:none;color:var(--red);cursor:pointer;font-size:14px;line-height:1">✕</button></span>`).join('');
        box.querySelectorAll('[data-kdrem]').forEach(b=>b.onclick=()=>{ kdSel=kdSel.filter(s=>String(s.doc)!==b.dataset.kdrem); renderKdList(); renderKdSel(); });
      };
      const renderKdList=()=>{ const box=document.getElementById('rb-kdlist'); if(!box)return;
        const dec=document.getElementById('rb-proj').value;
        if(!dec){ box.innerHTML='<div style="font-size:12px;color:var(--sub)">Выберите проект ОКР — покажутся его чертежи из реестра КД.</div>'; return; }
        const list=kdByProj(dec);
        if(!list.length){ box.innerHTML='<div style="font-size:12px;color:var(--sub)">В реестре КД нет документов для этого проекта.</div>'; return; }
        box.innerHTML='<div style="max-height:220px;overflow:auto;border:1px solid var(--bd);border-radius:6px">'+list.map(k=>{const rel=kdRelOf(k),has=!!rel,on=kdSel.some(s=>s.doc===k.docNo);return `<label style="display:flex;align-items:center;gap:8px;padding:5px 9px;border-top:1px solid var(--line2);font-size:12.5px"><input type="checkbox" data-kddoc="${esc(k.docNo)}"${on?' checked':''} style="flex:0 0 auto"><span class="code" style="font-family:monospace">${esc(String(k.docNo).replace('ПБС.',''))}</span><span class="ell" style="flex:1">${esc(k.name||'')}</span><span class="c-gray" style="font-size:11px;white-space:nowrap">${esc(k.kind||'')}</span>${has?`<a class="tbtn" href="/api/design/kd/file?rel=${encodeURIComponent(rel)}" target="_blank" rel="noopener" style="padding:2px 8px;font-size:11.5px;text-decoration:none" onclick="event.stopPropagation()">Просмотр</a>`:'<span class="c-gray" style="font-size:11px">нет PDF</span>'}</label>`;}).join('')+'</div>';
        box.querySelectorAll('[data-kddoc]').forEach(cb=>cb.onchange=()=>{ const k=list.find(x=>x.docNo===cb.dataset.kddoc); if(!k)return;
          if(cb.checked){ if(!kdSel.some(s=>s.doc===k.docNo))kdSel.push({doc:k.docNo,name:k.name||'',vid:k.kind||'',rel:kdRelOf(k),proj:dec}); }
          else kdSel=kdSel.filter(s=>s.doc!==k.docNo);
          renderKdSel();
        });
      };
      const projSel=document.getElementById('rb-proj'); if(projSel)projSel.onchange=renderKdList;
      renderKdList(); renderKdSel();
      const opsBox=document.getElementById('rb-ops');
      const otById=(id)=>cat.opTypes.find(t=>String(t.id)===String(id));
      const renumber=()=>{[...opsBox.querySelectorAll('[data-op]')].forEach((el,i)=>{const n=el.querySelector('[data-opn]');if(n)n.textContent='Оп. '+(i+1);});};
      const opHint=(el)=>{ const ot=otById(el.querySelector('[data-of="opTypeId"]').value); const h=el.querySelector('[data-ohint]'); if(!h)return; h.innerHTML=ot?`Участок: <b>${esc(ot.section||'—')}</b> · РИ: <b>${esc(ot.ri||'—')}</b>${ot.params&&ot.params.length?' · Параметры: '+ot.params.map(p=>esc(p.name+(p.unit?' ('+p.unit+')':''))).join(', '):''}`:'<span style="color:#5b6b7a">выберите тип операции — подтянутся участок, РИ и параметры</span>'; };
      const compRow=(c={})=>`<tr data-crow>
        <td style="padding:2px"><input data-cf="name" value="${esc(c.name||'')}" placeholder="Компонент / материал" style="${ist}"></td>
        <td style="padding:2px;width:80px"><input data-cf="qty" type="number" step="any" value="${esc(c.qty==null?'':c.qty)}" placeholder="кол-во" style="${ist};text-align:right"></td>
        <td style="padding:2px;width:160px"><input data-cf="src" value="${esc(c.src||'')}" placeholder="МК-КОМ / ПЗ / ЗнЗ" style="${ist}"></td>
        <td style="padding:2px;width:30px;text-align:center"><button data-crem title="Удалить" style="border:0;background:none;color:var(--red);cursor:pointer;font-size:15px">✕</button></td></tr>`;
      const opBlock=(o={})=>{
        const el=document.createElement('div'); el.dataset.op='1';
        el.style.cssText='border:1px solid var(--bd);border-radius:8px;padding:10px 12px;background:#fafcff';
        el.innerHTML=`<div style="display:flex;align-items:center;gap:8px;margin-bottom:8px">
            <b data-opn style="font-size:12.5px;color:var(--blue)">Оп.</b><span class="spacer" style="flex:1"></span>
            <button data-oup class="tbtn" style="padding:2px 7px" title="Выше">↑</button>
            <button data-odn class="tbtn" style="padding:2px 7px" title="Ниже">↓</button>
            <button data-orem class="tbtn" style="padding:2px 7px;color:var(--red)" title="Удалить операцию">✕</button></div>
          <div style="display:grid;grid-template-columns:1.3fr 1fr;gap:8px 14px">
            <div>${lbl('Тип операции')}<select data-of="opTypeId" style="${ist}">${otOpt(o.opTypeId)}</select></div>
            <div>${lbl('Операция (наименование)')}<input data-of="name" value="${esc(o.name||'')}" placeholder="как в маршруте (по умолч. = тип)" style="${ist}"></div>
          </div>
          <div data-ohint style="font-size:11.5px;color:#64748b;margin:6px 0"></div>
          <div style="display:grid;grid-template-columns:1.3fr .8fr .6fr;gap:8px 14px">
            <div>${lbl('Оборудование')}<input data-of="equipment" list="rb-equip-list" value="${esc(o.equipment||'')}" placeholder="из реестра или своё значение" style="${ist}"></div>
            <div>${lbl('Точка контроля')}<select data-of="control" style="${ist}">${opt(cat.controlPoints,o.control||'нет')}</select></div>
            <div>${lbl('Норма, ч')}<input data-of="norm" type="number" step="any" value="${esc(o.norm==null?'':o.norm)}" style="${ist};text-align:right"></div>
          </div>
          <details style="margin-top:8px"><summary style="cursor:pointer;font-size:12px;color:#5b6b7a">Материалы, контроль и входящие компоненты</summary>
            <div style="margin-top:8px;display:grid;grid-template-columns:1fr 1fr;gap:8px 14px">
              <div>${lbl('Что контролировать')}<input data-of="whatControl" value="${esc(o.whatControl||'')}" style="${ist}"></div>
              <div>${lbl('СИ (средство измерения)')}<input data-of="si" value="${esc(o.si||'')}" style="${ist}"></div>
              <div>${lbl('Допуски')}<input data-of="tolerance" value="${esc(o.tolerance||'')}" style="${ist}"></div>
              <div>${lbl('Входящие материалы (текст)')}<input data-of="materials" value="${esc(o.materials||'')}" style="${ist}"></div>
            </div>
            <div style="margin-top:8px">${lbl('Входящие компоненты (прослеживаемость)')}
              <table class="dt" style="width:100%"><thead><tr><th>Компонент</th><th>Кол-во</th><th>Источник</th><th></th></tr></thead><tbody data-comps>${(o.components||[]).map(compRow).join('')}</tbody></table>
              <button data-caddc class="tbtn" style="margin-top:6px;padding:3px 9px">+ компонент</button></div>
            ${((o.ncFiles&&o.ncFiles.length)||(o.setupFiles&&o.setupFiles.length))?`<div style="margin-top:10px">${lbl('Прикреплённые вложения операции')}<div style="font-size:11.5px;color:#5b6b7a;line-height:1.7">${(o.ncFiles||[]).map(f=>`ЧПУ: <a href="/api/route/opfile?mk=${encodeURIComponent(init.route.mk||'')}&op=${encodeURIComponent(o.n)}&kind=nc&rel=${encodeURIComponent(f)}" target="_blank" rel="noopener" class="c-blue" style="text-decoration:none">📎 ${esc(f)}</a>`).join('<br>')}${((o.ncFiles&&o.ncFiles.length)&&(o.setupFiles&&o.setupFiles.length))?'<br>':''}${(o.setupFiles||[]).map(f=>`Наладка: <a href="/api/route/opfile?mk=${encodeURIComponent(init.route.mk||'')}&op=${encodeURIComponent(o.n)}&kind=setup&rel=${encodeURIComponent(f)}" target="_blank" rel="noopener" class="c-blue" style="text-decoration:none">📎 ${esc(f)}</a>`).join('<br>')}</div><div style="font-size:11px;color:var(--sub);margin-top:3px">Загрузка / замена — в карточке МК, блок «Вложения операций».</div></div>`:''}
          </details>`;
        // wiring
        el.querySelector('[data-of="opTypeId"]').onchange=()=>{ opHint(el); const nm=el.querySelector('[data-of="name"]'); const ot=otById(el.querySelector('[data-of="opTypeId"]').value); if(ot&&!nm.value.trim())nm.value=ot.name; };
