    @media (max-width:900px){ .tl-3col,.tl-3col.tl-open{grid-template-columns:minmax(0,1fr);} .tl-3col>*{min-width:0;} .tl-drawer{border-left:0;box-shadow:none;padding-left:0;position:static;} .tl-loc-grid{grid-template-columns:minmax(0,1fr)!important;} }
