      modal.style.width='560px';
      modal.innerHTML=`<div class="mh"><b>Запросить оценку выполнимости</b><span style="margin-left:auto"><button class="x" id="re-x" aria-label="Закрыть">✕</button></span></div>
        <div class="mb">
          <div style="background:#f8fafc;border:1px solid var(--line);border-radius:2px;padding:9px 11px;font-size:12.5px;color:var(--sub);margin-bottom:14px">Запрос <b class="code" style="color:var(--ink)">${esc(zp)}</b>. Создаст лист ЛОВ и разделы выбранным подразделениям.</div>
          <div class="lbl-sm" style="font-size:11px;font-weight:700;text-transform:uppercase;color:#5b6b7a;margin-bottom:7px">Подразделения-оценщики</div>
          <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px" id="re-units">${units.map(u=>`<label style="display:flex;align-items:center;gap:8px;border:1px solid var(--line);border-radius:2px;padding:8px 10px;font-size:13px;cursor:pointer"><input type="checkbox" data-u="${esc(u.code)}" data-n="${esc(u.name)}"${u.std?' checked':''}> ${esc(u.code)} — ${esc(u.name)}</label>`).join('')}</div>
          <div style="display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-top:14px">
            <div><div class="lbl-sm" style="font-size:11px;font-weight:700;text-transform:uppercase;color:#5b6b7a;margin-bottom:5px">Сложность</div><select id="re-cx" style="width:100%;font:inherit;font-size:13px;padding:8px;border:1px solid var(--line);border-radius:2px"><option value="типовая">типовая (≤3 раб.дн)</option><option value="нестандартная">нестандартная (≤5 раб.дн)</option></select></div>
            <div><div class="lbl-sm" style="font-size:11px;font-weight:700;text-transform:uppercase;color:#5b6b7a;margin-bottom:5px">Срок оценки</div><input type="date" id="re-due" value="${due}" style="width:100%;font:inherit;font-size:13px;padding:7px;border:1px solid var(--line);border-radius:2px"></div></div>
          <div style="display:flex;gap:10px;justify-content:flex-end;margin-top:18px"><button class="tbtn" id="re-cancel">Отмена</button><button class="tbtn primary" id="re-go">Запросить</button></div>
        </div>`;
