    function kpRecalcRow(i){ const p=kpState.rows[i]; if(!p)return; const c=kpCalcRow(p,kpState.d.defProfitPct);
      const setT=(id,v)=>{const e=document.getElementById(id);if(e)e.textContent=v;};
      if(c.cfg&&c.cfg.model==='bimetal'){ const price=(c.cfg.price&&c.cfg.price[String(p.bmMaterial||'').trim()])||0;
        setT('kp-bmmass-'+i,Number(c.bm?c.bm.massKg:0).toLocaleString('ru-RU',{maximumFractionDigits:3}));
        setT('kp-bmprice-'+i,String(price)); setT('kp-bmmat-'+i,kpMoney(c.materials));
