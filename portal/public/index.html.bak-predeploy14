    .stg-dt th{position:sticky;top:0;text-align:left;padding:8px 9px;border-bottom:1px solid #d8e0ea;font-size:10.5px;font-weight:700;text-transform:uppercase;color:var(--sub);background:#f8fafc;white-space:nowrap}
