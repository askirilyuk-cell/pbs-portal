      if(!DOCS_STATE.live){msg.textContent='Запись доступна только в режиме LIVE (нужен токен NocoDB).';return;}
      // строка листа регистрации изменений (Ф.3–Л.1) — при выпуске новой версии
      let chg=null;
      if(o.mode==='version'){
        const desc=(document.getElementById('cf-desc')||{}).value||'';
        if(!desc.trim()){msg.textContent='Опишите изменение — обязательно для листа регистрации Ф.3–Л.1.';return;}
        chg={code,date:(document.getElementById('cf-date')||{}).value||new Date().toISOString().slice(0,10),
          verFrom:(document.getElementById('cf-verfrom')||{}).value||(o.doc&&o.doc.ver)||'',
          verTo:ver,desc:desc.trim(),
          approvedDoc:(document.getElementById('cf-appdoc')||{}).value||'',
          approver:(document.getElementById('cf-approver')||{}).value||''};
      }
      const p=docParse(code), lvl=docLevel({code,name});
      const picked=docFileDz?docFileDz.files():[];
      // реестр «ИСМ ПБС»: «Тип»=значение SingleSelect (ДП/РИ/РК/Форма), «Раздел»=номер уровня (1–4)
      const payload={'Код':code,'Название':name,'Версия':ver,'Тип':TYPE_WRITE[p.pref]||p.pref,'Раздел':String(lvl)};
      const save=document.getElementById('df-save'); if(save){save.disabled=true;save.textContent='Сохранение…';}
      try{let url,body,recordId;
        if(o.mode==='edit'){url='/api/docs/update';body={Id:o.doc.id,...payload};recordId=o.doc.id;}
        else{url='/api/docs/create';payload['Статус']='проект';body=payload;}
        const r=await fetch(url,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(body)});
        const j=await r.json().catch(()=>({}));if(!r.ok||j.error)throw new Error(j.error||('HTTP '+r.status));
        if(o.mode!=='edit')recordId=j.row&&(j.row.Id??j.row.id);
        // загрузка прикреплённого файла (черновик), привязка к записи
        if(picked.length&&recordId!=null){
          const fd=new FormData();fd.append('recordId',recordId);fd.append('code',code);fd.append('name',name);fd.append('file',picked[0],picked[0].name);
          const ur=await fetch('/api/docs/upload',{method:'POST',body:fd});const uj=await ur.json().catch(()=>({}));
          if(!ur.ok||uj.error)throw new Error('Запись создана, но файл не загружен: '+(uj.error||('HTTP '+ur.status)));
          // если документ уже действует — сразу публикуем приложенный файл в утверждённую папку
          if(o.mode==='edit'&&o.doc&&lcInfo(o.doc).cls==='act'){
            const pr=await fetch('/api/docs/lifecycle',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({Id:recordId,'Статус':'действует'})});
            const pj=await pr.json().catch(()=>({}));if(!pr.ok||pj.error)throw new Error('Файл загружен, но не опубликован: '+(pj.error||('HTTP '+pr.status)));
          }
        }
        if(o.mode==='version'&&o.doc&&o.doc.id!=null){try{await fetch('/api/docs/lifecycle',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({Id:o.doc.id,'Статус':'архив'})});}catch{}}
        // регистрируем строку изменения в журнале документа (Ф.3–Л.1)
        if(o.mode==='version'&&chg){try{await fetch('/api/docs/changelog',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(chg)});}catch{}}
        closeModal(); renderDocs(document.getElementById('view'));
      }catch(e){msg.textContent='Ошибка: '+(e.message||e);if(save){save.disabled=false;save.textContent=o.mode==='create'?'Создать (Проект)':o.mode==='version'?'Сохранить версию':'Сохранить';}}
    }
