    async function saveTask(id){
      const msg=document.getElementById('mmsg'), btn=document.getElementById('msave');
      const body={
        id,
        status:document.getElementById('f-status').value,
        factQty:document.getElementById('f-qty').value,
        factTime:document.getElementById('f-time').value,
        factDate:document.getElementById('f-date').value,
        // самоконтроль/ОТК — требование технолога (read-only), не пишем из портала
        note:document.getElementById('f-note').value,
        params:[...modal.querySelectorAll('.ptbl input[data-pid]')].map(i=>({pid:Number(i.dataset.pid),value:i.value})),
      };
      btn.disabled=true; msg.style.color='#64748b'; msg.textContent='Сохранение…';
      try{
        const r=await fetch('/api/task/update',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(body)});
        const j=await r.json().catch(()=>({}));
        if(!r.ok||j.error)throw new Error(j.error||('HTTP '+r.status));
        msg.style.color='var(--green)'; msg.textContent='Сохранено ✓';
        await load();
        setTimeout(closeModal,600);
      }catch(e){ btn.disabled=false; msg.style.color='var(--red)'; msg.textContent='Ошибка: '+e.message; }
    }
    /* ── A11y-энхансер (UX-02/UX-03): аддитивно, только ARIA/for-id, идемпотентно, всё в try/catch.
       Формы рендерятся из JS (часть — real <label>, часть — <div>-подпись+input), поэтому связываем на лету через MutationObserver. */
    (function(){
      let _uid=0; const genId=()=>'a11y-f'+(++_uid);
      const named=(c)=>!!(c.getAttribute('aria-label')||c.getAttribute('aria-labelledby')||(c.labels&&c.labels.length)||c.closest('label')||c.title);
      const labelish=(el)=>!!(el&&el.nodeType===1&&el.childElementCount===0&&/\S/.test(el.textContent||'')&&(el.textContent||'').trim().length<=80&&['LABEL','DIV','SPAN','P'].includes(el.tagName));
      function assoc(r){
        // real <label> в .fld/.stg-fld без for → for/id (UX-02)
        r.querySelectorAll('.fld,.stg-fld').forEach(fld=>{try{
          const lab=fld.querySelector(':scope>label,:scope>.stg-flab');
          if(!lab||lab.htmlFor||lab.querySelector('input,select,textarea'))return;
          const ctl=fld.querySelector('input:not([type=checkbox]):not([type=radio]),select,textarea')||fld.querySelector('input');
          if(!ctl)return; if(!ctl.id)ctl.id=genId(); lab.htmlFor=ctl.id;
        }catch(e){}});
        // контролы без доступного имени → aria-label из визуальной подписи-сиблинга или placeholder (UX-02)
        r.querySelectorAll('input,select,textarea').forEach(c=>{try{
          if(c.type==='hidden'||named(c))return;
          let nm=''; const p=c.previousElementSibling;
          if(labelish(p))nm=p.textContent.trim();
          if(!nm){const ph=c.getAttribute('placeholder'); if(ph)nm=ph;}
          nm=(nm||'').replace(/[\*…]+/g,'').replace(/\s+/g,' ').trim();
          if(nm)c.setAttribute('aria-label',nm);
        }catch(e){}});
      }
      function tabs(r){ // сегмент-табы .seg → role=tablist/tab + aria-selected по классу .on (UX-03)
        r.querySelectorAll('.seg').forEach(seg=>{try{
          const bs=[...seg.children].filter(x=>x.tagName==='BUTTON'); if(bs.length<2)return;
          if(seg.getAttribute('role')!=='tablist')seg.setAttribute('role','tablist');
          bs.forEach(b=>{b.setAttribute('role','tab');b.setAttribute('aria-selected',b.classList.contains('on')?'true':'false');});
        }catch(e){}});
      }
      function sorts(r){ // заголовки сортируемых таблиц → aria-sort (UX-03)
        r.querySelectorAll('table.dt th').forEach(th=>{try{
          const sortable=th.hasAttribute('data-dir')||th.querySelector('.th-l[data-sk]')||th.querySelector('.lbl'); if(!sortable)return;
          const t=(th.getAttribute('data-dir')||'')+' '+(th.textContent||'');
          th.setAttribute('aria-sort', /[▲↑]/.test(t)?'ascending':/[▼↓]/.test(t)?'descending':'none');
        }catch(e){}});
      }
      function enhance(n){try{const r=(n&&n.nodeType===1)?n:document.body; if(!r)return; assoc(r); tabs(r); sorts(r);}catch(e){}}
      const boot=()=>enhance(document.body);
      if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',boot); else boot();
      try{new MutationObserver(ms=>{for(const m of ms)for(const n of m.addedNodes)if(n.nodeType===1)enhance(n);}).observe(document.body,{childList:true,subtree:true});}catch(e){}
    })();
    window.addEventListener('afterprint',()=>document.body.classList.remove('printing'));
    load().catch(e=>{document.getElementById('view').innerHTML='<div class="warn">Ошибка загрузки: '+esc(e.message)+'</div>';});
  </script>
</body>
