<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Производство · ИСМ ПБС</title>
  <link rel="icon" href="data:image/svg+xml,%3Csvg%20xmlns='http://www.w3.org/2000/svg'%20viewBox='0%200%2032%2032'%3E%3Crect%20width='32'%20height='32'%20rx='6'%20fill='%231F4E79'/%3E%3Ctext%20x='16'%20y='23'%20font-family='Segoe%20UI,Arial,sans-serif'%20font-size='20'%20font-weight='700'%20fill='%23ffffff'%20text-anchor='middle'%3E%D0%9F%3C/text%3E%3C/svg%3E" />
  <link rel="mask-icon" href="data:image/svg+xml,%3Csvg%20xmlns='http://www.w3.org/2000/svg'%20viewBox='0%200%2032%2032'%3E%3Crect%20width='32'%20height='32'%20rx='6'%20fill='%231F4E79'/%3E%3C/svg%3E" color="#1F4E79" />
  <style>
    /* Стиль V1 «Классическая» по ДП–Л.1.2. Без внешних зависимостей (§10.1.1). */
    :root{
      --navy:#1F4E79; --navy-d:#1a3a5c; --blue:#2E75B6; --blue50:#eff6ff;
      --green:#15803d; --amber:#b45309; --red:#b91c1c; --gray:#475569; --gray4:#4b5563; --ink:#333333;
      --page:#eef2f6; --card:#fff; --bd:#e2e8f0; --radius:6px; --gap:14px; --shadow:0 1px 2px rgba(15,40,70,.06);
      --sub:#475569; --line:#e2e8f0; --line2:#eef2f6; --violet:#6d28d9;
      /* UX-01: --gray/--gray4/--sub затемнены до AA (≥4.5:1 на белом/светлом фоне; ~7.5:1) без смены палитры */
    }
    *{box-sizing:border-box;}
    body{margin:0;font-family:'Segoe UI',-apple-system,'Helvetica Neue',Arial,sans-serif;color:var(--ink);background:var(--page);overflow-x:hidden;}
    a{color:inherit;}
    /* UX-04: единый видимый фокус для клавиатуры. !important — чтобы победить инлайновый outline:0 у combobox/поиска */
    a:focus-visible,button:focus-visible,input:focus-visible,select:focus-visible,textarea:focus-visible,summary:focus-visible,[tabindex]:focus-visible,[role="tab"]:focus-visible{outline:2px solid #1d4ed8!important;outline-offset:2px!important;border-radius:2px;}

    .app{display:grid;grid-template-columns:236px 1fr;min-height:100vh;}
    /* K-41: grid-item min-width:auto иначе широкие гриды раздували <main> шире 1fr → гориз.скролл всего окна (резалась «СТАТУС»/кнопка входа). min-width:0 отдаёт скролл внутрь .erp-scroll. */
    main{min-width:0;}
    main .content{min-width:0;}
    .side{background:var(--card);border-right:1px solid var(--bd);display:flex;flex-direction:column;z-index:60;}
    .brand{display:flex;align-items:center;gap:10px;padding:14px 16px 10px;}
    .brand img{height:38px;width:auto;}
    .brand .t{font-weight:700;color:#1f3a52;font-size:14px;line-height:1.1;}
    .brand .t small{display:block;font-weight:400;color:#6b7785;font-size:11px;}
    nav{padding:8px;display:flex;flex-direction:column;gap:2px;}
    nav a{display:flex;align-items:center;gap:10px;padding:9px 12px;border-radius:2px;color:#1f3a52;text-decoration:none;font-size:14px;cursor:pointer;}
    nav a .i{width:20px;height:20px;display:inline-flex;align-items:center;justify-content:center;opacity:.85;flex:0 0 auto;}
    nav a.active .i{opacity:1;}
    nav a .i svg{width:17px;height:17px;}
    .pdot{display:inline-block;width:8px;height:8px;border-radius:50%;margin-right:6px;vertical-align:0;flex:0 0 auto;}
    .pdot-high{background:var(--red);} .pdot-norm{background:var(--amber);} .pdot-low{background:var(--gray4);}
    /* тач-цели цеха ≥44px (ISO 9241-400) */
    .jt input,.jt select{min-height:44px;padding:11px 8px;}
    #st-sec{min-height:44px;}
    .st-card{min-height:44px;}
    nav a:hover{background:var(--blue50);}
    nav a.active{background:var(--blue50);color:var(--navy);font-weight:600;}
    .ngrp{display:flex;align-items:center;font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:.07em;color:#7a8896;padding:13px 12px 3px;cursor:pointer;user-select:none;}
    .navg:first-child .ngrp{padding-top:4px;}
    .ngrp .chev{margin-left:auto;font-size:9px;color:#b6c0cb;transition:transform .15s;}
    .navg.collapsed .ngrp .chev{transform:rotate(-90deg);}
    .navg.collapsed a{display:none;}
    .ngrp:hover{color:#6b7785;}
    nav a .wipdot{margin-left:auto;width:6px;height:6px;border-radius:50%;background:#f0b34a;flex:0 0 auto;}
    .side .foot{margin-top:auto;padding:12px 16px;border-top:1px solid var(--bd);font-size:12px;color:#6b7785;}
    .side .foot b{color:#1f3a52;}

    .top{position:sticky;top:0;z-index:20;background:linear-gradient(90deg,var(--navy),var(--navy-d));color:#fff;padding:11px 18px;display:flex;align-items:center;gap:12px;}
    .top h1{font-size:16px;margin:0;font-weight:600;}
    .top .sub{color:rgba(255,255,255,.7);font-size:13px;}
    .top .right{margin-left:auto;display:flex;align-items:center;gap:8px;font-size:13px;}
    .top select{background:rgba(255,255,255,.12);color:#fff;border:1px solid rgba(255,255,255,.25);border-radius:6px;padding:4px 8px;}
    #burger{display:none;background:rgba(255,255,255,.14);border:0;color:#fff;font-size:18px;width:34px;height:34px;border-radius:2px;cursor:pointer;}
    .mbadge{padding:2px 9px;border-radius:999px;font-size:11px;}
    /* auth-виджет шапки (вход через Bitrix / залогиненный пользователь) */
    .authbox{display:flex;align-items:center;gap:9px;}
    .auth-login{display:inline-flex;align-items:center;gap:7px;font-size:13px;font-weight:600;color:#fff;background:var(--navy,#1F4E79);border:0;border-radius:2px;padding:7px 13px;cursor:pointer;text-decoration:none;}
    .auth-user{display:flex;align-items:center;gap:8px;}
    .auth-ava{width:28px;height:28px;border-radius:50%;background:#2E75B6;color:#fff;display:inline-flex;align-items:center;justify-content:center;font-size:11px;font-weight:700;flex:0 0 auto;}
    .auth-fio{font-size:13px;font-weight:600;color:var(--ink,#1f3a52);white-space:nowrap;}
    .auth-role{font-size:11px;font-weight:600;border-radius:999px;padding:3px 9px;background:#eff6ff;color:#1F4E79;border:1px solid #cfe0f5;display:inline-flex;align-items:center;gap:5px;white-space:nowrap;}
    .auth-role i{width:7px;height:7px;border-radius:50%;background:#2E75B6;display:inline-block;}
    .auth-as{font-size:12px;color:var(--ink,#1f3a52);background:#f1f5f9;border:1px solid #e2e8f0;border-radius:2px;padding:4px 7px;}
    .auth-out{font-size:12.5px;color:var(--sub,#64748b);cursor:pointer;background:none;border:0;}
    @media(max-width:760px){.auth-fio,.auth-as{display:none;}}
    /* K-49 Шаг3: индикатор «смотрю как» + кнопка возврата в админа */
    .auth-viewas{font-size:11px;font-weight:600;border-radius:999px;padding:3px 9px;background:#fef3c7;color:#92400e;border:1px solid #fcd9a3;white-space:nowrap;}
    .auth-reset{font-size:12px;color:var(--navy);cursor:pointer;background:#fff;border:1px solid var(--navy);border-radius:2px;padding:3px 8px;}
    /* K-49 Шаг3: полноэкранный экран входа (гость при RBAC_ENFORCE ON) */
    .loginscreen{position:fixed;inset:0;z-index:200;display:flex;align-items:center;justify-content:center;padding:24px;background:var(--page);}
    .loginscreen .lcard{background:var(--card);border:1px solid var(--bd);border-radius:12px;box-shadow:0 8px 28px rgba(15,40,70,.10);padding:34px 34px 30px;width:100%;max-width:380px;text-align:center;}
    .loginscreen .llogo{height:46px;width:auto;margin:0 auto 16px;display:block;}
    .loginscreen h2{margin:0 0 6px;font-size:21px;font-weight:700;color:var(--navy);}
    .loginscreen p{margin:0 0 22px;font-size:13px;color:var(--sub);line-height:1.5;}
    .loginscreen .lbtn{display:flex;align-items:center;justify-content:center;gap:8px;width:100%;font-size:15px;font-weight:600;color:#fff;background:var(--navy);border:0;border-radius:8px;padding:12px 16px;cursor:pointer;text-decoration:none;}
    .loginscreen .lbtn:hover{background:var(--navy-d);}
    .loginscreen .lfoot{margin-top:18px;font-size:11px;color:var(--gray4);}
    /* K-49 Шаг3: баннер «раздел только для просмотра» */
    .ro-banner{display:flex;align-items:center;gap:8px;background:#fffbeb;border:1px solid #fcd9a3;border-radius:6px;color:#92400e;font-size:12.5px;font-weight:600;padding:8px 12px;margin-bottom:12px;}
    .m-live{background:rgba(52,211,153,.22);color:#d1fae5;} .m-mock{background:rgba(251,191,36,.22);color:#fef3c7;}

    .content{padding:16px 18px;display:flex;flex-direction:column;gap:var(--gap);}
    .card{background:var(--card);border:1px solid var(--bd);border-radius:var(--radius);box-shadow:var(--shadow);}
    .pad{padding:13px 15px;}
    .h{font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.06em;color:var(--gray);margin:0 0 8px;}
    .row{display:flex;align-items:center;gap:10px;flex-wrap:wrap;}
    .title{font-size:18px;font-weight:700;color:var(--navy);} .spacer{margin-left:auto;}

    .orders{display:flex;gap:var(--gap);flex-wrap:wrap;}
    .ord{flex:1;min-width:230px;cursor:pointer;}
    .ord.sel{outline:2px solid var(--blue);outline-offset:-2px;}
    .ord .num{font-weight:700;color:var(--navy);} .ord .cust{font-size:13px;color:#52606d;margin-top:2px;}
    .ord .meta{font-size:12px;color:var(--gray);margin-top:4px;display:flex;align-items:center;}
    .ord .meta .pdot{vertical-align:middle;}
    /* KPI-сводка доски (Вариант A эталона) */
    .kpis{display:grid;grid-template-columns:repeat(auto-fit,minmax(155px,1fr));gap:var(--gap);}
    .kpi{background:var(--card);border:1px solid var(--bd);border-top:3px solid var(--gray4);border-radius:var(--radius);box-shadow:var(--shadow);padding:12px 14px;}
    .kpi-red{border-top-color:var(--red);} .kpi-blue{border-top-color:var(--blue);} .kpi-amber{border-top-color:var(--amber);} .kpi-green{border-top-color:var(--green);}
    .kpi .kl{font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:.05em;color:var(--gray);}
    .kpi .kn{font-size:28px;font-weight:800;color:var(--navy);line-height:1.15;margin:2px 0;}
    .kpi .ks{font-size:12px;color:var(--gray);}
    /* прогресс + «следующая операция» на карточке заказа */
    .oprog{display:flex;align-items:center;gap:8px;margin-top:10px;}
    .oprog .bar{flex:1;height:7px;background:#eef2f6;border-radius:5px;overflow:hidden;}
    .oprog .bar i{display:block;height:100%;}
    .oprog .n{font-size:12px;font-weight:600;color:var(--gray);}
    .nextop{display:inline-block;margin-top:10px;font-size:12px;color:var(--navy);background:var(--blue50);border:1px solid #cfe0f5;border-radius:2px;padding:5px 10px;}
    /* ── сегмент-переключатель / фильтры (эталон) ── */
    .seg{display:inline-flex;background:#fff;border:1px solid #cfd8e3;border-radius:9px;padding:3px;}
    .seg button{font:inherit;font-size:13px;font-weight:600;border:0;border-radius:2px;padding:7px 14px;cursor:pointer;background:transparent;color:var(--sub);}
    .seg button.on{background:var(--navy);color:#fff;}
    .filters{display:flex;align-items:center;gap:10px;flex-wrap:wrap;}
    .pill{font-size:12.5px;color:var(--sub);background:#fff;border:1px solid var(--line);border-radius:999px;padding:6px 13px;cursor:pointer;}
    .pill.on{color:#fff;background:var(--navy);border-color:var(--navy);font-weight:600;}
    .dot{width:8px;height:8px;border-radius:50%;display:inline-block;}
    .d-red{background:var(--red);} .d-amber{background:var(--amber);} .d-gray{background:#9ca3af;}
    /* ── матрица по участкам (эталон) ── */
    .matrix{background:#fff;border:1px solid var(--line);border-radius:12px;overflow:hidden;}
    .mrow{display:grid;grid-template-columns:180px minmax(0,1fr) minmax(0,1fr) minmax(0,1fr);border-bottom:1px solid var(--line2);}
    .mrow:last-child{border-bottom:0;}
    .mhead{background:#f3f6fa;border-bottom:1px solid var(--line);}
    .mhead .mc{font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.05em;color:var(--sub);padding:10px 12px;}
    .mhead .mc.s-blue{color:var(--blue);} .mhead .mc.s-green{color:var(--green);}
    .mstation{padding:12px 14px;display:flex;align-items:flex-start;gap:8px;}
    .mstation .chev{color:#5b6b7a;font-size:12px;margin-top:2px;cursor:pointer;user-select:none;}
    .mstation .nm{font-size:13px;font-weight:700;color:var(--navy);}
    .mstation .ds{font-size:11.5px;color:var(--sub);}
    .mstation .counts{margin-top:6px;display:flex;gap:6px;flex-wrap:wrap;}
    .mstation .counts .c{font-size:10.5px;padding:1px 7px;border-radius:999px;border:1px solid var(--line);color:var(--sub);}
    .mcell{padding:8px 10px;border-left:1px solid #f1f4f8;display:flex;flex-direction:column;gap:7px;}
    .mtask{border:1px solid var(--line);border-left:3px solid #9ca3af;border-radius:8px;padding:8px 10px;}
    .mtask.in-work{border-left-color:var(--blue);background:#fafcff;}
    .mtask.done{border-left-color:var(--green);}
    .mtask .t{display:flex;align-items:center;gap:6px;font-size:12.5px;font-weight:600;color:#334155;}
    .mtask .m{font-size:11px;color:var(--sub);margin-top:2px;}
    .mrow.collapsed .mcell{display:none;}
    /* ── master-detail заказов (эталон #s3) ── */
    .sec-h{font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.06em;color:var(--sub);}
    .split{display:grid;grid-template-columns:330px minmax(0,1fr);gap:16px;align-items:start;}
    /* K-42: split «таблица-реестр + деталь» — левая колонка шире (~60/40) для 7-колоночного грида */
    .split.wide{grid-template-columns:minmax(0,1.5fr) minmax(0,1fr);}
    .list .li{padding:12px 14px;border-left:3px solid transparent;border-top:1px solid var(--line2);cursor:pointer;}
    .list .li:first-child{border-top:0;}
    .list .li.on{border-left-color:var(--blue);background:#eff6ff;}
    .list .li .row{display:flex;align-items:center;gap:8px;}
    .list .li .num{font-weight:700;color:var(--navy);font-size:14px;}
    .list .li .cust{font-size:12.5px;color:#52606d;margin-top:3px;}
    .list .li .meta{display:flex;align-items:center;gap:10px;margin-top:7px;}
    .list .li .meta .pr{display:flex;align-items:center;gap:5px;font-size:11.5px;color:var(--sub);}
    .list .li .meta .pr.late{color:var(--red);font-weight:600;}
    .liprog{flex:1;height:7px;background:var(--line2);border-radius:999px;overflow:hidden;}
    .liprog i{display:block;height:100%;background:var(--blue);}
    .lipct{font-size:11.5px;color:var(--sub);white-space:nowrap;}
    .detail{display:flex;flex-direction:column;gap:var(--gap);min-width:0;}
    .nomen .nrow{display:flex;align-items:center;gap:14px;font-size:13.5px;color:#334155;padding:8px 0;border-top:1px solid var(--line2);}
    .nomen .nrow:first-of-type{border-top:0;} .nomen .nrow b{color:var(--navy);} .nomen .nrow .sp{flex:1;}
    .tasks{display:flex;gap:10px;flex-wrap:wrap;}
    .tcard{flex:1;min-width:150px;border:1px solid var(--line);border-left:3px solid #9ca3af;border-radius:9px;padding:11px 12px;}
    .tcard.done{border-left-color:var(--green);} .tcard.work{border-left-color:var(--blue);}
    .tcard .st{font-size:11px;font-weight:700;color:var(--navy);}
    .tcard .nm{font-size:13px;color:#334155;margin:3px 0 7px;}
    .qc{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px;}
    .qcell{border:1px solid var(--line2);border-radius:9px;padding:10px 12px;}
    .qcell .qh{font-size:11.5px;font-weight:600;color:var(--navy);margin-bottom:5px;}
    .qcell .qv{display:flex;align-items:center;gap:7px;font-size:12.5px;color:#334155;}
    /* ── воронка продаж по состояниям K-06 (эталон #s1) ── */
    .funnel{display:flex;gap:6px;overflow:auto;}
    .fseg{flex:1;min-width:118px;border:1px solid var(--line);border-radius:3px;padding:8px 11px;cursor:pointer;background:#fff;}
    .fseg:hover{background:#f7faff;}
    .fseg.on{border-color:var(--navy);box-shadow:inset 0 -2px 0 var(--navy);}
    .fseg .fn{font-size:20px;font-weight:800;line-height:1;color:var(--navy);}
    .fseg .fl{font-size:11px;font-weight:600;color:var(--sub);margin-top:5px;display:flex;align-items:center;gap:5px;}
    .fseg .fl i{width:7px;height:7px;border-radius:50%;display:inline-block;flex:0 0 auto;}
    .fterm{display:flex;gap:14px;align-items:center;font-size:12px;color:#64748b;flex-wrap:wrap;padding:8px 2px 0;}
    .fterm b{cursor:pointer;}
    .fterm b.on{text-decoration:underline;}
    /* ── документы: картотека + пирамида (эталон #s5/#s6) ── */
    table.dt{width:100%;border-collapse:collapse;background:#fff;}
    table.dt th{background:#f3f6fa;font-size:10.5px;font-weight:700;text-transform:uppercase;letter-spacing:.04em;color:var(--sub);text-align:left;padding:10px 12px;border-bottom:1px solid var(--line);}
    table.dt td{font-size:13px;color:#334155;padding:10px 12px;border-bottom:1px solid var(--line2);vertical-align:middle;}
    table.dt td.code{font-weight:700;color:var(--navy);white-space:nowrap;}
    table.dt tr.grp td{background:var(--page);font-weight:700;color:var(--navy);font-size:10.5px;text-transform:uppercase;letter-spacing:.04em;padding:7px 14px;}
    table.dt tr.grp td .cnt{color:#5b6b7a;}
    table.dt tr.due td{background:#fffdf7;}
    .due-txt{color:var(--amber);font-weight:600;} .muted{color:#5b6b7a;}
    .b-blue{background:#eff6ff;color:var(--blue);border-color:#bfdbfe;} .b-navy{background:#eef6ff;color:var(--navy);border-color:#cfe0f5;}
    .b-green{background:#ecfdf5;color:var(--green);border-color:#a7f3d0;} .b-amber{background:#fffbeb;color:var(--amber);border-color:#fde68a;}
    .b-gray{background:#f3f4f6;color:#4b5563;border-color:#e5e7eb;}
    .pyramid{display:flex;flex-direction:column;align-items:center;gap:10px;}
    .plevel{color:#fff;border-radius:10px;padding:14px 18px;display:flex;align-items:center;gap:12px;}
    .plevel .t{flex:1;min-width:0;} .plevel .t b{font-size:14px;font-weight:700;} .plevel .t small{display:block;font-size:11.5px;opacity:.82;}
    .plevel .n{font-size:13px;font-weight:700;background:rgba(255,255,255,.2);border-radius:999px;padding:2px 10px;}
    .pl1{width:54%;background:linear-gradient(90deg,#16314c,#1a3a5c);} .pl2{width:68%;background:var(--navy);}
    .pl3{width:84%;background:var(--blue);} .pl4{width:100%;background:#5b8fc7;}
    .side-list .sl{display:flex;align-items:center;gap:10px;padding:8px 0;border-top:1px solid var(--line2);}
    .side-list .sl:first-of-type{border-top:0;}
    .side-list .sl .c{font-size:12px;font-weight:700;color:var(--navy);width:92px;flex:0 0 auto;}
    .side-list .sl .n{flex:1;font-size:13px;color:#334155;min-width:0;} .side-list .sl .d{font-size:12px;color:var(--sub);}
    /* ── раздел «Проектирование» (КД-дерево, теги типов) ── */
    .tg{font-family:monospace;font-size:9px;font-weight:600;padding:1px 5px;border-radius:4px;flex:0 0 auto;}
    .tg.vd{background:#eef6ff;color:var(--navy);} .tg.vp{background:#ecfdf5;color:var(--green);} .tg.vm{background:#f3f4f6;color:#4b5563;} .tg.vo{background:#fffbeb;color:var(--amber);} .tg.vs{background:#f5f3ff;color:var(--violet);}
    .lit{font-size:9px;color:var(--sub);border:1px solid var(--bd);border-radius:4px;padding:0 4px;flex:0 0 auto;}
    .dgrp{background:var(--page);font-size:10.5px;font-weight:700;text-transform:uppercase;letter-spacing:.03em;color:var(--navy);padding:7px 12px;}
    .drow{display:flex;align-items:center;gap:7px;padding:7px 11px;border-top:1px solid var(--line2);font-size:12.5px;}
    .drow .dn{font-family:monospace;color:var(--navy);font-weight:600;flex:0 0 auto;}
