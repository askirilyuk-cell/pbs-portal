    // #s2 — канбан заказов по статусу (острые карточки, цветная левая кромка)
    function renderStatusKanban(host){
      const cols=[['Размещён','navy'],['В работе','blue'],['Ждёт ОТК','amber'],['Готово','green']];
      const place=(o)=>{ if(orderDone(o)&&(o.status==='Отгружен'||o.status==='Закрыт'))return 'Готово'; if(orderDone(o))return 'Ждёт ОТК'; if(o.status==='Размещён')return 'Размещён'; if(isDone(o.status))return 'Готово'; return 'В работе'; };
      const by={}; cols.forEach(([c])=>by[c]=[]); (DATA.orders||[]).forEach(o=>{(by[place(o)]||by['В работе']).push(o);});
      const card=(o)=>{const tot=(o.tasks||[]).length,dn=doneCount(o),pct=tot?Math.round(dn/tot*100):0;const nx=nextOp(o);
