        {key:'min',label:'Мин., кг',w:100,align:'right',cls:'nw c-gray',cell:r=>mtNum(r.minStock),sortVal:r=>r.minStock},
        {key:'def',label:'Дефицит, кг',w:120,align:'right',cls:'nw',cell:r=>`<b class="c-amber">${mtNum(r.deficit)}</b>`,sortVal:r=>r.deficit},
        {key:'act',label:'',w:132,cls:'nw',cell:r=>`<button class="tbtn primary" data-znz="${esc(String(r.id))}" style="padding:3px 9px;font-size:11.5px">Создать ЗнЗ →</button>`,sortVal:r=>0},
      ]});
      gh.addEventListener('click',async e=>{const b=e.target.closest('[data-znz]');if(!b)return;e.stopPropagation();const r=sig.find(x=>String(x.id)===b.dataset.znz);if(!r)return;
        b.disabled=true;b.textContent='Создание…';
        try{ const name=[r.grade,r.rollType,r.size].filter(Boolean).join(' ');
          const j=await postJson('/api/procurement/znz/create',{ type:'Цеховая (Ф.4–К)', name:'Металл: '+name, qty:Math.max(1,Math.ceil(r.deficit||r.minStock||1)), unit:'кг', initiator:(typeof ME!=='undefined'&&ME&&ME.name)||'Склад (кладовщик)', category:'Металл', urgency:'Срочная', note:`Дефицит по остатку металла ${r.code}: доступно ${mtNum(r.available)} ≤ мин. ${mtNum(r.minStock)} кг` });
          toast(`Заявка ${j.numZnz||'ЗнЗ'} создана на «${name}» (${mtNum(r.deficit)} кг).`,'ok'); b.textContent='ЗнЗ создана ✓';
        }catch(err){ toast('Не удалось создать ЗнЗ: '+(err.message||err),'err'); b.disabled=false; b.textContent='Создать ЗнЗ →'; }
      },true);
