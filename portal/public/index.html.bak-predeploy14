            <div><div class="lbl-sm" style="font-size:11px;color:#5b6b7a">Заказчик</div><div style="font-size:13px;color:var(--ink)">${esc(c.customer||'—')}</div></div>
            <span class="spacer"></span><div>${trace}</div></div>
          <div class="card pad"><div class="sec-h" style="margin-bottom:3px">Риски и ограничения</div>
