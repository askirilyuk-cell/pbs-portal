          headType:V('eqf-headType'), revolverSlots:V('eqf-revolverSlots'), spindleBore:V('eqf-spindleBore'),
          chuckTypeEq:V('eqf-chuckTypeEq'), chuckDia:V('eqf-chuckDia'), holderSecExt:V('eqf-holderSecExt'), holderSecInt:V('eqf-holderSecInt') };
        if(edit)body.id=it.id;
