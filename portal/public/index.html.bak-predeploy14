      const G='display:grid;grid-template-columns:repeat(12,1fr);gap:12px';
      modal.style.width='min(620px,96vw)';
      modal.innerHTML=`<div class="mh"><b>Добавить алиас (синоним)</b><span class="op">как называют → привязка к канону</span><button class="x" id="mx" aria-label="Закрыть">✕</button></div>
        <div class="mb" style="gap:0"><div style="${G}">
          <div style="grid-column:span 12">${FLAB('Наименование (как называют)',true)}<input id="ca-name" style="${FINP}" placeholder="напр. лист АМГ6 / металл лист 6мм"></div>
          <div style="grid-column:span 7">${FLAB('Источник / производитель')}<input id="ca-source" style="${FINP}" placeholder="счёт / поставщик / прайс"></div>
