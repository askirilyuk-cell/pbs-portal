      wrap.querySelectorAll('[data-ctldel]').forEach(b=>b.onclick=async()=>{
        const f=b.dataset.ctldel, ids=[...ctlSel[f]]; if(!ids.length)return;
        if(!confirm(`Удалить выбранные акты (${ids.length})? Действие необратимо.`))return;
