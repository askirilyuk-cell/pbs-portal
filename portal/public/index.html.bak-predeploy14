      const catOpts=['<option value="">— категория —</option>'].concat(cats.map(c=>`<option${cur.category===c?' selected':''}>${esc(c)}</option>`)).join('');
      const unitList=units.map(u=>`<option value="${esc(u)}">`).join('');
      modal.style.width='min(680px,96vw)';
      modal.innerHTML=`<div class="mh"><b>${cur.id?'Правка канон-позиции':'Новая канон-позиция'}</b><span class="op">K-54 · одна карточка на изделие</span><button class="x" id="mx" aria-label="Закрыть">✕</button></div>
        <div class="mb" style="gap:0"><div style="${G}">
          <div style="grid-column:span 12">${FLAB('Каноническое наименование',true)}<input id="cc-name" style="${FINP}" placeholder="напр. Лист стальной г/к, Ст3, 6 мм" value="${esc(cur.name||'')}"></div>
          <div style="grid-column:span 6">${FLAB('Категория')}<select id="cc-cat" style="${FINP}">${catOpts}</select></div>
          <div style="grid-column:span 6">${FLAB('Тип')}<input id="cc-kind" style="${FINP}" placeholder="лист / пруток / фреза / грунт / газ" value="${esc(cur.kind||'')}"></div>
          <div style="grid-column:span 6">${FLAB('Марка / материал')}<input id="cc-grade" style="${FINP}" placeholder="Ст3 / АМГ6 / ВК8" value="${esc(cur.grade||'')}"></div>
          <div style="grid-column:span 6">${FLAB('Типоразмер')}<input id="cc-size" style="${FINP}" placeholder="6 мм / ⌀20 / 10×1500×6000" value="${esc(cur.size||'')}"></div>
          <div style="grid-column:span 6">${FLAB('ISO-обозначение (инструмент)')}<input id="cc-iso" style="${FINP}" value="${esc(cur.iso||'')}"></div>
          <div style="grid-column:span 6">${FLAB('Базовая единица')}<input id="cc-unit" list="cc-units" style="${FINP}" placeholder="кг / м² / шт / л" value="${esc(cur.unit||'')}"><datalist id="cc-units">${unitList}</datalist></div>
          <div style="grid-column:span 12">${FLAB('Примечание')}<input id="cc-note" style="${FINP}" value="${esc(cur.note||'')}"></div>
        </div>
        <div id="cc-err" style="margin-top:12px;color:#b91c1c;font-size:12.5px"></div>
        <div style="margin-top:14px;padding-top:13px;border-top:1px solid #e2e8f0;display:flex;align-items:center;gap:10px">
          <span style="font-size:12px;color:#5b6b7a"><span style="color:#b91c1c">*</span> — обязательное поле</span>
          <div style="margin-left:auto;display:flex;gap:10px"><button class="tbtn" id="cc-cancel" style="padding:9px 18px">Отмена</button><button class="tbtn green" id="cc-save" style="padding:9px 18px">Сохранить</button></div>
        </div></div>`;
      modal.classList.add('open'); mscrim.classList.add('open');
      document.getElementById('mx').onclick=closeModal; document.getElementById('cc-cancel').onclick=closeModal;
      document.getElementById('cc-save').onclick=async()=>{
        const err=document.getElementById('cc-err'); err.textContent='';
        const V=(id)=>{const el=document.getElementById(id);return el?el.value.trim():'';};
        const body={ name:V('cc-name'), category:V('cc-cat'), kind:V('cc-kind'), grade:V('cc-grade'), size:V('cc-size'), iso:V('cc-iso'), unit:V('cc-unit'), note:V('cc-note') };
        if(cur.id)body.id=cur.id;
        if(!body.name){ err.textContent='Укажите каноническое наименование.'; return; }
        const btn=document.getElementById('cc-save'); btn.disabled=true; btn.textContent='Сохранение…';
        try{ const r=await fetch('/api/catalog/canon/save',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(body)});
          const j=await r.json().catch(()=>({})); if(!r.ok||j.error)throw new Error(j.error||('HTTP '+r.status));
          toast(`Канон сохранён: ${j.name}`,'ok'); catCardCache={}; CAT=null; catSelId=j.id; closeModal(); renderCatalog(document.getElementById('view'));
        }catch(e){ err.textContent=e.message; toast('Не сохранено: '+e.message,'err'); btn.disabled=false; btn.textContent='Сохранить'; }
      };
    }
    // ── Форма алиаса (ручной merge названия → канон) ──
    function openCatAlias(canonId){
