          <table class="dt" style="font-size:12.5px;width:100%"><thead><tr><th>Критерий</th><th style="text-align:center">Макс</th><th style="text-align:center">Балл</th></tr></thead>
          <tbody>${critRows}<tr style="background:#f0faf4"><td style="font-weight:700;color:var(--ink)">ИТОГО</td><td style="text-align:center;font-weight:700;color:#64748b">100</td><td style="text-align:center;font-weight:800;color:var(--green)">${latest.total??s.score??''}</td></tr></tbody></table>
          ${latest.note?`<div style="margin-top:9px;font-size:12px;color:var(--sub);line-height:1.55">${esc(latest.note)}</div>`:''}
          <div style="margin-top:8px;font-size:11.5px;color:var(--sub);display:flex;gap:10px"><span>Шкала: A 75–100 · B 50–74 · C &lt;50</span><span style="margin-left:auto">${latest.assessor?'провёл '+esc(latest.assessor):''}${latest.approver?' · утвердил '+esc(latest.approver):''}</span></div>
        </div>`:`<div class="card pad"><div class="sec-h" style="margin-bottom:8px">Лист оценки поставщика (Ф.3–К)</div><div style="font-size:13px;color:var(--sub)">Детальная разбивка ЛОП по критериям не заведена. Сводный балл РОП: <b style="color:var(--ink)">${s.score??'—'}</b> · категория ${esc(s.category||'—')}.</div></div>`;
      const histRows=evals.map(e=>`<div style="display:flex;align-items:center;gap:9px;font-size:12.5px"><span style="font-family:monospace;color:#5b6b7a;white-space:nowrap">${fmt(e.date)}</span><span>${esc(e.type||'Оценка')}</span><span style="margin-left:auto;font-weight:700;color:${DOTC[ropColor((/^([ABC])/.exec(e.category||'')||[])[1])]}">${e.total??''}${e.category?' · '+esc(e.category):''}</span></div>`).join('')||'<div class="c-gray" style="font-size:12.5px">нет записей</div>';
      const delRows=deliveries.map(r=>`<div style="display:flex;align-items:center;gap:8px;font-size:12.5px;cursor:pointer" data-znz="${esc(r.numZnz)}"><span class="code" style="color:var(--blue)">${esc(r.numZnz)}</span><span class="ell" title="${esc(r.name)}" style="flex:1;color:#334155">${esc(r.name)}</span><span style="margin-left:auto">${znzCell(r.status)}</span></div>`).join('')||'<div class="c-gray" style="font-size:12.5px">нет поставок</div>';
      viewHost.innerHTML=`<div style="display:flex;align-items:center;gap:12px;flex-wrap:wrap;margin-bottom:var(--gap)">
          <a class="c-blue" id="psupback" style="font-size:13px;text-decoration:none;cursor:pointer">← Поставщики</a>
          <span style="font-size:17px;font-weight:700;color:var(--navy)">${esc(s.name)}</span>
          <span class="st c-${col}" style="background:${col==='green'?'#ecfdf5':col==='amber'?'#fffbeb':col==='red'?'#fef2f2':'#eef6ff'};border:1px solid ${col==='green'?'#a7f3d0':col==='amber'?'#fde68a':col==='red'?'#fecaca':'#cfe0f5'};border-radius:2px;padding:3px 9px;font-size:11.5px"><i class="i-${col}"></i>${esc(s.category||'—')}${s.score!=null?' · '+s.score+' б.':''}</span>
        </div>
        <div style="display:grid;grid-template-columns:1fr 300px;gap:var(--gap);align-items:start">
          <div style="display:flex;flex-direction:column;gap:var(--gap)">
