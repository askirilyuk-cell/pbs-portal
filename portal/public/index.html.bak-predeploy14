      if((result==='Выиграли частично')!==prevPartial) drawKp(); // показать/скрыть блок частичного выигрыша
    }

    // ── Файлы запроса (папка записей на NAS): список по этапам + предпросмотр + скачивание ──
    const F_VIEW=/^(pdf|png|jpe?g|gif|webp|svg|html?|txt|md)$/i;
    const F_OFFICE=/^(docx?|xlsx?|pptx?|odt|ods|odp|rtf)$/i;   // предпросмотр через конвертацию в PDF (Gotenberg)
    const SALES_STAGES=['01-Запрос','02-Оценка','03-КП','04-Договор','05-Оплата','06-Переписка']; // этапы папки запроса (ДП–З.1)
    const fsize=(n)=>{ if(n==null)return ''; if(n<1024)return n+' Б'; if(n<1048576)return Math.round(n/1024)+' КБ'; return (n/1048576).toFixed(1).replace('.',',')+' МБ'; };
    const fileUrl=(zp,rel,dl)=>`/api/sales/file?zp=${encodeURIComponent(zp)}&rel=${encodeURIComponent(rel)}${dl?'&dl=1':''}`;
    async function loadReqFiles(zp){
      const host=document.getElementById('reqfiles'); if(!host)return;
      let d; try{ d=await (await fetch('/api/sales/files?zp='+encodeURIComponent(zp))).json(); }
      catch(e){ if(host.isConnected)host.innerHTML=`<div style="font-size:12.5px;color:var(--red)">Не удалось получить файлы: ${esc(e.message)}</div>`; return; }
      if(!host.isConnected)return;   // detail-панель пересобралась за время await (быстрое переключение ЗП) — не писать в отвалившийся узел
      const files=d.files||[];
      // панель загрузки: выбор этапа + drag-and-drop зона + кнопка (папка создаётся при первой загрузке)
      const uplBar=`<div style="background:#f6fbff;border:1px solid #cfe0f5;border-radius:2px;padding:9px 10px;margin-bottom:8px">
        <div style="display:flex;flex-wrap:wrap;align-items:center;gap:8px;margin-bottom:8px">
          <span style="font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.04em;color:#5b6b7a">Добавить файл · этап</span>
          <select id="upl-stage" style="font:inherit;font-size:12.5px;color:#1f3a52;padding:5px 8px;border:1px solid #cfd8e3;border-radius:2px;background:#fff">${SALES_STAGES.map(s=>`<option value="${esc(s)}">${esc(s)}</option>`).join('')}<option value="">(в корень папки)</option></select>
          <button class="tbtn primary" id="upl-btn" style="margin-left:auto;padding:5px 13px;font-size:12.5px">Загрузить</button>
        </div>
        <div id="upl-dz"></div>
        <div id="upl-status" style="font-size:12px;color:var(--sub);margin-top:6px"></div></div>`;
      let listHtml;
      if(!files.length){ listHtml=`<div style="font-size:12.5px;color:var(--sub)">${esc(d.warning||'Файлов пока нет — приложите через «Добавить файл».')}</div>`; }
      else {
        const groups={}, order=[];
        files.forEach(f=>{ const g=f.stage||'(корень)'; if(!groups[g]){groups[g]=[];order.push(g);} groups[g].push(f); });
        order.sort((a,b)=>a.localeCompare(b,'ru'));
        const fext=(x)=>`<span style="font:11px/1.4 monospace;font-weight:700;color:var(--navy);background:#eef4fb;border:1px solid #d6e4f5;border-radius:3px;padding:1px 5px;min-width:40px;text-align:center;flex:0 0 auto">${esc((x||'·').toUpperCase())}</span>`;
        listHtml=`<div style="font-size:11.5px;color:var(--sub);margin-bottom:2px">${files.length} файл(ов)${d.folder?` · ${esc(d.folder)}`:''}</div>`+order.map(g=>`<div style="margin-top:8px">
            <div style="font-size:10.5px;font-weight:700;color:var(--sub);text-transform:uppercase;letter-spacing:.04em;margin-bottom:1px">${esc(g)} <span style="color:var(--gray4)">${groups[g].length}</span></div>
            ${groups[g].map(f=>{const u=fileUrl(zp,f.rel),conv=`/api/sales/convert?zp=${encodeURIComponent(zp)}&rel=${encodeURIComponent(f.rel)}`,v=F_VIEW.test(f.ext)||F_OFFICE.test(f.ext);return `<div class="frow">
              <div style="display:flex;align-items:center;gap:8px;padding:6px 0;border-top:1px solid var(--line2)">
                ${fext(f.ext)}<span class="ell" title="${esc(f.name)}" style="flex:1;font-size:13px;color:#334155">${esc(f.name)}</span>
                <span style="font-size:11px;color:var(--sub);white-space:nowrap">${fsize(f.size)}</span>
                ${v?`<button class="tbtn" data-prev data-url="${u}" data-conv="${conv}" data-ext="${esc(f.ext)}" style="padding:3px 9px;font-size:12px">Просмотр</button>`:''}
                <a class="tbtn" href="${u}&dl=1" title="Скачать" style="padding:3px 9px;font-size:12px;text-decoration:none">⤓</a>
              </div><div class="fprev" hidden></div></div>`;}).join('')}
          </div>`).join('');
      }
      host.innerHTML=uplBar+listHtml;
      host.querySelectorAll('[data-prev]').forEach(b=>b.onclick=()=>toggleFilePrev(b));
      const dzEl=host.querySelector('#upl-dz'); const uplDz=dzEl?fileDropzone(dzEl,{note:'Перетащите файлы для этого запроса'}):null;
      const ub=host.querySelector('#upl-btn'); if(ub)ub.onclick=()=>uploadReqFiles(zp,uplDz);
    }
    async function uploadReqFiles(zp,dz){
      const sel=document.getElementById('upl-stage'),
        st=document.getElementById('upl-status'), btn=document.getElementById('upl-btn');
      const picked=dz?dz.files():[];
      if(!picked.length){ if(st)st.textContent='Перетащите или выберите файл(ы).'; return; }
      const fd=new FormData(); fd.append('zp',zp); fd.append('stage',sel?sel.value:'');
      picked.forEach(f=>fd.append('file',f,f.name));
      btn.disabled=true; const old=btn.textContent; btn.textContent='Загрузка…'; st.textContent='';
      try{ const r=await fetch('/api/sales/upload',{method:'POST',body:fd}); const j=await r.json().catch(()=>({})); if(!r.ok||j.error)throw new Error(j.error||('HTTP '+r.status));
        const n=(j.saved||[]).length, sk=(j.skipped||[]).length;
        await loadReqFiles(zp);
        const st2=document.getElementById('upl-status'); if(st2)st2.textContent=`Загружено: ${n}${sk?`, пропущено: ${sk}`:''}`;
      }catch(e){ st.textContent='Ошибка: '+(e.message||e); btn.disabled=false; btn.textContent=old; }
    }
