        ||'<tr><td colspan="5" class="c-gray" style="padding:8px 0">Истории цен нет — добавьте запись цены.</td></tr>';
      const rangeTxt=st.count?(st.min==null?`${st.count} записей`:(st.min===st.max?`${catRub(st.min)}/${esc(it.unit||'ед')}`:`от <b>${catRub(st.min)}</b> до <b>${catRub(st.max)}</b> /${esc(it.unit||'ед')}`)):'нет данных';
      host.innerHTML=`<div class="card pad">
          <div style="display:flex;align-items:flex-start;gap:10px">
            <div style="flex:1"><div style="font-size:16px;font-weight:700;color:var(--ink)">${esc(it.name)}</div>
              <div style="font-size:12px;color:var(--sub);margin-top:2px">${esc(it.category||'без категории')}${it.unit?(' · база: '+esc(it.unit)):''}</div></div>
            ${live?`<button class="tbtn" id="cat-edit" style="padding:6px 12px">Править</button>`:''}
          </div>
          <div style="margin-top:12px;border-top:1px solid #e2e8f0;padding-top:10px">
            ${attr('Тип',it.kind)}${attr('Марка / материал',it.grade)}${attr('Типоразмер',it.size)}${attr('ISO-обозначение',it.iso)}${attr('Базовая единица',it.unit)}${it.note?attr('Примечание',it.note):''}
          </div>
          <div style="margin-top:14px;display:flex;align-items:center;gap:10px">
            <b style="font-size:13px;color:var(--ink)">Алиасы / синонимы</b>
            ${live?`<button class="tbtn green" id="cat-add-alias" style="padding:4px 11px;font-size:12px">+ алиас</button>`:''}
          </div>
          <div class="tbl-wrap" style="margin-top:6px"><table class="dt"><thead><tr><th>Наименование (как называют)</th><th>Источник / произв.</th><th>Ед. источника</th><th style="text-align:right">Коэф.→база</th></tr></thead><tbody>${aliasRows}</tbody></table></div>
          <div style="margin-top:14px;display:flex;align-items:center;gap:10px">
            <b style="font-size:13px;color:var(--ink)">История цен (на канон)</b>
            ${live?`<button class="tbtn green" id="cat-add-price" style="padding:4px 11px;font-size:12px">+ цена</button>`:''}
            <span style="margin-left:auto;font-size:12.5px;color:var(--sub)">Разброс: ${rangeTxt}</span>
          </div>
          <div class="tbl-wrap" style="margin-top:6px"><table class="dt"><thead><tr><th>Дата</th><th>Поставщик</th><th style="text-align:right">Цена</th><th style="text-align:right">₽/базовую</th><th>Источник</th></tr></thead><tbody>${priceRows}</tbody></table></div>
        </div>`;
      const eb=host.querySelector('#cat-edit'); if(eb)eb.onclick=()=>openCatCanon(it);
      const aa=host.querySelector('#cat-add-alias'); if(aa)aa.onclick=()=>openCatAlias(it.id);
      const ap=host.querySelector('#cat-add-price'); if(ap)ap.onclick=()=>openCatPrice(it.id,it.unit);
    }
    // ── Форма канон-позиции (создать / править) ──
    function openCatCanon(canon){
