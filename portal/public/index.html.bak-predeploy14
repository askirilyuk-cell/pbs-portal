        }catch(e){ err.textContent=e.message; toast('Не добавлено: '+e.message,'err'); btn.disabled=false; btn.textContent='Добавить цену'; }
      };
    }

    // ══ Раздел «Участки и оборудование» — ДП–О.3 (K-35, реестр «Оборудование» Ф.3–О.3) ══
    // Разрезы: участок → его оборудование → задачи на оборудовании (mm-связь Ф.14).
    // Заведение единицы через форму «+ Новое оборудование» (автонумер инв.№ ОБ-NNN на бэкенде).
    let EQ=null, eqSelId=null, eqOpenSec=null, eqCardCache={};
    // K-35 редизайн: 3 вкладки раздела — дерево участков · реестр парка · обслуживание
    let eqTab='tree', eqRegSection='', eqRegFilter='all', eqRegQ='', eqMntSeg='todo', eqMntType='all', eqMntKind='planned', eqRegGridApi=null, eqMntGridApi=null;
    const EQ_STDOT={'В работе':'green','В ремонте':'amber','Резерв':'gray','Законсервировано':'gray','Списано':'red'};
    const eqStCell=(s)=>s?`<span class="st"><i class="i-${EQ_STDOT[s]||'gray'}"></i>${esc(s)}</span>`:'<span class="c-gray">—</span>';
    const eqYmd=()=>new Date().toISOString().slice(0,10);
    const eqDaysLeft=(d)=>{const m=/^(\d{4})-(\d{2})-(\d{2})/.exec(String(d||''));if(!m)return null;const t=Date.parse(m[1]+'-'+m[2]+'-'+m[3]);if(isNaN(t))return null;return Math.round((t-Date.parse(eqYmd()))/86400000);};
    const eqOverdue=(d)=>{const n=eqDaysLeft(d);return n!=null&&n<0;};
    // ТО-1 в ячейке: просрочка красным+bold, ≤14 дн — amber, иначе обычный
    const eqTo1Cell=(i)=>{ if(!i.to1Next)return '<span class="c-gray">—</span>'; const n=eqDaysLeft(i.to1Next); if(n!=null&&n<0)return `<b class="c-red" style="font-weight:800">${fmt(i.to1Next)} · просрочено ${-n} дн</b>`; if(n!=null&&n<=14)return `<span class="c-amber">${fmt(i.to1Next)}</span>`; return `<span style="color:#334155">${fmt(i.to1Next)}</span>`; };
    // бейдж типа ТО (план/внеплан) — только существующие токены
    const eqTypeChip=(t)=>t==='unplanned'
      ? '<span class="src-chip" style="background:#fffbeb;color:#b45309;border:1px solid #fde68a">внеплан</span>'
      : '<span class="src-chip" style="background:#eff6ff;color:#1d4e89;border:1px solid #cfe0f5">план</span>';
    async function renderEquipment(host,arg){
      host.innerHTML='<div class="card pad" style="color:var(--sub)">Загрузка раздела «Участки и оборудование»…</div>';
      if(!EQ){ try{EQ=await (await fetch('/api/equipment')).json();}catch(e){EQ={mode:'mock',warning:String(e.message||e),items:[],groups:[],sections:[],kpis:{}};} }
      if(arg){ const it=(EQ.items||[]).find(i=>String(i.id)===arg||i.invNo===arg); if(it){eqSelId=it.id; eqTab='tree';} }
      const live=EQ.mode==='live';
      const items=EQ.items||[], k=EQ.kpis||{};
      const to1OverdueN=items.filter(i=>eqOverdue(i.to1Next)).length;
      const to1SoonN=items.filter(i=>{const n=eqDaysLeft(i.to1Next);return n!=null&&n>=0&&n<=14;}).length;
      const tag=srcChip(live, live?(items.length+' ед. · '+(k.sections||0)+' участков'):'реестр «Оборудование» ещё не наполнен');
      const m=(lbl,num,col,sub)=>`<div class="m"><div class="lbl">${lbl}</div><div class="num"${col?` style="color:${col}"`:''}>${num}</div>${sub?`<div style="font-size:10.5px;color:var(--sub);margin-top:1px">${sub}</div>`:''}</div>`;
      host.innerHTML=`<div class="mstrip">
          ${m('Единиц оборудования',k.total??items.length,'var(--navy)','реестр Ф.3–О.3')}
          ${m('В работе',k.inWork??0,'var(--green)', (k.repair?k.repair+' в ремонте':''))}
          ${m('С ЧПУ',k.cnc??0,'var(--ink)','числовое ПУ')}
          ${m('ТО-1 просрочено',to1OverdueN,(to1OverdueN?'var(--red)':'var(--ink)'),(to1SoonN?to1SoonN+' в ближайшие 14 дн':'по графику'))}
        </div>
        <div class="filters card" style="margin-top:var(--gap);padding:8px 10px">
          <div class="seg" id="eqseg">
            <button data-t="tree" class="${eqTab==='tree'?'on':''}">Дерево участков</button>
            <button data-t="reg" class="${eqTab==='reg'?'on':''}">Реестр парка</button>
            <button data-t="mnt" class="${eqTab==='mnt'?'on':''}">Обслуживание</button>
          </div>
          <span style="margin-left:auto;font-size:12px;color:#64748b">${tag}</span>
        </div>
        <div id="eqbody" style="margin-top:var(--gap)"></div>`;
      host.querySelectorAll('#eqseg button').forEach(b=>b.onclick=()=>{ eqTab=b.dataset.t;
        try{history.replaceState(null,'',(eqTab==='tree'&&eqSelId!=null)?('#equipment/'+encodeURIComponent(eqSelId)):'#equipment');}catch{}
        host.querySelectorAll('#eqseg button').forEach(x=>x.classList.toggle('on',x.dataset.t===eqTab)); eqBody(); });
      eqBody();
    }
    function eqBody(){ const h=document.getElementById('eqbody'); if(!h)return; eqTab==='reg'?eqRegBody(h):eqTab==='mnt'?eqMntBody(h):eqTreeBody(h); }

    // ── Вкладка 1a: дерево участков + паспорт ──
    function eqTreeBody(host){
      host.innerHTML=`<div class="card" style="padding:8px 10px;display:flex;gap:6px;align-items:center;flex-wrap:wrap">
          <button class="tbtn green" id="eq-new">+ Новое оборудование</button>
          <input id="eq-search" placeholder="Поиск: инв.№ / наименование / модель" style="font:inherit;font-size:12.5px;padding:6px 9px;border:1px solid var(--bd);border-radius:6px;min-width:230px">
        </div>
        <div class="split" style="margin-top:var(--gap)">
          <div class="card" style="padding:0;overflow:hidden;align-self:stretch">
            <div style="padding:7px 11px;border-bottom:1px solid var(--line2);font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.05em;color:var(--sub)">Участок → оборудование</div>
            <div class="list" id="eqtree" style="max-height:640px;overflow:auto"></div>
          </div>
          <div class="detail" id="eqdetail"></div>
        </div>`;
      const nb=host.querySelector('#eq-new'); if(nb)nb.onclick=()=>openEquipForm(null);
      const sr=host.querySelector('#eq-search'); if(sr)sr.oninput=()=>eqPaintTree();
      eqPaintTree();
    }

    // ── Вкладка 1b: Реестр парка — плоская erpGrid всего оборудования ──
    function eqRegBody(host){
      const items=(EQ&&EQ.items)||[];
      const sections=[...new Set(items.map(i=>i.sectionName).filter(Boolean))].sort((a,b)=>a.localeCompare(b,'ru'));
      const secOpts='<option value="">Все участки</option>'+sections.map(s=>`<option${eqRegSection===s?' selected':''}>${esc(s)}</option>`).join('');
      const seg=(v,l,col)=>`<button data-f="${esc(v)}" class="${eqRegFilter===v?'on':''}"${col?` style="color:${col}"`:''}>${l}</button>`;
      host.innerHTML=`<div class="filters card" style="padding:8px 10px">
          <input id="eqreg-q" placeholder="Поиск: инв.№ / наименование / модель" value="${esc(eqRegQ)}" style="font:inherit;font-size:12.5px;padding:6px 9px;border:1px solid var(--bd);border-radius:6px;width:230px">
          <select id="eqreg-sec" style="font:inherit;font-size:12.5px;padding:6px 9px;border:1px solid var(--bd);border-radius:6px">${secOpts}</select>
          <div class="seg" id="eqreg-seg">${seg('all','Все')}${seg('work','В работе','var(--green)')}${seg('repair','В ремонте','var(--amber)')}${seg('cnc','ЧПУ')}</div>
          <button class="tbtn green" id="eqreg-new" style="margin-left:auto">+ Оборудование</button>
        </div>
        <div id="eqreggrid" style="margin-top:var(--gap);min-width:0"></div>`;
      const q=host.querySelector('#eqreg-q'); if(q)q.oninput=()=>{eqRegQ=q.value;eqRegGrid();};
      const sc=host.querySelector('#eqreg-sec'); if(sc)sc.onchange=()=>{eqRegSection=sc.value;eqRegGrid();};
      host.querySelectorAll('#eqreg-seg button').forEach(b=>b.onclick=()=>{eqRegFilter=b.dataset.f;host.querySelectorAll('#eqreg-seg button').forEach(x=>x.classList.toggle('on',x.dataset.f===eqRegFilter));eqRegGrid();});
      const nw=host.querySelector('#eqreg-new'); if(nw)nw.onclick=()=>openEquipForm(null);
      eqRegGrid();
    }
    function eqRegGrid(){
      const gh=document.getElementById('eqreggrid'); if(!gh)return;
      let rows=((EQ&&EQ.items)||[]).slice();
      const q=(eqRegQ||'').trim().toLowerCase();
      if(q)rows=rows.filter(i=>[i.invNo,i.name,i.model,i.serialNo].some(x=>String(x||'').toLowerCase().includes(q)));
      if(eqRegSection)rows=rows.filter(i=>i.sectionName===eqRegSection);
      if(eqRegFilter==='work')rows=rows.filter(i=>i.status==='В работе');
      else if(eqRegFilter==='repair')rows=rows.filter(i=>i.status==='В ремонте');
      else if(eqRegFilter==='cnc')rows=rows.filter(i=>i.isCnc);
      // сортировка по умолчанию ↑ по ТО-1 след. (просрочка/ближайшие наверху)
      rows.sort((a,b)=>{const x=a.to1Next?(Date.parse(a.to1Next)||8e15):8e15,y=b.to1Next?(Date.parse(b.to1Next)||8e15):8e15;return x-y;});
      const live=EQ&&EQ.mode==='live';
      if(!rows.length){ gh.innerHTML='<div class="card pad" style="color:var(--sub);font-size:13px">'+((EQ&&EQ.mode==='live')?'Оборудование не найдено по фильтру.':'Реестр «Оборудование» ещё не наполнен (появится в LIVE-режиме).')+'</div>'; eqRegGridApi=null; return; }
      const cncChip='<span class="src-chip" style="font-size:9.5px;padding:1px 5px;background:#eef2ff;color:#4338ca;border:1px solid #c7d2fe">ЧПУ</span>';
      const cols=[
        {key:'code',label:'Инв. №',w:112,cls:'code',cell:i=>esc(i.invNo||'—'),sortVal:i=>i.invNo},
        {key:'name',label:'Наименование',cls:'ell',cell:i=>`<span title="${esc(i.name||'')}" style="font-weight:600;color:var(--ink)">${esc(i.name||'—')}</span>`,sortVal:i=>i.name},
        {key:'model',label:'Модель',w:130,cls:'nw c-gray',cell:i=>esc(i.model||'—'),sortVal:i=>i.model},
        {key:'sec',label:'Участок',w:130,cls:'nw c-gray',cell:i=>esc(i.sectionName||'—'),sortVal:i=>i.sectionName},
        {key:'cnc',label:'ЧПУ',w:64,cls:'nw',cell:i=>i.isCnc?cncChip:'<span class="c-gray">—</span>',sortVal:i=>i.isCnc?0:1},
        {key:'resp',label:'Ответственный',w:140,cls:'nw c-gray',cell:i=>esc(i.responsible||'—'),sortVal:i=>i.responsible},
        {key:'to1',label:'ТО-1 след.',w:180,cls:'nw',cell:eqTo1Cell,sortVal:i=>i.to1Next?(Date.parse(i.to1Next)||8e15):8e15},
        {key:'status',label:'Статус',w:130,cls:'nw',cell:i=>eqStCell(i.status),sortVal:i=>i.status},
      ];
      eqRegGridApi=erpGrid(gh,{key:'eq-reg',cols,rows,search:false,rowKey:i=>String(i.id),selKey:eqSelId!=null?String(eqSelId):null,
        rowClass:i=>eqOverdue(i.to1Next)?'row-def':'',
        onRow:i=>{ eqSelId=i.id; eqTab='tree'; try{history.replaceState(null,'','#equipment/'+encodeURIComponent(i.id));}catch{}
          const sg=document.getElementById('eqseg'); if(sg)sg.querySelectorAll('button').forEach(x=>x.classList.toggle('on',x.dataset.t==='tree')); eqBody(); },
        info:`${srcChip(live)}<span>Единиц: <b style="color:var(--ink)">${rows.length}</b></span><span class="c-gray">клик по строке — паспорт единицы</span>`});
    }

    // ── Вкладка 1c: Обслуживание — план/внеплан ТО ──
    // модель обслуживания из реестра: плановые = единицы с ТО-1 следующее; внеплановые = «В ремонте»
    function eqMntRows(){
      const items=(EQ&&EQ.items)||[]; const out=[];
      for(const i of items){
        if(i.to1Next) out.push({eq:i,kind:'planned',workType:'ТО-1',section:i.sectionName,due:i.to1Next,last:i.to1Last});
        if(i.status==='В ремонте') out.push({eq:i,kind:'unplanned',workType:'Ремонт по отказу',section:i.sectionName,due:eqYmd(),last:''});
      }
      return out;
    }
    function eqMntBody(host){
      const all=eqMntRows();
      const overdue=all.filter(r=>r.kind==='planned'&&eqOverdue(r.due));
      const soon=all.filter(r=>r.kind==='planned'&&(()=>{const n=eqDaysLeft(r.due);return n!=null&&n>=0&&n<=14;})());
      const unpl=all.filter(r=>r.kind==='unplanned');
      const tile=(num,lbl,col,sub)=>`<div class="card" style="flex:1;padding:11px 13px;border-left:3px solid ${col}"><div style="display:flex;align-items:baseline;gap:8px"><span style="font-size:22px;font-weight:800;color:${col};line-height:1">${num}</span><span style="font-size:12px;color:var(--sub)">${lbl}</span></div><div style="font-size:11.5px;color:#64748b;margin-top:5px">${sub||'&nbsp;'}</div></div>`;
      const segT=(v,l)=>`<button data-s="${v}" class="${eqMntSeg===v?'on':''}">${l}</button>`;
      const segY=(v,l,col)=>`<button data-y="${v}" class="${eqMntType===v?'on':''}"${col?` style="color:${col}"`:''}>${l}</button>`;
      host.innerHTML=`<div class="filters card" style="padding:8px 10px">
          <span class="k-lbl" style="font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.05em;color:var(--sub)">План-график ТО</span>
          <button class="tbtn primary" id="eqmnt-plan" style="margin-left:auto">+ Запланировать ТО</button>
        </div>
        <div style="display:flex;gap:8px;margin-top:var(--gap);flex-wrap:wrap">
          ${tile(overdue.length,'ТО-1 просрочено','var(--red)',overdue.map(r=>r.eq.invNo).slice(0,3).join(', ')||'нет')}
          ${tile(soon.length,'в 14 дней','var(--amber)','плановые по графику')}
          ${tile(unpl.length,'внеплановое сейчас','#7c3aed',unpl.map(r=>r.eq.invNo).slice(0,3).join(', ')||'нет')}
          ${tile(0,'выполнено за месяц','var(--green)','план/внеплан — в LIVE')}
        </div>
        <div class="filters card" style="padding:8px 10px;margin-top:var(--gap)">
          <div class="seg" id="eqmnt-seg">${segT('todo','К выполнению')}${segT('all','Все')}${segT('done','Выполненные')}</div>
          <div class="seg" id="eqmnt-type">${segY('all','Все типы')}${segY('planned','Плановые','#1d4e89')}${segY('unplanned','Внеплановые','var(--amber)')}</div>
          <span style="margin-left:auto;font-size:11px;color:#5b6b7a">по сроку ↑</span>
        </div>
        <div id="eqmntgrid" style="margin-top:var(--gap);min-width:0"></div>`;
      const pb=host.querySelector('#eqmnt-plan'); if(pb)pb.onclick=()=>eqMntForm(null);
      host.querySelectorAll('#eqmnt-seg button').forEach(b=>b.onclick=()=>{eqMntSeg=b.dataset.s;host.querySelectorAll('#eqmnt-seg button').forEach(x=>x.classList.toggle('on',x.dataset.s===eqMntSeg));eqMntGrid();});
      host.querySelectorAll('#eqmnt-type button').forEach(b=>b.onclick=()=>{eqMntType=b.dataset.y;host.querySelectorAll('#eqmnt-type button').forEach(x=>x.classList.toggle('on',x.dataset.y===eqMntType));eqMntGrid();});
      eqMntGrid();
    }
    function eqMntGrid(){
      const gh=document.getElementById('eqmntgrid'); if(!gh)return;
      let rows=eqMntRows();
      if(eqMntType==='planned')rows=rows.filter(r=>r.kind==='planned');
      else if(eqMntType==='unplanned')rows=rows.filter(r=>r.kind==='unplanned');
      if(eqMntSeg==='todo')rows=rows.filter(r=>{const n=eqDaysLeft(r.due);return r.kind==='unplanned'||(n!=null&&n<=14);});
      else if(eqMntSeg==='done')rows=[]; // факты ТО ведутся в LIVE
      rows.sort((a,b)=>{const x=Date.parse(a.due)||8e15,y=Date.parse(b.due)||8e15;return x-y;});
      const live=EQ&&EQ.mode==='live';
      if(!rows.length){ gh.innerHTML='<div class="card pad" style="color:var(--sub);font-size:13px">'+((EQ&&EQ.mode==='live')?(eqMntSeg==='done'?'Журнал выполненных ТО ведётся в LIVE-режиме.':'Нет ТО по фильтру.'):'План-график появится после наполнения реестра (LIVE).')+'</div>'; eqMntGridApi=null; return; }
      const dueCell=(r)=>{ const n=eqDaysLeft(r.due); if(n!=null&&n<0)return `<b class="c-red" style="font-weight:700">${fmt(r.due)} · ${-n>0?'−'+(-n)+' дн':'сегодня'}</b>`; if(n===0)return `<b class="c-red" style="font-weight:700">${fmt(r.due)} · сегодня</b>`; if(n!=null&&n<=14)return `<span class="c-amber">${fmt(r.due)} · через ${n} дн</span>`; return `<span style="color:#64748b">${fmt(r.due)}${n!=null?' · через '+n+' дн':''}</span>`; };
      const cols=[
        {key:'code',label:'Инв. №',w:112,cls:'code',cell:r=>esc(r.eq.invNo||'—'),sortVal:r=>r.eq.invNo},
        {key:'name',label:'Оборудование',cls:'ell',cell:r=>`<span style="font-weight:600;color:var(--ink)">${esc(r.eq.name||'—')}</span>`,sortVal:r=>r.eq.name},
        {key:'type',label:'Тип',w:96,cls:'nw',cell:r=>eqTypeChip(r.kind),sortVal:r=>r.kind},
        {key:'work',label:'Вид работ',w:150,cls:'nw c-gray',cell:r=>esc(r.workType||'—'),sortVal:r=>r.workType},
        {key:'sec',label:'Участок',w:120,cls:'nw c-gray',cell:r=>esc(r.section||'—'),sortVal:r=>r.section},
        {key:'due',label:'Срок',w:180,cls:'nw',cell:dueCell,sortVal:r=>Date.parse(r.due)||8e15},
        {key:'act',label:'',w:118,cls:'nw',cell:r=>`<button class="tbtn ${eqOverdue(r.due)||eqDaysLeft(r.due)===0?'primary':''}" data-mark="${esc(String(r.eq.id))}" style="padding:3px 9px;font-size:11.5px">Отметить ✓</button>`,sortVal:r=>0},
      ];
      eqMntGridApi=erpGrid(gh,{key:'eq-mnt',cols,rows,search:false,
        rowClass:r=>eqOverdue(r.due)?'row-def':'',
        info:`${srcChip(live)}<span>Позиций: <b style="color:var(--ink)">${rows.length}</b></span><span class="c-gray">«Отметить ✓» — факт ТО</span>`});
      gh.addEventListener('click',e=>{const b=e.target.closest('[data-mark]'); if(b){ e.stopPropagation(); eqMntMark(b.dataset.mark); }},true);
    }
    async function eqMntMark(id){
      if(!EQ||EQ.mode!=='live'){ toast('Отметка о выполнении ТО доступна в LIVE-режиме (нужен токен NocoDB).','err'); return; }
      const it=((EQ&&EQ.items)||[]).find(i=>String(i.id)===String(id)); if(!it)return;
      const next=new Date(); next.setMonth(next.getMonth()+3);
      try{ const r=await fetch('/api/equipment/maintenance',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({equipmentId:it.id,kind:'planned',workType:'ТО-1',responsible:it.responsible||'—',lastDate:eqYmd(),planDate:next.toISOString().slice(0,10)})});
        const j=await r.json().catch(()=>({})); if(!r.ok||j.error)throw new Error(j.error||('HTTP '+r.status));
        toast('ТО отмечено, следующее ТО-1 пересчитано.','ok'); EQ=null; eqCardCache={}; renderEquipment(document.getElementById('view'));
      }catch(e){ toast('Не удалось отметить: '+e.message,'err'); }
    }
    // ── Форма планирования ТО (макеты 2a/2c) — переключатель Плановое/Внеплановое ──
    function eqMntForm(it){
      const items=(EQ&&EQ.items)||[]; const cur=it||items.find(i=>String(i.id)===String(eqSelId))||items[0]||null;
      const live=EQ&&EQ.mode==='live';
      const G='display:grid;grid-template-columns:repeat(12,1fr);gap:12px';
      const eqOpts=['<option value="">— выберите оборудование —</option>'].concat(items.map(i=>`<option value="${esc(String(i.id))}"${cur&&String(cur.id)===String(i.id)?' selected':''}>${esc((i.invNo?i.invNo+' · ':'')+(i.name||''))}</option>`)).join('');
      const seg=`<span class="seg" style="padding:2px"><button type="button" data-k="planned" class="${eqMntKind==='planned'?'on':''}" style="font-size:12px;padding:6px 13px">Плановое</button><button type="button" data-k="unplanned" class="${eqMntKind==='unplanned'?'on':''}" style="font-size:12px;padding:6px 13px">Внеплановое</button></span>`;
      const planned=`<div style="grid-column:span 4">${FLAB('Вид работ',true)}<select id="mnt-work" style="${FINP}"><option>ТО-1 (периодическое)</option><option>ТО-2</option><option>Осмотр</option><option>Смазка / регламент</option></select></div>
          <div style="grid-column:span 4">${FLAB('Категория ТО')}<select id="mnt-cat" style="${FINP}"><option>II · раз в 3 мес</option><option>I · раз в 6 мес</option><option>III · раз в мес</option></select></div>
          <div style="grid-column:span 4">${FLAB('Ответственный',true)}<input id="mnt-resp" style="${FINP}" value="${cur?esc(cur.responsible||''):''}"></div>
          <div style="grid-column:span 4">${FLAB('Последнее ТО')}<input id="mnt-last" type="date" style="${FINP}" value="${cur&&cur.to1Last?String(cur.to1Last).slice(0,10):''}"></div>
          <div style="grid-column:span 4">${FLAB('Плановая дата',true)}<input id="mnt-plan" type="date" style="${FINP}" value="${cur&&cur.to1Next?String(cur.to1Next).slice(0,10):''}"></div>
          <div style="grid-column:span 4">${FLAB('Плановый простой')}<input id="mnt-down" style="${FINP}" placeholder="напр. 4 ч"></div>
          <div style="grid-column:span 12">${FLAB('Работы / регламент')}<input id="mnt-works" style="${FINP}" placeholder="что выполнить: замена СОЖ, проверка направляющих…"></div>
          <div style="grid-column:span 12"><div style="background:#eff6ff;border:1px solid #cfe0f5;border-radius:2px;padding:8px 11px;font-size:11.5px;color:#1d4e89;line-height:1.5"><b>Плановое:</b> дата = «последнее ТО» + период категории (можно скорректировать). Запись попадёт в план-график и KPI «ТО-1».</div></div>`;
      const unplanned=`<div style="grid-column:span 4">${FLAB('Вид работ',true)}<select id="mnt-work" style="${FINP}"><option>Ремонт по отказу</option><option>Аварийный ремонт</option><option>Внеплановый осмотр</option></select></div>
          <div style="grid-column:span 4">${FLAB('Дата',true)}<input id="mnt-plan" type="date" style="${FINP}" value="${eqYmd()}"></div>
          <div style="grid-column:span 4">${FLAB('Ответственный',true)}<input id="mnt-resp" style="${FINP}" value="${cur?esc(cur.responsible||''):''}"></div>
          <div style="grid-column:span 12">${FLAB('Причина (отказ / поломка)',true)}<input id="mnt-reason" style="${FINP}" placeholder="что произошло"></div>
          <div style="grid-column:span 6">${FLAB('Связанная заявка / НП')}<input id="mnt-ref" style="${FINP}" placeholder="№ заявки в ремонт / НП"></div>
          <div style="grid-column:span 6">${FLAB('Плановый простой')}<input id="mnt-down" style="${FINP}" placeholder="напр. 1 смена"></div>
          <div style="grid-column:span 12"><div style="background:#fffbeb;border:1px solid #fde68a;border-radius:2px;padding:8px 11px;font-size:11.5px;color:#8a5a13;line-height:1.5"><b>Внеплановое</b> не сдвигает график планового ТО-1; оборудование переводится в статус «В ремонте».</div></div>`;
      modal.style.width='min(720px,96vw)';
      modal.innerHTML=`<div class="mh"><b>Планирование ТО</b><span class="op">ДП–О.3 · план-график</span><button class="x" id="mx" aria-label="Закрыть">✕</button></div>
        <div class="mb" style="gap:0">
          <div style="display:flex;align-items:center;gap:10px;margin-bottom:14px;flex-wrap:wrap">
            <span style="font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.04em;color:#5b6b7a">Тип ТО:</span>
            <span id="mnt-kindseg">${seg}</span>
            <span style="margin-left:auto;font-size:11px;color:#5b6b7a">${eqMntKind==='planned'?'плановое — по графику':'по факту отказа — вне графика'}</span>
          </div>
          <div style="${G}">
            <div style="grid-column:span 12">${FLAB('Оборудование',true)}<select id="mnt-eq" style="${FINP}">${eqOpts}</select></div>
            <div id="mnt-fields" style="grid-column:span 12"><div style="${G}">${eqMntKind==='planned'?planned:unplanned}</div></div>
          </div>
          <div id="mnt-err" style="margin-top:12px;color:#b91c1c;font-size:12.5px"></div>
          <div style="margin-top:14px;padding-top:13px;border-top:1px solid #e2e8f0;display:flex;align-items:center;gap:10px">
            <span style="font-size:12px;color:#5b6b7a"><span style="color:#b91c1c">*</span> — обязательное поле</span>
            <div style="margin-left:auto;display:flex;gap:10px">
              <button class="tbtn" id="mnt-cancel" style="padding:9px 18px">Отмена</button>
              <button class="tbtn ${eqMntKind==='planned'?'green':'primary'}" id="mnt-save" style="padding:9px 18px">${eqMntKind==='planned'?'Запланировать':'Создать внеплановое ТО'}</button>
            </div>
          </div>
        </div>`;
      modal.classList.add('open'); mscrim.classList.add('open');
      document.getElementById('mx').onclick=closeModal; document.getElementById('mnt-cancel').onclick=closeModal;
      modal.querySelectorAll('#mnt-kindseg button').forEach(b=>b.onclick=()=>{ if(b.dataset.k===eqMntKind)return; eqMntKind=b.dataset.k; eqMntForm(it); });
      document.getElementById('mnt-save').onclick=async()=>{
        const err=document.getElementById('mnt-err'); err.textContent='';
        const V=(id)=>{const el=document.getElementById(id);return el?el.value.trim():'';};
        const eqId=V('mnt-eq'), resp=V('mnt-resp'), planDate=V('mnt-plan');
        if(!eqId){ err.textContent='Выберите оборудование.'; return; }
        if(!resp){ err.textContent='Укажите ответственного.'; return; }
        if(!planDate){ err.textContent=eqMntKind==='planned'?'Укажите плановую дату.':'Укажите дату.'; return; }
        if(eqMntKind==='unplanned'&&!V('mnt-reason')){ err.textContent='Укажите причину (отказ/поломка).'; return; }
        const body={ equipmentId:eqId, kind:eqMntKind, workType:V('mnt-work'), responsible:resp, planDate,
          category:eqMntKind==='planned'?V('mnt-cat'):undefined, lastDate:eqMntKind==='planned'?V('mnt-last'):undefined,
          downtime:V('mnt-down')||undefined, reason:eqMntKind==='unplanned'?V('mnt-reason'):undefined,
          ref:eqMntKind==='unplanned'?V('mnt-ref'):undefined, works:eqMntKind==='planned'?V('mnt-works'):undefined };
        if(!live){ toast('Планирование ТО доступно в LIVE-режиме (нужен токен NocoDB).','err'); return; }
