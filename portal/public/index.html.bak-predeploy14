      const norm=(s)=>String(s||'').toLowerCase();
      mount.style.position='relative';
      mount.innerHTML=`
        <div class="cb-field" style="display:flex;align-items:center;gap:8px;border:1px solid #cfd8e3;border-radius:2px;padding:0 10px;background:#fff">
