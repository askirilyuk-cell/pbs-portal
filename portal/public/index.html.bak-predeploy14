      const back=viewHost.querySelector('#psupback'); if(back)back.onclick=()=>{procTab='rop';renderProcurement(viewHost);};
      viewHost.querySelectorAll('[data-znz]').forEach(el=>el.onclick=()=>{const r=(PROC.requests||[]).find(x=>x.numZnz===el.dataset.znz);if(r)openZnzCard(r);});
