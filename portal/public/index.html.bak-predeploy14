          cjCache=null; closeModal(); cjBody(document.getElementById('tlbody'));
        }catch(e){ err.textContent=e.message; toast('Не сохранено: '+e.message,'err'); btn.disabled=false; btn.textContent=edit?'Сохранить':'Завести'; }
      };
    }

    // --- рабочее место участка (планшет) --------------------------------------
    let stationSel = (()=>{try{return localStorage.getItem('pbs-station')||'';}catch{return '';}})();
    let boardMode = (()=>{try{return localStorage.getItem('pbs-board-mode')||'status';}catch{return 'status';}})();
    function sectionsList(){
      const m=new Map();
      DATA.orders.flatMap(o=>o.tasks).forEach(t=>{ if(t.sectionCode && !m.has(t.sectionCode)) m.set(t.sectionCode, t.sectionName||''); });
      return [...m.entries()].map(([code,name])=>({code,name})).sort((a,b)=>a.code.localeCompare(b.code));
    }
    function stationTasks(){
      return DATA.orders.flatMap(o=>o.tasks.map(t=>({...t,pz:o.numPz}))).filter(t=>t.sectionCode===stationSel);
    }
    function renderStation(host){
      const secs=sectionsList();
      if((!stationSel||!secs.some(s=>s.code===stationSel)) && secs.length) stationSel=secs[0].code;
      const opts=secs.map(s=>`<option value="${esc(s.code)}" ${s.code===stationSel?'selected':''}>${esc(s.code)}${s.name?' · '+esc(s.name):''}</option>`).join('')||'<option>нет участков</option>';
      const ord={'В работе':0,'В очереди':1,'Приостановлено':2,'Выполнено':3};
      const tasks=stationTasks().sort((a,b)=>(ord[a.status]??9)-(ord[b.status]??9));
      const cards=tasks.map(t=>`<div class="st-card ${TKCLASS[t.status]||'work'}" data-tid="${esc(t.id??t.num)}">
        <div class="op">${esc(t.op)} · ${esc(t.pz)}</div>
        <div class="nm">${esc(t.title||'Операция')}</div>
        <div class="meta">${badge(t.status)}<span>срок ${fmt(t.plan)}</span></div></div>`).join('')||'<div class="st-empty">На участке нет задач</div>';
      host.innerHTML=`<div class="st-top"><span class="title">Рабочее место</span>
        <select id="st-sec" aria-label="Участок">${opts}</select>
        <span class="spacer"></span><span style="color:#64748b;font-size:14px">активных задач: ${tasks.filter(t=>t.status!=='Выполнено').length} / ${tasks.length}</span></div>
        <div class="st-grid" style="margin-top:8px">${cards}</div>`;
      const sec=document.getElementById('st-sec');
      if(sec)sec.onchange=(e)=>{stationSel=e.target.value;try{localStorage.setItem('pbs-station',stationSel);}catch{} renderStation(host);};
      host.querySelectorAll('.st-card').forEach(c=>c.onclick=()=>renderStationTask(host,c.dataset.tid));
    }
    function renderStationTask(host,key){
      const t=stationTasks().find(x=>String(x.id??x.num)===String(key)); if(!t)return;
      const ro=DATA.mode!=='live';
      const C=t.control||{};
      const ctl=(C.point&&C.point!=='нет')?([C.what,C.tol,C.si].filter(Boolean).join(' · ')+(C.point?` (${esc(C.point)})`:'')):'';
      // «Выполнено» рабочий вручную не ставит — оно производное от приёмки журнала (кнопка «Закрыть задачу»)
      const statusBtns=['В очереди','В работе','Приостановлено'].map(s=>`<button class="st-sbtn ${s===t.status?'on':''}" data-st="${esc(s)}" ${ro?'disabled':''}>${esc(s)}</button>`).join('');
      const normStr=p=>[p.norm,p.tol].filter(x=>x!==''&&x!=null).join(' ');
      const paramRows=(t.params||[]).map(p=>`<div class="st-param">
        <div class="st-prow"><div class="pn">${esc(p.name)} <span class="pu">${esc(p.unit||'')}</span></div>
          <div class="pu">${normStr(p)?'норматив <b>'+esc(normStr(p))+'</b>':'норматив не задан'}</div></div>
        ${p.pid!=null?`<input data-pid="${esc(p.pid)}" value="${esc(p.fact)}" placeholder="введите факт" inputmode="decimal" ${ro?'disabled':''}>`:`<span class="pu">${esc(p.fact||'—')}</span>`}</div>`).join('');
      const kv=(k,v)=>`<div class="kv">${esc(k)}: <b>${esc(v)}</b></div>`;
      // §7 Журнал по единицам: строка на каждую единицу (по кол-ву задания)
      const qtyN=Math.max(Number(t.qtyPlan)||0,(t.journal||[]).length,1);
      const jByU=new Map((t.journal||[]).map(j=>[Number(j.unit),j]));
      const jOpt=(v,cur)=>`<option value="${v}" ${cur===v?'selected':''}>${v||'—'}</option>`;
      // исполнитель — выпадающий список допущенных к участку (t.executors); если список пуст — ручной ввод
      const execs=Array.isArray(t.executors)?t.executors:[];
      const execCell=(cur)=>{
        if(!execs.length) return `<input class="j-exec" value="${esc(cur||'')}" placeholder="ФИО" ${ro?'disabled':''}>`;
        const extra=(cur&&execs.indexOf(cur)<0)?`<option value="${esc(cur)}" selected>${esc(cur)} (вне участка)</option>`:'';
        const opts=`<option value="">— исполнитель —</option>`+execs.map(n=>`<option value="${esc(n)}" ${n===cur?'selected':''}>${esc(n)}</option>`).join('')+extra;
        return `<select class="j-exec" ${ro?'disabled':''}>${opts}</select>`;
      };
      const jrowsHtml=Array.from({length:qtyN},(_,i)=>{const u=i+1;const j=jByU.get(u)||{unit:u};
        return `<tr data-jid="${j.id??''}" data-unit="${u}">
          <td class="u">${u}</td>
          <td>${execCell(j.executor)}</td>
          <td><input class="j-blank" value="${esc(j.blankNo||'')}" placeholder="№" ${ro?'disabled':''}></td>
          <td><select class="j-self" ${ro?'disabled':''}>${['','годен','брак'].map(v=>jOpt(v,j.self||'')).join('')}</select></td>
          <td><select class="j-otk" ${ro?'disabled':''}>${['','годен','брак'].map(v=>jOpt(v,j.otk||'')).join('')}</select></td>
          <td><input class="j-date" type="date" value="${esc(String(j.date||'').slice(0,10))}" ${ro?'disabled':''}></td></tr>`;}).join('');
      const journalBlock=`<div class="st-sec"><div class="lab">§7 Журнал по единицам${t.qtyPlan!==''&&t.qtyPlan!=null?` · по заданию ${esc(t.qtyPlan)} шт`:''}</div>
        <div class="tbl-wrap"><table class="jt"><thead><tr><th>№</th><th>Исполнитель</th><th>№ заготовки / приёмки</th><th>Самоконтроль</th><th>Контроль ОТК</th><th>Дата</th></tr></thead>
        <tbody>${jrowsHtml}</tbody></table></div></div>`;
      host.innerHTML=`<div class="st-panel">
        <button class="st-back" id="st-back">← К задачам участка</button>
        <div class="st-hd">
          <div><div class="ht">${esc(t.title||'Операция')}</div>
            <div class="hs">${esc(t.section||'')} · ${esc(t.op)} · ${esc(t.num)}</div></div>
          <button class="hbtn" id="st-draw" title="Просмотр чертежа — после ввода базы КД" style="display:inline-flex;align-items:center;gap:5px">${aico('doc',14)} Чертёж${t.drawing?' '+esc(t.drawing):''}</button>
        </div>
        <div class="st-do"><div class="lab">Что делать (из маршрутной карты)</div>
          ${t.materials?`<div class="big"><b>Взять:</b> ${esc(t.materials)}</div>`:''}
          ${t.equip?`<div class="big"><b>Оборудование:</b> ${esc(t.equip)}</div>`:''}
          ${(t.normTime!==''&&t.normTime!=null)?`<div class="big"><b>Норма времени:</b> ${esc(t.normTime)} ч</div>`:''}
          ${t.ri?`<div class="big"><b>РИ:</b> ${esc(t.ri)}</div>`:''}
          ${ctl?`<div class="ctl"><b>Контроль (§5):</b> ${esc(ctl)}</div>`:''}</div>
        <div class="st-sec"><div class="lab">Задание (Ф.14 §1–2)</div>
          ${kv('№ ПЗ / срок',`${t.num} · ${fmt(t.plan)}`)}
          ${t.partName?kv('Изделие',t.partName+(t.drawing?` · чертёж ${t.drawing}`:'')+(t.applicability?` · ${t.applicability}`:'')):''}
          ${t.qtyPlan!==''&&t.qtyPlan!=null?kv('Кол-во по заданию',t.qtyPlan+' шт'):''}</div>
        ${ro?'<div class="warn">Демо-режим (нет токена NocoDB): изменения не сохраняются.</div>':''}
        <div class="st-sec"><div class="lab">Статус задачи</div>
          ${t.status==='Выполнено'
            ? `<div class="st-closed"><span>✓ Задача закрыта${t.factDate?' · '+fmt(t.factDate):''}</span>${ro?'':'<button class="st-reopen" id="st-reopen">Вернуть в работу</button>'}</div>`
            : `<div class="st-statusrow" id="st-status">${statusBtns}</div>
               <div class="st-done">
                 <div class="st-prog"><div class="st-progbar"><i id="st-progfill"></i></div><span id="st-progtxt">—</span></div>
                 ${ro?'':'<button id="st-close" disabled>✓ Закрыть задачу (Выполнено)</button>'}
               </div>`}
        </div>
        ${paramRows?`<div class="st-sec"><div class="lab">Параметры (норматив → факт)</div>${paramRows}</div>`:''}
        <div class="st-sec"><div class="lab">Факт выполнения</div>
          <div class="st-fields">
            <div class="fld"><label>Кол-во факт.</label><input id="st-qty" type="number" step="any" value="${esc(t.factQty)}" ${ro?'disabled':''}></div>
            <div class="fld"><label>Время факт. (ч)</label><input id="st-time" type="number" step="any" value="${esc(t.factTime)}" ${ro?'disabled':''}></div>
          </div>
          <div class="st-toggles" style="margin-top:12px">
            <label class="st-tog"><input id="st-self" type="checkbox" ${t.selfControl?'checked':''} disabled> Требуется самоконтроль <span class="st-bymk">(по МК)</span></label>
            <label class="st-tog"><input id="st-otk" type="checkbox" ${t.otk?'checked':''} disabled> Требуется ОТК <span class="st-bymk">(по МК)</span></label>
          </div>
          <div class="st-hint">Результат «годен/брак» по каждой единице — в журнале ниже (§7).</div>
          <div class="fld" style="margin-top:12px"><label>Примечание</label><textarea id="st-note" ${ro?'disabled':''}>${esc(t.note||'')}</textarea></div>
        </div>
        ${journalBlock}
        <div class="st-save">${ro?'':'<button class="btn btn-p" id="st-savebtn">Сохранить</button>'}
          <button class="btn btn-g" id="st-cancel">Назад</button>
          <span class="msg" id="st-msg"></span></div></div>`;
      let chosen=t.status;
      document.getElementById('st-back').onclick=()=>renderStation(host);
      document.getElementById('st-cancel').onclick=()=>renderStation(host);
      const drawBtn=document.getElementById('st-draw');
      if(drawBtn)drawBtn.onclick=()=>{const m=document.getElementById('st-msg');if(m){m.style.color='#64748b';m.textContent='Просмотр чертежа появится после ввода базы КД (процедура в утверждении).';}};
      if(!ro){
        host.querySelectorAll('#st-status .st-sbtn').forEach(b=>b.onclick=()=>{chosen=b.dataset.st;
          host.querySelectorAll('#st-status .st-sbtn').forEach(x=>x.classList.toggle('on',x===b));});
        // приёмка единицы = контроль «годен»: самоконтроль и, если требуется, ОТК. Браков нет.
        const reqSelf=!!t.selfControl, reqOtk=!!t.otk;
        const mPlan=Number(t.qtyPlan)>0?Number(t.qtyPlan):qtyN;
        const unitOk=(self,otk,exec,date)=>{
          if(self==='брак'||otk==='брак')return false;
          if(reqSelf&&self!=='годен')return false;
          if(reqOtk&&otk!=='годен')return false;
          if(!reqSelf&&!reqOtk)return !!(exec||date); // контроль не требуется → признак «сделано»
          return true;
        };
        const recompute=()=>{
          let n=0;host.querySelectorAll('.jt tbody tr').forEach(tr=>{
            if(unitOk(tr.querySelector('.j-self').value,tr.querySelector('.j-otk').value,tr.querySelector('.j-exec').value,tr.querySelector('.j-date').value))n++;});
