      /* minmax(0,1fr)+min-width:0 — чтобы широкая erpGrid-таблица не раздувала колонку и скролл уходил внутрь .erp-scroll, а не в страницу */
      .split,.split.wide{grid-template-columns:minmax(0,1fr);}
