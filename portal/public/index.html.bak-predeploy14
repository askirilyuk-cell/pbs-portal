        }catch(e){alert('Не удалось создать ЛОВ: '+e.message); go.disabled=false; go.textContent='Запросить';}
      };
    }

    // «Создать проект разработки» из карточки запроса продаж (мост ЗП→Проект, только запись)
    async function openProjectFromReq(z){
      let groups=[],subs=[];
      try{const d=await (await fetch('/api/sales/dicts')).json();groups=d.groups||[];subs=d.subgroups||[];}catch{}
      if(!groups.length)groups=[['ОК','Оснастка обсадных колонн'],['СП','Оборудование для спуска'],['ПВО','ЗИП к ПВО'],['РТИ','РТИ общие'],['БМ','Биметаллические изделия'],['ЦХ','Цеховое оборудование']].map(([code,name])=>({code,name}));
      const pre=(z.products&&z.products[0])||{};
      let g=pre.groupCode||groups[0].code, sc=pre.subCode||'';
      const subOpts=(grp)=>`<option value="">— без подгруппы (код группы) —</option>`+subs.filter(s=>s.group===grp).map(s=>`<option value="${esc(s.code)}"${s.code===sc?' selected':''}>${esc(s.code)} — ${esc(s.name)}</option>`).join('');
      modal.style.width='540px';
      modal.innerHTML=`<div class="mh"><b>Создать проект разработки (ОКР)</b><span style="margin-left:auto"><button class="x" id="pr-x" aria-label="Закрыть">✕</button></span></div>
        <div class="mb">
          <div style="background:#f8fafc;border:1px solid var(--line);border-radius:2px;padding:9px 11px;font-size:12.5px;color:var(--sub);margin-bottom:14px">Из запроса <b class="code" style="color:var(--ink)">${esc(z.numZp)}</b>. Заведёт проект в реестре ОКР (Ф.3–П.1) с авто-децимальным №, предзаполнением и связью ЗП↔Проект. Папку КД на NAS и чат проекта — отдельной кнопкой «Запустить ОКР» позже.</div>
          <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px">
            <div><div class="lbl-sm" style="font-size:11px;font-weight:700;text-transform:uppercase;color:#5b6b7a;margin-bottom:5px">Группа</div><select id="pr-grp" style="width:100%;font:inherit;font-size:13px;padding:8px;border:1px solid var(--line);border-radius:2px">${groups.map(gr=>`<option value="${esc(gr.code)}"${gr.code===g?' selected':''}>${esc(gr.code)} — ${esc(gr.name)}</option>`).join('')}</select></div>
            <div><div class="lbl-sm" style="font-size:11px;font-weight:700;text-transform:uppercase;color:#5b6b7a;margin-bottom:5px">Подгруппа</div><select id="pr-sub" style="width:100%;font:inherit;font-size:13px;padding:8px;border:1px solid var(--line);border-radius:2px">${subOpts(g)}</select></div>
          </div>
          <div style="margin-top:12px"><div class="lbl-sm" style="font-size:11px;font-weight:700;text-transform:uppercase;color:#5b6b7a;margin-bottom:5px">Наименование изделия</div><input id="pr-name" value="${esc(z.name||'')}" style="width:100%;font:inherit;font-size:13px;padding:8px;border:1px solid var(--line);border-radius:2px"></div>
          <div style="font-size:11.5px;color:var(--sub);margin-top:8px">Децимальный № присвоится автоматически: <b id="pr-prev" class="code">…</b> (счётчик 0001-9999 в подгруппе).</div>
          <div style="display:flex;gap:10px;justify-content:flex-end;margin-top:18px"><button class="tbtn" id="pr-cancel">Отмена</button><button class="tbtn primary" id="pr-go">Создать проект</button></div>
        </div>`;
      modal.classList.add('open'); mscrim.classList.add('open');
      const grpSel=document.getElementById('pr-grp'), subSel=document.getElementById('pr-sub'), prev=document.getElementById('pr-prev');
      const upPrev=()=>{const s=subSel.value||grpSel.value;prev.textContent=s+'NNNN';};
      grpSel.onchange=()=>{g=grpSel.value;sc='';subSel.innerHTML=subOpts(g);upPrev();};
      subSel.onchange=upPrev; upPrev();
      document.getElementById('pr-x').onclick=closeModal; document.getElementById('pr-cancel').onclick=closeModal;
      document.getElementById('pr-go').onclick=async()=>{
