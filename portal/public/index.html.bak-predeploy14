          <div style="grid-column:span 4">${FLAB('Единица цены')}<input id="cp-unit" style="${FINP}" placeholder="${esc(baseUnit||'ед')}"></div>
          <div style="grid-column:span 4">${FLAB('Кол-во (для ₽/базовую)')}<input id="cp-qty" type="number" step="any" style="${FINP}"></div>
          <div style="grid-column:span 6">${FLAB('Цена в базовой ед (₽/'+esc(baseUnit||'ед')+')')}<input id="cp-base" type="number" step="any" style="${FINP}" placeholder="пусто → цена/кол-во"></div>
          <div style="grid-column:span 6">${FLAB('Источник')}<select id="cp-source" style="${FINP}">${srcOpts}</select></div>
          <div style="grid-column:span 12">${FLAB('Наименование в источнике (трассировка)')}<input id="cp-sname" style="${FINP}" placeholder="как названо в счёте/заказе"></div>
