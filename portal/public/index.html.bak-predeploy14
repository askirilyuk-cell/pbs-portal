          <div style="grid-column:span 5">${FLAB('Коэффициент к базовой')}<input id="ca-factor" type="number" step="any" style="${FINP}" placeholder="задел (авто-конверт. — далее)"></div>
          <div style="grid-column:span 7">${FLAB('Примечание')}<input id="ca-note" style="${FINP}"></div>
