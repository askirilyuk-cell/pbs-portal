    .kcol{display:flex;flex-direction:column;gap:8px;min-width:0;}
    .kh{font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.04em;display:flex;align-items:center;gap:6px;margin-bottom:2px;}
    .kh .cnt{color:#5b6b7a;font-weight:600;}
    .kc{background:#fff;border:1px solid var(--line);border-left:3px solid var(--blue);border-radius:2px;padding:9px 10px;cursor:pointer;}
    .kc:hover{background:#f7faff;}
    .kc .pz{font-family:monospace;font-weight:700;color:var(--navy);font-size:12.5px;}
