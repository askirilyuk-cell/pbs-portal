            <div style="display:flex;align-items:center;gap:12px;flex-wrap:wrap"><span style="font-size:11px;font-weight:700;text-transform:uppercase;color:#5b6b7a">Вердикт:</span>${verdHtml}</div>
            <div style="margin-top:12px"><div class="lbl-sm" style="font-size:11px;color:#5b6b7a;margin-bottom:4px">Комментарий / условия</div>
            ${can?`<textarea id="lov-comment" style="width:100%;height:52px;font:inherit;font-size:13px;padding:7px 9px;border:1px solid var(--line);border-radius:2px;resize:vertical">${esc(c.conditions||'')}</textarea>`:`<div style="font-size:12.5px;color:#334155">${esc(c.conditions||'—')}</div>`}</div>
            ${c.decidedBy?`<div style="font-size:11.5px;color:#5b6b7a;margin-top:8px">Заполнил: ${esc(c.decidedBy)}${c.decidedDate?' · '+esc(fmt(c.decidedDate)):''}</div>`:''}
