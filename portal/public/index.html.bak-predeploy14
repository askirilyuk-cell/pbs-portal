              <div>${lbl('Тип задачи')}<select id="o-task" style="${ist}">${optHtml(PZ_TASK_TYPES,'Производство')}</select></div>
              <div>${lbl('Приоритет')}<select id="o-prio" style="${ist}">${optHtml(PZ_PRIORITIES,'Нормальный')}</select></div>
