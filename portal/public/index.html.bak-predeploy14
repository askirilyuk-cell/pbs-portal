        try{ const r=await fetch('/api/equipment/save',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(body)});
          const j=await r.json().catch(()=>({})); if(!r.ok||j.error)throw new Error(j.error||('HTTP '+r.status));
          toast(`Оборудование ${j.invNo} ${j.created?'заведено':'обновлено'}.`,'ok');
          EQ=null; eqCardCache={}; eqSelId=j.id; eqOpenSec=null; closeModal(); renderEquipment(document.getElementById('view'));
        }catch(e){ err.textContent=e.message; toast('Не сохранено: '+e.message,'err'); btn.disabled=false; btn.textContent=edit?'Сохранить':'Завести оборудование'; }
      };
    }

    // ══ Модуль «Инструмент и оснастка» — ДП–О.3.1 / О.4 (K-39, учётная система v3.0) ══
    //  ДВЕ парадигмы: количественная (режущий — остаток/мин, выдача/пополнение/возврат/
    //  поступление) и инвентарная (пресс-формы/оснастка — инв.№/статус/местоположение,
    //  приёмка/перемещение/списание). Мерительный (СИ) — инвентарный + поверка (ДП–О.4).
    //  3 подраздела: Режущий · Мерительный(СИ) · Пресс-формы/оснастка. Бэкенд /api/tools/*.
    let TL=null, tlTab='items', tlSel=null, tlSub='cut', tlCat='', tlFilter='all', tlCardCache={}, tlPlace='', tlGridApi=null;
    const TL_SUBS=[['cut','Режущий инструмент'],['si','Мерительный (СИ)'],['osn','Оснастка']];
    const tlSubOf=(i)=>i.subdivision||(i.isSi?'si':i.special?'osn':'cut');
    const tlIsInv=(i)=>tlSubOf(i)==='osn'; // инвентарная модель (оснастка)
    const tlQty=(n,u)=>Number(n||0).toLocaleString('ru-RU',{maximumFractionDigits:3})+(u?(' '+u):'');
    const tlYmd=()=>new Date().toISOString().slice(0,10);
    const tlMonthStart=()=>{const d=new Date();return new Date(d.getFullYear(),d.getMonth(),1).toISOString().slice(0,10);};
    const tlChip=(txt,kind)=>{const c={exp:['#eff6ff','#cfe0f5','#1F4E79'],spec:['#faf5ff','#e9d5ff','#7c3aed'],in:['#f0fdf4','#bbf7d0','#15803d'],out:['#fef2f2','#fecaca','#b91c1c'],warn:['#fffbeb','#fde68a','#b45309']}[kind]||['#f1f5f9','#e2e8f0','#475569'];return `<span style="font-size:11px;font-weight:600;border-radius:2px;padding:2px 8px;white-space:nowrap;color:${c[2]};background:${c[0]};border:1px solid ${c[1]}">${esc(txt)}</span>`;};
    const tlStatusChip=(s)=>{if(!s)return '';const k={'Годен':'in','Просрочен':'out','В эксплуатации':'exp','На станке':'warn','Списан':'gray'}[s]||'gray';return tlChip(s,k);};
    // операции по парадигме
    const TL_OPS_QTY=['Выдача','Пополнение','Возврат','Поступление'];
    const TL_OPS_INV=['Приёмка','Перемещение','Списание'];
    const TL_OPS_LOC=['Передача на участок','Возврат на склад']; // K-55: склад↔цех для любой позиции

    async function renderTools(host,arg){
      host.innerHTML='<div class="card pad" style="color:var(--sub)">Загрузка модуля «Инструмент и оснастка»…</div>';
      if(!TL){ try{TL=await (await fetch('/api/tools')).json();}catch(e){TL={mode:'mock',warning:String(e.message||e),items:[],kpis:{},signals:[],locations:[]};} }
      if(arg){ const it=(TL.items||[]).find(i=>i.code===arg); if(it){ tlTab='items'; tlSub=tlSubOf(it); tlSel=arg; tlPlace=''; tlCat=''; tlFilter='all'; } }
      const live=TL.mode==='live';
      const tag=srcChip(live, live?((TL.items||[]).length+' позиций'):'таблицы инструмента ещё не заведены');
      host.innerHTML=`<div class="filters">
          <div class="seg" id="tlseg">
            <button data-t="items" class="${tlTab==='items'?'on':''}">Реестр инструмента</button>
            <button data-t="loc" class="${tlTab==='loc'?'on':''}">Места хранения</button>
            <button data-t="act" class="${tlTab==='act'?'on':''}">Акт списания (Ф.3–О.3.1)</button>
            <button data-t="catins" class="${tlTab==='catins'?'on':''}">Каталог пластин (ISO 1832)</button>
            <button data-t="cathold" class="${tlTab==='cathold'?'on':''}">Каталог державок (ISO 5608)</button>
            <button data-t="catjaws" class="${tlTab==='catjaws'?'on':''}">Комплекты кулачков</button>
          </div><span class="spacer" style="margin-left:auto"></span>${tag}</div>
        <div id="tlbody" style="margin-top:var(--gap)"></div>`;
      host.querySelectorAll('#tlseg button').forEach(b=>b.onclick=()=>{tlTab=b.dataset.t;
        host.querySelectorAll('#tlseg button').forEach(x=>x.classList.toggle('on',x.dataset.t===tlTab)); tlBody();});
      tlBody();
    }
    function tlBody(){const h=document.getElementById('tlbody');if(!h)return; tlTab==='loc'?tlLocBody(h):tlTab==='act'?tlActBody(h):tlTab==='catjaws'?cjBody(h):(tlTab==='catins'||tlTab==='cathold')?tcBody(h,tlTab==='cathold'?'holders':'inserts'):tlItemsBody(h);}

    // ── Экран 1: KPI + сигналы + подразделы + master-detail ──
    function tlItemsBody(host){
      const items=(TL&&TL.items)||[], kpis=(TL&&TL.kpis)||{}, signals=(TL&&TL.signals)||[], calSignals=(TL&&TL.calSignals)||[];
      const m=(lbl,num,col,sub)=>`<div class="m"><div class="lbl">${lbl}</div><div class="num"${col?` style="color:${col}"`:''}>${num}</div>${sub?`<div style="font-size:10.5px;color:var(--sub);margin-top:1px">${sub}</div>`:''}</div>`;
      const kpiStrip=`<div class="mstrip">
          ${m('Позиций в реестре',kpis.total??0,'var(--navy)',((kpis.rig||0)+' оснастки · '+(kpis.si||0)+' СИ'))}
          ${m('Ниже мин. остатка',kpis.belowMin??0,(kpis.belowMin?'var(--red)':'var(--ink)'),(kpis.belowMin?'дефицит режущего':'дефицита нет'))}
          ${m('Движений (журнал)',kpis.movements??0,'var(--ink)','выдача · пополнение · перемещение …')}
          ${m('Поверка СИ просрочена',kpis.calOverdue??0,((kpis.calOverdue)?'var(--red)':'var(--ink)'),((kpis.calSoon)?kpis.calSoon+' истекает ≤30дн':'ДП–О.4'))}
        </div>`;
      // K-42: sigBlock (дефицит) и calBlock (поверка) — жёлтые карточки — убраны; данные в таблице (подсветка) + фильтры.
      // K-39: фасеты слева (Подраздел/Состояние/Категория чекбоксами+счётчики) · таблица · drawer справа.
      const subCount=(s)=>items.filter(i=>tlSubOf(i)===s).length;
      const subItems=items.filter(i=>tlSubOf(i)===tlSub);
      const defCount=subItems.filter(i=>i.belowMin||i.balance<=0).length;
      const normCount=subItems.length-defCount;
      const calCount=subItems.filter(i=>i.calOverdue||i.calSoon).length;
      const cats=[...new Set(subItems.map(i=>i.category).filter(Boolean))].sort((a,b)=>a.localeCompare(b,'ru'));
      const catCount=(c)=>subItems.filter(i=>i.category===c).length;
      const newLbl=tlSub==='si'?'СИ':(tlSub==='osn'?'Оснастку':'Инструмент');
      const uchet=tlSub==='osn'?'инвентарный учёт (штучный, по инв.№)':'количественный учёт (остаток / мин)';
      // фасет-строка: чекбокс + подпись + счётчик (data-grp/data-val)
      const facet=(grp,val,label,count,on,dis)=>`<label class="tl-facet${on?' on':''}" data-grp="${grp}" data-val="${esc(String(val))}"${dis?' style="opacity:.45;pointer-events:none"':''}><input type="checkbox"${on?' checked':''}${dis?' disabled':''}><span class="tl-fl">${label}</span><span class="tl-fc">${count}</span></label>`;
      const subFacets=TL_SUBS.map(([k,t])=>facet('sub',k,esc(t),subCount(k),tlSub===k)).join('');
      let stFacets=facet('st','all','Все',subItems.length,tlFilter==='all')
        +facet('st','def','⚠ Дефицит',defCount,tlFilter==='def',!defCount)
        +facet('st','norm','Норма',normCount,tlFilter==='norm',!normCount);
      if(tlSub==='si')stFacets+=facet('st','cal','⏰ Поверка',calCount,tlFilter==='cal',!calCount);
      const catFacets=cats.length?cats.map(c=>facet('cat',c,esc(c),catCount(c),tlCat===c)).join(''):'<div style="font-size:11.5px;color:var(--sub);padding:2px 5px">— нет —</div>';
      const facets=`<aside class="tl-facets">
          <div class="tl-fgrp">Подраздел</div>${subFacets}
          <div class="tl-fgrp">Состояние</div>${stFacets}
          <div class="tl-fgrp">Категория</div>${catFacets}
          <button class="tbtn tl-reset" id="tl-reset">Сбросить фильтры</button>
        </aside>`;
      host.innerHTML=kpiStrip+`
        <div class="filters" style="margin-top:var(--gap)">
          <span style="font-size:12.5px;color:var(--sub)">${uchet}</span>
          <span style="margin-left:auto"></span>
          <button class="tbtn primary" id="tl-move">↹ Операция</button>
          <button class="tbtn green" id="tl-new">+ ${newLbl}</button>
          <button class="tbtn" id="tl-act">Акт списания за месяц</button>
        </div>
        <div class="tl-3col${tlSel?' tl-open':''}" id="tl-3col" style="margin-top:var(--gap)">
          ${facets}
          <div style="min-width:0">
            <div class="filters" id="tl-summary" style="margin-bottom:8px;font-size:12px;color:var(--sub)"></div>
            <div id="tlgrid"></div>
          </div>
          <div class="detail tl-drawer" id="tldetail" style="${tlSel?'':'display:none'}"></div>
        </div>`;
      // «Пополнение →» по кнопке в строке (data-repl): делегирование на #tlgrid, stopPropagation → без выбора строки
      const gh=host.querySelector('#tlgrid');
      if(gh)gh.addEventListener('click',e=>{const b=e.target.closest('[data-repl]');if(b){e.stopPropagation();openToolMove(items.find(x=>x.code===b.dataset.repl),'Пополнение');}},true);
      host.querySelectorAll('.tl-facet[data-grp="sub"]').forEach(el=>el.onclick=()=>{if(el.dataset.val===tlSub)return;tlSub=el.dataset.val;tlCat='';tlFilter='all';tlSel=null;tlPlace='';tlItemsBody(host);});
      host.querySelectorAll('.tl-facet[data-grp="st"]').forEach(el=>el.onclick=()=>{tlFilter=(tlFilter===el.dataset.val)?'all':el.dataset.val;host.querySelectorAll('.tl-facet[data-grp="st"]').forEach(x=>{const on=x.dataset.val===tlFilter;x.classList.toggle('on',on);const cb=x.querySelector('input');if(cb)cb.checked=on;});tlGrid();});
      host.querySelectorAll('.tl-facet[data-grp="cat"]').forEach(el=>el.onclick=()=>{tlCat=(tlCat===el.dataset.val)?'':el.dataset.val;host.querySelectorAll('.tl-facet[data-grp="cat"]').forEach(x=>{const on=x.dataset.val===tlCat;x.classList.toggle('on',on);const cb=x.querySelector('input');if(cb)cb.checked=on;});tlGrid();});
      const rs=host.querySelector('#tl-reset'); if(rs)rs.onclick=()=>{tlCat='';tlFilter='all';tlPlace='';tlSel=null;tlItemsBody(host);};
      const mv=host.querySelector('#tl-move'); if(mv)mv.onclick=()=>{const it=(items.find(x=>x.code===tlSel&&tlSubOf(x)===tlSub))||items.find(x=>tlSubOf(x)===tlSub);openToolMove(it,'');};
      const nw=host.querySelector('#tl-new'); if(nw)nw.onclick=()=>openToolEdit(null,tlSub);
      const ac=host.querySelector('#tl-act'); if(ac)ac.onclick=()=>{tlTab='act';document.querySelectorAll('#tlseg button').forEach(x=>x.classList.toggle('on',x.dataset.t==='act'));tlBody();};
      tlGrid();
    }
    // K-39: синхронизация drawer (открыт ↔ выбрана позиция); сворачивается при отсутствии выбора
    function tlSyncDrawer(){ const c=document.getElementById('tl-3col'), d=document.getElementById('tldetail'); if(!c||!d)return; const open=!!tlSel; c.classList.toggle('tl-open',open); d.style.display=open?'':'none'; }
    function tlCloseDrawer(){ tlSel=null; try{history.replaceState(null,'','#tools');}catch{} if(tlGridApi)try{tlGridApi.selectKey(null,false);}catch{} tlSyncDrawer(); }
    // K-39: строка «Активно: <фасеты> · N из M» над таблицей
    function tlSummary(shown,total){ const sm=document.getElementById('tl-summary'); if(!sm)return;
      const chip=(t)=>`<span class="lit">${esc(t)}</span>`; const parts=[];
      parts.push(chip((TL_SUBS.find(s=>s[0]===tlSub)||[,tlSub])[1]));
      if(tlFilter==='def')parts.push(chip('⚠ дефицит')); else if(tlFilter==='norm')parts.push(chip('норма')); else if(tlFilter==='cal')parts.push(chip('⏰ поверка'));
      if(tlCat)parts.push(chip(tlCat));
      if(tlPlace)parts.push(`<span class="lit">место: ${esc(tlPlace)} <span data-clr-place style="cursor:pointer;color:var(--red)">✕</span></span>`);
      sm.innerHTML=`<span style="font-weight:600;color:var(--sub)">Активно:</span> ${parts.join(' ')}<span style="margin-left:auto;color:var(--sub)"><b style="color:var(--ink)">${shown}</b> из ${total}</span>`;
      const cp=sm.querySelector('[data-clr-place]'); if(cp)cp.onclick=()=>{tlPlace='';tlGrid();};
    }
    // K-42: отношение остаток/мин (дефицит наверху) + ячейка остатка с ▼ (дальтоники) + ячейка «Поверка до».
    function tlDefRatio(i){ if(Number(i.balance)<=0) return -1; const min=Number(i.minStock)||0; if(min<=0) return 1e9; return (Number(i.balance)||0)/min; }
    function tlBalCell(i){ const q=tlQty(i.balance,i.unit); if(Number(i.balance)<=0) return `<b class="c-red" style="font-weight:800">▼ ${q}</b>`; if(i.belowMin) return `<b class="c-amber" style="font-weight:800">▼ ${q}</b>`; return `<b style="color:var(--ink)">${q}</b>`; }
    function tlCalCell(i){ if(!i.calNext) return '<span class="c-gray">—</span>'; const c=i.calOverdue?'c-red':(i.calSoon?'c-amber':'c-gray'); return `<span class="${c}"${i.calOverdue?' style="font-weight:700"':''}>${fmt(i.calNext)}</span>`; }
    // K-55: «Где» — склад·ячейка (нейтр.) / цех·участок (жёлтый chip)
    function tlWhereCell(i){ const w=i.where||'—'; if(w==='—') return '<span class="c-gray">—</span>'; return i.whereKind==='shop'?tlChip(w,'warn'):`<span title="${esc(w)}">${esc(w)}</span>`; }
    // K-42: реестр инструмента — единая таблица erpGrid (колонки зависят от подраздела) + master-detail (deep-link #tools/<код>)
    function tlGrid(){
      const gh=document.getElementById('tlgrid'); if(!gh)return;
      const items=(TL&&TL.items)||[];
      const subAll=items.filter(i=>tlSubOf(i)===tlSub);   // все позиции подраздела (для «N из M»)
      let rows=subAll.slice();
      if(tlPlace)rows=rows.filter(i=>i.cell===tlPlace||i.location===tlPlace||i.storage===tlPlace);
      if(tlCat)rows=rows.filter(i=>i.category===tlCat);
      if(tlFilter==='def')rows=rows.filter(i=>i.belowMin||Number(i.balance)<=0);
      else if(tlFilter==='norm')rows=rows.filter(i=>!(i.belowMin||Number(i.balance)<=0));
      else if(tlFilter==='cal')rows=rows.filter(i=>i.calOverdue||i.calSoon);
      if(tlSub==='osn') rows.sort((a,b)=>String(a.invNo||a.code).localeCompare(String(b.invNo||b.code),'ru'));
      else rows.sort((a,b)=>tlDefRatio(a)-tlDefRatio(b));   // дефицит/пусто наверху
      tlSummary(rows.length,subAll.length);
      if(!rows.length){ gh.innerHTML='<div class="card pad" style="color:var(--sub);font-size:13px">'+((TL&&TL.mode==='live')?'Нет позиций по фильтру.':'Модуль ещё не наполнен (таблицы появятся после миграции).')+'</div>'; tlGridApi=null; tlSel=null; tlShowDetail(null); tlSyncDrawer(); return; }
      // K-39: drawer НЕ открывается автоматически — только по клику/deep-link. Сбрасываем «протухший» выбор.
      if(tlSel&&!rows.some(r=>r.code===tlSel)) tlSel=null;
      const live=TL&&TL.mode==='live';
      let cols;
      if(tlSub==='osn'){   // оснастка — инвентарная модель (штучный, по инв.№)
        cols=[
          {key:'inv',label:'Инв. №',w:122,cls:'code',cell:i=>esc(i.invNo||i.code),sortVal:i=>i.invNo||i.code},
          {key:'name',label:'Наименование',cls:'ell',cell:i=>`<span title="${esc(i.name||'')}" style="font-weight:600;color:var(--ink)">${esc(i.name||'—')}</span>`,sortVal:i=>i.name},
          {key:'kind',label:'Вид',w:150,cls:'nw c-gray',cell:i=>esc(i.rigKind||i.category||'оснастка'),sortVal:i=>i.rigKind||i.category},
          {key:'status',label:'Статус',w:150,cls:'nw',cell:i=>tlStatusChip(i.status)||'<span class="c-gray">—</span>',sortVal:i=>i.status},
          {key:'where',label:'Где',w:172,cls:'nw',cell:tlWhereCell,sortVal:i=>i.where||''},
        ];
      } else {             // режущий / СИ — количественная модель (остаток/мин)
        cols=[
          {key:'code',label:tlSub==='si'?'Инв./код':'Код',w:118,cls:'code',cell:i=>esc((tlSub==='si'&&i.invNo)||i.code),sortVal:i=>(tlSub==='si'&&i.invNo)||i.code},
          {key:'name',label:'Наименование',cls:'ell',cell:i=>`<span title="${esc(i.name||'')}" style="font-weight:600;color:var(--ink)">${esc(i.name||'—')}</span>`,sortVal:i=>i.name},
          {key:'cat',label:'Категория',w:150,cls:'nw c-gray',cell:i=>esc(i.category||i.subcategory||'—'),sortVal:i=>i.category||i.subcategory},
          {key:'balance',label:'Остаток',w:116,align:'right',cls:'nw',cell:tlBalCell,sortVal:i=>tlDefRatio(i)},
          {key:'minStock',label:'Мин.',w:88,align:'right',cls:'nw c-gray',cell:i=>tlQty(i.minStock,i.unit),sortVal:i=>Number(i.minStock)||0},
          {key:'unit',label:'ЕИ',w:58,cls:'nw c-gray',cell:i=>esc(i.unit||'—'),sortVal:i=>i.unit},
          {key:'where',label:'Где',w:168,cls:'nw',cell:tlWhereCell,sortVal:i=>i.where||''},
        ];
        if(tlSub==='si') cols.push({key:'cal',label:'Поверка до',w:120,cls:'nw',cell:tlCalCell,sortVal:i=>i.calNext?(Date.parse(i.calNext)||0):8e15});
        cols.push({key:'act',label:'',w:112,cls:'nw',cell:i=>(i.belowMin||Number(i.balance)<=0)?`<button class="tbtn green" data-repl="${esc(i.code)}" style="padding:3px 9px;font-size:11.5px">Пополнение →</button>`:'',sortVal:i=>0});
      }
      tlGridApi=erpGrid(gh,{key:'tl-'+tlSub,cols,rows,rowKey:i=>i.code,selKey:tlSel,rowClass:i=>((tlSub!=='osn'&&(i.belowMin||Number(i.balance)<=0))||i.calOverdue)?'row-def':'',
        onRow:i=>{ tlSel=i.code; try{history.replaceState(null,'','#tools/'+encodeURIComponent(i.code));}catch{} tlShowDetail(i.code); tlSyncDrawer(); },
        onEnter:i=>{ tlSel=i.code; tlShowDetail(i.code); tlSyncDrawer(); },
