    }
    function saveLovUI(sheetId){
      const v=modal.querySelector('.lov-vseg.on');
      const risks={};
      modal.querySelectorAll('.lov-risk').forEach(el=>{risks[el.dataset.k]={r:el.querySelector('[data-r]').checked,c:el.querySelector('[data-c]').value};});
      const body={sheetId,verdict:v?v.dataset.v:'',comment:(document.getElementById('lov-comment')||{}).value||'',risks};
      const btn=document.getElementById('lov-save'); if(btn){btn.disabled=true;btn.textContent='Сохранение…';}
      fetch('/api/lov/save',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(body)}).then(r=>r.json().then(jr=>{if(!r.ok)throw new Error(jr.error||'ошибка');openLovCard(sheetId);})).catch(e=>{toast('Не удалось сохранить: '+e.message,'err');if(btn){btn.disabled=false;btn.textContent='Сохранить заключение';}});
    }

    // упрощённый вход: создать ЛОВ (без подразделений) или открыть существующий.
    // K-12: 1 ЛОВ на 1 ЗП — сервер идемпотентен, клиент дизейблит кнопку на время запроса (анти-дабл-клик).
    let lovFromReqBusy=false;
    async function lovFromReq(zp,btn){
      if(lovFromReqBusy)return; lovFromReqBusy=true;
      const t0=btn?btn.textContent:''; if(btn){btn.disabled=true;btn.textContent='Открываю ЛОВ…';}
      try{
        const r=await fetch('/api/lov/request',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({zp})});
        const j=await r.json();
        if(r.ok){if(j.existed)toast('ЛОВ уже создан, открываю','ok');closeModal();location.hash='#lov/'+j.id;return;}
        // фолбэк на старый текст ошибки (на случай несинхронного деплоя сервера)
        if(/уже создан/.test(j.error||'')){const lj=await (await fetch('/api/lov')).json();const it=(lj.items||[]).find(x=>x.zp===zp);if(it){toast('ЛОВ уже создан, открываю','ok');closeModal();location.hash='#lov/'+it.id;return;}}
        toast('ЛОВ: '+(j.error||'ошибка'),'err');
      }catch(e){toast('ЛОВ: '+(e.message||'ошибка'),'err');}
      finally{lovFromReqBusy=false; if(btn){btn.disabled=false;btn.textContent=t0;}}
    }
    function lovSectionHtml(s){
      const editable=lovCanEdit(s.code);
      const tpl=LOV_UNIT_FIELDS[s.code]||null;
      const inp=(k,label,val)=>editable
        ? `<div${tpl&&tpl.length>2?'':' style="grid-column:1/-1"'}><div class="lbl-sm" style="font-size:11px;color:#5b6b7a;margin-bottom:3px">${esc(label)}</div><textarea data-f="${k}" style="width:100%;height:38px;font:inherit;font-size:12.5px;padding:6px 9px;border:1px solid var(--line);border-radius:2px;resize:vertical">${esc(val||'')}</textarea></div>`
        : `<div><div class="lbl-sm" style="font-size:11px;color:#5b6b7a">${esc(label)}</div><div style="font-size:12.5px;color:#334155">${esc(val||'—')}</div></div>`;
      let body;
      if(tpl){ body=`<div style="display:grid;grid-template-columns:1fr 1fr;gap:9px">${tpl.map(([k,l])=>inp(k,l,s.details&&s.details[k])).join('')}</div>`; }
      else { body= editable
        ? `<textarea data-f="_concl" style="width:100%;height:54px;font:inherit;font-size:12.5px;padding:6px 9px;border:1px solid var(--line);border-radius:2px;resize:vertical">${esc(s.conclusion||'')}</textarea>`
        : `<div style="font-size:12.5px;color:#334155">${esc(s.conclusion||'—')}</div>`; }
      const giveTerm=(s.code==='ДЛЗ'||s.code==='ПД'||s.durationClass);
      const dur=editable&&giveTerm?`<div style="margin-top:9px;display:flex;align-items:center;gap:8px"><span style="font-size:11px;color:#5b6b7a">Длительность, раб.дн</span><input type="number" data-f="_dur" value="${s.duration!=null?s.duration:''}" style="width:90px;font:inherit;font-size:12.5px;padding:5px 8px;border:1px solid var(--line);border-radius:2px"></div>`:'';
      // вердикт
      const verd=editable
        ? `<div style="display:flex;border:1px solid var(--line);border-radius:2px;overflow:hidden">${LOV_VERD.map(v=>`<span class="lov-vseg${s.verdict===v?' on':''}" data-sec="${s.id}" data-v="${v}" style="font-size:11.5px;font-weight:600;padding:6px 11px;cursor:pointer;border-left:1px solid var(--line)">${esc(v)}</span>`).join('')}</div>`
        : (s.verdict?stCellDot(LOV_VDOT[s.verdict]||'gray',s.verdict):'<span class="c-gray" style="font-size:12px">вердикт не задан</span>');
      const statSel=editable?`<select data-f="_status" style="font:inherit;font-size:12px;padding:4px 7px;border:1px solid var(--line);border-radius:2px">${['Не начат','Черновик','Готов'].map(o=>`<option${s.status===o?' selected':''}>${o}</option>`).join('')}</select>`:stCellDot(LOV_SDOT[s.status]||'gray',s.status);
      return `<div class="card pad lov-sec" data-sec="${s.id}" style="${editable?'border:1px solid var(--navy);box-shadow:0 0 0 3px rgba(46,117,182,.07)':''}">
        <div class="row" style="align-items:center;gap:8px;margin-bottom:9px"><span style="font-weight:700;color:var(--ink)">${esc(s.code)}</span><span style="font-size:12px;color:var(--sub)">${esc(s.name||'')}</span>
          ${editable?'<span class="badge b-amber" style="font-size:9px">ваш раздел</span>':'<span style="font-size:9px;color:#5b6b7a">read-only</span>'}
          <span class="spacer"></span>${statSel}</div>
        ${body}${dur}
        <div style="display:flex;align-items:center;gap:10px;margin-top:11px;flex-wrap:wrap"><span style="font-size:11px;font-weight:700;text-transform:uppercase;color:#5b6b7a">Вердикт:</span>${verd}
          ${editable?`<span class="spacer"></span><button class="tbtn primary" id="lov-save-${s.id}">Сохранить раздел</button>`:`<span class="spacer"></span><span style="font-size:11px;color:#5b6b7a">${esc(s.filledBy||'')}${s.filledDate?' · '+esc(fmt(s.filledDate)):''}</span>`}</div></div>`;
    }

    async function saveLovSectionUI(s,sheetId){
      const card=modal.querySelector(`.lov-sec[data-sec="${s.id}"]`); if(!card)return;
      const body={sectionId:s.id};
      const tpl=LOV_UNIT_FIELDS[s.code];
      if(tpl){const det={};card.querySelectorAll('[data-f]').forEach(el=>{const k=el.dataset.f;if(k[0]!=='_')det[k]=el.value;});body.details=det;}
      else{const t=card.querySelector('[data-f="_concl"]');if(t)body.conclusion=t.value;}
      const st=card.querySelector('[data-f="_status"]'); if(st)body.status=st.value;
      const du=card.querySelector('[data-f="_dur"]'); if(du&&du.value!=='')body.duration=Number(du.value);
      const v=card.querySelector('.lov-vseg.on'); if(v)body.verdict=v.dataset.v;
      const btn=document.getElementById('lov-save-'+s.id); if(btn){btn.disabled=true;btn.textContent='Сохранение…';}
      try{const r=await fetch('/api/lov/section',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(body)});const jr=await r.json();
        if(!r.ok)throw new Error(jr.error||'ошибка');
        openLovCard(sheetId); // перечитать карточку
      }catch(e){toast('Не удалось сохранить раздел: '+e.message,'err'); if(btn){btn.disabled=false;btn.textContent='Сохранить раздел';}}
    }
    async function saveLovDecisionUI(sheetId){
      const dseg=modal.querySelector('.lov-dseg.on'); if(!dseg){toast('Выберите решение.','err');return;}
      const body={sheetId,decision:dseg.dataset.d,conditions:(document.getElementById('lov-cond')||{}).value||'',risks:{}};
      modal.querySelectorAll('[data-risk]').forEach(el=>{if(el.value)body.risks[el.dataset.risk]=el.value;});
      const btn=document.getElementById('lov-decide'); if(btn){btn.disabled=true;btn.textContent='Сохранение…';}
      try{const r=await fetch('/api/lov/decision',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(body)});const jr=await r.json();
        if(!r.ok)throw new Error(jr.error||'ошибка');
        openLovCard(sheetId);
      }catch(e){toast('Не удалось вынести решение: '+e.message,'err'); if(btn){btn.disabled=false;btn.textContent='Вынести решение';}}
