    /* ═══ ERP-тема (пилот redesign-erp: оболочка + таблицы; блок-оверрайд, легко снять) ═══ */
    :root{ --radius:2px; --erp-side:#16314c; --erp-act:#1d3e5e; --erp-head:#f1f4f8; }
    .card,.kpi,.tk,.kc,.matrix,.modal,.colmenu,.tbtn,.seg,.st-card,.st-sec,.st-hd,.st-do,.info,.warn,.tag,.lit,.pbtn,.btn,.pill,.badge,.tbl-search input,.fld input,.fld select,.fld textarea,.erp-search{border-radius:2px;}
