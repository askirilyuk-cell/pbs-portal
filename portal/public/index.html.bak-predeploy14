      host.querySelectorAll('#w-filter button').forEach(b=>b.onclick=()=>{if(b.disabled)return;whFilter=b.dataset.fl;
        host.querySelectorAll('#w-filter button').forEach(x=>x.classList.toggle('on',x.dataset.fl===whFilter)); whGrid();});
      const rc=host.querySelector('#w-receipt'); if(rc)rc.onclick=()=>openWhReceipt();
