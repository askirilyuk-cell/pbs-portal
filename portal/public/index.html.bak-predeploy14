    // ══ Документы ИСМ — реестр Ф.2–Л.1 · пирамида · связи · карточка · ЖЦ ══
    let docsView=(()=>{try{return localStorage.getItem('pbs-docs-view')||'cards';}catch{return 'cards';}})();
    let docsType='', docsStatus='', docsLevel=0, docsQ='';
    let DOCS_STATE={list:[],live:false};
    let docFileDz=null; // дропзона файла в модалке «Завести/Новая версия/Правка»
    const GD_NAME='ГД С.Г. Кирилюк', DPP_NAME='ДпП А.С. Кирилюк';
    const DOC_SECTIONS={'Л':'Управление ИСМ','Д':'Производство','З':'Продажи и заказы','К':'Закупки','У':'Несоответствия и улучшения','П':'Проектирование','Э':'Экология','О':'Охрана труда'};
    const DOC_XREF={'ф.5-д.1':['ДП–У.2']}; // ручные кросс-ссылки (ключ нормализован), приоритет
    // нормализация кода: убрать версию-хвост («–1.0»), привести тире/регистр (для сопоставления связей)
    const dcNorm=(s)=>String(s||'').replace(/[–—−-]\d+\.\d+$/,'').replace(/[–—−]/g,'-').replace(/\s+/g,'').toLowerCase();
    // отображаемый код без версии-хвоста (реестр хранит «ДП–Л.1–1.0», показываем «ДП–Л.1»)
    const dispCode=(d)=>String((d&&d.code)||d||'').replace(/[–—−-]\d+\.\d+$/,'');
    const TYPE_FULL={'ДП':'Процедура','РК':'Руководство','РИ':'Инструкция','Ф':'Форма'};
    const TYPE_WRITE={'ДП':'ДП','РК':'РК','РИ':'РИ','Ф':'Форма'}; // значения SingleSelect «Тип» в реестре («Ф»→«Форма»)
    const typeFull=(d)=>TYPE_FULL[d.type]||d.type||docParse(d.code).type;
    const docPref=(d)=>{const t=String(d.type||'').toUpperCase();return ['ДП','РИ','Ф','РК'].includes(t)?t:docParse(d.code).pref;};
    const docFind=(code)=>DOCS_STATE.list.find(d=>dcNorm(d.code)===dcNorm(code));
    const fmtShort=(d)=>{const m=/^(\d{4})-(\d{2})-(\d{2})/.exec(String(d||''));return m?`${m[3]}.${m[2]}`:'';};
    const shortAppr=(s)=>{const m=/(ГД|ДпП|ПРК)/.exec(String(s||''));return m?m[1]:(s||'');};
    // шифр → тип / префикс / номер раздела / родитель / раздел
    function docParse(code){
      const bare=String(code||'').replace(/[–—−-]\d+\.\d+$/,''); // отбросить версию-хвост
      const norm=bare.trim().replace(/[–—−]/g,'-');
      let type='Форма',pref='Ф';
      if(/^ИСМ-?РК/i.test(norm)){type='Руководство';pref='РК';}
      else if(/^ДП/i.test(norm)){type='Процедура';pref='ДП';}
      else if(/^РИ/i.test(norm)){type='Инструкция';pref='РИ';}
      let secNum='',parent='';
      if(pref==='ДП'){
        const m=/^ДП-\s*([A-ZА-Яа-яё]+(?:\.\d+){0,2})/i.exec(norm); secNum=m?m[1]:'';
        const parts=secNum.split('.'); if(parts.length>=3)parent='ДП–'+parts.slice(0,2).join('.');
      } else if(pref==='РИ'||pref==='Ф'){
        const m=/-\s*([A-ZА-Яа-яё]+\.\d+(?:\.\d+)?)/i.exec(norm); secNum=m?m[1]:'';
        if(secNum)parent='ДП–'+secNum;
      }
      const secLetter=(secNum.match(/^[A-ZА-Яа-яё]+/)||[''])[0];
      return {type,pref,secNum,secLetter,parent,section:DOC_SECTIONS[secLetter]||secLetter||'—'};
    }
    function docLevel(d){
      const s=String(d.section||'').trim(); if(/^[1-4]$/.test(s))return +s; // реестр хранит уровень в «Раздел»
      const p=docParse(d.code);
      if(p.pref==='РК')return 1;
      if(/политик/i.test(d.type||'')||/политик/i.test(d.name||''))return 1;
      if(p.pref==='ДП')return 2; if(p.pref==='РИ')return 3; return 4;}
    const docApprover=(lvl)=>lvl<=2?GD_NAME:DPP_NAME;
    function docChildren(code){const me=dcNorm(code);return DOCS_STATE.list.filter(d=>{const pr=docParse(d.code).parent;return pr&&dcNorm(pr)===me;});}
    // статус ЖЦ → класс/подпись
    // статусы реестра (SingleSelect): проект → на регистрации → действует → архив
    function lcInfo(d){const s=String(d.status||'').toLowerCase();
      if(/архив|изъят|отмен|заменен|заменён/.test(s))return {cls:'arch',label:'Архив'};
