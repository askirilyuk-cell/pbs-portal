    // ── ГЕЙТ 1 (§4.1): форма прихода — только по акту Ф.3–Д.1 «принято» ──
    async function openWhReceipt(preCode){
      if(!WH||WH.mode!=='live'){ toast('Приход доступен только в LIVE-режиме (нужен токен NocoDB в «Настройках»).','err'); return; }
      let acts=[]; try{ const b=await (await fetch('/api/board')).json(); acts=((b.controls&&b.controls.incoming)||[]).filter(a=>whAcceptedV(a.verdict)); }catch{}
      const items=(WH.items||[]);
      const G='display:grid;grid-template-columns:repeat(12,1fr);gap:12px';
      const actOpts=acts.length?acts.map(a=>`<option value="${esc(String(a.id))}">Ф.3–Д.1 № ${esc(a.num||a.id)}${a.material?` — ${esc(a.material)}`:''} — принято ✓</option>`).join(''):'';
      const itemOpts=items.map(i=>`<option value="${esc(String(i.id))}">${esc(i.code)} · ${esc(i.name)}</option>`).join('');
      modal.style.width='min(680px,96vw)';
      modal.innerHTML=`<div class="mh"><b>Приход материала на склад</b><span class="op">ГЕЙТ 1 · §4.1 · только по Ф.3–Д.1 «принято»</span><button class="x" id="mx" aria-label="Закрыть">✕</button></div>
