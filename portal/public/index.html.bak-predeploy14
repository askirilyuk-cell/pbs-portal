          <div style="font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.06em;color:var(--sub);margin-bottom:10px">Карточка ${inv?'оснастки (инвентарная модель)':(si?'СИ (инвентарная + поверка · ДП–О.4)':'инструмента (Ф.1–О.3.1)')}</div>
          <div style="display:grid;grid-template-columns:1fr 1fr;gap:9px 18px;font-size:13px">${details}</div>
        </div>
        <div class="card pad">
          <div style="font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.06em;color:var(--sub);margin-bottom:10px">Журнал движения (Ф.2–О.3.1)</div>
          ${jTable(jhead,jrows)}
        </div>`;
      const mb=host.querySelector('[data-act="move"]'); if(mb)mb.onclick=()=>openToolMove(it,'');
      const eb=host.querySelector('[data-act="edit"]'); if(eb)eb.onclick=()=>openToolEdit(it,tlSubOf(it));
      const cb=host.querySelector('[data-act="close"]'); if(cb)cb.onclick=tlCloseDrawer;
    }

    // ── Форма операции (адаптируется к парадигме позиции) ──
    function openToolMove(preItem,preOp){
      if(!TL||TL.mode!=='live'){ toast('Операции доступны только в LIVE-режиме (нужен токен NocoDB в «Настройках»).','err'); return; }
      const items=(TL.items||[]); if(!items.length){ toast('Нет позиций. Сначала заведите инструмент.','err'); return; }
      let cur=preItem&&typeof preItem==='object'?preItem:items.find(i=>i.code===preItem)||items[0];
      const inv=tlIsInv(cur);
      const G='display:grid;grid-template-columns:repeat(12,1fr);gap:12px';
      const dict=(TL&&TL.dict)||{};
      const stations=((TL&&TL.locations)||[]).filter(l=>l.assign&&l.assign.indexOf('Станок')>=0);
      // DEF-33: список позиций — ВСЕ подразделы (режущий/СИ/оснастка), сгруппированы optgroup,
      // чтобы движение оснастки открывалось из любой точки (не только с вкладки «Оснастка»).
      // Поля формы соответствуют парадигме текущей единицы (cur); при выборе позиции другой
      // парадигмы форма перестраивается (openToolMove) — поля не смешиваются, журнал/логика DEF-23 не затрагиваются.
      const pool=items.slice();
      const tmOpt=(i)=>{const gi=tlIsInv(i);return `<option value="${esc(String(i.id))}"${i.id===cur.id?' selected':''}>${esc((gi?i.invNo:i.code)||i.code)} · ${esc(i.name)}${gi?'':' · ост. '+tlQty(i.balance,i.unit)}</option>`;};
      const tmGrp=(sub,label)=>{const g=pool.filter(i=>tlSubOf(i)===sub);return g.length?`<optgroup label="${esc(label)}">${g.map(tmOpt).join('')}</optgroup>`:'';};
      const itemOpts=tmGrp('cut','Режущий инструмент')+tmGrp('si','Мерительный (СИ)')+tmGrp('osn','Оснастка');
      const cells=((TL&&TL.locations)||[]).filter(l=>!l.assign||l.assign.indexOf('Станок')<0);
      // K-55: локационные операции (склад↔цех) доступны для любой позиции
      const ops=(inv?TL_OPS_INV:TL_OPS_QTY).concat((dict.opsLoc)||TL_OPS_LOC);
      const opOpts=ops.map(o=>`<option${o===(preOp&&ops.includes(preOp)?preOp:ops[0])?' selected':''}>${o}</option>`).join('');
      const stationOpts=`<option value="">— выбрать —</option>`+stations.map(s=>`<option>${esc(s.code)}</option>`).join('');
      const stationList=stations.map(s=>`<option value="${esc(s.code)}">${esc(s.description||'')}`).join('');
      const cellList=cells.map(l=>`<option value="${esc(l.code)}">${esc(l.description||'')}`).join('');
      // K-55: поля локационного движения (участок/станок ↔ ячейка склада)
      const locFields=`
            <div style="grid-column:span 12" id="tm-shopbox">${FLAB('Участок / станок (куда передаём)',true)}<input id="tm-shop" list="tm-stations" style="${FINP}" value="${esc(cur.shopArea||'')}" placeholder="напр. VMC1370 / Токарный участок"><datalist id="tm-stations">${stationList}</datalist></div>
            <div style="grid-column:span 12" id="tm-cellbox">${FLAB('Ячейка склада (куда возвращаем)')}<input id="tm-cell" list="tm-cells" style="${FINP}" value="${esc(cur.cell||'')}" placeholder="напр. А-01"><datalist id="tm-cells">${cellList}</datalist></div>
            <div style="grid-column:span 6">${FLAB('Дата')}<input id="tm-locdate" type="date" value="${tlYmd()}" style="${FINP}"></div>
            <div style="grid-column:span 6">${FLAB('Комментарий / основание')}<input id="tm-locbasis" style="${FINP}" placeholder="№ ПЗ / задание"></div>`;
      modal.style.width='min(660px,96vw)';
      const invFields=`
            <div style="grid-column:span 6">${FLAB('Откуда')}<input id="tm-from" style="${FINP}" value="${esc(cur.location||'')}" placeholder="текущее местоположение"></div>
            <div style="grid-column:span 6">${FLAB('Куда (станок / место)')}<select id="tm-to" style="${FINP}">${stationOpts}</select></div>
            <div style="grid-column:span 6">${FLAB('№ СФ (счёт-фактура)')}<input id="tm-batch" style="${FINP}" value="${esc(cur.invoiceNo||'')}"></div>
            <div style="grid-column:span 6">${FLAB('Комментарий / причина (Износ, Поломка)')}<input id="tm-basis" style="${FINP}"></div>`;
      const qtyFields=`
            <div style="grid-column:span 3">${FLAB('Кол-во',true)}<input id="tm-qty" type="number" step="any" style="${FINP}"></div>
            <div style="grid-column:span 4">${FLAB('Дата')}<input id="tm-date" type="date" value="${tlYmd()}" style="${FINP}"></div>
            <div style="grid-column:span 5" id="tm-recbox">${FLAB('ФИО получателя',true)}<input id="tm-rec" style="${FINP}" placeholder="кому выдан"></div>
            <div style="grid-column:span 6">${FLAB('Партия / СФ (ИНС-ГГММ-NNN)')}<input id="tm-batch" style="${FINP}"></div>
            <div style="grid-column:span 6">${FLAB('Комментарий / основание')}<input id="tm-basis" style="${FINP}" placeholder="№ ПЗ / МК"></div>`;
      modal.innerHTML=`<div class="mh"><b>Движение ${inv?'оснастки':'инструмента'}</b><span class="op">Ф.2–О.3.1 · ${inv?'приёмка / перемещение / списание':'выдача / пополнение / возврат / поступление'}</span><button class="x" id="mx" aria-label="Закрыть">✕</button></div>
        <div class="mb" style="gap:0">
          <div style="${G}">
            <div style="grid-column:span 8">${FLAB(inv?'Оснастка (по инв.№)':'Инструмент',true)}<select id="tm-item" style="${FINP}">${itemOpts}</select></div>
            <div style="grid-column:span 4">${FLAB('Операция',true)}<select id="tm-op" style="${FINP}">${opOpts}</select></div>
          </div>
          <div id="tm-pararow" style="${G};margin-top:12px">${inv?invFields:qtyFields}</div>
          <div id="tm-locrow" style="${G};margin-top:12px;display:none">${locFields}</div>
          <div id="tm-soft" style="display:none;margin-top:11px;font-size:12px;color:#b45309;background:#fffbeb;border:1px solid #fde68a;border-radius:2px;padding:8px 10px"></div>
          <div style="margin-top:9px;font-size:11.5px;color:#5b6b7a;line-height:1.5">${inv?'<b>Приёмка</b> — регистрация/приход оснастки; <b>Перемещение</b> — смена местоположения (Откуда→Куда); <b>Списание</b> — вывод из эксплуатации (причина обязательна).':'<b>Выдача</b> − остаток (проверка ≤ остатка, ФИО обяз.); <b>Пополнение</b>/<b>Поступление</b> + остаток (от поставщика); <b>Возврат</b> + остаток (годный).'}<br><b>Передача на участок</b> — перевод в цех на участок/станок; <b>Возврат на склад</b> — назад в ячейку. Остаток не меняют.</div>
          <div id="tm-err" style="margin-top:12px;color:#b91c1c;font-size:12.5px"></div>
          <div style="margin-top:14px;padding-top:13px;border-top:1px solid #e2e8f0;display:flex;align-items:center;gap:10px">
            <span style="font-size:12px;color:#5b6b7a"><span style="color:#b91c1c">*</span> — обязательное поле</span>
            <div style="margin-left:auto;display:flex;gap:10px">
              <button class="tbtn" id="tm-cancel" style="padding:9px 18px">Отмена</button>
              <button class="tbtn primary" id="tm-save" style="padding:9px 18px">Провести</button>
            </div>
          </div>
        </div>`;
      modal.classList.add('open'); mscrim.classList.add('open');
      document.getElementById('mx').onclick=closeModal; document.getElementById('tm-cancel').onclick=closeModal;
      const itemEl=document.getElementById('tm-item'), opEl=document.getElementById('tm-op');
      const curItem=()=>pool.find(i=>String(i.id)===itemEl.value);
      const isLocSel=()=>TL_OPS_LOC.includes(opEl.value);
      // K-55: переключение блока полей (парадигма ↔ локация) и подполей передача/возврат
      const syncMode=()=>{ const loc=isLocSel();
        const para=document.getElementById('tm-pararow'), locrow=document.getElementById('tm-locrow');
        if(para)para.style.display=loc?'none':''; if(locrow)locrow.style.display=loc?'':'none';
        if(loc){ const toShop=opEl.value==='Передача на участок';
          const sb=document.getElementById('tm-shopbox'), cb=document.getElementById('tm-cellbox');
          if(sb)sb.style.display=toShop?'':'none'; if(cb)cb.style.display=toShop?'none':''; }
        recalc(); };
      const recalc=()=>{ const soft=document.getElementById('tm-soft'); if(!soft)return;
        if(inv||isLocSel()){ soft.style.display='none'; return; }
        const op=opEl.value; const recBox=document.getElementById('tm-recbox'); if(recBox)recBox.style.display=op==='Выдача'?'block':'none';
        const it=curItem(), q=Number((document.getElementById('tm-qty')||{}).value);
        // K-39 (5c): плашка пересчёта — зелёная при норме, жёлтая при превышении остатка
        const setSoft=(bg,bd,col,html)=>{soft.style.display='block';soft.style.background=bg;soft.style.borderColor=bd;soft.style.color=col;soft.innerHTML=html;};
        if(!it||!(q>0)){ soft.style.display='none'; return; }
        const bal=Number(it.balance)||0;
        if(op==='Выдача'){
          if(q>bal) setSoft('#fffbeb','#fde68a','#b45309',`Выдача ${tlQty(q)} превышает остаток ${tlQty(bal,it.unit)} — будет отклонена. Уменьшите кол-во или проведите пополнение.`);
          else setSoft('#f0fdf4','#bbf7d0','#15803d',`После выдачи остаток: <b>${tlQty(bal-q,it.unit)}</b> (было ${tlQty(bal,it.unit)}).`);
        } else setSoft('#f0fdf4','#bbf7d0','#15803d',`После операции «${esc(op)}» остаток: <b>${tlQty(bal+q,it.unit)}</b> (было ${tlQty(bal,it.unit)}).`); };
      // DEF-33: при выборе позиции другой парадигмы перестраиваем форму под неё (сохраняя выбранную операцию)
      itemEl.onchange=()=>{ const ni=curItem(); if(ni&&tlIsInv(ni)!==inv){ openToolMove(ni,opEl.value); return; } syncMode(); }; opEl.onchange=syncMode; const qe=document.getElementById('tm-qty'); if(qe)qe.oninput=recalc; syncMode();
      document.getElementById('tm-save').onclick=async()=>{
        const err=document.getElementById('tm-err'); err.textContent='';
        const fail=(mm)=>{ err.textContent=mm; toast(mm,'err'); };
        const V=(id)=>{const el=document.getElementById(id);return el?el.value.trim():'';};
        const it=curItem();
        const op=V('tm-op');
        const body={ itemId:itemEl.value, operation:op };
        if(TL_OPS_LOC.includes(op)){ body.date=V('tm-locdate')||tlYmd(); body.basis=V('tm-locbasis');
          if(op==='Передача на участок'){ body.to=V('tm-shop'); if(!body.to){ fail('Передача на участок: укажите участок / станок.'); return; } }
          else { body.cell=V('tm-cell'); }
        } else if(inv){ body.date=V('tm-date')||tlYmd(); body.basis=V('tm-basis'); body.from=V('tm-from'); body.to=V('tm-to'); body.invoiceNo=V('tm-batch');
          if(op==='Перемещение'&&!body.to){ fail('Перемещение: укажите «Куда».'); return; }
          if(op==='Списание'&&!body.basis){ fail('Списание: укажите причину (Износ / Поломка).'); return; }
        } else { body.date=V('tm-date')||tlYmd(); body.basis=V('tm-basis'); body.qty=Number(V('tm-qty')); body.recipient=V('tm-rec'); body.batch=V('tm-batch');
          if(!(body.qty>0)){ fail('Укажите положительное количество.'); return; }
          if(op==='Выдача'&&!body.recipient){ fail('Выдача: укажите ФИО получателя.'); return; }
          if(op==='Выдача'&&it&&body.qty>Number(it.balance)){ fail('Выдача превышает остаток.'); return; }
        }
        const btn=document.getElementById('tm-save'); btn.disabled=true; btn.textContent='Проведение…';
        try{ const r=await fetch('/api/tools/move',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(body)});
          const j=await r.json().catch(()=>({})); if(!r.ok||j.error)throw new Error(j.error||('HTTP '+r.status));
          toast(`${j.operation} проведена: ${inv?(j.invNo||j.code):j.code}${j.where?' · '+j.where:(j.balance!=null?' · остаток '+tlQty(j.balance):(j.status?' · '+j.status:''))}`,'ok');
          tlCardCache={}; TL=null; tlSel=(it&&it.code)||tlSel; closeModal(); renderTools(document.getElementById('view'));
        }catch(e){ err.textContent=e.message; toast('Отклонено: '+e.message,'err'); btn.disabled=false; btn.textContent='Провести'; }
      };
    }

    // ── Форма заведения / правки (по подразделу) ──
    function openToolEdit(it,sub){
      if(!TL||TL.mode!=='live'){ toast('Заведение доступно только в LIVE-режиме (нужен токен NocoDB).','err'); return; }
      const edit=!!it; it=it||{};
      if(edit)sub=tlSubOf(it);
      const dict=(TL&&TL.dict)||{types:['Расходный','Специальный'],categories:[],rigKinds:[],statuses:[]};
      const locs=(TL&&TL.locations)||[];
      const G='display:grid;grid-template-columns:repeat(12,1fr);gap:12px';
      if(!edit&&sub==='si'){ it.type='Расходный'; it.category='Мерительный/СИ'; }
      else if(!edit&&sub==='osn'){ it.type='Специальный'; }
      const opt=(arr,cur)=>arr.map(o=>`<option${cur===o?' selected':''}>${esc(o)}</option>`).join('');
      const cells=locs.filter(l=>!l.assign||l.assign.indexOf('Станок')<0);
      const stations=locs.filter(l=>l.assign&&l.assign.indexOf('Станок')>=0);
      const cellList=cells.map(l=>`<option value="${esc(l.code)}">`).join('');
      const stationList=stations.map(l=>`<option value="${esc(l.code)}">`).join('');
      let title,fields;
      if(sub==='osn'){ title=edit?'Оснастка '+esc(it.invNo||it.code):'Новая оснастка';
        fields=`
            <div style="grid-column:span 12">${FLAB('Наименование',true)}<input id="te-name" style="${FINP}" value="${esc(it.name||'')}" placeholder="напр. Оправка BT40-ER32"></div>
            <div style="grid-column:span 4">${FLAB('Вид оснастки')}<select id="te-rigkind" style="${FINP}"><option value="">—</option>${opt(dict.rigKinds||['Державка','Приспособление','Пресс-форма'],it.rigKind)}</select></div>
            <div style="grid-column:span 4">${FLAB('Категория')}<select id="te-cat" style="${FINP}"><option value="">—</option>${opt((dict.categories||[]).filter(c=>['Токарные','Фрезерные','Пресс-формы','Оправки','Прочее'].includes(c)),it.category)}</select></div>
            <div style="grid-column:span 4">${FLAB('Инв. №'+(edit?'':' (авто ОСН-ГГММ-NNN)'))}<input id="te-inv" style="${FINP}" value="${esc(it.invNo||'')}" ${edit?'':'placeholder="присвоится автоматически"'}></div>
            <div style="grid-column:span 4">${FLAB('Код 1С (для списания)')}<input id="te-code1c" style="${FINP}" value="${esc(it.code1c||'')}" placeholder="БП-000NNNN"></div>
            <div style="grid-column:span 4">${FLAB('№ СФ (счёт-фактура)')}<input id="te-invoice" style="${FINP}" value="${esc(it.invoiceNo||'')}"></div>
            <div style="grid-column:span 4">${FLAB('Местоположение')}<input id="te-loc" list="te-stations" style="${FINP}" value="${esc(it.location||'')}" placeholder="Склад / станок"><datalist id="te-stations">${stationList}</datalist></div>
            <div style="grid-column:span 4">${FLAB('Статус')}<select id="te-status" style="${FINP}">${opt(['В эксплуатации','На станке','Списан'],it.status||'В эксплуатации')}</select></div>
            <div style="grid-column:span 12">${FLAB('Примечание')}<input id="te-note" style="${FINP}" value="${esc(it.note||'')}"></div>`; }
      else if(sub==='si'){ title=edit?'СИ '+esc(it.invNo||it.code):'Новое СИ (мерительный инструмент)';
        fields=`
            <div style="grid-column:span 12">${FLAB('Наименование',true)}<input id="te-name" style="${FINP}" value="${esc(it.name||'')}" placeholder="напр. Штангенциркуль ШЦ-I-150-0.05"></div>
            <div style="grid-column:span 4">${FLAB('Инв. №'+(edit?'':' (авто СИ-NNN)'))}<input id="te-inv" style="${FINP}" value="${esc(it.invNo||'')}" ${edit?'':'placeholder="авто"'}></div>
            <div style="grid-column:span 4">${FLAB('Диапазон / класс точности')}<input id="te-acc" style="${FINP}" value="${esc(it.accuracyRange||'')}" placeholder="0–150 мм / 0.05"></div>
            <div style="grid-column:span 4">${FLAB('Ед. изм.')}<input id="te-unit" style="${FINP}" value="${esc(it.unit||'шт')}"></div>
            <div style="grid-column:span 4">${FLAB('Дата поверки')}<input id="te-cal" type="date" style="${FINP}" value="${esc(it.calDate||'')}"></div>
            <div style="grid-column:span 4">${FLAB('След. поверка')}<input id="te-calnext" type="date" style="${FINP}" value="${esc(it.calNext||'')}"></div>
            <div style="grid-column:span 4">${FLAB('№ свидетельства')}<input id="te-cert" style="${FINP}" value="${esc(it.calCert||'')}" placeholder="СП-…"></div>
            <div style="grid-column:span 4">${FLAB('Код 1С (для списания)')}<input id="te-code1c" style="${FINP}" value="${esc(it.code1c||'')}" placeholder="БП-000NNNN"></div>
            <div style="grid-column:span 4">${FLAB('Местоположение')}<input id="te-loc" style="${FINP}" value="${esc(it.location||'')}" placeholder="Кладовая СИ"></div>
            <div style="grid-column:span 4">${FLAB('Статус')}<select id="te-status" style="${FINP}">${opt(['Годен','Просрочен','Списан'],it.status||'Годен')}</select></div>
            <div style="grid-column:span 12">${FLAB('Примечание')}<input id="te-note" style="${FINP}" value="${esc(it.note||'')}"></div>`; }
      else { title=edit?'Инструмент '+esc(it.code):'Новый режущий инструмент';
        fields=`
            <div style="grid-column:span 12">${FLAB('Наименование',true)}<input id="te-name" style="${FINP}" value="${esc(it.name||'')}" placeholder="напр. Резец проходной Т15К6 16×16"></div>
            <div style="grid-column:span 4">${FLAB('Тип',true)}<select id="te-type" style="${FINP}">${opt(dict.types||['Расходный','Специальный'],it.type||'Расходный')}</select></div>
            <div style="grid-column:span 4">${FLAB('Категория')}<select id="te-cat" style="${FINP}"><option value="">—</option>${opt((dict.categories||[]).filter(c=>c!=='Мерительный/СИ'),it.category)}</select></div>
            <div style="grid-column:span 4">${FLAB('Подкатегория')}<input id="te-subcat" style="${FINP}" value="${esc(it.subcategory||'')}" placeholder="Проходные / Торцевые"></div>
            <div style="grid-column:span 4">${FLAB('Код 1С (для списания)')}<input id="te-code1c" style="${FINP}" value="${esc(it.code1c||'')}" placeholder="БП-000NNNN"></div>
            <div style="grid-column:span 4">${FLAB('Ед. изм.')}<input id="te-unit" style="${FINP}" value="${esc(it.unit||'шт')}"></div>
            <div style="grid-column:span 4">${FLAB('Ячейка')}<input id="te-cell" list="te-cells" style="${FINP}" value="${esc(it.cell||'')}" placeholder="А-01"><datalist id="te-cells">${cellList}</datalist></div>
            <div style="grid-column:span 4">${FLAB('Мин. остаток')}<input id="te-min" type="number" step="any" style="${FINP}" value="${it.minStock!=null?it.minStock:''}"></div>
            ${edit?'':`<div style="grid-column:span 4">${FLAB('Стартовый остаток')}<input id="te-bal" type="number" step="any" style="${FINP}" placeholder="0"></div>`}
            <div style="grid-column:span 12">${FLAB('Примечание')}<input id="te-note" style="${FINP}" value="${esc(it.note||'')}"></div>`; }
      modal.style.width='min(680px,96vw)';
      modal.innerHTML=`<div class="mh"><b>${title}</b><span class="op">${sub==='osn'?'инвентарная модель · инв.№ ОСН-ГГММ-NNN':(sub==='si'?'ДП–О.4 · поверка':'Ф.1–О.3.1 · количественный учёт')}</span><button class="x" id="mx" aria-label="Закрыть">✕</button></div>
        <div class="mb" style="gap:0">
          ${edit
            ? `<div style="margin-bottom:13px">${tlChip((sub==='osn'?'Оснастка':(sub==='si'?'Мерительный (СИ)':'Режущий инструмент')),'spec')}</div>`
            : `<div style="margin-bottom:13px"><div style="font-size:11px;color:var(--sub);margin-bottom:5px">Подраздел</div><div class="seg" id="te-sub">${TL_SUBS.map(([k,t])=>`<button data-sub="${k}" class="${sub===k?'on':''}">${t}</button>`).join('')}</div></div>`}
          <div style="${G}">${fields}</div>
          <div id="te-err" style="margin-top:12px;color:#b91c1c;font-size:12.5px"></div>
          <div style="margin-top:14px;padding-top:13px;border-top:1px solid #e2e8f0;display:flex;align-items:center;gap:10px">
            <span style="font-size:12px;color:#5b6b7a"><span style="color:#b91c1c">*</span> — обязательное поле</span>
            <div style="margin-left:auto;display:flex;gap:10px">
              <button class="tbtn" id="te-cancel" style="padding:9px 18px">Отмена</button>
              <button class="tbtn green" id="te-save" style="padding:9px 18px">${edit?'Сохранить':'Завести'}</button>
            </div>
          </div>
        </div>`;
      modal.classList.add('open'); mscrim.classList.add('open');
      document.getElementById('mx').onclick=closeModal; document.getElementById('te-cancel').onclick=closeModal;
      // K-39 (5a/5b): переключатель подраздела в шапке формы заведения — меняет набор полей
      if(!edit)modal.querySelectorAll('#te-sub button').forEach(b=>b.onclick=()=>{if(b.dataset.sub!==sub)openToolEdit(null,b.dataset.sub);});
      document.getElementById('te-save').onclick=async()=>{
        const err=document.getElementById('te-err'); err.textContent='';
        const V=(id)=>{const el=document.getElementById(id);return el?el.value.trim():'';};
        const body={ name:V('te-name'), note:V('te-note'), code1c:V('te-code1c') };
        if(sub==='osn'){ body.type='Специальный'; body.rigKind=V('te-rigkind'); body.category=V('te-cat'); body.invNo=V('te-inv'); body.invoiceNo=V('te-invoice'); body.location=V('te-loc'); body.status=V('te-status'); }
        else if(sub==='si'){ body.type='Расходный'; body.category='Мерительный/СИ'; body.invNo=V('te-inv'); body.accuracyRange=V('te-acc'); body.unit=V('te-unit'); body.calDate=V('te-cal'); body.calNext=V('te-calnext'); body.calCert=V('te-cert'); body.location=V('te-loc'); body.status=V('te-status'); }
        else { body.type=V('te-type'); body.category=V('te-cat'); body.subcategory=V('te-subcat'); body.unit=V('te-unit'); body.cell=V('te-cell'); body.minStock=V('te-min'); if(!edit&&V('te-bal'))body.balance=Number(V('te-bal')); }
        if(edit)body.id=it.id;
        if(!body.name){ err.textContent='Укажите наименование.'; toast('Укажите наименование.','err'); return; }
        const btn=document.getElementById('te-save'); btn.disabled=true; btn.textContent='Сохранение…';
        try{ const r=await fetch('/api/tools/save',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(body)});
          const j=await r.json().catch(()=>({})); if(!r.ok||j.error)throw new Error(j.error||('HTTP '+r.status));
          toast(`${sub==='osn'?'Оснастка':(sub==='si'?'СИ':'Инструмент')} ${j.code} ${j.created?'заведён(а)':'обновлён(а)'}.`,'ok');
          TL=null; tlCardCache={}; tlSel=j.code; closeModal(); renderTools(document.getElementById('view'));
        }catch(e){ err.textContent=e.message; toast('Не сохранено: '+e.message,'err'); btn.disabled=false; btn.textContent=edit?'Сохранить':'Завести'; }
      };
    }

    // ── Экран 2: справочник мест хранения (ячейки инструмента + станки оснастки) — макет 4b ──
    function tlLocBody(host){
      const locs=(TL&&TL.locations)||[];
      const items=(TL&&TL.items)||[];
      const cells=locs.filter(l=>!l.assign||l.assign.indexOf('Станок')<0);
      const stations=locs.filter(l=>l.assign&&l.assign.indexOf('Станок')>=0);
      const cntAt=(code)=>items.filter(i=>i.cell===code||i.location===code||i.storage===code).length;
      // карточка места: заголовок + подпись + счётчик, таблица (клик по строке → фильтр реестра по месту)
      const locCard=(title,sub,arr,cols,cntLbl,kind)=>{
        const rows=arr.length?arr.map(l=>{const n=cntAt(l.code);return `<tr data-place="${esc(l.code)}" data-kind="${kind}" style="cursor:pointer"><td class="code" style="color:var(--navy);font-weight:700">${esc(l.code||'—')}</td><td>${esc(l.cabinet||'—')}</td><td>${esc(l.description||'—')}</td><td style="text-align:right">${n?`<b style="color:var(--navy)">${n}</b>`:'<span class="c-gray">0</span>'}</td></tr>`;}).join(''):`<tr><td colspan="${cols.length+1}" style="padding:12px;color:#5b6b7a;text-align:center">Пусто.</td></tr>`;
        return `<div class="card pad" style="min-width:0">
            <div style="display:flex;align-items:baseline;gap:8px;margin-bottom:8px">
              <div style="font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.06em;color:var(--sub)">${title}</div>
              <span class="lit">${arr.length}</span>
              <span style="margin-left:auto;font-size:11px;color:#5b6b7a">${sub}</span>
            </div>
            <div class="tbl-wrap"><table class="dt"><thead><tr>${cols.map(c=>`<th>${c}</th>`).join('')}<th style="text-align:right">${cntLbl}</th></tr></thead><tbody>${rows}</tbody></table></div>
          </div>`;
      };
      host.innerHTML=`<div class="filters" style="margin-bottom:var(--gap)">
          <span style="font-size:12.5px;color:var(--sub)">Ячейки — для режущего/СИ (поле «Ячейка»); станки — местоположение оснастки (перемещение по цеху).</span>
          <button class="tbtn green" id="tl-loc-new" style="margin-left:auto">+ Место хранения</button>
        </div>
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:var(--gap);align-items:start" class="tl-loc-grid">
          ${locCard('Ячейки хранения инструмента (режущий / СИ)','клик — фильтр реестра',cells,['Код ячейки','Шкаф / Стеллаж','Описание'],'Позиций','cut')}
          ${locCard('Места оснастки — станки','клик — фильтр реестра',stations,['Код','Участок','Станок / описание'],'Оснастки','osn')}
        </div>`;
      host.querySelectorAll('tr[data-place]').forEach(tr=>tr.onclick=()=>{
        tlPlace=tr.dataset.place; if(tr.dataset.kind==='osn')tlSub='osn'; else if(tlSub==='osn')tlSub='cut';
        tlCat='';tlFilter='all';tlSel=null; tlTab='items';
        document.querySelectorAll('#tlseg button').forEach(x=>x.classList.toggle('on',x.dataset.t==='items'));
        tlBody(); toast('Реестр отфильтрован по месту: '+tlPlace,'ok');
      });
      const ln=host.querySelector('#tl-loc-new'); if(ln)ln.onclick=()=>toast('Заведение места хранения — через справочник NocoDB (locations). Форма — в следующем релизе.','err');
    }

    // ── Экран 3: акт списания за период (Ф.3–О.3.1) — режущий (2 раздела) + оснастка ──
    async function tlActBody(host){
      const from=(host.querySelector('#ta-from')||{}).value||tlMonthStart();
      const to=(host.querySelector('#ta-to')||{}).value||tlYmd();
      host.innerHTML='<div class="card pad" style="color:var(--sub)">Сбор акта списания…</div>';
      let rep; try{ rep=await (await fetch(`/api/tools/act?from=${from}&to=${to}`)).json(); }catch(e){ rep={mode:'mock',section1:{lines:[]},section2:{lines:[]},rig:{lines:[]},total:{qty:0,count:0}}; }
      const s1=rep.section1||{lines:[]}, s2=rep.section2||{lines:[]}, rig=rep.rig||{lines:[]}, tot=rep.total||{qty:0,count:0};
      const secTbl=(s,pz)=>{const ls=s.lines||[]; const rows=ls.length?ls.map(l=>`<tr><td class="code">${esc(l.code)}</td><td class="code">${esc(l.code1c||'—')}</td><td>${esc(l.name)}</td><td>${esc(l.category||'—')}</td><td style="text-align:right">${tlQty(l.qty,l.unit)}</td><td>${esc(pz?(l.pzNo||'—'):(l.writeOff||'—'))}</td><td>${esc(l.batch||'—')}</td></tr>`).join(''):'<tr><td colspan="7" style="padding:12px;color:#5b6b7a;text-align:center">Списаний в разделе за период нет.</td></tr>';
        return `<div style="font-size:12px;font-weight:700;color:var(--navy);margin:14px 0 6px">${esc(s.title||'')}</div>
          <div class="tbl-wrap"><table class="dt"><thead><tr><th>Код</th><th>Код 1С</th><th>Наименование</th><th>Категория</th><th style="text-align:right">Кол-во</th><th>${pz?'№ ПЗ':'Списание на'}</th><th>Партии (СФ)</th></tr></thead>
            <tbody>${rows}<tr><td colspan="4" style="font-weight:700">Итого по разделу</td><td style="text-align:right;font-weight:800;color:var(--navy)">${tlQty(s.totalQty||0)}</td><td colspan="2"></td></tr></tbody></table></div>`;};
      const rigTbl=()=>{const ls=rig.lines||[]; if(!ls.length)return ''; const rows=ls.map(l=>`<tr><td class="nowrap">${fmt(l.date)}</td><td>${esc(l.name)}</td><td class="code">${esc(l.invNo)}</td><td class="code">${esc(l.code1c||'—')}</td><td>${esc(l.reason||'—')}</td><td>${esc(l.pzNo||'—')}</td><td>${esc(l.invoiceNo||'—')}</td></tr>`).join('');
        return `<div style="font-size:12px;font-weight:700;color:#7c3aed;margin:16px 0 6px">Акт списания оснастки (износ / поломка)</div>
          <div class="tbl-wrap"><table class="dt"><thead><tr><th>Дата</th><th>Наименование</th><th>Инв. №</th><th>Код 1С</th><th>Причина</th><th>№ ПЗ</th><th>№ СФ</th></tr></thead><tbody>${rows}</tbody></table></div>`;};
      const so=rep.signoff||{prepared:'Составил: мастер участка',approved:'Утвердил: директор по производству'};
      host.innerHTML=`<div class="card pad">
          <div class="filters" style="align-items:flex-end;padding-bottom:13px;border-bottom:1px solid var(--line);margin-bottom:14px">
            <div>${FLAB('Период с')}<input id="ta-from" type="date" value="${from}" style="${FINP};width:170px"></div>
            <div>${FLAB('по')}<input id="ta-to" type="date" value="${to}" style="${FINP};width:170px"></div>
            <button class="tbtn primary" id="ta-month">Сформировать акт (текущий месяц)</button>
            <button class="tbtn" id="ta-apply">Пересобрать за период</button>
            <button class="tbtn primary" id="ta-pdf" style="margin-left:auto">Скачать акт ↧ (PDF)</button>
            <button class="tbtn" id="ta-export">Выгрузка акта ↧ (CSV)</button>
          </div>
          <div style="font-size:13px;font-weight:700;color:var(--navy);margin-bottom:8px">Акт списания инструмента за период (Ф.3–О.3.1)</div>
          ${secTbl(s1,false)}
          ${secTbl(s2,true)}
          ${rigTbl()}
          <div style="margin-top:12px;font-size:12.5px;color:#334155">Режущий (выдача) за период: <b>${tlQty(tot.qty)}</b> · проводок ${tot.count}${tot.rig?` · оснастки списано ${tot.rig}`:''}</div>
          <div style="display:flex;gap:60px;margin-top:22px;flex-wrap:wrap">
            <div style="font-size:12.5px;color:#334155">${esc(so.prepared)}<div style="margin-top:26px;border-top:1px solid #5b6b7a;width:220px;font-size:11px;color:#5b6b7a;padding-top:3px">подпись / дата</div></div>
            <div style="font-size:12.5px;color:#334155">${esc(so.approved)}<div style="margin-top:26px;border-top:1px solid #5b6b7a;width:220px;font-size:11px;color:#5b6b7a;padding-top:3px">подпись / дата</div></div>
          </div>
          <div style="font-size:11px;color:#5b6b7a;margin-top:12px">Раздел 1 (расходный) → ОПР сч.25; Раздел 2 (специальный) → на заказ (№ ПЗ); оснастка → по операциям «Списание». PDF в Drive (Год/Месяц) — v2.</div>
        </div>`;
      const mo=host.querySelector('#ta-month'); if(mo)mo.onclick=()=>{host.querySelector('#ta-from').value=tlMonthStart();host.querySelector('#ta-to').value=tlYmd();tlActBody(host);toast('Акт сформирован за текущий месяц.','ok');};
      const ap=host.querySelector('#ta-apply'); if(ap)ap.onclick=()=>tlActBody(host);
      const pd=host.querySelector('#ta-pdf'); if(pd)pd.onclick=()=>{ window.open(`/api/tools/act.pdf?from=${from}&to=${to}`,'_blank'); toast('Формируем акт (PDF)…','ok'); };
      const ex=host.querySelector('#ta-export'); if(ex)ex.onclick=()=>{
        const all=[...(s1.lines||[]).map(l=>({sec:'Расходный (ОПР сч.25)',code:l.code,code1c:l.code1c,name:l.name,cat:l.category,qty:l.qty,unit:l.unit,ref:l.writeOff,batch:l.batch})),
          ...(s2.lines||[]).map(l=>({sec:'Специальный (№ ПЗ)',code:l.code,code1c:l.code1c,name:l.name,cat:l.category,qty:l.qty,unit:l.unit,ref:l.pzNo,batch:l.batch})),
          ...(rig.lines||[]).map(l=>({sec:'Оснастка (списание)',code:l.invNo,code1c:l.code1c,name:l.name,cat:l.reason,qty:1,unit:'шт',ref:l.pzNo,batch:l.invoiceNo}))];
        if(!all.length){ toast('Нет данных для выгрузки за период.','err'); return; }
