          ${jTable('<tr><th>Дата</th><th>Тип</th><th>Направление</th><th style="text-align:right">Кол-во</th><th>Партия / плавка</th><th>Документ-основание</th><th style="text-align:right">Сумма</th></tr>',jrows)}
