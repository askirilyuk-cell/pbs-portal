      const dirOpts=WH_DIRS.map(d=>`<option${d==='Ремонт'?' selected':''}>${d}</option>`).join('');
      modal.style.width='min(660px,96vw)';
      modal.innerHTML=`<div class="mh"><b>Расход материала (Ф.5–СХ)</b><span class="op">ГЕЙТ 2 · §4.3 · объект отнесения обязателен</span><button class="x" id="mx" aria-label="Закрыть">✕</button></div>
        <div class="mb" style="gap:0">
          <div style="${G}">
            <div style="grid-column:span 12">${FLAB('Позиция',true)}<select id="wi-item" style="${FINP}">${itemOpts}</select></div>
            <div style="grid-column:span 4">${FLAB('Кол-во',true)}<input id="wi-qty" type="number" step="any" style="${FINP}"></div>
            <div style="grid-column:span 4">${FLAB('Дата')}<input id="wi-date" type="date" value="${whYmd()}" style="${FINP}"></div>
            <div style="grid-column:span 4">${FLAB('Направление расхода',true)}<select id="wi-dir" style="${FINP}">${dirOpts}</select></div>
            <div style="grid-column:span 12">${FLAB('Объект отнесения',true)}<input id="wi-object" style="${FINP};border-color:#fca5a5;background:#fff7f7" placeholder="не указан — проводка заблокирована (§4.3)"></div>
            <div style="grid-column:span 12">${FLAB('Документ-основание')}<input id="wi-basis" style="${FINP}" placeholder="Ф.5–СХ № … (производство → МК/ПЗ)"></div>
            <div style="grid-column:span 8">${FLAB('Партия / плавка')}<input id="wi-batch" style="${FINP}"></div>
            <div style="grid-column:span 4">${FLAB('Примечание')}<input id="wi-note" style="${FINP}"></div>
          </div>
          <div id="wi-soft" style="display:none;margin-top:11px;font-size:12px;color:#b45309;background:#fffbeb;border:1px solid #fde68a;border-radius:2px;padding:8px 10px"></div>
          <div style="margin-top:9px;font-size:11.5px;color:#5b6b7a;line-height:1.5">Маршрут основания: <b>производство</b> → МК в рамках ПЗ (списывается в произв. модуле); <b>испытание</b> → Ф.5–СХ + проект ОКР; <b>ремонт</b> → Ф.5–СХ + оборудование (заглушка); <b>прочее</b> → Ф.5–СХ + текст. Отрицательный остаток — мягкий (§5.3): не блок, а предупреждение + флаг.</div>
          <div id="wi-err" style="margin-top:12px;color:#b91c1c;font-size:12.5px"></div>
          <div style="margin-top:14px;padding-top:13px;border-top:1px solid #e2e8f0;display:flex;align-items:center;gap:10px">
            <span style="font-size:12px;color:#5b6b7a"><span style="color:#b91c1c">*</span> — обязательное поле</span>
            <div style="margin-left:auto;display:flex;gap:10px">
              <button class="tbtn" id="wi-cancel" style="padding:9px 18px">Отмена</button>
              <button class="tbtn primary" id="wi-save" style="padding:9px 18px" disabled>Провести расход</button>
            </div>
          </div>
        </div>`;
      modal.classList.add('open'); mscrim.classList.add('open');
      document.getElementById('mx').onclick=closeModal; document.getElementById('wi-cancel').onclick=closeModal;
      const objEl=document.getElementById('wi-object'), qtyEl=document.getElementById('wi-qty'), itemEl=document.getElementById('wi-item'), saveBtn=document.getElementById('wi-save'), soft=document.getElementById('wi-soft');
      const curItem=()=>items.find(i=>String(i.id)===itemEl.value);
      const recalc=()=>{
        // ГЕЙТ 2 отражён в UI: кнопка активна только с объектом
        saveBtn.disabled=!objEl.value.trim();
        objEl.style.borderColor=objEl.value.trim()?'#cfd8e3':'#fca5a5'; objEl.style.background=objEl.value.trim()?'#fff':'#fff7f7';
        const it=curItem(), q=Number(qtyEl.value);
        if(it&&q>0){ const after=Number(it.balance)-q;
          if(after<0){ soft.style.display='block'; soft.innerHTML=`§5.3 мягкий минус: ${whQty(it.balance,it.unit)} − ${whQty(q)} = <b>${whQty(after,it.unit)}</b>. Проводка пройдёт с флагом «отрицательный остаток» (цех не стопорится).`; }
          else { soft.style.display='none'; } }
        else soft.style.display='none';
      };
      objEl.oninput=recalc; qtyEl.oninput=recalc; itemEl.onchange=recalc; document.getElementById('wi-dir').onchange=recalc; recalc();
      saveBtn.onclick=async()=>{
        const err=document.getElementById('wi-err'); err.textContent='';
        const fail=(m)=>{ err.textContent=m; toast(m,'err'); }; // K-21: любой отказ виден тостом, не только в модалке
        const it=curItem(); const V=(id)=>{const el=document.getElementById(id);return el?el.value.trim():'';};
        const body={ itemId:itemEl.value, qty:Number(V('wi-qty')), object:V('wi-object'), direction:V('wi-dir'), date:V('wi-date'), basis:V('wi-basis'), batch:V('wi-batch'), note:V('wi-note') };
        if(!body.object){ fail('ГЕЙТ 2 (§4.3): укажите объект отнесения.'); return; }
        if(!(body.qty>0)){ fail('Укажите положительное количество.'); return; }
        saveBtn.disabled=true; saveBtn.textContent='Проведение…';
        try{ const r=await fetch('/api/warehouse/issue',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(body)});
          const j=await r.json().catch(()=>({})); if(!r.ok||j.error)throw new Error(j.error||('HTTP '+r.status));
          if(j.warning) toast(j.warning,'info');
          toast(`Расход проведён: ${j.code}${j.direction?' · '+j.direction:''} · остаток ${whQty(j.balance)}`,'ok');
          whCardCache={}; WH=null; whSelCode=(it&&it.code)||whSelCode; closeModal(); renderWarehouse(document.getElementById('view'));
        }catch(e){ err.textContent=e.message; toast('Расход отклонён: '+e.message,'err'); saveBtn.disabled=false; saveBtn.textContent='Провести расход'; }
      };
    }

    // ── Экран 4а: инвентаризация Ф.3–СХ (§4.5) — факт → авто-расхождение → НП (ДП-У.2) ──
    async function whInvBody(host){
      host.innerHTML='<div class="card pad" style="color:var(--sub)">Загрузка описи Ф.3–СХ…</div>';
      let inv; try{ inv=await (await fetch('/api/warehouse/inventory')).json(); }catch(e){ inv={mode:'mock',lines:[],warning:String(e.message||e)}; }
      const lines=inv.lines||[];
      if(!lines.length){ host.innerHTML='<div class="card pad" style="color:var(--sub);text-align:center;padding:26px">Опись Ф.3–СХ пуста — нет учётных остатков.<br>'+((WH&&WH.mode==='live')?'Проведите приход, чтобы появились позиции.':'Раздел заполнится после APPLY (таблицы Склада).')+'</div>'; return; }
      const rows=lines.map((l,i)=>`<tr>
          <td class="code" style="color:#334155">${esc(l.code1c||l.code||'—')}</td>
          <td>${esc(l.name||'')}</td>
          <td style="text-align:right">${whQty(l.accounting,l.unit)}</td>
          <td style="text-align:right;width:130px"><input data-fact="${i}" data-code="${esc(l.code)}" type="number" step="any" style="width:110px;font:inherit;font-size:12.5px;padding:5px 7px;border:1px solid #cfd8e3;border-radius:2px;text-align:right" placeholder="${Number(l.accounting)||0}"></td>
          <td data-diff="${i}" style="text-align:right" class="c-gray">—</td>
        </tr>`).join('');
      host.innerHTML=`<div class="card pad">
          <div style="display:flex;gap:12px;align-items:flex-end;flex-wrap:wrap;margin-bottom:12px">
            <div>${FLAB('Дата описи')}<input id="wv-date" type="date" value="${whYmd()}" style="${FINP};width:170px"></div>
            <div>${FLAB('МОЛ')}<input id="wv-mol" style="${FINP};width:220px" placeholder="Ф.И.О."></div>
            <div>${FLAB('Комиссия (чел.)')}<input id="wv-com" type="number" min="0" style="${FINP};width:120px" value="3"></div>
            <button class="tbtn primary" id="wv-calc" style="margin-left:auto">Рассчитать расхождение</button>
          </div>
          <div class="tbl-wrap"><table class="dt"><thead><tr><th>Код 1С</th><th>Наименование</th><th style="text-align:right">Учётный</th><th style="text-align:right">Факт</th><th style="text-align:right">Расхожд.</th></tr></thead><tbody>${rows}</tbody></table></div>
          <div id="wv-result" style="margin-top:12px"></div>
          <div style="font-size:11px;color:#5b6b7a;margin-top:8px">Расхождение = учётный − факт (§4.5). При ≠ 0 — маршрут в ДП-У.2 (несоответствия).</div>
        </div>`;
      const calc=host.querySelector('#wv-calc');
      calc.onclick=async()=>{
        if(!WH||WH.mode!=='live'){ toast('Инвентаризация доступна только в LIVE-режиме.','err'); return; }
        const facts=[...host.querySelectorAll('[data-fact]')].map(el=>({code:el.dataset.code, fact:el.value===''?Number(lines[+el.dataset.fact].accounting)||0:Number(el.value)}));
        calc.disabled=true; calc.textContent='Расчёт…';
        try{ const body={ date:host.querySelector('#wv-date').value, mol:host.querySelector('#wv-mol').value, commission:Number(host.querySelector('#wv-com').value)||0, lines:facts };
          const r=await fetch('/api/warehouse/inventory',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(body)});
          const j=await r.json().catch(()=>({})); if(!r.ok||j.error)throw new Error(j.error||('HTTP '+r.status));
          (j.lines||[]).forEach((ln,i)=>{ const cell=host.querySelector(`[data-diff="${i}"]`); if(cell){ cell.textContent=(ln.diff>0?'+':'')+whQty(ln.diff); cell.className=ln.diff===0?'c-green':'c-red'; cell.style.textAlign='right'; } });
          const disc=j.discrepancies||[];
          host.querySelector('#wv-result').innerHTML=disc.length?disc.map(d=>`<div style="display:flex;align-items:center;gap:10px;padding:8px 11px;border:1px solid #fecaca;background:#fef2f2;border-radius:3px;margin-bottom:8px">
              <span style="font-size:12.5px;color:#334155"><b>Расхождение ${(d.diff>0?'+':'')+whQty(d.diff)} по ${esc(d.code1c||d.code)}</b> → завести несоответствие (ДП-У.2)</span>
              <button class="tbtn amber" data-np="${esc(d.code)}" style="margin-left:auto">Создать НП →</button>
            </div>`).join(''):'<div style="font-size:12.5px;color:var(--green)">Расхождений нет — опись сходится.</div>';
          host.querySelectorAll('[data-np]').forEach(el=>el.onclick=()=>toast('Черновик НП (ДП-У.2) по '+el.dataset.np+' подготовлен. Авто-создание НП — следующий этап (TODO).','info'));
          toast(j.hasDiscrepancy?`Опись рассчитана: расхождений ${disc.length}`:'Опись рассчитана: расхождений нет','ok');
        }catch(e){ toast('Инвентаризация: '+e.message,'err'); }
        calc.disabled=false; calc.textContent='Рассчитать расхождение';
      };
    }

    // ── Экран 4б: отчёт Ф.4–СХ (§4.7–4.8) — свод расхода по направлениям + выгрузка ──
    async function whF4Body(host){
      const from=(host.querySelector('#wf-from')||{}).value||whMonthStart();
      const to=(host.querySelector('#wf-to')||{}).value||whYmd();
      host.innerHTML='<div class="card pad" style="color:var(--sub)">Сбор Ф.4–СХ…</div>';
      let rep; try{ rep=await (await fetch(`/api/warehouse/report/f4?from=${from}&to=${to}`)).json(); }catch(e){ rep={mode:'mock',byDirection:[],total:{amount:0,count:0},warning:String(e.message||e)}; }
      const bd=rep.byDirection||[], tot=rep.total||{amount:0,count:0};
      const rows=bd.length?bd.map(d=>`<tr><td>${esc(d.direction)}</td><td style="text-align:right">${kpMoney(d.amount)} ₽</td><td style="text-align:right">${d.count}</td></tr>`).join('')
        :'<tr><td colspan="3" style="padding:14px;color:#5b6b7a;text-align:center">Расхода за период нет.</td></tr>';
      host.innerHTML=`<div class="card pad">
          <div style="display:flex;gap:12px;align-items:flex-end;flex-wrap:wrap;margin-bottom:12px">
            <div>${FLAB('Период с')}<input id="wf-from" type="date" value="${from}" style="${FINP};width:170px"></div>
            <div>${FLAB('по')}<input id="wf-to" type="date" value="${to}" style="${FINP};width:170px"></div>
            <button class="tbtn" id="wf-apply">Пересобрать</button>
            <button class="tbtn primary" id="wf-export" style="margin-left:auto">Выгрузка Ф.4–СХ ↧ (CSV для бухгалтерии)</button>
          </div>
          <div style="font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.06em;color:var(--sub);margin-bottom:8px">Свод расхода по направлениям (§4.7–4.8)</div>
          <div class="tbl-wrap"><table class="dt"><thead><tr><th>Направление</th><th style="text-align:right">Сумма расхода</th><th style="text-align:right">Проводок</th></tr></thead>
            <tbody>${rows}<tr><td style="font-weight:700;color:var(--navy)">Итого за период</td><td style="text-align:right;font-weight:800;color:var(--navy)">${kpMoney(tot.amount)} ₽</td><td style="text-align:right;font-weight:700">${tot.count}</td></tr></tbody></table></div>
          <div style="font-size:11px;color:#5b6b7a;margin-top:8px">До 5-го раб. дня → списание в 1С. Ключ сопоставления — <b>код 1С</b>. Ручной мост (Стадия A, §5.1); API-обмен — отдельный проект.</div>
        </div>`;
      const ap=host.querySelector('#wf-apply'); if(ap)ap.onclick=()=>whF4Body(host);
      const ex=host.querySelector('#wf-export'); if(ex)ex.onclick=()=>{
        const detail=rep.detail||[];
        if(!detail.length){ toast('Нет данных для выгрузки за период.','err'); return; }
        const head=['Дата','Код позиции','Направление','Объект отнесения','Кол-во','Сумма, руб.','Основание'];
        const csv=[head.join(';')].concat(detail.map(d=>[d.date,d.code,d.direction,d.object,d.qty,d.amount,String(d.basis||'').replace(/;/g,',')].join(';'))).join('\r\n');
        const blob=new Blob(['﻿'+csv],{type:'text/csv;charset=utf-8'}); const u=URL.createObjectURL(blob);
        const a=document.createElement('a'); a.href=u; a.download=`Ф.4-СХ_${from}_${to}.csv`; a.click(); URL.revokeObjectURL(u);
        toast('Ф.4–СХ выгружен (CSV) — ручной мост в 1С по коду 1С.','ok');
      };
    }

    // ══════════════════════════════════════════════════════════════════════════
    //  Раздел «Каталог (номенклатура)» — K-54 MVP (канон + алиасы + история цен).
    //  Бэкенд: /api/catalog/*. Forward-tolerant: нет таблиц → пусто (до APPLY).
    //  Стиль/компоненты 1:1 с разделом «Склад» (master-detail, erpGrid, модалки).
    // ══════════════════════════════════════════════════════════════════════════
    let CAT=null, catSelId=null, catFilter='all', catCardCache={};
    const catRub=(n)=>(n==null||n==='')?'—':Number(n).toLocaleString('ru-RU',{maximumFractionDigits:2})+' ₽';
    const catRange=(i)=>{ if(!i.priceCount) return '<span class="c-gray">нет цен</span>';
      if(i.priceMin==null) return `<span class="c-gray">${i.priceCount} зап.</span>`;
      const u=i.unit?('/'+esc(i.unit)):'';
      return (i.priceMin===i.priceMax)?`<b>${catRub(i.priceMin)}${u}</b>`:`<b>${catRub(i.priceMin)}</b> – <b>${catRub(i.priceMax)}</b>${u}`; };
    const catYmd=()=>new Date().toISOString().slice(0,10);

    async function renderCatalog(host,arg){
      host.innerHTML='<div class="card pad" style="color:var(--sub)">Загрузка раздела «Каталог»…</div>';
      if(!CAT){ try{CAT=await (await fetch('/api/catalog')).json();}catch(e){CAT={mode:'mock',warning:String(e.message||e),items:[],kpis:{}};} }
      if(arg){ const it=(CAT.items||[]).find(i=>String(i.id)===String(arg)); if(it)catSelId=it.id; }
      const live=CAT.mode==='live';
      const k=CAT.kpis||{};
      const tag=srcChip(live, live?((CAT.items||[]).length+' канон-позиций'):'таблицы Каталога ещё не заведены (APPLY migrate-032)');
      const m=(lbl,num,col,sub)=>`<div class="m"><div class="lbl">${lbl}</div><div class="num"${col?` style="color:${col}"`:''}>${num}</div>${sub?`<div style="font-size:10.5px;color:var(--sub);margin-top:1px">${sub}</div>`:''}</div>`;
      host.innerHTML=`<div class="mstrip">
          ${m('Канон-позиций',k.canon??0,'var(--navy)','одна карточка на изделие')}
          ${m('Алиасов (синонимов)',k.aliases??0,'var(--ink)','«как называют» → канон')}
          ${m('Записей истории цен',k.prices??0,'var(--ink)','цены сведены НА КАНОН')}
          ${m('Без алиасов',k.noAlias??0,(k.noAlias?'var(--amber)':'var(--ink)'),'нужен ручной merge')}
        </div>
        <div class="filters" style="margin-top:var(--gap)">
          <div class="seg" id="cat-filter">
            <button data-fl="all" class="${catFilter==='all'?'on':''}">Все</button>
            <button data-fl="noalias" class="${catFilter==='noalias'?'on':''}">Без алиасов</button>
            <button data-fl="noprice" class="${catFilter==='noprice'?'on':''}">Без цен</button>
          </div>
          <button class="tbtn primary" id="cat-add"${live?'':' disabled title="нет таблиц каталога — сначала APPLY migrate-032" style="opacity:.5;cursor:not-allowed"'}>+ Канон-позиция</button>
          <span class="spacer" style="margin-left:auto"></span>${tag}</div>
        <div class="split wide" style="margin-top:var(--gap)">
          <div id="catgrid"></div>
          <div class="detail" id="catdetail"></div>
        </div>`;
      host.querySelectorAll('#cat-filter button').forEach(b=>b.onclick=()=>{catFilter=b.dataset.fl;
        host.querySelectorAll('#cat-filter button').forEach(x=>x.classList.toggle('on',x.dataset.fl===catFilter)); catGrid();});
      const ab=host.querySelector('#cat-add'); if(ab&&live)ab.onclick=()=>openCatCanon(null);
      catGrid();
    }
    function catGrid(){
      const gh=document.getElementById('catgrid'); if(!gh)return;
      const items=(CAT&&CAT.items)||[]; const live=CAT&&CAT.mode==='live';
      let rows=items.slice();
      if(catFilter==='noalias')rows=rows.filter(i=>!i.aliasCount);
      else if(catFilter==='noprice')rows=rows.filter(i=>!i.priceCount);
      if(!rows.length){ gh.innerHTML='<div class="card pad" style="color:var(--sub);font-size:13px">'+(live?'Нет позиций по фильтру. Добавьте канон-позицию кнопкой «+ Канон-позиция».':'Раздел «Каталог» ещё не наполнен (таблицы появятся после APPLY migrate-032).')+'</div>'; catShowDetail(null); return; }
      if(catSelId==null||!rows.some(r=>String(r.id)===String(catSelId))) catSelId=rows[0].id;
      const cols=[
        {key:'name',label:'Каноническое наименование',cls:'ell',cell:i=>`<span title="${esc(i.name||'')}" style="font-weight:600;color:var(--ink)">${esc(i.name||'—')}</span>`,sortVal:i=>i.name},
        {key:'category',label:'Категория',w:120,cls:'nw c-gray',cell:i=>esc(i.category||'—'),sortVal:i=>i.category},
        {key:'grade',label:'Марка / материал',w:130,cls:'nw c-gray',cell:i=>esc(i.grade||'—'),sortVal:i=>i.grade},
        {key:'size',label:'Типоразмер',w:120,cls:'nw c-gray',cell:i=>esc(i.size||'—'),sortVal:i=>i.size},
        {key:'unit',label:'Баз. ед',w:70,cls:'nw c-gray',cell:i=>esc(i.unit||'—'),sortVal:i=>i.unit},
        {key:'aliasCount',label:'Алиасы',w:74,align:'right',cls:'nw',cell:i=>i.aliasCount?`<b>${i.aliasCount}</b>`:'<span class="c-amber">0</span>',sortVal:i=>i.aliasCount},
        {key:'range',label:'Разброс цен (₽/ед)',w:190,align:'right',cls:'nw',cell:catRange,sortVal:i=>i.priceMin==null?-1:i.priceMin},
      ];
      erpGrid(gh,{key:'cat-items',cols,rows,rowKey:i=>String(i.id),selKey:String(catSelId),
        onRow:i=>{ catSelId=i.id; try{history.replaceState(null,'','#catalog/'+encodeURIComponent(i.id));}catch{} catShowDetail(i.id); },
        onEnter:i=>{ catSelId=i.id; catShowDetail(i.id); },
        del:live?{key:'catalog_canon',idOf:(r)=>r.id,reload:()=>{catCardCache={};CAT=null;renderCatalog(document.getElementById('view'));}}:undefined,
        info:`${srcChip(live)}<span>Позиций: <b style="color:var(--ink)">${rows.length}</b></span><span class="c-gray">клик / ↑↓ — карточка</span>`});
      catShowDetail(catSelId);
    }
    async function catShowDetail(id){
      const host=document.getElementById('catdetail'); if(!host)return;
      if(id==null){ host.innerHTML='<div class="card pad" style="color:var(--sub)">Выберите канон-позицию слева.</div>'; return; }
      host.innerHTML='<div class="card pad" style="color:var(--sub)">Загрузка карточки канона…</div>';
      let card=catCardCache[id];
      if(!card){ try{ card=await (await fetch('/api/catalog/item?id='+encodeURIComponent(id))).json(); catCardCache[id]=card; }catch(e){ card={mode:'mock',warning:String(e.message||e)}; } }
      if(String(catSelId)!==String(id)) return; // устарело
      if(!card||!card.item){ host.innerHTML='<div class="card pad" style="color:var(--sub)">Карточка недоступна (нет данных).</div>'; return; }
      const it=card.item, st=card.priceStats||{}, live=(CAT&&CAT.mode==='live');
