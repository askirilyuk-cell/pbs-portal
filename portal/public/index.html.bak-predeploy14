      host.innerHTML=`<div class="filters"><span style="font-size:12.5px;color:var(--sub)">Принятые ЗнЗ на металл — подтвердите факт. вес, сертификат и ячейку → приходная проводка</span><span style="margin-left:auto"></span>${srcChip(live)}</div>
