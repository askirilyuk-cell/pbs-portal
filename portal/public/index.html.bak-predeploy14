    const RBAC_API_PREFIX=[['/api/board','board'],['/api/station','station'],['/api/orders','orders'],['/api/control','control'],['/api/routes','routes'],['/api/route','routes'],['/api/task','board'],['/api/equipment','equipment'],['/api/tools','tools'],['/api/metal','metal'],['/api/warehouse','warehouse'],['/api/sales','sales'],['/api/lov','lov'],['/api/counterpart','counterparties'],['/api/procurement','purchase'],['/api/catalog','catalog'],['/api/design','design'],['/api/docs','docs'],['/api/settings','settings']];
    function rbacApiSection(u){ try{ const p=new URL(u,location.origin).pathname; for(const[pre,sec]of RBAC_API_PREFIX)if(p===pre||p.startsWith(pre+'/')||p.startsWith(pre+'.'))return sec; }catch{} return null; }
