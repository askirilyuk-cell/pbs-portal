    /* Адаптивный журнал движения (общий рендер jTable): широкий контейнер — таблица;
       узкий (drawer/панель) — стопка строк-карточек с подписями, без обрезки заголовков и без гор. скролла. */
    .jtbl-wrap{overflow-x:auto;container-type:inline-size;}
    @container (max-width:560px){
      .jtbl-wrap{overflow-x:visible;}
      table.dt.jtbl,table.dt.jtbl thead,table.dt.jtbl tbody,table.dt.jtbl tr,table.dt.jtbl td{display:block;width:auto;}
      table.dt.jtbl thead{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap;border:0;}
