      const sg=document.getElementById('kp-signer'); if(sg)sg.innerHTML=`${t.subtotal>=kpn(d.threshold)?'ГД':'ДпП'} <span style="font-weight:400;color:#5b6b7a">(порог ${kpMoney(d.threshold)} ₽)</span>`; }
    function kpPositionsBody(){ return kpState.rows.map(r=>({ id:r.id||'', posNum:r.posNum, name:r.name, line:r.line, lineCode:r.lineCode||'', unit:r.unit, qty:r.qty, bmArea:r.bmArea, bmThickness:r.bmThickness, bmMaterial:r.bmMaterial, materials:r.materials, labor:r.labor, energy:r.energy, overhead:r.overhead, profitPct:r.profitPct, priceUnit:r.priceUnit, note:r.note })); }
    async function kpReload(){ try{ const d=await (await fetch('/api/sales/kp?zp='+encodeURIComponent(kpState.zp))).json(); if(!d.error){ kpState.d=d; kpState.rows=(d.items||[]).map(it=>({...it})); kpState.locked=!(d.gates&&d.gates.kp); drawKp(); } }catch{} }
    async function kpSave(silent){
      const sv=document.getElementById('kpSave'); if(sv){sv.disabled=true;}
      let r; try{ r=await fetch('/api/sales/kp/save',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({zp:kpState.zp,positions:kpPositionsBody()})}); }
      catch(e){ if(sv)sv.disabled=false; if(!silent)toast('Сеть: '+e.message,'err'); throw e; }
      const j=await r.json(); if(sv)sv.disabled=false;
      if(!r.ok){ if(!silent)toast('Не удалось сохранить КП: '+(j.error||r.status),'err'); throw new Error(j.error||'save'); }
      if(!silent){ toast(`КП сохранено: ${j.saved} поз. (${j.created} нов. · ${j.updated} изм. · ${j.deleted} удал.)`,'ok'); kpState.d=j; kpState.rows=(j.items||[]).map(it=>({...it})); kpState.locked=!(j.gates&&j.gates.kp); drawKp(); }
      return j;
    }
    async function kpSend(confirmSign){
      if(!confirmSign){ try{ await kpSave(true); }catch{ return; } }   // отправка читает сохранённые позиции — сначала фиксируем
      const sn=document.getElementById('kpSend'); if(sn)sn.disabled=true;
      let r; try{ r=await fetch('/api/sales/kp/send',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({zp:kpState.zp,confirmSign:!!confirmSign})}); }
      catch(e){ if(sn)sn.disabled=false; return toast('Сеть: '+e.message,'err'); }
      const j=await r.json(); if(sn)sn.disabled=false;
      if(r.status===409){ // Гейт 2 §5.3.5 — требуется подпись по порогу
        if(confirm(`${j.error}\n\nПодтвердить подписание (${j.signer}) и отправить КП заказчику?`)) return kpSend(true);
        return;
      }
      if(!r.ok){ return toast('Не удалось отправить КП: '+(j.error||r.status),'err'); }
      toast(`КП ${j.numKp} отправлено · ${kpMoney(j.subtotal)} ₽ без НДС · подпись ${j.signer} · действ. до ${esc(j.validUntil)}`,'ok');
      SALES=null; await kpReload();
    }
