          manufacturer:V('eqf-manufacturer'), serialNo:V('eqf-serialNo'), yearMade:V('eqf-yearMade'), status:V('eqf-status'),
          maintClass:V('eqf-maintClass'), responsible:V('eqf-responsible'), location:V('eqf-location'), powerKw:V('eqf-powerKw'),
