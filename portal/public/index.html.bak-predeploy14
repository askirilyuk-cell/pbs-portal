    // ── Форма операции (динамические поля под операцию, живой превью) ──
    function openMetalMove(preItem,preOp){
      if(!MT||MT.mode!=='live'){ toast('Операции доступны только в LIVE-режиме (нужен токен NocoDB в «Настройках»).','err'); return; }
      const items=(MT.items||[]); if(!items.length){ toast('Нет позиций. Сначала заведите позицию металла.','err'); return; }
      let cur=preItem&&typeof preItem==='object'?preItem:items.find(i=>i.code===preItem)||items[0];
      const G='display:grid;grid-template-columns:repeat(12,1fr);gap:12px';
      const ops=(MT.dict&&MT.dict.ops)||MT_OPS;
      const itemOpts=items.map(i=>`<option value="${esc(String(i.id))}"${i.id===cur.id?' selected':''}>${esc(i.code)} · ${esc(i.grade)}${i.rollType?' '+esc(i.rollType):''}${i.size?' '+esc(i.size):''} · ост. ${mtNum(i.balance)} кг</option>`).join('');
      const opOpts=ops.map(o=>`<option${o===(preOp&&ops.includes(preOp)?preOp:ops[0])?' selected':''}>${o}</option>`).join('');
      modal.style.width='min(740px,96vw)';
      modal.innerHTML=`<div class="mh"><b>Движение металла</b><span class="op">приход / расход / списание / инвентаризация / резерв</span><button class="x" id="mx" aria-label="Закрыть">✕</button></div>
        <div class="mb" style="gap:0">
          <div style="${G}">
            <div style="grid-column:span 8">${FLAB('Позиция',true)}<select id="mm-item" style="${FINP}">${itemOpts}</select></div>
            <div style="grid-column:span 4">${FLAB('Операция',true)}<select id="mm-op" style="${FINP}">${opOpts}</select></div>
          </div>
          <div id="mm-fields" style="${G};margin-top:12px"></div>
          <div id="mm-soft" style="display:none;margin-top:11px;font-size:12px;border-radius:2px;padding:8px 10px"></div>
          <div id="mm-err" style="margin-top:12px;color:#b91c1c;font-size:12.5px"></div>
          <div style="margin-top:14px;padding-top:13px;border-top:1px solid #e2e8f0;display:flex;align-items:center;gap:10px">
            <span style="font-size:12px;color:#5b6b7a"><span style="color:#b91c1c">*</span> — обязательное поле · учёт в кг</span>
            <div style="margin-left:auto;display:flex;gap:10px">
              <button class="tbtn" id="mm-cancel" style="padding:9px 18px">Отмена</button>
              <button class="tbtn primary" id="mm-save" style="padding:9px 18px">Провести</button>
            </div>
          </div>
        </div>`;
      modal.classList.add('open'); mscrim.classList.add('open');
      document.getElementById('mx').onclick=closeModal; document.getElementById('mm-cancel').onclick=closeModal;
      const itemEl=document.getElementById('mm-item'), opEl=document.getElementById('mm-op');
      const curItem=()=>items.find(i=>String(i.id)===itemEl.value);
      const qtyLbl=(op)=>op==='Инвентаризация'?'Факт. остаток, кг':'Кол-во, кг';
      function buildFields(){
        const op=opEl.value, it=curItem();
        const heat=op==='Приход'?`<div style="grid-column:span 6">${FLAB('№ сертификата / плавки',true)}<input id="mm-heat" style="${FINP}" placeholder="прослеживаемость плавки"></div>`:'';
        const supp=op==='Приход'?`<div style="grid-column:span 6">${FLAB('Поставщик')}<input id="mm-supplier" style="${FINP}"></div>
            <div style="grid-column:span 6">${FLAB('№ счёта')}<input id="mm-invoice" style="${FINP}"></div>`:'';
        const pz=(op==='Расход'||op==='Резерв')?`<div style="grid-column:span 6">${FLAB('№ ПЗ / позиция')}<input id="mm-pzline" style="${FINP}" placeholder="ПЗ-2026-001 · поз.3"></div>`:'';
        const part=op==='Расход'?`<div style="grid-column:span 6">${FLAB('Деталь')}<input id="mm-part" style="${FINP}" placeholder="что изготавливаем"></div>`:'';
        const fmtF=(op==='Приход'||op==='Расход')?`<div style="grid-column:span 6">${FLAB('Раскрой / формат')}<input id="mm-format" style="${FINP}" placeholder="лист 10×1500×6000 / L=3000"></div>
            <div style="grid-column:span 3">${FLAB('Кол-во ед.')}<input id="mm-units" type="number" step="any" style="${FINP}"></div>`:'';
        const reason=op==='Списание'?`<div style="grid-column:span 12">${FLAB('Причина списания',true)}<input id="mm-basis" style="${FINP}" placeholder="брак / некондиция / …"></div>`
          :`<div style="grid-column:span 12">${FLAB('Основание / комментарий')}<input id="mm-basis" style="${FINP}"></div>`;
        const remnant=op==='Расход'?`<div style="grid-column:span 12;background:#fff7ed;border:1px solid #f5d9b0;border-radius:3px;padding:9px 12px">
            <label style="display:flex;align-items:center;gap:8px;font-size:12.5px;color:#b45309;font-weight:600"><input type="checkbox" id="mm-rem"> Образовался деловой остаток (оприходовать ДО)</label>
            <div id="mm-rembox" style="display:none;${G};margin-top:9px">
              <div style="grid-column:span 3">${FLAB('Вес ДО, кг',true)}<input id="mm-remw" type="number" step="any" style="${FINP}"></div>
              <div style="grid-column:span 5">${FLAB('Размеры')}<input id="mm-rems" style="${FINP}" placeholder="Д×Ш / Ø×L"></div>
              <div style="grid-column:span 2">${FLAB('Толщина')}<input id="mm-remt" style="${FINP}"></div>
              <div style="grid-column:span 2">${FLAB('Ячейка')}<input id="mm-reml" style="${FINP}"></div>
            </div></div>`:'';
        document.getElementById('mm-fields').innerHTML=`
          <div style="grid-column:span 3">${FLAB(qtyLbl(op),true)}<input id="mm-qty" type="number" step="any" style="${FINP}"></div>
          <div style="grid-column:span 3">${FLAB('Дата')}<input id="mm-date" type="date" value="${mtYmd()}" style="${FINP}"></div>
          ${heat}${supp}${pz}${part}${fmtF}${reason}${remnant}`;
        const qe=document.getElementById('mm-qty'); if(qe)qe.oninput=recalc;
        const rem=document.getElementById('mm-rem'); if(rem)rem.onchange=()=>{const rb=document.getElementById('mm-rembox'); if(rb)rb.style.display=rem.checked?'grid':'none';};
        recalc();
      }
      function recalc(){
        const soft=document.getElementById('mm-soft'); if(!soft)return;
        const op=opEl.value, it=curItem(), q=Number((document.getElementById('mm-qty')||{}).value);
        const set=(bg,bd,col,html)=>{soft.style.display='block';soft.style.background=bg;soft.style.border='1px solid '+bd;soft.style.color=col;soft.innerHTML=html;};
        if(!it||!(op==='Инвентаризация'?q>=0:q>0)){ soft.style.display='none'; return; }
        const bal=Number(it.balance)||0, res=Number(it.reserved)||0, av=bal-res;
        if(op==='Приход')set('#f0fdf4','#bbf7d0','#15803d',`Остаток станет <b>${mtNum(bal+q)} кг</b> (было ${mtNum(bal)}).`);
        else if(op==='Расход'){ if(q>av)set('#fffbeb','#fde68a','#b45309',`Расход ${mtNum(q)} превышает доступно ${mtNum(av)} кг — будет отклонён (остаток ${mtNum(bal)}, резерв ${mtNum(res)}).`); else set('#f0fdf4','#bbf7d0','#15803d',`Остаток станет <b>${mtNum(bal-q)} кг</b>, доступно ${mtNum(av-q)} (было ${mtNum(bal)}).`); }
        else if(op==='Списание'){ if(q>bal)set('#fffbeb','#fde68a','#b45309',`Списание ${mtNum(q)} превышает остаток ${mtNum(bal)} кг — будет отклонено.`); else set('#f0fdf4','#bbf7d0','#15803d',`Остаток станет <b>${mtNum(bal-q)} кг</b> (было ${mtNum(bal)}).`); }
        else if(op==='Инвентаризация')set('#eff6ff','#cfe0f5','#1F4E79',`Остаток будет установлен в <b>${mtNum(q)} кг</b> (текущий ${mtNum(bal)}; расхождение ${mtNum(q-bal)}).`);
        else if(op==='Резерв'){ if(q>av)set('#fffbeb','#fde68a','#b45309',`Резерв ${mtNum(q)} превышает доступно ${mtNum(av)} кг — будет отклонён.`); else set('#f0fdf4','#bbf7d0','#15803d',`Резерв станет <b>${mtNum(res+q)} кг</b>, доступно ${mtNum(av-q)}.`); }
        else if(op==='Снятие резерва'){ if(q>res)set('#fffbeb','#fde68a','#b45309',`Снятие ${mtNum(q)} превышает резерв ${mtNum(res)} кг — будет отклонено.`); else set('#f0fdf4','#bbf7d0','#15803d',`Резерв станет <b>${mtNum(res-q)} кг</b>, доступно ${mtNum(av+q)}.`); }
      }
      itemEl.onchange=recalc; opEl.onchange=buildFields; buildFields();
      document.getElementById('mm-save').onclick=async()=>{
        const err=document.getElementById('mm-err'); err.textContent='';
        const fail=(mm)=>{ err.textContent=mm; toast(mm,'err'); };
        const V=(id)=>{const el=document.getElementById(id);return el?el.value.trim():'';};
        const it=curItem(), op=V('mm-op');
        const body={ itemId:itemEl.value, operation:op, date:V('mm-date')||mtYmd(), qty:Number(V('mm-qty')), basis:V('mm-basis'), author:(typeof ME!=='undefined'&&ME&&ME.name)||'' };
        if(op==='Инвентаризация'){ if(!(body.qty>=0)){ fail('Инвентаризация: укажите фактический остаток ≥ 0.'); return; } }
        else if(!(body.qty>0)){ fail('Укажите положительное количество (кг).'); return; }
        if(op==='Приход'){ body.heatNo=V('mm-heat'); body.supplier=V('mm-supplier'); body.invoiceNo=V('mm-invoice'); body.format=V('mm-format'); if(V('mm-units'))body.units=Number(V('mm-units')); if(!body.heatNo){ fail('Приход: укажите № сертификата / плавки.'); return; } }
        else if(op==='Расход'){ body.pzLine=V('mm-pzline'); body.part=V('mm-part'); body.format=V('mm-format'); if(V('mm-units'))body.units=Number(V('mm-units'));
          const bal=Number(it.balance)||0, av=bal-(Number(it.reserved)||0); if(body.qty>av){ fail('Расход превышает доступно.'); return; }
          const rem=document.getElementById('mm-rem'); if(rem&&rem.checked){ body.remnant=true; body.remnantWeight=Number(V('mm-remw')); body.remnantSizes=V('mm-rems'); body.remnantThickness=V('mm-remt'); body.remnantLocation=V('mm-reml'); if(!(body.remnantWeight>0)){ fail('Деловой остаток: укажите вес ДО (кг) > 0.'); return; } } }
        else if(op==='Списание'){ if(!body.basis){ fail('Списание: укажите причину.'); return; } }
        else if(op==='Резерв'){ body.pzLine=V('mm-pzline'); }
        const btn=document.getElementById('mm-save'); btn.disabled=true; btn.textContent='Проведение…';
        try{ const j=await postJson('/api/metal/move',body);
          toast(`${j.operation} проведена: ${j.code} · остаток ${mtNum(j.balance)} кг · доступно ${mtNum(j.available)} кг${j.remnant?' · ДО '+j.remnant.code:''}`,'ok');
          mtCardCache={}; MT=null; mtSel=(it&&it.code)||mtSel; closeModal(); renderMetal(document.getElementById('view'));
        }catch(e){ err.textContent=e.message; toast('Отклонено: '+e.message,'err'); btn.disabled=false; btn.textContent='Провести'; }
      };
    }

