            <select data-sk="edge" style="${FINP};width:auto;padding:6px 9px"><option value="-1">— сторона —</option></select>
            <span style="font-size:12.5px;color:#5b6b7a">=</span>
            <input data-sk="mm" type="number" step="any" min="0" placeholder="длина, мм" style="${FINP};width:130px;padding:6px 9px">
            <button type="button" class="tbtn primary" data-sk="setscale" style="padding:6px 12px;font-size:12px">Задать масштаб</button>
          </div>
          <div data-sk="res" style="margin-top:10px;font-size:12.5px;color:#334155;line-height:1.7"></div>
        </div>`;
      const cv=mount.querySelector('[data-sk="cv"]'), ctx=cv.getContext('2d');
      const selEdge=mount.querySelector('[data-sk="edge"]'), inpMm=mount.querySelector('[data-sk="mm"]'), resBox=mount.querySelector('[data-sk="res"]');
      let pts=[], holes=[], mode='outer', scale=0, lastWeight=null, wField=null; // scale: мм на пиксель; holes: массив вырезов
      const dist=(a,b)=>Math.hypot(a.x-b.x,a.y-b.y);
      const modeBox=mount.querySelector('[data-sk="mode"]'), btnHole=mount.querySelector('[data-sk="addhole"]');
      function edgeList(){ const n=pts.length; if(n<2)return []; const m=n>=3?n:n-1; const e=[]; for(let i=0;i<m;i++)e.push([i,(i+1)%n]); return e; }
      function areaPxOf(poly){ const n=poly.length; if(n<3)return 0; let s=0; for(let i=0;i<n;i++){const a=poly[i],b=poly[(i+1)%n];s+=a.x*b.y-b.x*a.y;} return Math.abs(s)/2; }
      function areaPx(){ return areaPxOf(pts); }
      function holesAreaPx(){ return holes.reduce((s,h)=>s+areaPxOf(h),0); }
      function updateModeLabel(){ if(!modeBox)return;
        if(mode==='hole') modeBox.innerHTML='Режим: <b style="color:#c1121f">отверстие '+holes.length+'</b> — клик ставит вершины выреза (красный контур). «+ Отверстие» — начать ещё одно.';
        else modeBox.innerHTML='Режим: <b>внешний контур</b> — клик ставит вершину; при ≥3 точках замыкается. Затем задайте масштаб и «+ Отверстие».';
        if(btnHole){ btnHole.style.background=mode==='hole'?'#c1121f':''; btnHole.style.color=mode==='hole'?'#fff':''; } }
      function pos(ev){ const r=cv.getBoundingClientRect(); return { x:(ev.clientX-r.left)*(cv.width/r.width), y:(ev.clientY-r.top)*(cv.height/r.height) }; }
      function refreshEdges(){ const cur=selEdge.value, el=edgeList(); selEdge.innerHTML='<option value="-1">— сторона —</option>'+el.map(([a,b],i)=>`<option value="${i}">Сторона ${i+1} (${a+1}→${b+1})</option>`).join(''); if(+cur>=0&&+cur<el.length)selEdge.value=cur; }
      function redraw(){
        ctx.clearRect(0,0,CW,CH);
        ctx.strokeStyle='#eef2f7'; ctx.lineWidth=1; ctx.beginPath();
        for(let x=0;x<=CW;x+=30){ctx.moveTo(x+.5,0);ctx.lineTo(x+.5,CH);} for(let y=0;y<=CH;y+=30){ctx.moveTo(0,y+.5);ctx.lineTo(CW,y+.5);} ctx.stroke();
        const n=pts.length;
        if(n>=1){ ctx.beginPath(); ctx.moveTo(pts[0].x,pts[0].y); for(let i=1;i<n;i++)ctx.lineTo(pts[i].x,pts[i].y); if(n>=3)ctx.closePath();
          if(n>=3){ ctx.fillStyle='rgba(46,117,182,.12)'; ctx.fill(); }
          ctx.strokeStyle='#2E75B6'; ctx.lineWidth=2; ctx.stroke(); }
        const sel=+selEdge.value, el=edgeList();
        if(sel>=0&&sel<el.length){ const [a,b]=el[sel]; ctx.beginPath(); ctx.moveTo(pts[a].x,pts[a].y); ctx.lineTo(pts[b].x,pts[b].y); ctx.strokeStyle='#e8871e'; ctx.lineWidth=3.5; ctx.stroke(); }
        pts.forEach((p)=>{ ctx.beginPath(); ctx.arc(p.x,p.y,4,0,7); ctx.fillStyle='#1f3a52'; ctx.fill(); });
        holes.forEach((h)=>{ const m=h.length; if(!m)return;
          ctx.beginPath(); ctx.moveTo(h[0].x,h[0].y); for(let i=1;i<m;i++)ctx.lineTo(h[i].x,h[i].y); if(m>=3)ctx.closePath();
          if(m>=3){ ctx.fillStyle='rgba(193,18,31,.14)'; ctx.fill(); }
          ctx.strokeStyle='#c1121f'; ctx.lineWidth=2; ctx.setLineDash(m>=3?[]:[5,4]); ctx.stroke(); ctx.setLineDash([]);
          h.forEach(p=>{ ctx.beginPath(); ctx.arc(p.x,p.y,3.5,0,7); ctx.fillStyle='#c1121f'; ctx.fill(); }); });
        if(scale>0){ ctx.font='11px system-ui,Segoe UI,sans-serif'; ctx.textAlign='center'; ctx.textBaseline='middle';
          el.forEach(([a,b])=>{ const mx=(pts[a].x+pts[b].x)/2, my=(pts[a].y+pts[b].y)/2, t=Math.round(dist(pts[a],pts[b])*scale)+' мм', w=ctx.measureText(t).width+6;
            ctx.fillStyle='rgba(255,255,255,.85)'; ctx.fillRect(mx-w/2,my-8,w,16); ctx.fillStyle='#0b3d5c'; ctx.fillText(t,mx,my); }); }
      }
      function recompute(){
        const n=pts.length;
        if(n<3){ resBox.innerHTML='<span style="color:#5b6b7a">Поставьте ≥3 вершин, затем задайте масштаб по стороне.</span>'; lastWeight=null; return; }
        if(!(scale>0)){ resBox.innerHTML='<span style="color:#5b6b7a">Контур готов ('+n+' вершин). Выберите сторону и задайте её реальную длину в мм.</span>'; lastWeight=null; return; }
        const oMm2=areaPx()*scale*scale, hMm2=holesAreaPx()*scale*scale, netMm2=Math.max(0,oMm2-hMm2);
        const oCm2=oMm2/100, hCm2=hMm2/100, netCm2=netMm2/100, netM2=netMm2/1e6;
        const nHoles=holes.filter(h=>h.length>=3).length;
        const th=getThickness(), {d:dens,def}=steelDensity(getGrade());
        let wHtml='';
        if(th>0){ const kg=netM2*(th/1000)*dens; lastWeight=kg;
          wHtml=`Толщина <b>${(''+th).replace('.',',')}</b> мм · Плотность <b>${dens}</b> кг/м³${def?' <span style="color:#94a3b8">(дефолт)</span>':''}<br><span style="font-size:14px">Расчётный вес: <b style="color:#0b7a2f">${kg.toFixed(2).replace('.',',')} кг</b></span> <button type="button" class="tbtn" data-sk="apply" style="padding:3px 10px;font-size:11.5px">Подставить в «Вес»</button>`;
          if(wField)wField.value=(Math.round(kg*1000)/1000);
        } else { lastWeight=null; wHtml='<span style="color:#b45309">укажите толщину в поле «Толщина» для расчёта веса</span>'; }
        const holesLine=nHoles?`Отверстий: <b>${nHoles}</b> · площадь вырезов: <b style="color:#c1121f">−${hCm2.toFixed(1).replace('.',',')} см²</b><br>`:'';
        resBox.innerHTML=`Площадь внешняя: <b>${oCm2.toFixed(1).replace('.',',')} см²</b><br>${holesLine}Чистая площадь: <b>${netCm2.toFixed(1).replace('.',',')} см²</b> (${netM2.toFixed(4).replace('.',',')} м²)<br>`+wHtml;
        const ab=resBox.querySelector('[data-sk="apply"]'); if(ab)ab.onclick=()=>{ if(wField&&lastWeight!=null){ wField.value=(Math.round(lastWeight*1000)/1000); toast('Вес подставлен: '+lastWeight.toFixed(2)+' кг','ok'); } };
      }
      cv.addEventListener('click',ev=>{ const p=pos(ev);
        if(mode==='hole'){ if(!holes.length)holes.push([]); holes[holes.length-1].push(p); }
        else { pts.push(p); refreshEdges(); }
        redraw(); recompute(); });
      mount.querySelector('[data-sk="undo"]').onclick=()=>{
        if(mode==='hole'&&holes.length){ const h=holes[holes.length-1]; if(h.length)h.pop(); else { holes.pop(); if(!holes.length)mode='outer'; } }
        else pts.pop();
        refreshEdges(); updateModeLabel(); redraw(); recompute(); };
      btnHole.onclick=()=>{ if(pts.length<3){ toast('Сначала задайте внешний контур (≥3 вершин).','err'); return; }
        if(!holes.length||holes[holes.length-1].length>0)holes.push([]); mode='hole'; updateModeLabel(); redraw(); };
      mount.querySelector('[data-sk="delhole"]').onclick=()=>{ if(!holes.length){ toast('Отверстий нет.','err'); return; } holes.pop(); if(!holes.length)mode='outer'; updateModeLabel(); redraw(); recompute(); };
      mount.querySelector('[data-sk="clear"]').onclick=()=>{ pts=[]; holes=[]; mode='outer'; scale=0; inpMm.value=''; refreshEdges(); updateModeLabel(); redraw(); recompute(); };
      selEdge.onchange=()=>redraw();
      mount.querySelector('[data-sk="setscale"]').onclick=()=>{ const ei=+selEdge.value, el=edgeList(), mm=parseFloat(String(inpMm.value).replace(',','.'));
        if(ei<0||ei>=el.length){ toast('Выберите сторону для масштаба.','err'); return; }
        if(!(mm>0)){ toast('Введите реальную длину стороны в мм.','err'); return; }
        const [a,b]=el[ei], px=dist(pts[a],pts[b]); if(!(px>0)){ toast('Нулевая длина стороны.','err'); return; }
        scale=mm/px; redraw(); recompute(); };
      updateModeLabel(); redraw(); recompute();
      return {
        hasDrawing:()=>pts.length>=3, weight:()=>lastWeight, recompute,
        bindWeightField:(el)=>{ wField=el; },
        file:(code)=>{ if(pts.length<3)return null; const b=atob(cv.toDataURL('image/png').split(',')[1]), u=new Uint8Array(b.length); for(let i=0;i<b.length;i++)u[i]=b.charCodeAt(i); const blob=new Blob([u],{type:'image/png'}), name='эскиз-'+(code||'ДО')+'.png'; try{return new File([blob],name,{type:'image/png'});}catch(e){ blob.name=name; return blob; } }
      };
    }
    // Быстрый калькулятор веса делового остатка (без рисования): форма+размеры+марка(плотность) → площадь/вес.
    // Переиспользует steelDensity(). Лист: Д×Ш×t; Круг: π/4·d²·L; Труба: π/4·(D²−(D−2s)²)·L. Размеры в мм → м.
    function mtRemnCalc(mount, getGrade, weightField, rollSel){
      if(!mount)return;
      mount.innerHTML=`<div style="border:1px solid #cfe0f5;background:#f6fbff;border-radius:4px;padding:9px 11px">
        <div style="font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.04em;color:#2b6cb0;margin-bottom:8px">Быстрый расчёт веса (без рисования)</div>
        <div style="display:flex;flex-wrap:wrap;gap:8px;align-items:flex-end">
          <div><div style="font-size:11px;color:#5b6b7a">Форма</div><select id="mc-shape" style="${FINP};width:auto;padding:6px 9px"><option value="sheet">Лист Д×Ш</option><option value="round">Круг ⌀</option><option value="tube">Труба ⌀×стенка</option></select></div>
          <div id="mc-f1"></div><div id="mc-f2"></div><div id="mc-f3"></div>
          <button type="button" class="tbtn primary" id="mc-calc" style="padding:6px 12px;font-size:12px">Посчитать</button>
        </div>
        <div id="mc-res" style="margin-top:9px;font-size:12.5px;color:#334155;line-height:1.6"></div>
      </div>`;
      const $=(id)=>mount.querySelector('#'+id);
      let lastKg=null;
      const numIn=(id,ph)=>`<div style="font-size:11px;color:#5b6b7a">${ph}</div><input id="${id}" type="number" step="any" min="0" style="${FINP};width:96px;padding:6px 9px">`;
      function fields(){ const sh=$('mc-shape').value;
        if(sh==='sheet'){ $('mc-f1').innerHTML=numIn('mc-a','Длина, мм'); $('mc-f2').innerHTML=numIn('mc-b','Ширина, мм'); $('mc-f3').innerHTML=numIn('mc-t','Толщина, мм'); }
        else if(sh==='round'){ $('mc-f1').innerHTML=numIn('mc-d','⌀, мм'); $('mc-f2').innerHTML=numIn('mc-l','Длина, мм'); $('mc-f3').innerHTML=''; }
        else { $('mc-f1').innerHTML=numIn('mc-d','⌀ нар., мм'); $('mc-f2').innerHTML=numIn('mc-wall','Стенка, мм'); $('mc-f3').innerHTML=numIn('mc-l','Длина, мм'); } }
      const val=(id)=>{ const el=$(id); return el?(parseFloat(String(el.value).replace(',','.'))||0):0; };
      function calc(){ const sh=$('mc-shape').value, g=(getGrade&&getGrade())||'', dd=steelDensity(g), dens=dd.d, def=dd.def;
        let volM3=0, note='';
        if(sh==='sheet'){ const a=val('mc-a')/1000,b=val('mc-b')/1000,t=val('mc-t')/1000; const areaM2=a*b; volM3=areaM2*t; note='Площадь листа: <b>'+areaM2.toFixed(4).replace('.',',')+' м²</b>'; }
        else if(sh==='round'){ const d=val('mc-d')/1000,l=val('mc-l')/1000; const sec=Math.PI/4*d*d; volM3=sec*l; note='Сечение: <b>'+(sec*1e4).toFixed(2).replace('.',',')+' см²</b> · длина '+val('mc-l')+' мм'; }
        else { const D=val('mc-d')/1000,w=val('mc-wall')/1000,l=val('mc-l')/1000; const di=Math.max(0,D-2*w); const sec=Math.PI/4*(D*D-di*di); volM3=sec*l; note='Сечение стенки: <b>'+(sec*1e4).toFixed(2).replace('.',',')+' см²</b> · длина '+val('mc-l')+' мм'; }
        if(!(volM3>0)){ $('mc-res').innerHTML='<span style="color:#5b6b7a">Заполните размеры (мм).</span>'; lastKg=null; return; }
        const kg=volM3*dens; lastKg=kg;
        $('mc-res').innerHTML=note+'<br>Плотность <b>'+dens+'</b> кг/м³'+(def?' <span style="color:#94a3b8">(дефолт)</span>':'')+' · <span style="font-size:14px">вес: <b style="color:#0b7a2f">'+kg.toFixed(2).replace('.',',')+' кг</b></span> <button type="button" class="tbtn" id="mc-apply" style="padding:3px 10px;font-size:11.5px">Подставить в «Вес»</button>';
        const ab=$('mc-apply'); if(ab)ab.onclick=()=>{ if(weightField&&lastKg!=null){ weightField.value=Math.round(lastKg*1000)/1000; toast('Вес подставлен: '+lastKg.toFixed(2)+' кг','ok'); } }; }
      $('mc-shape').onchange=()=>{ fields(); $('mc-res').innerHTML=''; };
      $('mc-calc').onclick=calc;
      if(rollSel){ const rv=rollSel.value; $('mc-shape').value=(rv==='Круг')?'round':(rv==='Труба')?'tube':'sheet'; }
      fields();
    }
    function openMetalRemnant(){
