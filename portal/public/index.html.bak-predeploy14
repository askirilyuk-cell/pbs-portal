            <div class="meta" style="gap:8px;flex-wrap:wrap">${e.model?`<span class="c-gray" style="font-size:11px">${esc(e.model)}</span>`:''}${e.taskCount?`<span class="c-blue" style="font-size:11px">${e.taskCount} задач</span>`:''}</div>
          </div>`;}).join('');
        return head+rows;
      }).join('');
      el.innerHTML=html;
      el.querySelectorAll('[data-sec]').forEach(x=>x.onclick=()=>{ const k=x.dataset.sec; eqOpenSec=(String(eqOpenSec)===k)?'__none__':k; eqPaintTree(); });
      el.querySelectorAll('[data-eq]').forEach(x=>x.onclick=()=>{ eqSelId=x.dataset.eq;
        try{history.replaceState(null,'','#equipment/'+encodeURIComponent(eqSelId));}catch{}
        el.querySelectorAll('.li[data-eq]').forEach(y=>y.classList.toggle('on',y.dataset.eq===String(eqSelId)));
        eqShowDetail(eqSelId); });
      if(!eqSelId||!(EQ.items||[]).some(i=>String(i.id)===String(eqSelId))) eqSelId=firstId;
      el.querySelectorAll('.li[data-eq]').forEach(y=>y.classList.toggle('on',y.dataset.eq===String(eqSelId)));
