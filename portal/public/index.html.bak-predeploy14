        if(ws)body.wonPartSum=ws.value; if(wn)body.wonPartNote=wn.value; }
      let r; try{ r=await fetch('/api/sales/kp/result',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(body)}); }
      catch(e){ return toast('Сеть: '+e.message,'err'); }
      const j=await r.json();
      if(!r.ok){ return toast('Не удалось зафиксировать результат: '+(j.error||r.status),'err'); }
      toast(result?`Результат КП: ${esc(result)}${j.orderGate?' · заказ (ЗКЗ) доступен':''}`:'Результат КП снят','ok');
      SALES=null; kpState.d.kpResult=result;
      if(result==='Выиграли частично'){ kpState.d.wonPartSum=body.wonPartSum??''; kpState.d.wonPartNote=body.wonPartNote??''; }
