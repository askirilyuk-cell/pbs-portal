        opHint(el);
        return el;
      };
      const addOp=(o)=>{ const el=opBlock(o); opsBox.appendChild(el); renumber(); return el; };
      (init.operations&&init.operations.length?init.operations:[{}]).forEach(addOp);
      document.getElementById('rb-addop').onclick=()=>addOp({});
      document.getElementById('rb-save').onclick=async()=>{
        const errEl=document.getElementById('rb-err'); errEl.textContent='';
        const gv=(id)=>document.getElementById(id).value.trim();
        const operations=[...opsBox.querySelectorAll('[data-op]')].map(el=>{
          const g=(f)=>{const x=el.querySelector(`[data-of="${f}"]`);return x?x.value.trim():'';};
          const components=[...el.querySelectorAll('[data-crow]')].map(tr=>{const c=(f)=>{const x=tr.querySelector(`[data-cf="${f}"]`);return x?x.value.trim():'';};return {name:c('name'),qty:c('qty'),src:c('src')};}).filter(c=>c.name);
          return {opTypeId:g('opTypeId'),name:g('name'),equipment:g('equipment'),control:g('control'),norm:g('norm'),whatControl:g('whatControl'),si:g('si'),tolerance:g('tolerance'),materials:g('materials'),components};
        }).filter(o=>o.name||o.opTypeId);
