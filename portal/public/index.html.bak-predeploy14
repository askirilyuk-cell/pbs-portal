          <div style="font-size:12.5px;color:#334155">${esc(cur.c||'—')}</div></div>`;
      }).join('');
      const verdHtml=can
        ? `<div style="display:flex;border:1px solid var(--line);border-radius:2px;overflow:hidden;width:max-content">${['Выполнимо','Невыполнимо'].map(v=>`<span class="lov-vseg${c.verdict===v?' on':''}" data-v="${v}" style="font-size:13px;font-weight:600;padding:8px 18px;cursor:pointer;border-left:1px solid var(--line)">${v}</span>`).join('')}</div>`
        : (c.verdict?stCellDot(c.verdict==='Выполнимо'?'green':'red',c.verdict):'<span class="c-gray" style="font-size:12.5px">вердикт не вынесен</span>');
      modal.style.width='720px';
      modal.innerHTML=`<div class="mh"><b>${esc(c.numLov)}</b><span class="op">${esc(c.customer||'')}</span>
          <span style="margin-left:auto;display:flex;gap:8px;align-items:center">${c.verdict?stCellDot(c.verdict==='Выполнимо'?'green':'red',c.verdict):stCellDot(LOV_ST_DOT[c.status]||'gray',c.status||'')}<button class="x" id="lov-x" aria-label="Закрыть">✕</button></span></div>
        <div class="mb" style="max-height:80vh;overflow:auto">
          <div style="display:flex;align-items:center;gap:14px;flex-wrap:wrap;margin-bottom:12px">
