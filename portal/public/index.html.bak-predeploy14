      setT('kp-cost-'+i,kpMoney(c.cost)+' ₽'); setT('kp-sum-'+i,kpMoney(c.lineSum)+' ₽');
      const pc=document.querySelector(`[data-pc="${i}"] input[data-f="priceUnit"]`); if(pc)pc.placeholder='авто '+kpMoney(c.priceAuto); }
    function kpRecalcTotals(){ const d=kpState.d, t=kpCalcTotals(kpState.rows,d.defProfitPct,d.vatRate);
      const set=(id,v)=>{const e=document.getElementById(id);if(e)e.textContent=v;};
