          MT=null; mtCardCache={}; closeModal(); renderMetal(document.getElementById('view'));
        }catch(e){ err.textContent=e.message; toast('Не оприходовано: '+e.message,'err'); btn.disabled=false; btn.textContent='Оприходовать'; }
      };
    }

    // ── Вкладка «Приёмка» (очередь принятых ЗнЗ на металл → оприходование) ──
    async function mtIntakeBody(host){
