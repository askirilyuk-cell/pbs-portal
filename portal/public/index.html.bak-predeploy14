        try{ const r=await fetch('/api/records/delete',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({key:CTL_KEY[f],ids})});
          const j=await r.json().catch(()=>({})); if(!r.ok||j.error)throw new Error(j.error||('HTTP '+r.status));
