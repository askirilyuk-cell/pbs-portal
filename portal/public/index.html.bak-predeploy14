            <div id="mr-sketch-hint" style="display:none;font-size:11.5px;color:#b45309;margin-top:6px"></div>
            <div id="mr-photo" style="margin-top:8px"></div>
            <div id="mr-sketch" style="margin-top:8px;display:none"></div>
          </div>
        </div>
        <div id="mr-err" style="margin-top:12px;color:#b91c1c;font-size:12.5px"></div>
        <div style="margin-top:14px;padding-top:13px;border-top:1px solid #e2e8f0;display:flex;gap:10px;justify-content:flex-end">
          <button class="tbtn" id="mr-cancel" style="padding:9px 18px">Отмена</button>
          <button class="tbtn green" id="mr-save" style="padding:9px 18px">Оприходовать</button>
        </div></div>`;
      modal.classList.add('open'); mscrim.classList.add('open');
      // фото/эскиз ДО — штатный drag-and-drop виджет портала (как в КД/Продажах), с превью-миниатюрами
      const remPhotoDz=fileDropzone(document.getElementById('mr-photo'),{accept:'image/*,.pdf',thumbs:true,note:'Перетащите фото сюда или нажмите для выбора · image/*, PDF — можно несколько'});
      // эскиз-инструмент (альтернатива фото): контур листового обрезка → площадь/вес; толщину/марку берём из полей формы ДО
      const sketch=metalSketchTool(document.getElementById('mr-sketch'),
        ()=>{ const v=parseFloat(String(document.getElementById('mr-t').value||'').replace(',','.')); return v>0?v:0; },
        ()=>document.getElementById('mr-grade').value);
      sketch.bindWeightField(document.getElementById('mr-w'));
      // быстрый калькулятор веса (без рисования): форма+размеры+марка(плотность) → площадь/вес → в «Вес»
      mtRemnCalc(document.getElementById('mr-calcwrap'), ()=>document.getElementById('mr-grade').value, document.getElementById('mr-w'), document.getElementById('mr-roll'));
      // переключатель «Фото | Эскиз»; эскиз доступен ВСЕГДА (обнаруживаемость); для не-листа — подсказка
      (function(){ const seg=document.getElementById('mr-io'), ph=document.getElementById('mr-photo'), sk=document.getElementById('mr-sketch'), hint=document.getElementById('mr-sketch-hint');
        const spans=[...seg.querySelectorAll('span')], skSpan=spans.find(s=>s.dataset.v==='Эскиз');
        function refreshHint(){ const isSheet=(document.getElementById('mr-roll').value==='Лист'), onSk=skSpan&&skSpan.classList.contains('on');
          if(hint){ hint.textContent='Эскиз рассчитывает площадь для листового проката; для круга/трубы используйте «Быстрый расчёт веса» выше.'; hint.style.display=(onSk&&!isSheet)?'':'none'; } }
        function selectSeg(s){ spans.forEach(x=>{x.classList.remove('on');x.style.background='';x.style.color='#5b6b7a';}); s.classList.add('on'); s.style.background='var(--navy)'; s.style.color='#fff';
          const em=s.dataset.v==='Эскиз'; ph.style.display=em?'none':''; sk.style.display=em?'':'none'; if(em)sketch.recompute(); refreshHint(); }
