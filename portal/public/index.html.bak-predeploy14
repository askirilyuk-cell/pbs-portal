    const supplyChip=(s)=>`<span class="badge ${SUPPLY_B[s]||'b-gray'}">${esc(s||'—')}</span>`;
    const moneyVal=(s)=>parseFloat(String(s||'').replace(/[^\d]/g,''))||0;

    // неблокирующее уведомление — замена alert() в потоке продаж (alert вешает вкладку/браузер)
    function toast(msg,kind){
      let host=document.getElementById('pbs-toasts');
      if(!host){host=document.createElement('div');host.id='pbs-toasts';host.style.cssText='position:fixed;right:16px;bottom:16px;z-index:9999;display:flex;flex-direction:column;gap:8px;max-width:min(420px,92vw)';document.body.appendChild(host);}
      const t=document.createElement('div');
      const bg=kind==='err'?'#fef2f2':(kind==='ok'?'#f0faf4':'#eff6ff'), bd=kind==='err'?'#fecaca':(kind==='ok'?'#c4ead2':'#cfe0f5'), fg=kind==='err'?'#b91c1c':(kind==='ok'?'#15803d':'#1e40af');
      t.style.cssText=`background:${bg};border:1px solid ${bd};color:${fg};border-radius:3px;padding:10px 13px;font-size:13px;line-height:1.35;box-shadow:0 4px 14px rgba(15,23,42,.12);cursor:pointer`;
      t.textContent=msg; t.onclick=()=>t.remove(); host.appendChild(t);
      setTimeout(()=>{t.style.transition='opacity .3s';t.style.opacity='0';setTimeout(()=>t.remove(),300);},kind==='err'?6000:3500);
    }
    // создание заказа (ЗКЗ) из принятого запроса — реальная запись в NocoDB (D4)
    async function createZkzFromReq(z){
      const ob=modal.querySelector('[data-act="order"]'); if(ob){ob.disabled=true;ob.textContent='Создание…';}
      try{
        const r=await fetch('/api/sales/order/create',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({zp:z.numZp})});
        const j=await r.json(); if(!r.ok)throw new Error(j.error||'ошибка');
        toast('Заказ создан: '+j.numZkz,'ok');
        closeModal(); SALES=null; renderSales(document.getElementById('view'));
      }catch(e){ toast('Не удалось создать заказ (ЗКЗ): '+e.message,'err'); if(ob){ob.disabled=false;ob.textContent='Создать заказ (ЗКЗ) →';} }
    }

    async function renderSales(host,openZp){
      host.innerHTML='<div class="card pad" style="color:var(--gray)">Загрузка раздела «Продажи»…</div>';
      if(!SALES){ try{SALES=await (await fetch('/api/sales')).json();}catch(e){SALES={mode:'mock',warning:String(e.message||e),requests:[],orders:[]};} }
      const S=SALES;
      // deep-link #sales/<№ЗП> → открыть карточку запроса
      if(openZp){ const z=(S.requests||[]).find(r=>r.numZp===openZp); if(z){ salesTab='req'; salesSelZp=openZp; salesFilter=null; } }   // deep-link → выбрать в реестре (master-detail)
      const tag=srcChip(S.mode==='live', S.mode==='live'?((S.requests||[]).length+' ЗП'):'демо-сид ЗП-2026');
      host.innerHTML=`<div class="filters">
          <div class="seg" id="sseg">
            <button data-t="req" class="${salesTab==='req'?'on':''}">Запросы (ЗП)</button>
            <button data-t="ord" class="${salesTab==='ord'?'on':''}">Заказы (ЗКЗ)</button>
          </div><span class="spacer" style="margin-left:auto"></span>${tag}</div>
        <div id="sbody" style="margin-top:var(--gap)"></div>`;
      host.querySelectorAll('#sseg button').forEach(b=>b.onclick=()=>{salesTab=b.dataset.t;
        host.querySelectorAll('#sseg button').forEach(x=>x.classList.toggle('on',x.dataset.t===salesTab)); salesBody();});
      salesBody();
    }
    function salesBody(){const h=document.getElementById('sbody');if(!h)return; salesTab==='ord'?salesOrd(h):salesReq(h);}

    // K-05: реестр запросов ЗП — дашборд KPI + воронка по состояниям K-06 + master-detail (список слева, карточка справа, без модалки)
    function salesReq(host){
      const all=(SALES&&SALES.requests)||[];
      // ── бакеты воронки (5 активных состояний K-06 + 2 терминала) ──
      const B=[['new','Новый','gray'],['lov','На оценке (ЛОВ)','navy'],['prep','КП готовится','blue'],['sent','КП отправлено','amber'],['won','Согласовано / Выиграли','green']];
      const T=[['rej','Отклонён / проигран','red'],['closed','Закрыт без сделки','gray']];
      const cnt={}; [...B,...T].forEach(([k])=>cnt[k]=0);
      all.forEach(r=>{cnt[zpBucket(r.status)]=(cnt[zpBucket(r.status)]||0)+1;});
      const CB={gray:'#9ca3af',navy:'var(--navy)',blue:'var(--blue)',amber:'var(--amber)',green:'var(--green)',red:'var(--red)'};
      // ── KPI дашборда ──
      const nWon=cnt.won, conv=all.length?Math.round(nWon/all.length*100):0;
      const sumWork=all.filter(r=>['prep','sent'].includes(zpBucket(r.status))).reduce((s,r)=>s+moneyVal(r.sumKp),0);
      const stale=all.filter(r=>zpBucket(r.status)==='sent'&&r.kpStale).length;
      const m=(lbl,num,col,sub,subcol)=>`<div class="m"><div class="lbl">${lbl}</div><div class="num"${col?` style="color:${col}"`:''}>${num}</div>${sub?`<div style="font-size:10.5px;color:${subcol||'var(--red)'};margin-top:1px">${sub}</div>`:''}</div>`;
      const funnel=B.map(([k,lbl,c])=>`<div class="fseg${salesFilter===k?' on':''}" data-f="${k}"><div class="fn"${c!=='gray'?` style="color:${CB[c]}"`:''}>${cnt[k]}</div><div class="fl"><i style="background:${CB[c]}"></i>${esc(lbl)}</div></div>`).join('');
      const terms=T.map(([k,lbl,c])=>`<b class="c-${c}${salesFilter===k?' on':''}" data-f="${k}">${esc(lbl)} · ${cnt[k]}</b>`).join('<span style="color:#cbd5e1">·</span>');
      host.innerHTML=`<div class="mstrip">
          ${m('Сумма КП в работе',sumWork?kpMoney(sumWork)+' ₽':'—','var(--ink)')}
          ${m('Конверсия ЗП→ЗКЗ',conv+'%','var(--green)')}
          ${m('КП без ответа &gt;10 дн.',stale,stale?'var(--red)':'var(--ink)',stale?'SLA §5.3.8':'')}
          ${m('Активных запросов',cnt.new+cnt.lov+cnt.prep+cnt.sent,'var(--navy)')}
        </div>
        <div class="funnel" style="margin-top:var(--gap)">${funnel}</div>
        <div class="fterm">Терминалы (вне воронки): ${terms}<span style="margin-left:auto;color:#5b6b7a">клик по сегменту → фильтр реестра${salesFilter?` · <a href="#" data-f="" style="color:var(--blue)">сбросить</a>`:''}</span></div>
        <div class="split wide" style="margin-top:var(--gap)">
          <div id="sgrid"></div>
          <div class="detail" id="sdetail"></div>
        </div>`;
      // воронка/терминалы → фильтр реестра (повторный клик по активному сегменту снимает фильтр)
      host.querySelectorAll('[data-f]').forEach(el=>el.onclick=(e)=>{ e.preventDefault(); const k=el.dataset.f||null; salesFilter=(k&&salesFilter===k)?null:k; salesReq(host); });
      salesGrid();
    }
    // K-42: «Ответ до» (SLA §5.3.8) — дата КП + 10 дней; просрочка = kpStale (считает server).
    function zpReplyParse(r){ if(!r.kp||!r.kp.date)return null; const mm=/^(\d{2})\.(\d{2})\.(\d{4})/.exec(r.kp.date); if(!mm)return null; const d=new Date(+mm[3],+mm[2]-1,+mm[1]); d.setDate(d.getDate()+10); return d; }
    function zpReplyDue(r){ const d=zpReplyParse(r);
      if(r.kpStale){ const n=d?Math.max(1,Math.floor((Date.now()-d.getTime())/864e5)):0; return `<span class="c-red" style="font-weight:600">просрочен${n?' '+n+' дн.':''}</span>`; }
      if(!d) return '<span class="c-gray">—</span>';
      return `<span class="c-gray">${String(d.getDate()).padStart(2,'0')}.${String(d.getMonth()+1).padStart(2,'0')}</span>`; }
    // K-42: реестр ЗП — единая таблица через erpGrid (сорт/поиск/колонки/удаление) + master-detail справа (#sdetail).
    function salesGrid(){
      const gh=document.getElementById('sgrid'); if(!gh)return;
      const all=(SALES&&SALES.requests)||[];
      let rows=all.slice();
      if(salesFilter) rows=rows.filter(r=>zpBucket(r.status)===salesFilter);
      rows.sort((a,b)=>String(b.numZp).localeCompare(String(a.numZp),'ru'));   // по умолчанию № ЗП ↓
      if(!rows.length){ gh.innerHTML='<div class="card pad" style="color:var(--sub);font-size:13px">Нет запросов по фильтру.</div>'; salesShowDetail(null); return; }
      if(!salesSelZp||!rows.some(r=>r.numZp===salesSelZp)) salesSelZp=rows[0].numZp;
      const live=SALES&&SALES.mode==='live';
      const cols=[
        {key:'numZp',label:'№ ЗП',w:118,cls:'code',cell:r=>esc(r.numZp),sortVal:r=>r.numZp},
        {key:'customer',label:'Заказчик',cls:'ell',cell:r=>`<span title="${esc(r.customer||'')}">${esc(r.customer||'—')}</span>`,sortVal:r=>r.customer},
        {key:'product',label:'Изделие',cls:'ell',cell:r=>`<span title="${esc(r.name||'')}">${esc(r.name||'—')}</span>`,sortVal:r=>r.name},
        {key:'sumKp',label:'Сумма КП',w:126,align:'right',cls:'nw',cell:r=>{const n=moneyVal(r.sumKp);return n?kpMoney(n)+' ₽':'<span class="c-gray">—</span>';},sortVal:r=>moneyVal(r.sumKp)},
        {key:'owner',label:'Ответственный',w:148,cls:'nw',cell:r=>r.owner?esc(r.owner):'<span class="c-gray">не назначен</span>',sortVal:r=>r.owner},
        {key:'replyDue',label:'Ответ до',w:120,cls:'nw',cell:zpReplyDue,sortVal:r=>{const d=zpReplyParse(r);return d?d.getTime():8e15;}},
        {key:'status',label:'Статус',w:150,cls:'nw',cell:r=>zpCell(r.status)+((zpBucket(r.status)==='sent'&&!(r.kp&&r.kp.status))?` <span title="Укажите результат КП" style="margin-left:6px;font-size:10px;font-weight:700;color:#b45309;background:#fffbeb;border:1px solid #fde68a;border-radius:8px;padding:1px 6px">!</span>`:''),sortVal:r=>r.status},
      ];
      erpGrid(gh,{key:'sales-req',cols,rows,rowKey:r=>r.numZp,selKey:salesSelZp,
        onRow:r=>{ salesSelZp=r.numZp; try{history.replaceState(null,'','#sales/'+encodeURIComponent(r.numZp));}catch{} salesShowDetail(r.numZp); },
        onEnter:r=>openReqCard(r),
        del:live?{key:'sales_requests',idOf:r=>r.id,reload:()=>{salesSelZp=null;SALES=null;renderSales(document.getElementById('view'));}}:undefined,
        info:`${srcChip(live)}<span>Запросов: <b style="color:var(--ink)">${rows.length}</b></span><span class="c-gray">клик / ↑↓ — деталь · Enter — карточка</span>`,
        toolbar:[{label:'+ Новый запрос',cls:'primary',onClick:()=>openCreateRequest()},{label:'Реестр (PDF)',onClick:()=>window.open('/api/sales/registry.pdf','_blank','noopener')}]});
      salesShowDetail(salesSelZp);
    }
    // правая колонка: карточка ЗП вместо модалки — переиспользует reqCardBody/wireReqCard
    function salesShowDetail(numZp){
      const host=document.getElementById('sdetail'); if(!host)return;
      const z=numZp?((SALES&&SALES.requests)||[]).find(r=>r.numZp===numZp):null;
      if(!z){ host.innerHTML='<div class="card pad" style="color:var(--sub)">Выберите запрос слева.</div>'; return; }
      const canDel=SALES&&SALES.mode==='live';
      host.innerHTML=`<div class="card pad" style="display:flex;align-items:center;gap:10px;flex-wrap:wrap">
          <span class="code" style="font-size:18px;color:var(--navy);font-weight:700">${esc(z.numZp)}</span>${zpCell(z.status)}
          <span style="font-size:12.5px;color:var(--sub)">${esc(z.customer||'')}</span>
        </div>${reqCardBody(z)}${canDel?`<div class="card pad" style="display:flex;align-items:center;gap:10px;border-color:#f3d6d6">
          <span style="font-size:12px;color:var(--sub)">Опасная зона · действие необратимо</span>
          <button class="tbtn" data-act="del" style="margin-left:auto;color:var(--red);border-color:#f3c9c9">Удалить запрос</button>
        </div>`:''}`;
      wireReqCard(z,host);
      const db=host.querySelector('[data-act="del"]'); if(db)db.onclick=()=>delSalesReq(z);
    }
    async function delSalesReq(z){
      if(!confirm(`Удалить запрос ${z.numZp}? Действие необратимо.`))return;
      try{ const r=await fetch('/api/records/delete',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({key:'sales_requests',ids:[z.id]})});
        const j=await r.json().catch(()=>({})); if(!r.ok||j.error)throw new Error(j.error||('HTTP '+r.status));
        toast('Запрос удалён: '+z.numZp,'ok'); salesSelZp=null; SALES=null; renderSales(document.getElementById('view'));
      }catch(e){ toast('Не удалось удалить: '+e.message,'err'); }
    }

    function salesOrd(host){
      const os=(SALES&&SALES.orders)||[];
      const cols=[
        {key:'zkz',label:'№ ЗКЗ',w:128,cls:'code',cell:o=>esc(o.numZkz),sortVal:o=>o.numZkz},
        {key:'type',label:'Тип',w:150,cls:'nw c-gray',cell:o=>esc(o.type||'—'),sortVal:o=>o.type},
        {key:'cust',label:'Заказчик',cls:'ell',cell:o=>`<span title="${esc(o.customer)}">${esc(o.customer)}</span>`,sortVal:o=>o.customer},
        {key:'prod',label:'Продукция / работы',cls:'ell',cell:o=>`<span title="${esc(o.product)}">${esc(o.product)}</span>`,sortVal:o=>o.product},
        {key:'sum',label:'Сумма',w:116,align:'right',cls:'nw',cell:o=>o.sum?esc(o.sum):'<span class="c-gray">—</span>',sortVal:o=>moneyVal(o.sum)},
        {key:'pay',label:'Оплата',w:158,cls:'nw',cell:o=>payCell(o.payStatus),sortVal:o=>o.payStatus},
        {key:'plan',label:'План срок',w:112,cls:'nw',cell:o=>esc(o.planDate||'—'),sortVal:o=>String(o.planDate||'')},
        {key:'stage',label:'Текущий этап',w:152,cls:'nw c-gray',cell:o=>esc(o.stage||'—'),sortVal:o=>o.stage},
        {key:'status',label:'Статус',w:140,cls:'nw',cell:o=>zkzCell(o.status),sortVal:o=>o.status},
      ];
      erpGrid(host,{key:'sales-ord',cols,rows:os,onRow:openOrderCardSales,
        del:SALES.mode==='live'?{key:'sales_orders',idOf:o=>o.id,reload:()=>{SALES=null;renderSales(document.getElementById('view'));}}:undefined,
        info:`${srcChip(SALES.mode==='live')}<span>Заказов: <b style="color:var(--ink)">${os.length}</b></span><span class="c-gray">агрегатный статус — из позиций</span>`,
        toolbar:[{label:'+ Новый заказ',cls:'primary',onClick:()=>toast('Заказ (ЗКЗ) создаётся из принятого запроса: вкладка «Запросы» → карточка ЗП → «Создать заказ (ЗКЗ)».','info')}]});
    }

    // --- создание запроса продаж ЗП из портала (форма Ф.1–З.1, этап регистрации) ---
    const ZP_TYPES=['Производство','Производство (ОПИ, образец)','Поставка','Услуги (металлообработка)','Торговое посредничество','ВЭД','Проектирование/Разработка','Нестандартный'];
    // ось A — характер сделки (фолбэк, если справочник недоступен); ВЭД — отдельный флаг
    const ZP_NATURE=['Производство','Изготовление по чертежу заказчика','Поставка','Торговое посредничество','Услуги'];
    const ZP_LINES=['Л1 — Оснастка обсадных колонн','Л2 — Биметалл / Наплавка','Л3 — ЗИП для ПВО','Л4 — Услуги металлообработки','Л5 — Поставки и логистика'];
    const ZP_SOURCES=['Email','Мессенджер','Телефон','Сайт','Тендер','Партнёр (Ендейвер/ЮПБ)','Повторный заказ'];
    const ZP_UNITS=['шт','т','поз.','компл.','кг','м'];
    // элементы ERP-формы (эталон redesign-modal-newrequest): подпись + контрол, радиус 2px
    const FLAB=(t,req)=>`<label style="font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.04em;color:#5b6b7a;margin-bottom:5px;display:block">${esc(t)}${req?' <span style="color:#b91c1c">*</span>':''}</label>`;
    const FINP='font:inherit;font-size:13.5px;color:#1f3a52;padding:9px 11px;border:1px solid #cfd8e3;border-radius:2px;background:#fff;width:100%';
    const fSelect=(id,arr,def,blank)=>`<select id="${id}" style="${FINP}">${blank?`<option value="">${esc(blank)}</option>`:''}${arr.map(o=>`<option${o===def?' selected':''}>${esc(o)}</option>`).join('')}</select>`;
    const fSeg=(id,opts,def)=>`<div class="seg" id="${id}" style="display:flex;border:1px solid #cfd8e3;border-radius:2px;overflow:hidden">${opts.map((o,i)=>`<span data-v="${esc(o)}" class="${o===def?'on':''}" style="flex:1;text-align:center;font-size:12.5px;font-weight:600;padding:9px 6px;cursor:pointer;${i?'border-left:1px solid #cfd8e3;':''}${o===def?'background:var(--navy);color:#fff;':'color:#5b6b7a;'}">${esc(o)}</span>`).join('')}</div>`;
    // продуктовая классификация (ось B, ДП–Д.1.2): каскад «группа → подгруппа», можно несколько строк.
    // Значение — массив кодов «ГР:ПОДГР» (или «ГР» для всей группы). Пусто = не классифицировано.
    // groups:[{code,name}], subgroups:[{code,name,group,outside?}] (outside = вне утв. Прил.А).
    function multiClassPicker(mount, groups, subgroups){
      groups=groups||[]; subgroups=subgroups||[];
      const gName={}; groups.forEach(g=>gName[g.code]=g.name);
      const subsByGroup={}; groups.forEach(g=>subsByGroup[g.code]=[]);
      subgroups.forEach(s=>{ (subsByGroup[s.group]=subsByGroup[s.group]||[]).push(s); });
      const outside=new Set(subgroups.filter(s=>s.outside).map(s=>`${s.group}:${s.code}`));
      const avail=groups.length>0;
      let rows=[]; // [{g,s}]  s='' => вся группа
      mount.innerHTML=`<div data-pp>
        <div data-rows style="display:flex;flex-direction:column;gap:8px"></div>
        <button type="button" data-add ${avail?'':'disabled'} style="margin-top:8px;font:inherit;font-size:12.5px;font-weight:600;color:var(--navy);background:#eef4fb;border:1px solid #cfe0f5;border-radius:2px;padding:7px 12px;cursor:${avail?'pointer':'not-allowed'}">+ Добавить продукт</button>
        <div data-warn style="display:none;margin-top:7px;font-size:11.5px;color:#b45309;background:#fff8ef;border:1px solid #f3dcc0;border-radius:2px;padding:7px 9px"></div>
        <div data-hint style="font-size:11px;color:#5b6b7a;margin-top:5px"></div></div>`;
      const rowsEl=mount.querySelector('[data-rows]'), addBtn=mount.querySelector('[data-add]'),
        warnEl=mount.querySelector('[data-warn]'), hintEl=mount.querySelector('[data-hint]');
      function render(){
        rowsEl.innerHTML=rows.map((r,i)=>{
          const gopts=groups.map(g=>`<option value="${esc(g.code)}"${g.code===r.g?' selected':''}>${esc(g.name)} (${esc(g.code)})</option>`).join('');
          const subs=subsByGroup[r.g]||[];
          const sopts=`<option value="">— вся группа —</option>`+subs.map(s=>`<option value="${esc(s.code)}"${s.code===r.s?' selected':''}>${s.outside?'⚠ ':''}${esc(s.name)} (${esc(s.code)})</option>`).join('');
          return `<div data-row="${i}" style="display:grid;grid-template-columns:1fr 1fr 34px;gap:8px;align-items:center">
            <select data-g style="${FINP}">${gopts}</select>
            <select data-s style="${FINP}"${subs.length?'':' disabled'}>${sopts}</select>
            <button type="button" data-del title="Удалить" style="font:inherit;font-size:15px;line-height:1;color:#7d93ab;background:#f3f6fa;border:1px solid #d8e0ea;border-radius:2px;height:38px;cursor:pointer">✕</button></div>`;
        }).join('');
        rowsEl.querySelectorAll('[data-row]').forEach(el=>{ const i=+el.dataset.row;
          el.querySelector('[data-g]').onchange=(e)=>{ rows[i].g=e.target.value; rows[i].s=''; render(); };
          el.querySelector('[data-s]').onchange=(e)=>{ rows[i].s=e.target.value; render(); };
          el.querySelector('[data-del]').onclick=()=>{ rows.splice(i,1); render(); };
        });
        const flagged=rows.filter(r=>r.s&&outside.has(`${r.g}:${r.s}`)).map(r=>{const s=(subsByGroup[r.g]||[]).find(x=>x.code===r.s);return s?`${s.name} (${s.code})`:r.s;});
