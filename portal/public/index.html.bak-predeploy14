        {key:'sup',label:'Поставщик',w:150,cls:'nw c-gray',cell:r=>esc(r.supplier||'—'),sortVal:r=>r.supplier},
        {key:'st',label:'Статус',w:120,cls:'nw',cell:r=>tlChip(r.status||'Принята','in'),sortVal:r=>r.status},
        {key:'act',label:'',w:134,cls:'nw',cell:r=>`<button class="tbtn green" data-intake="${esc(String(r.id))}" style="padding:3px 9px;font-size:11.5px">Оприходовать →</button>`,sortVal:r=>0},
