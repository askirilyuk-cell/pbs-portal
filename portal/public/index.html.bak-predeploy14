    // ════════════════════════════════════════════════════════════════════════
    //  РАЗДЕЛ «СКЛАД» (K-07, ДП–СХ–1.0 §4.1–4.8): номенклатура + журнал движения,
    //  дашборд KPI + сигналы на закупку, master-detail, приход (ГЕЙТ 1 · Ф.3–Д.1),
    //  расход (ГЕЙТ 2 · объект отнесения, §5.3 мягкий минус), инвентаризация Ф.3–СХ,
    //  отчёт Ф.4–СХ. Бэкенд: /api/warehouse/*. Forward-tolerant: нет таблиц → пусто.
    //  Стиль/компоненты 1:1 с разделом «Продажи» (master-detail, тосты, table.dt).
    // ════════════════════════════════════════════════════════════════════════
    let WH=null, whTab='items', whSelCode=null, whFilter='all', whCardCache={};
    const WH_DIRS=['Производство','Ремонт','Испытание','Прочее'];
    const whQty=(n,u)=>Number(n||0).toLocaleString('ru-RU',{maximumFractionDigits:3})+(u?(' '+u):'');
    const whAcceptedV=(v)=>{const s=String(v||'').trim().toUpperCase();if(!s)return false;if(s.startsWith('НЕ ГОДЕН')||s.startsWith('НЕГОДЕН'))return false;return s.startsWith('ГОДЕН')||s.includes('ПРИНЯТ');};
    // чип (нет глобального .chip — инлайн, палитра ДП–Л.1.2): kind = in/out/metal/dav/warn/gray
    const whChip=(txt,kind)=>{const c={in:['#f0fdf4','#bbf7d0','#15803d'],out:['#fef2f2','#fecaca','#b91c1c'],metal:['#eff6ff','#cfe0f5','#1F4E79'],dav:['#f0f9ff','#bae6fd','#0369a1'],warn:['#fffbeb','#fde68a','#b45309']}[kind]||['#f1f5f9','#e2e8f0','#475569'];return `<span style="font-size:11px;font-weight:600;border-radius:2px;padding:2px 8px;white-space:nowrap;color:${c[2]};background:${c[0]};border:1px solid ${c[1]}">${esc(txt)}</span>`;};
    const whYmd=()=>new Date().toISOString().slice(0,10);
    const whMonthStart=()=>{const d=new Date();return new Date(d.getFullYear(),d.getMonth(),1).toISOString().slice(0,10);};

    async function renderWarehouse(host,arg){
      host.innerHTML='<div class="card pad" style="color:var(--sub)">Загрузка раздела «Склад»…</div>';
      if(!WH){ try{WH=await (await fetch('/api/warehouse')).json();}catch(e){WH={mode:'mock',warning:String(e.message||e),items:[],kpis:{},signals:[]};} }
      if(arg){ const it=(WH.items||[]).find(i=>i.code===arg); if(it){ whTab='items'; whSelCode=arg; } }
      const live=WH.mode==='live';
      const tag=srcChip(live, live?((WH.items||[]).length+' позиций'):'таблицы Склада ещё не заведены');
      host.innerHTML=`<div class="filters">
          <div class="seg" id="wseg">
            <button data-t="items" class="${whTab==='items'?'on':''}">Номенклатура</button>
            <button data-t="inv" class="${whTab==='inv'?'on':''}">Инвентаризация (Ф.3–СХ)</button>
            <button data-t="f4" class="${whTab==='f4'?'on':''}">Отчёт Ф.4–СХ</button>
          </div><span class="spacer" style="margin-left:auto"></span>${tag}</div>
        <div id="wbody" style="margin-top:var(--gap)"></div>`;
      host.querySelectorAll('#wseg button').forEach(b=>b.onclick=()=>{whTab=b.dataset.t;
        host.querySelectorAll('#wseg button').forEach(x=>x.classList.toggle('on',x.dataset.t===whTab)); whBody();});
      whBody();
    }
    function whBody(){const h=document.getElementById('wbody');if(!h)return; whTab==='inv'?whInvBody(h):whTab==='f4'?whF4Body(h):whItemsBody(h);}

    // ── Экран 1: дашборд (KPI + сигналы) + master-detail номенклатуры ──
    function whItemsBody(host){
      const items=(WH&&WH.items)||[], kpis=(WH&&WH.kpis)||{}, signals=(WH&&WH.signals)||[];
      const m=(lbl,num,col,sub,subcol)=>`<div class="m"><div class="lbl">${lbl}</div><div class="num"${col?` style="color:${col}"`:''}>${num}</div>${sub?`<div style="font-size:10.5px;color:${subcol||'var(--sub)'};margin-top:1px">${sub}</div>`:''}</div>`;
      const kpiStrip=`<div class="mstrip">
          ${m('Позиций на складе',kpis.positions??0,'var(--navy)',(kpis.customerOwned?kpis.customerOwned+' давальч. обособл.':'собственное'),'var(--sub)')}
          ${m('Ниже мин. остатка',kpis.belowMin??0,(kpis.belowMin?'var(--red)':'var(--ink)'),(kpis.belowMin?'→ сигнал на закупку (§4.4)':''),'var(--red)')}
          ${m('Движений за период',kpis.movements??0,'var(--ink)','приход + расход по журналу','var(--sub)')}
          ${m('Истекает срок (FEFO)','—','var(--amber)','подсказки по сроку — 2-я волна (§4.6)','var(--sub)')}
        </div>`;
      const defCount=items.filter(i=>i.belowMin).length;
      const whNoIssue = !!(WH && WH.mode==='live' && !((WH.items||[]).length)); // K-21: расход недоступен на пустом складе — дизейбл с подсказкой
      // K-42: sigBlock (жёлтые карточки-сигналы) убран — дефицит теперь в таблице (фон #fef2f2 + ▼ в остатке) и как фильтр «⚠ Дефицит».
      host.innerHTML=kpiStrip+`
        <div class="filters" style="margin-top:var(--gap)">
          <div class="seg" id="w-filter">
