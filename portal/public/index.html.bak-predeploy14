    // ── ERP-таблица: поиск + сортировка + ресайз столбцов (.rz→localStorage) + скрытие столбцов («Колонки ▾»→localStorage) ──
    // cols: [{key,label,cell:(r)=>html,w?:px,align?,cls?,fixed?,sortVal?:(r)=>v}]
    // opts: {key, cols, rows, toolbar:[{label,cls,onClick}], info:html, onRow, search=true}
    function erpGrid(host, opts){
      const cols=opts.cols, rows=opts.rows, KW='erp.'+opts.key+'.w', KH='erp.'+opts.key+'.hidden';
      let W={},H={}; try{W=JSON.parse(localStorage.getItem(KW)||'{}');}catch{} try{H=JSON.parse(localStorage.getItem(KH)||'{}');}catch{}
      const st={sk:null,dir:1,q:''};
      // K-42: master-detail — выделение строки (opts.rowKey/selKey) + клавиатура (↑/↓ выбор, Enter → opts.onEnter).
      const rowKey=opts.rowKey||null; let selKey=(opts.selKey!=null)?opts.selKey:null; let lastVisible=[];
      // режим выбора+удаления: opts.del={key,idOf?,reload}. idOf по умолчанию r.id/r.Id.
      // чекбоксы мульти-выбора скрыты по умолчанию, включаются кнопкой «Выбрать» (K-10 #4).
      const DEL=opts.del, selId=DEL?(DEL.idOf||((r)=>r.id??r.Id)):null, selected=new Set();
      let selMode=false;
