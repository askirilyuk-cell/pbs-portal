    // POST/PATCH JSON: postJson(url,body) или postJson(url,'PATCH',body); кидает ошибку при !ok/error
    const postJson=async(url,a,b)=>{ let method='POST',body=a; if(typeof a==='string'){method=a;body=b;} const r=await fetch(url,{method,headers:{'Content-Type':'application/json'},body:JSON.stringify(body||{})}); const j=await r.json().catch(()=>({})); if(!r.ok||j.error)throw new Error(j.error||('HTTP '+r.status)); return j; };

    // Переиспользуемая таблица: поиск + сортировка по столбцу + resize колонок + группировка.
    // cols: [{label, cell:(row)=>html, val?:(row)=>значение для сортировки/поиска, align?, w?}]
    // opts: {search=true, groupBy:(row)=>key, groupLabel:(key,rows)=>html, onRow:(row)=>void}
    function mountTable(el, cols, rows, opts={}){
      const st={sort:-1, dir:1, q:''};
      const cellText=(c,r)=>c.val?String(c.val(r)??''):stripHtml(c.cell(r));
