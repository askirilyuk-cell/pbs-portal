    // --- рабочее место: модалка записи задачи ---------------------------------
    const modal=document.getElementById('modal'), mscrim=document.getElementById('mscrim');
    function closeModal(){modal.classList.remove('open');mscrim.classList.remove('open');modal.innerHTML='';modal.style.width='';}
