      modal.style.width='min(940px,96vw)';
      modal.innerHTML=`<div class="mh"><b>Новое производственное задание (ПЗ)</b><span class="op">Ф.1–П.2 · № присвоится автоматически</span><button class="x" id="mx" aria-label="Закрыть">✕</button></div>
        <div class="mb">
          <div class="card pad">
            <div class="sec-h" style="margin-bottom:10px">Реквизиты задания</div>
