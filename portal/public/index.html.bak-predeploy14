    // K-29: сборки свёрнуты по умолчанию — узел свёрнут, пока явно не развёрнут (false в localStorage)
    const kdIsCol=(k)=>dKdCol[k]===undefined?true:!!dKdCol[k];
    // структурный ключ: от токена подгруппы+проекта (ПР0001) до конца, без " СБ/СП" и кода по каталогу
    const structKey=(doc)=>{const s=String(doc||'').replace(/\s+\S+$/,'').replace('ПБС.','');const m=s.match(/[А-Я]{2}\d{4}/);return m?s.slice(s.indexOf(m[0])):s;};
    function buildKdTree(list){
      const nodes=list.map(k=>({...k,_key:structKey(k.docNo),_children:[]}));
      const byKey={}; nodes.forEach(n=>{if(!byKey[n._key])byKey[n._key]=n;});
      const roots=[];
      nodes.forEach(n=>{const segs=n._key.split('.');let parent=null;
        for(let i=segs.length-1;i>=1;i--){const pk=segs.slice(0,i).join('.');if(byKey[pk]&&byKey[pk]!==n){parent=byKey[pk];break;}}
        if(parent)parent._children.push(n);else roots.push(n);});
      const srt=(a,b)=>String(a.docNo).localeCompare(String(b.docNo),'ru');
      (function s(arr){arr.sort(srt);arr.forEach(n=>s(n._children));})(roots);
