    function eqFilteredGroups(){
      const q=((document.getElementById('eq-search')||{}).value||'').trim().toLowerCase();
      const groups=(EQ&&EQ.groups)||[];
      if(!q)return groups;
      const hit=(e)=>[e.invNo,e.name,e.model,e.serialNo,e.category].some(x=>String(x||'').toLowerCase().includes(q));
      return groups.map(g=>({section:g.section,equipment:(g.equipment||[]).filter(hit)})).filter(g=>g.equipment.length);
    }
    function eqPaintTree(){
      const el=document.getElementById('eqtree'); if(!el)return;
      const groups=eqFilteredGroups();
      const total=groups.reduce((s,g)=>s+(g.equipment||[]).length,0);
      if(!total){ el.innerHTML='<div style="padding:20px 14px;color:var(--sub);font-size:13px;text-align:center">'+((EQ&&EQ.mode==='live')?'Оборудование не найдено. Заведите первую единицу кнопкой «+ Новое оборудование».':'Реестр «Оборудование» ещё не наполнен (появится в LIVE-режиме).')+'</div>'; eqShowDetail(null); return; }
      // авто-раскрытие: если ничего не выбрано — раскрыть участок первой найденной единицы
      if(eqOpenSec===null){ const fg=groups.find(g=>(g.equipment||[]).length); eqOpenSec=fg?String(fg.section.id):''; }
      let firstId=null;
      const html=groups.map(g=>{
        const list=g.equipment||[]; if(!list.length)return '';
        const secKey=String(g.section.id);
        const open=String(eqOpenSec)===secKey;
        const head=`<div class="li" data-sec="${esc(secKey)}" style="background:#f7faff;cursor:pointer">
            <div class="row"><span class="c-blue">${open?'▾':'▸'}</span> <b style="color:var(--ink);font-size:12.5px">${esc(g.section.name||'—')}</b><span style="margin-left:auto;font-size:11px;color:var(--sub)">${list.length} ед.</span></div>
            ${g.section.code?`<div class="meta"><span class="c-gray" style="font-size:11px">${esc(g.section.code)}${g.section.type?' · '+esc(g.section.type):''}</span></div>`:''}</div>`;
        if(!open)return head;
        const rows=list.map(e=>{ if(firstId===null)firstId=e.id; const sel=String(e.id)===String(eqSelId);
          return `<div class="li${sel?' on':''}" data-eq="${esc(String(e.id))}" style="padding-left:22px">
            <div class="row"><span class="num" style="font-size:12px">${esc(e.invNo||'—')}</span>${e.isCnc?'<span class="src-chip" style="font-size:9.5px;padding:1px 5px;margin-left:6px;background:#eef2ff;color:#4338ca;border:1px solid #c7d2fe">ЧПУ</span>':''}<span style="margin-left:auto">${eqStCell(e.status)}</span></div>
