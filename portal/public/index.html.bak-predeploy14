      const isLocOp=(o)=>o==='Передача на участок'||o==='Возврат на склад';
      let jhead,jrows;
      if(inv){ jhead='<tr><th>Дата</th><th>Операция</th><th>Откуда</th><th>Куда</th><th>№ СФ</th><th>Комментарий</th></tr>';
        jrows=jr.length?jr.map(m=>{const oc=opChip(m.op);return `<tr><td class="nowrap">${fmt(m.date)}</td><td>${tlChip(oc[0],oc[1])}</td><td>${esc(m.from||'—')}</td><td>${esc(m.to||'—')}</td><td>${esc(m.batch||'—')}</td><td>${esc(m.basis||'—')}</td></tr>`;}).join(''):'<tr><td colspan="6" style="padding:14px;color:#5b6b7a;text-align:center">Движений по оснастке нет.</td></tr>'; }
