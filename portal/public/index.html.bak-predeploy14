        return `<div class="tcard ${cls}"><div class="st">${esc(t.sectionCode||t.section||'')}${(t.opNum!==''&&t.opNum!=null)?' · оп.'+esc(t.opNum):''}</div><div class="nm">${esc(t.title||t.op||'')}</div>${badge(t.status)}</div>`;}).join('')||'<div style="color:var(--sub)">Задач нет</div>';
      const c=DATA.controls||{};
      const vbadge=(v)=>badge(v==='ГОДЕН'?'Выполнено':v);
      const qcell=(h,arr,fld)=>{const x=(arr||[])[0];
        return `<div class="qcell"><div class="qh">${h}</div><div class="qv">${x?`<span style="color:var(--sub)">${esc(x.num)}</span><span style="margin-left:auto">${vbadge(x[fld])}</span>`:'<span style="color:var(--sub)">нет</span>'}</div></div>`;};
      const routes=(o.routes||[]).map(r=>pbtn('route',r.mk,'Ф.13 '+String(r.mk).replace('МК-',''))).join('');
      return `<div class="card pad"><div style="display:flex;align-items:center;gap:10px;flex-wrap:wrap">
          <span style="font-size:20px;font-weight:700;color:var(--navy)">${esc(o.numPz)}</span>${badge(o.status)}
          <span style="font-size:13px;color:var(--sub)">${esc(o.customer||'')}${o.orderType?' · '+esc(o.orderType):''}</span>
          <span style="margin-left:auto;display:flex;gap:8px;flex-wrap:wrap">${pbtn('pz',o.numPz,'ПЗ (Ф.1–П.2)')}${routes}</span></div></div>
        <div class="card pad nomen"><div class="sec-h" style="margin-bottom:8px">Номенклатура</div>${nomen}${genBtn}</div>
        <div class="card pad"><div class="sec-h" style="margin-bottom:10px">Задачи по участкам</div><div class="tasks">${tasks}</div></div>
        <div class="card pad"><div class="sec-h" style="margin-bottom:10px">Контроль качества</div>
          <div class="qc">${qcell('Ф.3 Входной',c.incoming,'verdict')}${qcell('Ф.4 Приёмочный',c.acceptance,'verdict')}
            <div class="qcell"><div class="qh">Ф.5 Несоответствия</div><div class="qv" style="color:var(--sub)">${(c.nonconformity&&c.nonconformity[0])?esc(c.nonconformity[0].num)+' · '+esc(c.nonconformity[0].decision||'открыто'):'нет открытых'}</div></div>
          </div></div>`;
    }
    // ══ Раздел «Учёт остатков металла» — реестр остатка (кг) + журнал + деловые остатки (migrate-035) ══
    //  Образец парадигмы — модуль «Инструмент» (renderTools): реестр + running-баланс «Остаток после»,
    //  master-detail drawer, KPI, erpGrid, forward-tolerant. Двойной показ: кг (авторитет) + ≈ мерн. ед.
    let MT=null, mtTab='items', mtSel=null, mtRoll='all', mtGrade='', mtFilter='all', mtShowZero=false, mtCardCache={}, mtGridApi=null;
