      document.getElementById('mx').onclick=closeModal;
      modal.querySelectorAll('[data-gopz]').forEach(e=>e.onclick=()=>{const pz=e.dataset.gopz;if(pz&&(DATA.orders||[]).some(o=>o.numPz===pz)){sel=pz;closeModal();location.hash='#orders';}else if(pz){alert(pz+': производственное задание появится на доске после заведения в NocoDB.');}});
      modal.querySelectorAll('[data-gozp]').forEach(e=>e.onclick=()=>{const zp=e.dataset.gozp;const r=((SALES&&SALES.requests)||[]).find(x=>x.numZp===zp);if(r){closeModal();openReqCard(r);}});
    }

    // ════════════════════════════════════════════════════════════════════════
    //  РАЗДЕЛ «ЗАКУПКИ» (ДП–К): ЗнЗ → согласование → заказ поставщику → приёмка/ВК
    //  Эталон redesign-procurement.html (#s1 дашборд, #s2 канбан, #s3 карточка,
    //  #s4 РОП, #s5 поставщик+ЛОП). Данные — /api/procurement (NocoDB).
    // ════════════════════════════════════════════════════════════════════════
    let PROC=null, procTab='dash';
    let procReqView=(()=>{try{return localStorage.getItem('pbs-proc-rv')||'kanban';}catch{return 'kanban';}})();
    const ZNZ_STATUSES=['Новая','Согласована','Поиск поставщика','Размещена','В пути','Принята','Закрыта'];
    const ZNZ_DOT={'Новая':'gray','Согласована':'amber','Поиск поставщика':'navy','Размещена':'blue','В пути':'blue','Принята':'green','Закрыта':'gray'};
    const DOTC={gray:'#9ca3af',navy:'var(--navy)',blue:'var(--blue)',amber:'var(--amber)',green:'var(--green)',red:'var(--red)'};
    const znzCell=(s)=>stCellDot(ZNZ_DOT[s]||'gray',s||'—');
    const znzKind=(r)=>/ВЭД/i.test(r.trigger||'')?'ved':(/Цехов/i.test(r.type||'')?'ceh':'plan');
    const ZNZ_TAG={plan:['b-navy','ПЛАН'],ceh:['b-amber','ЦЕХ'],ved:['b-green','ВЭД']};
    const znzTag=(r)=>{const t=ZNZ_TAG[znzKind(r)];return `<span class="badge ${t[0]}" style="font-size:9px;font-weight:700">${t[1]}</span>`;};
    const procMoney=(n)=>{if(n==null||n==='')return '';const v=Number(n);if(!isFinite(v))return '';return String(Math.round(v)).replace(/\B(?=(\d{3})+(?!\d))/g,' ')+' ₽';};
    const daysTo=(iso)=>{const m=/^(\d{4})-(\d{2})-(\d{2})/.exec(String(iso||''));if(!m)return null;const d=Date.UTC(+m[1],+m[2]-1,+m[3]);const t=new Date();const today=Date.UTC(t.getFullYear(),t.getMonth(),t.getDate());return Math.round((d-today)/86400000);};
    const znzActive=(s)=>!/Принята|Закрыта/.test(s||'');
    const znzOverdue=(r)=>znzActive(r.status)&&!!r.duePlan&&!r.dueFact&&(daysTo(r.duePlan)<0);
    const ropLetter=(s)=>(/^([ABC])/.exec(s.category||'')||[])[1]||'';
    const ropColor=(L)=>L==='A'?'green':L==='B'?'amber':L==='C'?'red':'navy';

    async function renderProcurement(host){
      host.innerHTML='<div class="card pad" style="color:var(--gray)">Загрузка раздела «Закупки»…</div>';
      if(!PROC){ try{PROC=await (await fetch('/api/procurement')).json();}catch(e){PROC={mode:'mock',warning:String(e.message||e),requests:[],orders:[],suppliers:[],evaluations:[]};} }
      const live=PROC.mode==='live';
      const tag=srcChip(live, live?((PROC.requests||[]).length+' ЗнЗ · '+(PROC.suppliers||[]).length+' пост.'):(PROC.warning||'нет данных'));
      host.innerHTML=`<div class="filters">
          <div class="seg" id="pseg">
            <button data-t="dash" class="${procTab==='dash'?'on':''}">Дашборд</button>
            <button data-t="req" class="${procTab==='req'?'on':''}">Заявки (ЗнЗ)</button>
            <button data-t="rop" class="${procTab==='rop'?'on':''}">Поставщики (РОП)</button>
          </div><span class="spacer" style="margin-left:auto"></span>${tag}</div>
        <div id="pbody" style="margin-top:var(--gap)"></div>`;
      host.querySelectorAll('#pseg button').forEach(b=>b.onclick=()=>{procTab=b.dataset.t;
        host.querySelectorAll('#pseg button').forEach(x=>x.classList.toggle('on',x.dataset.t===procTab)); procBody(host);});
      procBody(host);
    }
    function procBody(host){ const h=document.getElementById('pbody'); if(!h)return;
      if(procTab==='dash')procDash(h); else if(procTab==='rop')procRop(h,host); else procReq(h,host); }

    // ── Дашборд (#s1): KPI · сроки поставок · РОП A/B/C · разбивка по статусам ──
    function procDash(h){
      const all=PROC.requests||[], sup=PROC.suppliers||[];
      const cBy=(f)=>all.filter(f).length;
      const active=cBy(r=>znzActive(r.status)), onAppr=cBy(r=>r.status==='Согласована');
      const inTransit=cBy(r=>r.status==='В пути'), overdueN=all.filter(znzOverdue).length;
      const searching=cBy(r=>r.status==='Поиск поставщика'), accepted=cBy(r=>/Принята|Закрыта/.test(r.status));
      const watch=all.filter(r=>/Поиск поставщика|Размещена|В пути/.test(r.status)&&r.duePlan)
        .sort((x,y)=>(daysTo(x.duePlan)??1e9)-(daysTo(y.duePlan)??1e9)).slice(0,6);
      const dueLabel=(r)=>{const d=daysTo(r.duePlan);if(d==null)return '';
        if(d<0)return stCellDot('red','просрочка '+(-d)+' дн.'); if(d===0)return stCellDot('amber','сегодня');
        if(d===1)return stCellDot('amber','завтра'); if(d<=3)return stCellDot('amber','через '+d+' дн.');
        return stCellDot('blue','через '+d+' дн.');};
      const rA=sup.filter(s=>ropLetter(s)==='A').length, rB=sup.filter(s=>ropLetter(s)==='B').length, rC=sup.filter(s=>ropLetter(s)==='C').length;
      const rTot=sup.length||1, reassessOver=sup.filter(s=>s.reassess&&daysTo(s.reassess)<-365).length;
      const m=(lbl,num,col,sub)=>`<div class="m"><div class="lbl">${lbl}</div><div class="num"${col?` style="color:${col}"`:''}>${num}</div>${sub?`<div style="font-size:10.5px;color:var(--red);margin-top:1px">${sub}</div>`:''}</div>`;
      const ropBar=(lbl,n,col)=>`<div><div style="display:flex;align-items:center;gap:8px;font-size:13px;margin-bottom:4px"><span style="width:9px;height:9px;border-radius:2px;background:${col}"></span><span style="color:var(--ink);font-weight:600">${lbl}</span><span style="margin-left:auto;color:#64748b">${n}</span></div><div style="height:8px;background:#eef2f6;border-radius:2px;overflow:hidden"><div style="height:100%;width:${Math.round(n/rTot*100)}%;background:${col}"></div></div></div>`;
      h.innerHTML=`<div class="mstrip">
          ${m('Заявок в работе',active)}
          ${m('На согласовании',onAppr,'var(--amber)')}
          ${m('Поставки в пути',inTransit,'var(--blue)',overdueN?overdueN+' просрочка':'')}
          ${m('Поиск поставщика',searching,'var(--navy)')}
          ${m('Принято / закрыто',accepted,'var(--green)')}
        </div>
        <div style="margin-top:var(--gap);display:grid;grid-template-columns:1fr 1fr;gap:var(--gap);align-items:start">
          <div class="card" style="padding:0;overflow:hidden">
            <div style="padding:11px 14px;border-bottom:1px solid var(--line2)" class="sec-h">Сроки поставок — требуют внимания</div>
            <table class="dt" style="font-size:12.5px;width:100%"><tbody>
              ${watch.map(r=>`<tr><td class="code" style="cursor:pointer" data-znz="${esc(r.numZnz)}">${esc(r.numZnz)}</td><td class="ell" title="${esc(r.name)}">${esc(r.name)}</td><td class="nw">${dueLabel(r)}</td></tr>`).join('')||'<tr><td style="padding:12px;color:#5b6b7a">Нет поставок с заданным сроком.</td></tr>'}
            </tbody></table>
          </div>
          <div class="card pad">
            <div class="sec-h" style="margin-bottom:10px">Поставщики по категориям (РОП)</div>
            <div style="display:flex;flex-direction:column;gap:11px">
              ${ropBar('A — Одобренные',rA,'var(--green)')}
              ${ropBar('B — Условно одобренные',rB,'var(--amber)')}
              ${ropBar('C — Не одобренные',rC,'var(--red)')}
            </div>
            ${reassessOver?`<div style="margin-top:13px;padding-top:11px;border-top:1px solid var(--line2);display:flex;align-items:center;gap:8px;font-size:12px;color:var(--amber)"><span style="width:7px;height:7px;border-radius:50%;background:var(--amber)"></span>${reassessOver} поставщик(ов) — переоценка просрочена (&gt;1 года)</div>`:''}
          </div>
          <div class="card pad" style="grid-column:1 / -1">
            <div class="sec-h" style="margin-bottom:10px">Заявки по статусам</div>
            <div style="display:flex;align-items:stretch">
              ${ZNZ_STATUSES.map((st,i)=>{const n=all.filter(r=>r.status===st).length;const dot=ZNZ_DOT[st]||'gray';return `<div style="flex:1;text-align:center;padding:6px;${i<ZNZ_STATUSES.length-1?'border-right:1px solid var(--line2)':''}"><div style="font-size:22px;font-weight:800;color:${dot==='gray'?'#9ca3af':DOTC[dot]}">${n}</div><div style="font-size:11px;color:#64748b;margin-top:2px">${esc(st)}</div></div>`;}).join('')}
            </div>
          </div>
        </div>`;
      h.querySelectorAll('[data-znz]').forEach(el=>el.onclick=()=>{const r=(PROC.requests||[]).find(x=>x.numZnz===el.dataset.znz);if(r)openZnzCard(r);});
    }

    // ── Заявки (#s2): канбан по статусам / список ──
    function procReq(h,viewHost){
      const all=PROC.requests||[];
      h.innerHTML=`<div class="filters" style="margin:0 0 var(--gap)">
          <div class="seg" id="prvseg"><button data-v="kanban" class="${procReqView==='kanban'?'on':''}">Канбан</button><button data-v="list" class="${procReqView==='list'?'on':''}">Список</button></div>
          <span style="margin-left:auto;font-size:11.5px;color:var(--sub)">${all.length} заявок</span>
          <button class="tbtn primary" style="margin-left:8px" id="pnew">+ Заявка</button></div>
        <div id="preqbody"></div>`;
      h.querySelectorAll('#prvseg button').forEach(b=>b.onclick=()=>{procReqView=b.dataset.v;try{localStorage.setItem('pbs-proc-rv',procReqView);}catch{} procReq(h,viewHost);});
      const nb=h.querySelector('#pnew'); if(nb)nb.onclick=()=>openZnzForm();
      const body=h.querySelector('#preqbody');
      procReqView==='kanban'?procKanban(body):procList(body);
    }
    function procKanban(body){
      const all=PROC.requests||[];
      const cols=ZNZ_STATUSES.map(st=>{
        const items=all.filter(r=>r.status===st), dot=ZNZ_DOT[st]||'gray';
        const cards=items.map(r=>{const ov=znzOverdue(r), sum=procMoney(r.orderSum??r.budget);
          const right=r.supplier||r.sourceRef||r.initiatorDept||'';
          return `<div class="kc" data-znz="${esc(r.numZnz)}"${ov?' style="border-left-color:var(--red)"':''}>
            <div style="display:flex;gap:6px;align-items:center"><span class="pz">${esc(r.numZnz)}</span><span style="margin-left:auto">${znzTag(r)}</span></div>
            <div class="cu" title="${esc(r.name)}">${esc(r.name)}</div>
            <div style="display:flex;margin-top:7px;font-size:11px;color:#64748b;gap:6px"><span>${sum||'—'}</span><span class="ell" style="margin-left:auto;max-width:96px;text-align:right" title="${esc(right)}">${esc(right)}</span></div>
            ${ov?`<div style="margin-top:5px;font-size:11px;color:var(--red);font-weight:600">просрочка ${-daysTo(r.duePlan)} дн.</div>`:''}</div>`;}).join('')
          ||'<div style="font-size:11.5px;color:#5b6b7a;padding:4px 2px">—</div>';
        return `<div class="kcol"><div class="kh c-${dot}"><i class="i-${dot}"></i>${esc(st)} <span class="cnt">${items.length}</span></div>${cards}</div>`;
      }).join('');
      body.innerHTML=`<div class="kan" style="grid-template-columns:repeat(7,minmax(166px,1fr));overflow-x:auto">${cols}</div>`;
      body.querySelectorAll('[data-znz]').forEach(el=>el.onclick=()=>{const r=(PROC.requests||[]).find(x=>x.numZnz===el.dataset.znz);if(r)openZnzCard(r);});
    }
    function procList(body){
      const all=PROC.requests||[];
      const cols=[
        {key:'znz',label:'№ ЗнЗ',w:132,cls:'code',cell:r=>esc(r.numZnz),sortVal:r=>r.numZnz},
        {key:'date',label:'Дата',w:100,cls:'nw c-gray',cell:r=>r.created?fmt(r.created):'<span class="c-gray">—</span>',sortVal:r=>String(r.created||'')},
        {key:'kind',label:'Тип',w:72,cls:'nw',cell:r=>znzTag(r),sortVal:r=>znzKind(r)},
        {key:'name',label:'Наименование',cls:'ell',cell:r=>`<span title="${esc(r.name)}">${esc(r.name)}</span>`,sortVal:r=>r.name},
        {key:'cat',label:'Категория',w:128,cls:'nw c-gray',cell:r=>esc(r.category||'—'),sortVal:r=>r.category},
        {key:'sum',label:'Сумма',w:118,align:'right',cls:'nw',cell:r=>{const v=procMoney(r.orderSum??r.budget);return v?esc(v):'<span class="c-gray">—</span>';},sortVal:r=>r.orderSum??r.budget??0},
        {key:'sup',label:'Поставщик',w:172,cls:'ell c-gray',cell:r=>esc(r.supplier||'—'),sortVal:r=>r.supplier},
        {key:'due',label:'Срок',w:116,cls:'nw',cell:r=>{if(!r.duePlan)return '<span class="c-gray">—</span>';const ov=znzOverdue(r);return `<span class="${ov?'c-red':'c-gray'}"${ov?' style="font-weight:600"':''}>${fmt(r.duePlan)}</span>`;},sortVal:r=>String(r.duePlan||'')},
        {key:'status',label:'Статус',w:158,cls:'nw',cell:r=>znzCell(r.status),sortVal:r=>r.status},
      ];
      erpGrid(body,{key:'proc-req',cols,rows:all,onRow:openZnzCard,
        del:PROC.mode==='live'?{key:'procurement_requests',idOf:r=>r.id,reload:()=>{PROC=null;renderProcurement(document.getElementById('view'));}}:undefined,
        info:`${srcChip(PROC.mode==='live')}<span>Заявок: <b style="color:var(--ink)">${all.length}</b></span><span class="c-gray">клик по строке — карточка</span>`});
    }

    // ── Реестр поставщиков РОП (#s4, Ф.5–К) ──
    function procRop(h,viewHost){
      const sup=PROC.suppliers||[];
      const ropBadge=(s)=>{const L=ropLetter(s);if(!s.category&&s.score==null)return '<span class="c-gray">—</span>';return `<span class="nw" style="color:${DOTC[ropColor(L)]};font-weight:600">${esc(s.category||'—')}</span>`;};
      const reassCell=(s)=>{if(!s.reassess)return '<span class="c-gray">—</span>';const over=daysTo(s.reassess)<-365;return `<span class="nw${over?' c-red':''}"${over?' style="font-weight:600"':''}>${fmt(s.reassess)}${over?' · просроч.':''}</span>`;};
      const statCell=(s)=>{const t=String(s.status||'');if(/Исключ/i.test(t))return stCellDot('red',t);if(/контрол/i.test(t))return stCellDot('amber',t);if(/Активен/i.test(t))return stCellDot('green',t);return t?stCellDot('gray',t):'<span class="c-gray">—</span>';};
      const cols=[
        {key:'name',label:'Поставщик',cls:'ell',cell:s=>`<span title="${esc(s.name)}" style="font-weight:600;color:var(--ink)">${esc(s.name)}</span>`,sortVal:s=>s.name},
        {key:'inn',label:'ИНН',w:120,cls:'nw c-gray',cell:s=>s.inn?`<span style="font-family:monospace">${esc(s.inn)}</span>`:'<span class="c-gray">—</span>',sortVal:s=>s.inn},
        {key:'cat',label:'Категория продукции',w:180,cls:'ell c-gray',cell:s=>esc(s.productCat||'—'),sortVal:s=>s.productCat},
        {key:'score',label:'Балл',w:70,align:'center',cls:'nw',cell:s=>s.score!=null?`<b style="color:var(--ink)">${s.score}</b>`:'<span class="c-gray">—</span>',sortVal:s=>s.score==null?-1:s.score},
        {key:'rop',label:'Категория (оценка)',w:152,cls:'nw',cell:ropBadge,sortVal:s=>ropLetter(s)},
        {key:'reass',label:'Переоценка',w:148,cls:'nw',cell:reassCell,sortVal:s=>String(s.reassess||'')},
        {key:'status',label:'Статус в РОП',w:170,cls:'nw',cell:statCell,sortVal:s=>s.status},
      ];
      erpGrid(h,{key:'proc-rop',cols,rows:sup,onRow:s=>openSupplierCard(viewHost,s.id),
        del:PROC.mode==='live'?{key:'sales_counterparties',idOf:s=>s.id,reload:()=>{PROC=null;CPS=null;renderProcurement(document.getElementById('view'));}}:undefined,
        info:`${srcChip(PROC.mode==='live')}<span>Поставщиков: <b style="color:var(--ink)">${sup.length}</b></span><span class="c-gray">A 75–100 · B 50–74 · C &lt;50</span>`,
        toolbar:[{label:'+ Поставщик',cls:'primary',onClick:()=>alert('Добавление поставщика — через справочник «Контрагенты» (роль «Поставщик» + РОП-поля).')}]});
    }

    // ── Форма создания ЗнЗ (цеховая Ф.4–К / плановая Ф.1–К) ──
    // Быстрая форма (планшет у станка): тип · наименование · кол-во/ед · заявитель;
    // прочее — опционально. POST /api/procurement/znz/create → автономер ЗнЗ-ГГГГ-NNN.
    function openZnzForm(){
      const today=new Date().toISOString().slice(0,10);
      const G='display:grid;grid-template-columns:repeat(12,1fr);gap:14px';
      const sup=(PROC&&PROC.suppliers||[]).map(s=>s.name).filter(Boolean);
      const cats=[...new Set((PROC&&PROC.requests||[]).map(r=>r.category).filter(Boolean))];
      const units=['шт','компл.','кг','м','м²','л','упак.','пог.м','набор'];
      const dl=(id,arr)=>`<datalist id="${id}">${arr.map(o=>`<option value="${esc(o)}">`).join('')}</datalist>`;
      modal.style.width='min(680px,96vw)';
      modal.innerHTML=`<div class="mh"><b>Новая заявка на закупку (ЗнЗ)</b><span class="op">№ присвоится автоматически (ЗнЗ-ГГГГ-NNN)</span><button class="x" id="mx" aria-label="Закрыть">✕</button></div>
        <div class="mb" style="gap:0">
          <div style="${G}">
            <div style="grid-column:span 12">${FLAB('Тип заявки')}${fSeg('zn-type',['Цеховая (Ф.4–К)','Плановая (Ф.1–К)'],'Цеховая (Ф.4–К)')}<div style="font-size:11px;color:#5b6b7a;margin-top:4px">Цеховая — быстрый сигнал у станка; плановая — от снабжения по потребности.</div></div>
            <div style="grid-column:span 12">${FLAB('Наименование',true)}<textarea id="zn-name" rows="2" style="${FINP};resize:vertical" placeholder="Что нужно закупить — номенклатура / марка / типоразмер"></textarea></div>
            <div style="grid-column:span 5">${FLAB('Количество',true)}<input id="zn-qty" type="number" min="0" step="any" style="${FINP}" placeholder="напр. 2"></div>
            <div style="grid-column:span 7">${FLAB('Ед. изм.')}<input id="zn-unit" list="zn-units" style="${FINP}" placeholder="шт / компл. / кг…">${dl('zn-units',units)}</div>
            <div style="grid-column:span 7">${FLAB('Заявитель',true)}<input id="zn-init" style="${FINP}" placeholder="ФИО инициатора"></div>
            <div style="grid-column:span 5">${FLAB('Подразделение')}<input id="zn-dept" style="${FINP}" placeholder="Участок / отдел"></div>
            <div style="grid-column:span 6">${FLAB('Категория')}<input id="zn-cat" list="zn-cats" style="${FINP}" placeholder="напр. Инструмент, Металл, ЗИП">${dl('zn-cats',cats)}</div>
            <div style="grid-column:span 6">${FLAB('Срочность')}${fSelect('zn-urg',['Плановая','Срочная','Критичная'],'Плановая')}</div>
            <div style="grid-column:span 7">${FLAB('Поставщик (опц.)')}<input id="zn-sup" list="zn-sups" style="${FINP}" placeholder="Если известен">${dl('zn-sups',sup)}</div>
            <div style="grid-column:span 5">${FLAB('Срок поставки (опц.)')}<input id="zn-due" type="date" style="${FINP}"></div>
            <div style="grid-column:span 12">${FLAB('Ссылка / референс (опц.)')}<input id="zn-ref" style="${FINP}" placeholder="URL карточки товара, напр. https://atmt.ru/…"></div>
            <div style="grid-column:span 12">${FLAB('Основание / комментарий (опц.)')}<textarea id="zn-note" rows="2" style="${FINP};resize:vertical" placeholder="Под какой заказ/ПЗ/ЗКЗ, для чего, доп. условия"></textarea></div>
          </div>
          <div id="zn-err" style="margin-top:12px;color:#b91c1c;font-size:12.5px"></div>
          <div style="margin-top:14px;padding-top:13px;border-top:1px solid #e2e8f0;display:flex;align-items:center;gap:10px">
            <span style="font-size:12px;color:#5b6b7a"><span style="color:#b91c1c">*</span> — обязательное поле</span>
            <div style="margin-left:auto;display:flex;gap:10px">
              <button class="tbtn" id="zn-cancel" style="padding:9px 18px">Отмена</button>
              <button class="tbtn primary" id="zn-save" style="padding:9px 18px">Создать ЗнЗ</button>
            </div>
          </div>
        </div>`;
      modal.classList.add('open'); mscrim.classList.add('open');
      document.getElementById('mx').onclick=closeModal; document.getElementById('zn-cancel').onclick=closeModal;
      const segType=document.getElementById('zn-type');
      segType.querySelectorAll('span').forEach(s=>s.onclick=()=>{segType.querySelectorAll('span').forEach(x=>{x.classList.remove('on');x.style.background='';x.style.color='#5b6b7a';});s.classList.add('on');s.style.background='var(--navy)';s.style.color='#fff';});
      const segVal=(el,def)=>{const on=el&&el.querySelector('span.on');return on?on.dataset.v:def;};
      const v=(id)=>{const el=document.getElementById(id);return el?el.value.trim():'';};
      document.getElementById('zn-name').focus();
      document.getElementById('zn-save').onclick=async()=>{
        const errEl=document.getElementById('zn-err'); errEl.textContent='';
        const body={ type:segVal(segType,'Цеховая (Ф.4–К)'), name:v('zn-name'), qty:v('zn-qty'), unit:v('zn-unit'),
          initiator:v('zn-init'), initiatorDept:v('zn-dept'), category:v('zn-cat'), urgency:v('zn-urg'),
          supplier:v('zn-sup'), duePlan:v('zn-due'), reference:v('zn-ref'), note:v('zn-note') };
        if(!body.name){errEl.textContent='Укажите наименование.';return;}
        if(!body.qty||Number(body.qty)<=0){errEl.textContent='Укажите количество (> 0).';return;}
        if(!body.initiator){errEl.textContent='Укажите заявителя.';return;}
        const btn=document.getElementById('zn-save'); btn.disabled=true; btn.textContent='Создание…';
        try{ const j=await postJson('/api/procurement/znz/create',body);
          closeModal(); PROC=null; procTab='req';
          renderProcurement(document.getElementById('view'));
          const nt=j.notified||{};
          const notMsg=nt.ok?' · уведомление в чат отправлено':(nt.skipped?' · уведомление в чат не настроено':'');
          toast('Создана заявка '+j.numZnz+notMsg,'ok');
        }catch(e){ errEl.textContent='Не удалось создать: '+(e.message||e); btn.disabled=false; btn.textContent='Создать ЗнЗ'; }
      };
    }

