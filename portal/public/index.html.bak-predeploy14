        if(!body.name){errEl.textContent='Укажите наименование изделия / компонента.';return;}
        const btn=document.getElementById('rb-save'); btn.disabled=true; const ot=btn.textContent; btn.textContent='Сохранение…';
        try{ const r=await fetch('/api/routes/save',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(body)}); const j=await r.json().catch(()=>({})); if(!r.ok||j.error)throw new Error(j.error||('HTTP '+r.status));
          closeModal(); RT=null; toast(`МК ${esc(j.mk||'')} сохранена · операций: ${j.operations}${j.components?', компонентов: '+j.components:''}`,'ok'); openRouteCard(host,j.id);
        }catch(e){ errEl.textContent='Не удалось сохранить: '+(e.message||e); btn.disabled=false; btn.textContent=ot; }
      };
    }

    // ══ Раздел «Карты наладки» — Конструктор карт наладки (Этап 2b модуля МК) ═══
    let SETUP=null, SETUPCAT=null;
    // Подразделы «Карт наладки» по видам операций (migrate-040). Токарные — рабочий
    // (список+конструктор); остальные — заглушки «в разработке». Активный подраздел.
    const SETUP_KINDS=[
      {kind:'Токарная',label:'Токарные операции',ready:true},
      {kind:'Фрезерная',label:'Фрезерные операции',ready:false},
      {kind:'Наплавка',label:'Наплавка',ready:false},
      {kind:'Плазменная резка',label:'Плазменная резка',ready:false},
