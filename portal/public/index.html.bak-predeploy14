      // реквизиты по подразделу
      const kv=(l,v,style)=>`<div><div style="font-size:11px;color:#5b6b7a">${l}</div><div style="${style||''}">${v||'—'}</div></div>`;
      let details;
      // K-55: «Где» — склад·ячейка / цех·участок; «Код 1С» — справочный (для списания/выдачи)
