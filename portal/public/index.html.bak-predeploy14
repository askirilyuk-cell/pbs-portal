          || (q?'':'<div style="padding:10px 12px;font-size:12.5px;color:#5b6b7a">Список пуст</div>');
        if(opts.onCreate&&q){ html+=`<div class="cb-create" style="padding:9px 12px;border-top:1px solid #eef2f6;font-size:13px;color:#2E75B6;cursor:pointer;display:flex;align-items:center;gap:8px"><svg viewBox="0 0 20 20" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"><path d="M10 4v12M4 10h12"/></svg>${esc(opts.createLabel||'Создать')} «${esc(q)}»</div>`; }
        drop.innerHTML=html; drop.style.display='';
