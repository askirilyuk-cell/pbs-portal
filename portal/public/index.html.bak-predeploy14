          <div style="grid-column:span 3">${FLAB('Вес, кг',true)}<input id="mr-w" type="number" step="any" style="${FINP}"></div>
          <div style="grid-column:span 6">${FLAB('Размеры')}<input id="mr-s" style="${FINP}" placeholder="Д×Ш / Ø×L"></div>
          <div style="grid-column:span 3">${FLAB('Толщина')}<input id="mr-t" style="${FINP}"></div>
          <div style="grid-column:span 3">${FLAB('Ячейка')}<input id="mr-l" style="${FINP}"></div>
          <div style="grid-column:span 6">${FLAB('№ сертификата / плавки')}<input id="mr-heat" style="${FINP}"></div>
          <div style="grid-column:span 6">${FLAB('Дата')}<input id="mr-date" type="date" value="${mtYmd()}" style="${FINP}"></div>
          <div style="grid-column:span 12" id="mr-calcwrap"></div>
          <div style="grid-column:span 12">${FLAB('Фото / эскиз обрезка')}
