        </div>`;
      modal.classList.add('open'); mscrim.classList.add('open');
      document.getElementById('lov-x').onclick=closeModal;
      modal.querySelectorAll('.lov-vseg').forEach(b=>b.onclick=()=>{modal.querySelectorAll('.lov-vseg').forEach(x=>x.classList.remove('on'));b.classList.add('on');});
