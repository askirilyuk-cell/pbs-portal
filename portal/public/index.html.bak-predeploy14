          ${tot?`<div style="display:flex;align-items:center;gap:6px;margin-top:6px"><span class="bar2" style="flex:1;width:auto"><i style="width:${pct}%;${pct===100?'background:var(--green)':''}"></i></span><span class="c-gray" style="font-size:11px">${dn}/${tot}</span></div>`:'<div style="font-size:11px;color:#5b6b7a;margin-top:5px">маршрут не заведён</div>'}
          ${nx?`<div style="font-size:11px;color:var(--navy);margin-top:6px">${esc(nx)}</div>`:''}</div>`;};
      host.innerHTML=`<div class="kan" style="margin-top:10px">${cols.map(([c,tone])=>`<div class="kcol"><div class="kh c-${tone}"><i class="i-${tone}" style="width:7px;height:7px;border-radius:50%;display:inline-block"></i>${c} <span class="cnt">${by[c].length}</span></div>${by[c].map(card).join('')||'<div class="kempty">нет заказов</div>'}</div>`).join('')}</div>`;
      host.querySelectorAll('.kc[data-pz]').forEach(el=>el.onclick=()=>openOrderModal((DATA.orders||[]).find(o=>o.numPz===el.dataset.pz)));
    }
    // #s3 — доска по оборудованию: загрузка + разворот строки в задачи из МК
    function renderEquipBoard(host){
      const today=new Date().toISOString().slice(0,10);
      const tasks=(DATA.orders||[]).flatMap(o=>(o.tasks||[]).map(t=>({...t,pz:o.numPz})));
      const eq=new Map();
      tasks.forEach(t=>{const k=t.equip||((t.sectionCode||t.section)?('Участок '+(t.sectionCode||t.section)):'Без привязки');if(!eq.has(k))eq.set(k,{name:k,tasks:[]});eq.get(k).tasks.push(t);});
      const list=[...eq.values()].sort((a,b)=>a.name.localeCompare(b.name,'ru'));
      const ord={'В работе':0,'В очереди':1,'Приостановлено':2,'Выполнено':3};
      const rowsHtml=list.map(e=>{
        const W=e.tasks.filter(t=>t.status==='В работе').length, Q=e.tasks.filter(t=>t.status==='В очереди'||t.status==='Приостановлено').length;
        const load=W>0?Math.min(95,55+Q*12):(Q>0?Math.min(45,15+Q*9):0);
        const cur=e.tasks.find(t=>t.status==='В работе');
        const st=W>0?['blue','Работает']:['gray','Свободен'];
        const open=equipOpen===e.name;
        const main=`<tr class="eq-row" data-eq="${esc(e.name)}">
          <td><span class="c-blue">${open?'▾':'▸'}</span> <b style="color:var(--ink)">${esc(e.name)}</b></td>
          <td class="nw"><span class="st"><span class="bar2" style="width:78px"><i style="width:${load}%;background:${load>=80?'var(--amber)':'var(--blue)'}"></i></span><span class="${load>=80?'c-amber':'c-gray'}" style="font-weight:600">${load}%</span></span></td>
          <td class="ell">${cur?esc((cur.title||cur.op)+' · '+cur.pz):'<span style="color:#5b6b7a">—</span>'}</td>
          <td class="nw c-gray">${Q?Q+' в очереди':'—'}</td>
          <td class="nw">${stCellDot(st[0],st[1])}</td></tr>`;
        if(!open)return main;
        const sub=e.tasks.slice().sort((a,b)=>(ord[a.status]??9)-(ord[b.status]??9)).map(t=>{const late=t.plan&&String(t.plan).slice(0,10)<today&&!isDone(t.status);
          return `<tr><td class="code" style="font-weight:400">${esc(t.op)}</td><td class="ell">${esc((t.title||'')+' · '+t.pz)}</td><td class="nw c-gray">${(t.normTime!==''&&t.normTime!=null)?esc(t.normTime)+' ч':'—'}</td><td class="nw${late?' c-red':''}"${late?' style="font-weight:600"':''}>${esc(fmt(t.plan))}</td><td class="nw">${stCell(t.status)}</td></tr>`;}).join('');
        return main+`<tr class="eq-detail"><td colspan="5"><div style="padding:10px 14px 12px 30px"><div style="font-size:10.5px;font-weight:700;text-transform:uppercase;letter-spacing:.04em;color:var(--sub);margin-bottom:7px">Задачи на оборудовании (из маршрутных карт)</div>
          <table class="dt erp" style="font-size:12px;border:1px solid var(--line)"><thead><tr><th>МК · операция</th><th>Деталь / ПЗ</th><th style="width:80px">Норма</th><th style="width:92px">Срок</th><th style="width:122px">Статус</th></tr></thead><tbody>${sub}</tbody></table></div></td></tr>`;
      }).join('')||'<tr><td colspan="5" style="padding:14px;color:#5b6b7a">Нет задач с привязкой к оборудованию</td></tr>';
      host.innerHTML=`<div class="erp-scroll" style="margin-top:10px"><table class="dt erp"><colgroup><col style="width:230px"><col style="width:150px"><col><col style="width:130px"><col style="width:112px"></colgroup>
        <thead><tr><th>Оборудование</th><th>Загрузка</th><th>Сейчас в работе</th><th>Очередь</th><th>Статус</th></tr></thead>
        <tbody>${rowsHtml}</tbody></table></div>`;
      host.querySelectorAll('.eq-row[data-eq]').forEach(tr=>tr.onclick=()=>{equipOpen=equipOpen===tr.dataset.eq?null:tr.dataset.eq;renderEquipBoard(host);});
    }
    // Доска «по участкам» — swimlane-матрица участки × статусы (эталон #s2)
    function renderMatrix(host){
      const tasks=DATA.orders.flatMap(o=>(o.tasks||[]).map(t=>({...t,pz:o.numPz})));
      const secMap=new Map();
      tasks.forEach(t=>{const code=t.sectionCode||'—';if(!secMap.has(code))secMap.set(code,{code,name:t.sectionName||'',tasks:[]});secMap.get(code).tasks.push(t);});
      const cols=[['В очереди',t=>t.status==='В очереди'],['В работе',t=>t.status==='В работе'||t.status==='Приостановлено'],['Выполнено',t=>t.status==='Выполнено']];
      let collapsed={};try{collapsed=JSON.parse(localStorage.getItem('pbs-matrix')||'{}');}catch{}
      const pr={'Высокий':0,'Нормальный':1,'Низкий':2};
      const sortT=(a,b)=>String(a.plan||'').localeCompare(String(b.plan||''))||((pr[a.priority]??9)-(pr[b.priority]??9));
      const sections=[...secMap.values()].sort((a,b)=>a.code.localeCompare(b.code,'ru'));
      const mtask=(t)=>{
        const cls=t.status==='Выполнено'?'done':(t.status==='В работе'?'in-work':'');
        const hold=t.status==='Приостановлено';
        const dot=t.priority==='Высокий'?'<span class="dot d-red"></span>':'';
        return `<div class="mtask ${cls}" ${hold?'style="border-left-color:var(--amber);background:#fffdf7;"':''} data-tid="${esc(t.id??t.num)}" data-sec="${esc(t.sectionCode||'')}">
          <div class="t">${dot}${esc(t.title||t.op||'операция')}</div>
          <div class="m">${esc(t.pz)}${t.plan?' · срок '+fmt(t.plan):''}</div></div>`;
      };
      const rows=sections.map(s=>{
        const isC=!!collapsed[s.code];
        const byCol=cols.map(([,f])=>s.tasks.filter(f).sort(sortT));
        const counts=`<div class="counts"><span class="c">очередь ${byCol[0].length}</span><span class="c">в работе ${byCol[1].length}</span><span class="c">выполнено ${byCol[2].length}</span></div>`;
        const station=`<div class="mstation"><span class="chev" data-sec="${esc(s.code)}">${isC?'▸':'▾'}</span><div><div class="nm">${esc(s.code)}</div><div class="ds">${esc(s.name)}</div>${isC?counts:''}</div></div>`;
        const cells=byCol.map(list=>`<div class="mcell">${list.map(mtask).join('')}</div>`).join('');
        return `<div class="mrow ${isC?'collapsed':''}">${station}${cells}</div>`;
      }).join('');
      host.innerHTML=`<div class="filters">
          <span class="pill"><span class="dot d-red" style="margin-right:4px"></span>Высокий приоритет</span>
          <span style="margin-left:auto;font-size:12.5px;color:var(--sub)">${sections.length} участков · ${tasks.length} задач</span></div>
        <div class="matrix">
          <div class="mrow mhead"><div class="mc">Участок</div><div class="mc">В очереди</div><div class="mc s-blue">В работе</div><div class="mc s-green">Выполнено</div></div>
          ${rows||'<div class="mrow"><div class="mstation" style="color:var(--sub)">Задач нет</div></div>'}</div>`;
      host.querySelectorAll('.chev[data-sec]').forEach(ch=>ch.onclick=()=>{const c=ch.dataset.sec;collapsed[c]=!collapsed[c];try{localStorage.setItem('pbs-matrix',JSON.stringify(collapsed));}catch{} renderMatrix(host);});
      host.querySelectorAll('.mtask[data-tid]').forEach(el=>el.onclick=()=>{stationSel=el.dataset.sec;try{localStorage.setItem('pbs-station',stationSel);}catch{} location.hash='#station';});
    }
    function progressBar(d,total){
      const pct=total?Math.round(d/total*100):0;
      return `<div class="prog"><div class="bar"><i style="width:${pct}%;background:${pct===100?'var(--green)':'var(--blue)'}"></i></div><span class="n">${d}/${total}</span></div>`;
    }
    function doneCount(o){return (o.tasks||[]).filter(t=>t.status==='Выполнено').length;}
    const isDone=(s)=>s==='Выполнено'||s==='Отгружен'||s==='Закрыт';
    const orderDone=(o)=>{const t=(o.tasks||[]).length;return t>0&&doneCount(o)===t;};
    // «следующая операция»: первая в работе, иначе первая в очереди
    function nextOp(o){const tk=o.tasks||[];const t=tk.find(x=>x.status==='В работе')||tk.find(x=>x.status==='В очереди');
      if(!t)return '';const ttl=t.title||t.op||'операция';return `След.: ${ttl}${t.sectionCode?' · '+t.sectionCode:''}`;}
    // KPI-сводка «что требует внимания» (ISO 9241-110)
    function boardKpis(){
      const today=new Date().toISOString().slice(0,10);
      const O=DATA.orders||[];
      const overdue=O.filter(o=>o.plan&&String(o.plan).slice(0,10)<today&&!isDone(o.status));
      const working=O.filter(o=>o.status==='В работе');
      const waitOtk=O.flatMap(o=>o.tasks||[]).filter(t=>t.otk&&t.status==='Выполнено');
      const nc=(DATA.controls&&DATA.controls.nonconformity)||[];
      const ship=O.filter(o=>orderDone(o)&&o.status!=='Отгружен'&&o.status!=='Закрыт');
      return [
        {label:'Просрочено',tone:'red',n:overdue.length,sub:overdue[0]?`${overdue[0].numPz} · ${overdue[0].customer||''}`:'нет'},
        {label:'В работе',tone:'blue',n:working.length,sub:'заказов сейчас'},
        {label:'Ждут ОТК',tone:'amber',n:waitOtk.length,sub:waitOtk.length?'операций на контроль':'нет'},
        {label:'Несоответствия',tone:'red',n:nc.length,sub:nc[0]?`${nc[0].num} · ${nc[0].decision||'открыто'}`:'нет'},
        {label:'К отгрузке',tone:'green',n:ship.length,sub:ship.length?'готовы к отгрузке':'нет'},
      ];
    }
    function renderKpis(){const host=document.getElementById('kpis');if(!host)return;
      host.innerHTML=boardKpis().map(k=>`<div class="kpi kpi-${k.tone}">
        <div class="kl">${esc(k.label)}</div><div class="kn">${k.n}</div><div class="ks">${esc(k.sub)}</div></div>`).join('');}

    // Раздел «Заказы (ПЗ)» — реестр производственных заданий
    // Заказы (ПЗ) — master-detail (эталон #s3)
    // --- K-72 / Узел 8: привязка позиции ПЗ к маршруту (МК) + генерация задач Ф.14 ---
    let BOARD_RT=null, BOARD_RT_LOADING=false; // кэш списка МК для выпадающих списков позиций
    async function ensureRoutesList(){ if(BOARD_RT===null){ try{ const j=await (await fetch('/api/routes')).json(); BOARD_RT=(j&&j.routes)||[]; }catch{ BOARD_RT=[]; } } return BOARD_RT; }
    // контрол выбора маршрута для позиции (только LIVE и когда у позиции есть id)
    function posRouteSelect(p){
      if(!p||DATA.mode!=='live'||p.id==null) return p&&p.mk?`<span class="mk-tag" style="font-family:monospace;color:var(--navy);font-size:12px">${esc(p.mk)}</span>`:'';
      const list=BOARD_RT||[];
      const opts=['<option value="">— МК не привязана —</option>'].concat(list.map(r=>`<option value="${r.id}"${String(r.id)===String(p.routeId)?' selected':''}>${esc(r.mk)}${r.name?' · '+esc(r.name):''}</option>`)).join('');
      return `<select class="pos-route" data-pid="${p.id}" title="Маршрутная карта позиции" style="font:inherit;font-size:12px;padding:2px 6px;border:1px solid #cfd8e3;border-radius:6px;background:#fff;max-width:220px">${opts}</select>`;
    }
    // навесить обработчики на select-ы привязки маршрута внутри scope; onReload — перерисовать источник
    function wirePosRoutes(scope,onReload){
      scope.querySelectorAll('select.pos-route').forEach(sel=>{ sel.onchange=async()=>{
        const pid=Number(sel.dataset.pid), rid=sel.value?Number(sel.value):null; sel.disabled=true;
        try{ const r=await fetch('/api/position/route',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({positionId:pid,routeId:rid})}); const j=await r.json().catch(()=>({})); if(!r.ok||j.error)throw new Error(j.error||('HTTP '+r.status));
          toast(rid?('Позиция привязана к маршруту '+(j.mk||'')):'Позиция отвязана от маршрута','ok');
          await load(); if(onReload)onReload();
        }catch(e){ toast('Не удалось привязать: '+(e.message||e),'err'); sel.disabled=false; }
      };});
    }
    // сгенерировать задачи Ф.14 по всем МК, привязанным к позициям ПЗ (по актуальным DATA)
    async function genOrderTasks(numPz){
      const o=(DATA.orders||[]).find(x=>x.numPz===numPz); if(!o)return;
      const rids=[...new Set((o.positions||[]).map(p=>p.routeId).filter(x=>x!=null))];
      if(!rids.length){ toast('Сначала привяжите позиции к маршрутным картам (МК).','err'); return; }
      if(!confirm('Сгенерировать карты задач Ф.14 по '+rids.length+' маршрут(ам) этого ПЗ?\n\nЗадачи с уже существующим № не дублируются.'))return;
      let created=0,skipped=0,err=0;
      for(const rid of rids){ try{ const r=await fetch('/api/routes/generate-tasks',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({id:rid})}); const j=await r.json().catch(()=>({})); if(!r.ok||j.error)throw new Error(j.error||('HTTP '+r.status)); created+=j.created||0; skipped+=j.skipped||0; }catch(e){ err++; } }
      toast('Ф.14: создано '+created+', пропущено '+skipped+(err?(' · ошибок: '+err):''), err?'err':'ok');
      await load();
    }

    function orderDetailHtml(o){
