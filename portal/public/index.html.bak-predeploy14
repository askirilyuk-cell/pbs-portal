    nav a.active .i{color:#7fb0e4;}
    .side .foot{color:#9db8d4;border-top:1px solid rgba(255,255,255,.10);}
    .side .foot b{color:#fff;}
    /* светлая шапка */
    .top{background:#fff;color:var(--ink);border-bottom:1px solid var(--bd);}
    .top h1{color:var(--ink);} .top .sub{color:#5b6b7a;} .top .right{color:var(--ink);}
    #burger{background:#eef2f6;color:var(--navy);}
    .top select{background:#fff;color:var(--ink);border:1px solid var(--bd);}
    #mbadge.m-live{background:#ecfdf5;color:var(--green);} #mbadge.m-mock{background:#fffbeb;color:var(--amber);}
    /* ERP-таблицы */
    table.dt thead tr{background:var(--erp-head);}
    table.dt th{background:var(--erp-head);text-transform:uppercase;font-size:11px;font-weight:700;color:var(--sub);border-bottom:1px solid #d8e0ea;}
    table.dt.erp{font-size:13px;} table.dt.erp th{padding:8px 10px;} table.dt.erp td{padding:9px 10px;border-bottom:1px solid var(--line2);}
    table.dt.erp tbody tr:nth-child(even):not(.grp){background:#fafcfe;}
    table.dt.erp tbody tr:hover:not(.grp) td{background:#f7faff;}
    /* K-42: строка-дефицит склада/инструмента (остаток ≤ мин.) — фон #fef2f2 (существующий red-50) */
    table.dt.erp tbody tr.row-def:not(.grp) td{background:#fef2f2;}
    /* UX-05: дефицит различим не только цветом фона — маркер ⚠ в первой ячейке строки */
    table.dt.erp tbody tr.row-def:not(.grp) td:first-child::before{content:'⚠ ';color:var(--red);font-weight:700;}
    /* K-42: выбранная строка master-detail (реестр слева, деталь справа) — токены существующие; выбор важнее дефицита */
    table.dt.erp tbody tr.row-sel:not(.grp) td{background:var(--blue50);}
    table.dt.erp tbody tr.row-sel:not(.grp) td:first-child{box-shadow:inset 3px 0 0 var(--blue);}
    td.ell{white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:0;}
    td.nw{white-space:nowrap;} td.code{font-family:monospace;font-weight:700;color:var(--navy);white-space:nowrap;}
    .st{display:inline-flex;align-items:center;gap:6px;white-space:nowrap;}
    .st i{width:7px;height:7px;border-radius:50%;display:inline-block;flex:0 0 auto;}
    .i-blue{background:var(--blue);}.i-amber{background:var(--amber);}.i-red{background:var(--red);}.i-green{background:var(--green);}.i-gray{background:#9ca3af;}.i-navy{background:var(--navy);}
    .c-blue{color:var(--blue);}.c-amber{color:var(--amber);}.c-red{color:var(--red);}.c-green{color:var(--green);}.c-gray{color:#64748b;}.c-navy{color:var(--navy);}
    .bar2{height:6px;width:64px;background:var(--line);border-radius:1px;overflow:hidden;display:inline-block;vertical-align:middle;}
    .bar2 i{display:block;height:100%;background:var(--blue);}
    /* ERP тулбар / колонки / ресайз / статус-бар */
    .erp-toolbar{display:flex;align-items:center;gap:8px;flex-wrap:wrap;margin-bottom:10px;}
    .tbtn{font:inherit;font-size:12.5px;color:#334155;background:#fff;border:1px solid #cfd8e3;padding:6px 11px;cursor:pointer;}
    .tbtn:hover{background:#f1f4f8;} .tbtn.primary{font-weight:600;color:#fff;background:var(--navy);border-color:var(--navy);} .tbtn.primary:hover{background:var(--navy-d);}
    .tbtn.green{font-weight:600;color:#fff;background:var(--green);border-color:var(--green);} .tbtn.green:hover{background:#126b34;}
    .tbtn.amber{font-weight:600;color:#fff;background:var(--amber);border-color:var(--amber);} .tbtn.amber:hover{background:#93470a;}
    .tbtn:disabled{color:#b6c0cc;background:#f4f6f9;border-color:#e2e8f0;cursor:not-allowed;}
    .tbtn.on{background:var(--blue50);border-color:var(--blue);color:var(--navy);font-weight:600;}
    /* выбранный сегмент вердикта/решения ЛОВ */
    .lov-vseg{cursor:pointer;} .lov-vseg.on{background:var(--navy);color:#fff;}
    .lov-dseg.on{background:var(--navy);color:#fff;border-color:var(--navy);}
    .erp-search{font:inherit;font-size:13px;padding:6px 10px;border:1px solid #cfd8e3;width:min(260px,42vw);}
    .erp-colwrap{position:relative;}
    .colmenu{position:absolute;top:36px;left:0;z-index:30;width:190px;background:#fff;border:1px solid #cfd8e3;box-shadow:0 8px 22px rgba(20,40,70,.18);padding:6px 0;}
    .colmenu[hidden]{display:none;}
    .colmenu .h{font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:.04em;color:#5b6b7a;padding:5px 12px;}
    .colmenu label{display:flex;align-items:center;gap:8px;padding:6px 12px;font-size:12.5px;color:#334155;cursor:pointer;} .colmenu label:hover{background:#f1f4f8;}
    .erp-scroll{overflow-x:auto;border:1px solid var(--line);}
    table.dt.erp th{position:relative;cursor:default;}
    table.dt.erp th .th-l{cursor:pointer;user-select:none;}
    table.dt.erp th .rz{position:absolute;top:0;right:0;width:8px;height:100%;cursor:col-resize;border-right:2px solid transparent;touch-action:none;}
    table.dt.erp th:hover .rz{border-right-color:#9bb4cc;} table.dt.erp th .rz:hover{border-right-color:var(--blue);}
    .statusbar{display:flex;align-items:center;gap:14px;padding:7px 10px;border:1px solid var(--line);border-top:0;font-size:12px;color:#64748b;}
    /* ERP метрики-лента + канбан + разворот строки оборудования */
    .mstrip{display:flex;border:1px solid var(--line);background:#f8fafc;}
    .mstrip .m{flex:1;padding:9px 14px;border-right:1px solid #e8edf3;} .mstrip .m:last-child{border-right:0;}
    /* K-42 мобайл: KPI-лента переносится по 2 в ряд (правило ПОСЛЕ базового .mstrip, чтобы победить по порядку) */
    @media (max-width:760px){ .mstrip{flex-wrap:wrap;} .mstrip .m{flex:1 1 44%;min-width:0;} }
    .mstrip .lbl{font-size:10.5px;font-weight:700;text-transform:uppercase;letter-spacing:.04em;color:var(--sub);}
    .mstrip .num{font-size:21px;font-weight:800;line-height:1.1;margin-top:2px;color:var(--navy);}
    /* K-39: реестр инструмента — 3 колонки [фасеты | таблица | drawer] */
    .tl-3col{display:grid;grid-template-columns:198px minmax(0,1fr);gap:var(--gap);align-items:start;}
    .tl-3col.tl-open{grid-template-columns:198px minmax(0,1fr) 280px;}
    .tl-facets{background:#f8fafc;border:1px solid var(--bd);border-radius:var(--radius);padding:10px 11px;font-size:12.5px;min-width:0;}
    .tl-fgrp{font-size:10.5px;font-weight:700;text-transform:uppercase;letter-spacing:.04em;color:var(--sub);margin:13px 0 5px;}
    .tl-fgrp:first-child{margin-top:0;}
    .tl-facet{display:flex;align-items:center;gap:7px;padding:4px 5px;border-radius:2px;cursor:pointer;color:#334155;user-select:none;}
    .tl-facet:hover{background:var(--blue50);}
    .tl-facet.on{color:var(--navy);font-weight:600;}
    .tl-facet input{margin:0;flex:0 0 auto;}
    .tl-facet .tl-fl{flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;}
    .tl-facet .tl-fc{font-size:11px;color:var(--sub);font-variant-numeric:tabular-nums;}
    .tl-reset{margin-top:11px;width:100%;}
