    // Заказы (ПЗ) — ERP-реестр (erpGrid) + master-detail: таблица слева, панель с вкладками справа (K-42 Задача C)
    let ordSel=null, ordTab='pos', ordApi=null;
    function renderOrdersView(host,arg){
      if(arg)ordSel=arg;
      const today=new Date().toISOString().slice(0,10);
      const rows=DATA.orders.map(o=>{const tot=(o.tasks||[]).length,dn=doneCount(o);const late=o.plan&&String(o.plan).slice(0,10)<today&&!isDone(o.status);return {o,tot,dn,pct:tot?Math.round(dn/tot*100):0,late};});
      const lateN=rows.filter(r=>r.late).length;
      const otkN=DATA.orders.reduce((s,o)=>s+(o.tasks||[]).filter(t=>t.otk&&!isDone(t.status)).length,0);
      const cols=[
        {key:'numPz',label:'№ ПЗ',w:120,cls:'code',cell:r=>esc(r.o.numPz),sortVal:r=>r.o.numPz},
        {key:'customer',label:'Заказчик',cls:'ell',cell:r=>`<span title="${esc(r.o.customer||'')}">${esc(r.o.customer||'')}</span>`,sortVal:r=>r.o.customer},
        {key:'type',label:'Тип',w:120,cls:'nw c-gray',cell:r=>esc(r.o.orderType||'—'),sortVal:r=>r.o.orderType},
        {key:'prio',label:'Приоритет',w:118,cls:'nw',cell:r=>prioCell(r.o.priority),sortVal:r=>r.o.priority},
        {key:'plan',label:'Срок',w:152,cls:'nw',cell:r=>r.late?`<span class="c-red" style="font-weight:600">${esc(fmt(r.o.plan))} · просрочен</span>`:esc(fmt(r.o.plan)),sortVal:r=>String(r.o.plan||'')},
        {key:'prog',label:'Готовность',w:128,cls:'nw',cell:r=>`<span class="st"><span class="bar2"><i style="width:${r.pct}%;${r.pct===100?'background:var(--green)':''}"></i></span><span class="c-gray">${r.dn}/${r.tot}</span></span>`,sortVal:r=>r.pct},
        {key:'status',label:'Статус',w:140,cls:'nw',cell:r=>stCell(r.o.status),sortVal:r=>r.o.status},
      ];
      if(ordSel&&!rows.some(r=>r.o.numPz===ordSel))ordSel=null;
      host.innerHTML=`<div class="split wide"><div id="ogrid"></div><div class="detail" id="odetail"></div></div>`;
      ordApi=erpGrid(document.getElementById('ogrid'),{key:'orders',cols,rows,rowKey:r=>r.o.numPz,selKey:ordSel,
        onRow:r=>{ordSel=r.o.numPz;try{history.replaceState(null,'','#orders/'+encodeURIComponent(ordSel));}catch{}odShowDetail(ordSel);},
        onEnter:r=>openOrderModal(r.o),                       // Enter — карточка целиком (модалка; полноэкранный роут — TODO)
        onEsc:()=>{ordSel=null;try{history.replaceState(null,'','#orders');}catch{}if(ordApi)ordApi.selectKey(null);odShowDetail(null);},
        del:DATA.mode==='live'?{key:'orders',idOf:r=>r.o.id,reload:()=>load()}:undefined,
        info:`${srcChip(DATA.mode==='live')}<span>Всего: <b style="color:var(--ink)">${rows.length}</b></span>${lateN?`<span class="c-red">Просрочено: <b>${lateN}</b></span>`:''}${otkN?`<span class="c-amber">Ждут ОТК: <b>${otkN}</b></span>`:''}<span class="c-gray">клик/↑↓ — деталь · Esc — закрыть</span>`,
        toolbar:[{label:'+ Создать ПЗ',cls:'primary',onClick:()=>openCreateOrder()}],
      });
      odShowDetail(ordSel);
    }
    // Панель детали заказа с вкладками Позиции/Задачи/Контроль/История (K-42 C)
    function odShowDetail(numPz){
      const host=document.getElementById('odetail'); if(!host)return;
      const o=numPz?(DATA.orders||[]).find(x=>x.numPz===numPz):null;
      if(!o){ host.innerHTML='<div class="card pad" style="color:var(--sub)">Выберите заказ слева (клик или ↑/↓). Enter — карточка целиком, Esc — закрыть.</div>'; return; }
      const today=new Date().toISOString().slice(0,10);
      const late=o.plan&&String(o.plan).slice(0,10)<today&&!isDone(o.status);
      // Риск срока: открытые НП, связанные с ПЗ (best-effort по ссылке на № ПЗ) + просрочка плана
      const nc=((DATA.controls&&DATA.controls.nonconformity)||[]).filter(n=>{const ref=String(n.pz||n.numPz||n.order||n.object||n.pzNo||'');return ref&&ref.includes(o.numPz)&&!/закры|устран|отклон/i.test(String(n.decision||n.status||''));});
      const riskBlock=(late||nc.length)?`<div class="card pad" style="border-left:3px solid var(--red);background:#fef2f2"><b class="c-red">Риск срока</b> <span style="color:#334155">${[late?'план '+esc(fmt(o.plan))+' просрочен':'',nc.length?('открытые НП: '+nc.map(n=>esc(n.num||n.numNp||'НП')).join(', ')):''].filter(Boolean).join(' · ')}</span></div>`:'';
      const routeBtns=(o.routes||[]).map(r=>`<button class="tbtn" data-mk="${esc(r.mk)}">${aico('route',14)} Маршрут ${esc(String(r.mk).replace('МК-',''))}</button>`).join('');
      const tabs=[['pos','Позиции'],['tasks','Задачи'],['ctl','Контроль'],['hist','История']];
      host.innerHTML=`
        <div class="card pad" style="display:flex;align-items:center;gap:10px;flex-wrap:wrap">
          <span style="font-size:19px;font-weight:700;color:var(--navy)">${esc(o.numPz)}</span>${stCell(o.status)}
          <span style="font-size:12.5px;color:var(--sub)">${esc(o.customer||'')}${o.orderType?' · '+esc(o.orderType):''}</span>
          <button class="x" id="od-x" aria-label="Закрыть" title="Закрыть (Esc)" style="margin-left:auto;background:#eef2f6;border:0;width:26px;height:26px;border-radius:var(--radius);cursor:pointer;color:var(--sub);font-size:14px">✕</button>
        </div>
        ${riskBlock}
        <div style="display:flex;gap:4px;border-bottom:1px solid var(--bd)" id="od-tabs">${tabs.map(([k,l])=>`<button data-tab="${k}" style="font:inherit;font-size:13px;font-weight:600;padding:8px 13px;border:0;border-bottom:2px solid ${ordTab===k?'var(--navy)':'transparent'};background:none;color:${ordTab===k?'var(--navy)':'#5b6b7a'};cursor:pointer">${l}</button>`).join('')}</div>
        <div id="od-body"></div>
        <div class="card pad" style="display:flex;gap:8px;flex-wrap:wrap;justify-content:flex-end">
          ${routeBtns}
          <a class="pbtn" href="/api/print/pz/${encodeURIComponent(o.numPz)}" target="_blank" rel="noopener">${aico('print',14)} Печать ПЗ (Ф.1–П.2)</a>
        </div>`;
      const xb=host.querySelector('#od-x'); if(xb)xb.onclick=()=>{ordSel=null;try{history.replaceState(null,'','#orders');}catch{}if(ordApi)ordApi.selectKey(null);odShowDetail(null);};
      host.querySelectorAll('#od-tabs button').forEach(b=>b.onclick=()=>{ordTab=b.dataset.tab;odShowDetail(numPz);});
      host.querySelectorAll('[data-mk]').forEach(b=>b.onclick=()=>{location.hash='#routes/'+encodeURIComponent(b.dataset.mk);});
      odTabBody(o);
    }
    function odTabBody(o){
      const h=document.getElementById('od-body'); if(!h)return;
      if(ordTab==='pos'){
        // K-72 / Узел 8: подгружаем список МК (если ещё нет) и перерисовываем вкладку
        if(DATA.mode==='live'&&BOARD_RT===null&&!BOARD_RT_LOADING){ BOARD_RT_LOADING=true; ensureRoutesList().then(()=>{BOARD_RT_LOADING=false; if(ordTab==='pos')odTabBody(o);}); }
        const nomen=(o.positions||[]).map(p=>`<div class="nrow"><b>${esc(p.numPos)}</b><span class="sp">${esc(p.name||'')}</span>${p.drawing?`<span style="color:var(--sub)">чертёж ${esc(p.drawing)}</span>`:''}<span style="color:var(--sub)">${esc(p.qty??'')} ${esc(p.unit||'')}</span>${badge(p.status)}${DATA.mode==='live'?`<span style="margin-left:auto">${posRouteSelect(p)}</span>`:''}</div>`).join('')||'<div class="nrow" style="color:var(--sub)">Позиции не заведены</div>';
        const genBtn=DATA.mode==='live'?`<div style="margin-top:10px;display:flex;align-items:center;gap:8px;justify-content:flex-end"><span style="font-size:11.5px;color:var(--sub)">Привяжите МК к позициям, затем</span><button class="tbtn primary" id="pos-gen">⚙ Сгенерировать задачи Ф.14</button></div>`:'';
        h.innerHTML=`<div class="card pad nomen">${nomen}</div>${genBtn}`;
        wirePosRoutes(h); // после load() вся вкладка перерисуется через route()
        const gb=h.querySelector('#pos-gen'); if(gb)gb.onclick=()=>genOrderTasks(o.numPz);
      } else if(ordTab==='tasks'){
        const tk=(o.tasks||[]).slice().sort((a,b)=>(Number(a.opNum)||0)-(Number(b.opNum)||0));
        const tasks=tk.map(t=>{const cls=t.status==='Выполнено'?'done':(t.status==='В работе'?'work':'');return `<div class="tcard ${cls}"><div class="st">${esc(t.sectionCode||t.section||'')}${(t.opNum!==''&&t.opNum!=null)?' · оп.'+esc(t.opNum):''}</div><div class="nm">${esc(t.title||t.op||'')}</div>${badge(t.status)}</div>`;}).join('')||'<div style="color:var(--sub)">Задач нет</div>';
        h.innerHTML=`<div class="card pad"><div class="tasks">${tasks}</div></div>`;
      } else if(ordTab==='ctl'){
        const c=DATA.controls||{};
        const vbadge=(v)=>badge(v==='ГОДЕН'?'Выполнено':v);
        const qcell=(hd,arr,fld)=>{const x=(arr||[])[0];return `<div class="qcell"><div class="qh">${hd}</div><div class="qv">${x?`<span style="color:var(--sub)">${esc(x.num)}</span><span style="margin-left:auto">${vbadge(x[fld])}</span>`:'<span style="color:var(--sub)">нет</span>'}</div></div>`;};
        h.innerHTML=`<div class="card pad"><div class="qc">${qcell('Ф.3 Входной',c.incoming,'verdict')}${qcell('Ф.4 Приёмочный',c.acceptance,'verdict')}<div class="qcell"><div class="qh">Ф.5 Несоответствия</div><div class="qv" style="color:var(--sub)">${(c.nonconformity&&c.nonconformity[0])?esc(c.nonconformity[0].num)+' · '+esc(c.nonconformity[0].decision||'открыто'):'нет открытых'}</div></div></div><div style="font-size:11px;color:#5b6b7a;margin-top:8px">Контроль показан по разделу (Ф.3/Ф.4/Ф.5); привязка к конкретному ПЗ — TODO бэкенда.</div></div>`;
      } else {
        const hist=(o.history||[]);
        h.innerHTML=`<div class="card pad"><div style="display:flex;flex-direction:column;gap:9px;font-size:12.5px">${hist.length?hist.map(x=>`<div style="display:flex;gap:8px"><span style="color:#5b6b7a;white-space:nowrap">${esc(x.date||'')}</span><span>${esc(x.text||'')}</span></div>`).join(''):'<span class="c-gray">Журнал по ПЗ в реестре не ведётся (движение задач — на производственной доске).</span>'}</div></div>`;
      }
    }
    async function openOrderModal(o){
      if(!o)return;
      if(DATA.mode==='live')await ensureRoutesList(); // K-72: список МК для выпадающих списков позиций
      modal.style.width='min(820px,96vw)';
      modal.innerHTML=`<div class="mh"><b>${esc(o.numPz)}</b><span class="op">${esc(o.customer||'')}</span><button class="x" id="mx" aria-label="Закрыть">✕</button></div><div class="mb">${orderDetailHtml(o)}</div>`;
