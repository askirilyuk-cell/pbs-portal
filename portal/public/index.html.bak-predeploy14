    // ── Эскиз-инструмент делового остатка (листовой обрезок): контур от руки → площадь (шнуровка/Гаусс) → вес ──
    // Плотность по марке стали (кг/м³); дефолт 7850 (Ст3/углеродистые/низколегированные). Словарь расширяется по мере надобности.
    function steelDensity(grade){
      const g=String(grade||'').toUpperCase().replace(/[\s.\-]+/g,'');
      const T=[
        [/(АД0|АД1|АД31|АМГ|АМЦ|Д16|В95|1561|1105|АЛЮМИН)/,2710],
        [/(ЛС59|Л63|Л68|ЛАТУН)/,8500],
        [/(М1|М2|М3|МЕДЬ)/,8900],
        [/(ВТ\d|ОТ4|ТИТАН)/,4500],
        [/(12Х18Н10|08Х18Н10|10Х17Н|03Х|20Х13|30Х13|40Х13|08Х13|12Х13|20Х17|Х18Н|НЕРЖ)/,7900],
      ];
      for(const [re,d] of T) if(re.test(g)) return {d,def:false};
      return {d:7850,def:true};
    }
