        <div style="margin-top:14px;padding-top:13px;border-top:1px solid #e2e8f0;display:flex;justify-content:flex-end;gap:10px"><button class="tbtn" id="ca-cancel" style="padding:9px 18px">Отмена</button><button class="tbtn green" id="ca-save" style="padding:9px 18px">Добавить алиас</button></div></div>`;
      modal.classList.add('open'); mscrim.classList.add('open');
      document.getElementById('mx').onclick=closeModal; document.getElementById('ca-cancel').onclick=closeModal;
      document.getElementById('ca-save').onclick=async()=>{
        const err=document.getElementById('ca-err'); err.textContent='';
        const V=(id)=>{const el=document.getElementById(id);return el?el.value.trim():'';};
        const body={ canonId, name:V('ca-name'), source:V('ca-source'), sourceUnit:V('ca-unit'), note:V('ca-note') };
        if(V('ca-factor'))body.factor=Number(V('ca-factor'));
        if(!body.name){ err.textContent='Укажите наименование-алиас.'; return; }
        const btn=document.getElementById('ca-save'); btn.disabled=true; btn.textContent='Добавление…';
        try{ const r=await fetch('/api/catalog/alias/save',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(body)});
          const j=await r.json().catch(()=>({})); if(!r.ok||j.error)throw new Error(j.error||('HTTP '+r.status));
          toast('Алиас привязан к канону.','ok'); catCardCache={}; CAT=null; closeModal(); renderCatalog(document.getElementById('view'));
        }catch(e){ err.textContent=e.message; toast('Не добавлено: '+e.message,'err'); btn.disabled=false; btn.textContent='Добавить алиас'; }
      };
    }
    // ── Форма записи истории цен (на канон) ──
    function openCatPrice(canonId,baseUnit){
      if(!CAT||CAT.mode!=='live'){ toast('Каталог доступен только в LIVE-режиме.','err'); return; }
      const G='display:grid;grid-template-columns:repeat(12,1fr);gap:12px';
      const srcOpts=['<option value="">— источник —</option>'].concat((CAT.priceSources||[]).map(s=>`<option>${esc(s)}</option>`)).join('');
      modal.style.width='min(640px,96vw)';
      modal.innerHTML=`<div class="mh"><b>Добавить цену (на канон)</b><span class="op">сводится в разброс «от X до Y ₽/ед»</span><button class="x" id="mx" aria-label="Закрыть">✕</button></div>
        <div class="mb" style="gap:0"><div style="${G}">
          <div style="grid-column:span 4">${FLAB('Дата')}<input id="cp-date" type="date" value="${catYmd()}" style="${FINP}"></div>
          <div style="grid-column:span 8">${FLAB('Поставщик')}<input id="cp-supplier" style="${FINP}"></div>
