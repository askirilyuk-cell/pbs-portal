          const who=loc?(esc(m.from||'—')+' → '+esc(m.to||'—')):esc(m.recipient||'—');
          const bal=loc?'<span class="c-gray">—</span>':((m.balanceAfter||m.balanceAfter===0)?tlQty(m.balanceAfter):'—');
          return `<tr><td class="nowrap">${fmt(m.date)}</td><td>${tlChip(oc[0],oc[1])}</td><td style="text-align:right">${qtyCell}</td><td class="nowrap">${who}</td><td class="nowrap">${esc(m.batch||'—')}</td><td>${esc(m.basis||'—')}</td><td style="text-align:right">${bal}</td></tr>`;}).join(''):'<tr><td colspan="7" style="padding:14px;color:#5b6b7a;text-align:center">Движений нет.</td></tr>'; }
      const calWarn=si&&(it.calOverdue?' '+tlChip('поверка просрочена','out'):(it.calSoon?' '+tlChip('поверка ≤30дн','warn'):''));
      host.innerHTML=`<div class="card pad" style="display:flex;align-items:center;gap:8px;flex-wrap:wrap">
          ${idTag}${chips}${stTag||''}${calWarn||''}
          <button class="tbtn" data-act="close" title="Свернуть" aria-label="Свернуть" style="margin-left:auto;padding:4px 9px">✕</button>
          <div style="flex-basis:100%;height:0"></div>
