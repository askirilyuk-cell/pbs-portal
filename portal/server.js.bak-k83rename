// маппинг простых текстовых полей формы → колонки «Остаток металла»
const METAL_WRITE = {
  'Марка': 'grade', 'Типоразмер': 'size', 'ГОСТ': 'gost', 'Ед. изм.': 'unit',
  'Склад по умолчанию': 'warehouse', 'Ячейка': 'cell', 'Примечание': 'note',
};
function metalBuildPatch(body) {
  const patch = {};
  for (const [title, key] of Object.entries(METAL_WRITE)) if (body[key] != null && body[key] !== '') patch[title] = String(body[key]).trim();
  if (METAL_ROLL_TYPES.includes(body.rollType)) patch['Тип проката'] = body.rollType;
  if (body.minStock != null && body.minStock !== '') patch['Мин. остаток'] = Number(body.minStock);
  if (body.norm != null && body.norm !== '') patch['Норма пересчёта'] = Number(body.norm);
  return patch;
}
// POST /api/metal/save — создать/обновить позицию остатка (автонумер МС-NNNN при создании)
async function metalSave(body) {
  const rows = await ncListSoft('metal_stock');
  const existing = (body.id != null && body.id !== '' && rows.find((r) => String(r.Id ?? r.id) === String(body.id)))
    || (body.code && rows.find((r) => String(r['Код'] || '').trim() === String(body.code).trim()));
  const patch = metalBuildPatch(body);
  let id, code, created;
  if (existing) {
    id = existing.Id ?? existing.id; code = String(existing['Код'] || '').trim();
    if (Object.keys(patch).length) await ncUpdate('metal_stock', id, patch);
    created = false;
  } else {
    const grade = String(body.grade || '').trim();
    if (!grade) throw new Error('Укажите марку металла (grade).');
    code = await metalNextCode();
    const row = { 'Код': code, 'Ед. изм.': 'кг', ...patch, 'Марка': grade };
    if (body.balance != null && body.balance !== '') row['Остаток'] = Number(body.balance); // стартовый остаток (без проводки)
    if (body.reserved != null && body.reserved !== '') row['Резерв'] = Number(body.reserved);
    const cr = await ncCreateMany('metal_stock', [row]);
    const c = Array.isArray(cr) ? cr[0] : cr; id = c.Id ?? c.id;
    // best-effort привязка к канону
    if (body.canonId != null && body.canonId !== '') { try { await ncLinkRecords('metal_stock', 'Номенклатура-канон', id, [Number(body.canonId)]); } catch { /* реципрок/связь может отличаться */ } }
    created = true;
  }
  return { ok: true, id, code, created };
}
// POST /api/metal/move — операции с металлом → журнал + пересчёт «Остаток после» + кэш реестра
async function metalMove(body) { return withClientOpId(body && body.clientOpId, () => metalMoveImpl(body)); }
async function metalMoveImpl(body) {
  const op = String(body.operation || body.op || '').trim();
  if (!METAL_OPS.includes(op)) { const e = new Error(`Операция должна быть одной из: ${METAL_OPS.join(' / ')}.`); e.status = 400; throw e; }
  const items = await ncListSoft('metal_stock');
  const it = (body.itemId != null && body.itemId !== '' && items.find((r) => String(r.Id ?? r.id) === String(body.itemId)))
    || (body.code && items.find((r) => String(r['Код'] || '').trim() === String(body.code).trim()));
  if (!it) throw new Error('Позиция металла не найдена (укажите itemId или code существующей позиции).');
  const code = String(it['Код'] || '').trim();
  const itemId = it.Id ?? it.id;
  const dateIso = body.date ? String(body.date).slice(0, 10) : whToday();
  const heatNo = String(body.heatNo || '').trim();
  // валидация количества
  const qty = Number(body.qty);
  if (op === 'Инвентаризация') { if (!Number.isFinite(qty) || qty < 0) throw new Error('Инвентаризация: укажите фактический остаток (кг) ≥ 0.'); }
  else if (!Number.isFinite(qty) || qty <= 0) throw new Error('Укажите положительное количество (кг).');
  // прослеживаемость плавки (надстройка 5): № сертификата/плавки обязателен в Приходе
  if (op === 'Приход' && !heatNo) { const e = new Error('Приход: укажите № сертификата / плавки (прослеживаемость).'); e.status = 409; throw e; }

  return withKeyLock(`metal:${code}`, async () => {
    const movements = await ncListSoft('metal_movements');
    const jb = metalLastBalance(code, movements);
    const stockBase = jb != null ? jb : whNum(it['Остаток']);
    const resBase = metalReserveFor(code, movements, it['Резерв']);
    const avail = stockBase - resBase;
    let newStock = stockBase, newRes = resBase, balanceAfter = stockBase;
    if (op === 'Приход') { newStock = stockBase + qty; balanceAfter = newStock; }
    else if (op === 'Расход') { if (qty > avail) { const e = new Error(`Расход ${qty} кг превышает доступно ${avail} кг (${code}; остаток ${stockBase}, резерв ${resBase}). Уменьшите кол-во или снимите резерв.`); e.status = 409; throw e; } newStock = stockBase - qty; balanceAfter = newStock; }
    else if (op === 'Списание') { if (qty > stockBase) { const e = new Error(`Списание ${qty} кг превышает остаток ${stockBase} кг (${code}).`); e.status = 409; throw e; } newStock = stockBase - qty; balanceAfter = newStock; }
    else if (op === 'Инвентаризация') { newStock = qty; balanceAfter = qty; if (newRes > newStock) newRes = newStock; }
    else if (op === 'Резерв') { if (qty > avail) { const e = new Error(`Резерв ${qty} кг превышает доступно ${avail} кг (${code}).`); e.status = 409; throw e; } newRes = resBase + qty; balanceAfter = stockBase; }
    else if (op === 'Снятие резерва') { if (qty > resBase) { const e = new Error(`Снятие резерва ${qty} кг превышает текущий резерв ${resBase} кг (${code}).`); e.status = 409; throw e; } newRes = resBase - qty; balanceAfter = stockBase; }

    const row = {
      'Проводка': `${code} · ${op.toLowerCase()} · ${whRuDate(dateIso)}`,
      'Код': code, 'Дата': dateIso, 'Операция': op, 'Кол-во': qty, 'Остаток после': balanceAfter,
    };
    const put = (col, v) => { const s = (v == null ? '' : String(v)).trim(); if (s) row[col] = s; };
    put('Раскрой / формат', body.format); put('Поставщик', body.supplier); put('№ счёта', body.invoiceNo);
    put('№ сертификата / плавки', heatNo); put('Позиция ПЗ', body.pzLine); put('Деталь', body.part);
    put('Основание / комментарий', body.basis || body.reason); put('Автор', body.author);
    if (body.units != null && body.units !== '') row['Кол-во ед.'] = Number(body.units);
    const cr = await ncCreateMany('metal_movements', [row]);
    const mv = Array.isArray(cr) ? cr[0] : cr;
    const movementId = mv.Id ?? mv.id;
    // best-effort связи (журнал ведётся по «Код», связи — для реляционной навигации)
    try { await ncLinkRecords('metal_stock', 'Движения металла', itemId, [movementId]); } catch { /* soft */ }
    if (body.znzId != null && body.znzId !== '') { try { await ncLinkRecords('procurement_requests', 'Движения металла (ЗнЗ)', Number(body.znzId), [movementId]); } catch { /* soft */ } }
    if (body.pzId != null && body.pzId !== '') { try { await ncLinkRecords('orders', 'Движения металла (расход)', Number(body.pzId), [movementId]); } catch { /* soft */ } }

    // кэш реестра (остаток авторитетен из журнала — при сбое ncUpdate самовосстановится)
    let sync = true;
    try { await ncUpdate('metal_stock', itemId, { 'Остаток': newStock, 'Резерв': newRes }); }
    catch (e) { sync = false; console.error(`[${new Date().toISOString()}] metal balance update failed (${code}):`, (e && e.message) || e); }

    // надстройка 4: деловой остаток при Расходе (чекбокс «образовался деловой остаток»)
    let remnant = null;
    if (op === 'Расход' && body.remnant && Number(body.remnantWeight) > 0) {
      try { remnant = await metalRemnantCreate({ posId: itemId, grade: it['Марка'], rollType: whLinkVal(it['Тип проката']) || it['Тип проката'], sizes: body.remnantSizes, thickness: body.remnantThickness, weight: body.remnantWeight, location: body.remnantLocation || it['Ячейка'], heatNo, pzId: body.pzId, date: dateIso }); }
      catch (e) { console.error(`[${new Date().toISOString()}] metal remnant create failed (${code}):`, (e && e.message) || e); }
    }
    const out = { ok: true, movementId, itemId, code, operation: op, qty, balance: newStock, reserved: newRes, available: newStock - newRes };
    if (remnant) out.remnant = remnant;
    if (!sync) out.warning = `Кэш остатка/резерва в реестре (${code}) не обновился — журнал верен, поле пересчитается при следующей операции.`;
    return out;
  });
}
// оприходование делового остатка (надстройка 4) — из формы «Оприходование ДО» или из Расхода
async function metalRemnantCreate(body) {
  const weight = Number(body.weight);
  if (!Number.isFinite(weight) || weight <= 0) throw new Error('Укажите вес делового остатка (кг) > 0.');
  const code = await metalNextRemnantCode();
  const row = { 'Код': code, 'Вес': weight, 'Дата': body.date ? String(body.date).slice(0, 10) : whToday(), 'Статус': 'Доступен' };
  const put = (col, v) => { const s = (v == null ? '' : String(v)).trim(); if (s) row[col] = s; };
  put('Марка', body.grade); put('Размеры', body.sizes); put('Толщина', body.thickness);
  put('Склад / ячейка', body.location); put('№ сертификата / плавки', body.heatNo);
  if (METAL_ROLL_TYPES.includes(String(body.rollType || '').trim())) row['Тип проката'] = String(body.rollType).trim();
  const cr = await ncCreateMany('metal_remnants', [row]);
  const rec = Array.isArray(cr) ? cr[0] : cr;
  const id = rec.Id ?? rec.id;
  if (body.posId != null && body.posId !== '') { try { await ncLinkRecords('metal_stock', 'Деловые остатки', Number(body.posId), [id]); } catch { /* soft */ } }
  if (body.pzId != null && body.pzId !== '') { try { await ncLinkRecords('orders', 'Деловые остатки (источник)', Number(body.pzId), [id]); } catch { /* soft */ } }
  return { ok: true, id, code, weight };
}
// идемпотентный сид реестра остатка из канон-Металла (для дозасева при росте канона; APPLY делает миграция)
async function metalSeedFromCanon() {
  const [canon, stock] = await Promise.all([ncListSoft('catalog_canon'), ncListSoft('metal_stock')]);
  const metalCanon = canon.filter((r) => String(r['Категория'] || '').trim() === 'Металл');
  const linked = new Set(stock.map((s) => String(catLinkId(s['Номенклатура-канон']))).filter((x) => x !== 'null'));
  let n = stock.length, created = 0;
  for (const c of metalCanon) {
    const canonId = c.Id ?? c.id;
    if (linked.has(String(canonId))) continue;
    n += 1;
    const code = `МС-${String(n).padStart(4, '0')}`;
    const rt = /труб/i.test(String(c['Тип'] || '')) ? 'Труба' : (/круг|пруток|прут/i.test(String(c['Тип'] || '')) ? 'Круг' : (/лист/i.test(String(c['Тип'] || '')) ? 'Лист' : ''));
    const row = { 'Код': code, 'Марка': String(c['Марка / материал'] || '').trim(), 'Типоразмер': String(c['Типоразмер'] || '').trim(), 'Ед. изм.': 'кг', 'Остаток': 0, 'Резерв': 0, 'Мин. остаток': 0, 'Примечание': String(c['Каноническое наименование'] || '').trim() };
    if (rt) row['Тип проката'] = rt;
    const cr = await ncCreateMany('metal_stock', [row]);
    const rec = Array.isArray(cr) ? cr[0] : cr; const id = rec.Id ?? rec.id;
    try { await ncLinkRecords('metal_stock', 'Номенклатура-канон', id, [canonId]); } catch { /* soft */ }
    created += 1;
  }
  return { ok: true, created, canonMetal: metalCanon.length };
}
// очередь приёмки металла (надстройка 6): принятые ЗнЗ на металл → кандидаты на оприходование.
// Имена полей 1:1 с procurement_requests (createZnzRequest): «№ ЗнЗ»/«Наименование»/«Кол-во»/
// «Ед.изм.»/«Категория»/«Выбранный поставщик»/«Статус». Фильтр: статус «Принята*» + категория «Металл»
// (либо в наименовании есть «металл/лист/круг/ст3/сталь» — толерантно к незаполненной категории).
async function buildMetalIntake() {
  const reqs = await ncListSoft('procurement_requests');
  const isMetal = (r) => {
    const cat = (whLinkVal(r['Категория']) || String(r['Категория'] || '')).toLowerCase();
    if (cat.includes('металл')) return true;
    const nm = String(r['Наименование'] || '').toLowerCase();
    return /металл|лист|круг|прокат|ст3|сталь|\bст\.?\s?3/.test(nm);
  };
  const accepted = reqs.filter((r) => {
    const st = (whLinkVal(r['Статус']) || String(r['Статус'] || '')).toLowerCase();
    return /принят/.test(st) && isMetal(r);
  }).map((r) => ({
    id: r.Id ?? r.id, num: r['№ ЗнЗ'] || '', material: r['Наименование'] || '',
    qty: whNum(r['Кол-во']), unit: r['Ед.изм.'] || 'кг', supplier: r['Выбранный поставщик'] || '',
    status: whLinkVal(r['Статус']) || String(r['Статус'] || ''), date: r['Дата'] || '',
  }));
  return { mode: 'live', items: accepted };
}

