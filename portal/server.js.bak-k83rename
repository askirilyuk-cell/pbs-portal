const STATUSES = ['В очереди', 'В работе', 'Выполнено', 'Приостановлено'];

// --- DEF-04 (вариант B): статус ПЗ ВЫВОДИТСЯ из хода его задач ---------------
//  Триггер: ПЗ-2026-001 висел на доске как «Размещён», хотя задачи по нему уже
//  сгенерированы/идут. Источник истины — агрегат статусов задач (STATUSES),
//  а не руками выставленное поле «Статус» заказа.
//  Маппинг на существующий enum ПЗ (ORDER_OPTS['Статус']) — новых значений НЕ вводим:
//    • задач нет / все «В очереди»/«Приостановлено» (ни одна не начата) → стартовый статус (обычно «Размещён»);
//    • хотя бы одна «В работе» или часть «Выполнено» (но не все)        → «В работе»;
//    • ВСЕ задачи «Выполнено»                                            → «Выполнен».
//  Терминальные/после-производственные и ручные статусы ПЗ НЕ перетираем —
//  это состояния за пределами хода производства: «Отгружен»/«Закрыт»/«Отменён»/«Приостановлен».
const PZ_TERMINAL = new Set(['Отгружен', 'Закрыт', 'Отменён', 'Приостановлен']);
function derivePzStatus(taskStatuses, current) {
  const cur = current || 'Размещён';
  if (PZ_TERMINAL.has(cur)) return cur;                 // ручное/после-производственное — оставляем как есть
  const list = (taskStatuses || []).filter(Boolean);
  if (!list.length) return cur;                         // задач ещё нет → стартовый статус
  if (list.every((s) => s === 'Выполнено')) return 'Выполнен';
  const started = list.some((s) => s === 'В работе' || s === 'Выполнено');
  return started ? 'В работе' : cur;                    // хоть одна пошла → «В работе», иначе стартовый
}
// пересчёт и идемпотентная запись статуса ПЗ по задаче (best-effort; вызывается
// из точки смены статуса задачи). Пишем в БД только при фактическом изменении.
async function syncPzStatusForTask(taskId) {
  const tasks = await ncListSoft('tasks');
  const t = tasks.find((x) => String(x.Id ?? x.id) === String(taskId));
  if (!t) return null;
  const numPz = String(t['№ задачи'] || '').split('/')[0];
  if (!numPz) return null;
  const orders = await ncListSoft('orders');
  const order = orders.find((o) => String(o['№ ПЗ'] || '') === numPz);
  if (!order) return null;
  const sib = tasks.filter((x) => String(x['№ задачи'] || '').startsWith(numPz));
  const want = derivePzStatus(sib.map((x) => x['Статус']), order['Статус']);
  if (want && want !== order['Статус']) { await ncUpdate('orders', order.Id ?? order.id, { 'Статус': want }); return want; }
  return order['Статус'];
}

// --- запись задачи с рабочего места: whitelist полей + коэрция типов --------
//  Принимаем только поля рабочего места; статус сверяем со справочником.
//  При переводе в «Выполнено» без явной даты факта проставляем сегодняшнюю.
function buildTaskPatch(body) {
  const patch = {};
  if (typeof body.status === 'string' && body.status) {
    if (!STATUSES.includes(body.status)) throw new Error(`Недопустимый статус: ${body.status}`);
    patch['Статус'] = body.status;
  }
  if ('factDate' in body) patch['Дата факт.'] = body.factDate ? String(body.factDate).slice(0, 10) : null;
  const num = (v) => (v === '' || v == null ? null : Number(v));
  if ('factQty' in body) patch['Кол-во факт.'] = num(body.factQty);
  if ('factTime' in body) patch['Время факт. (ч)'] = num(body.factTime);
  if ('selfControl' in body) patch['Самоконтроль (С)'] = !!body.selfControl;
  if ('otk' in body) patch['Контроль ОТК'] = !!body.otk;
  if ('note' in body) patch['Примечание'] = String(body.note || '');
  if (patch['Статус'] === 'Выполнено' && !patch['Дата факт.'] && !body.factDate) {
    patch['Дата факт.'] = new Date().toISOString().slice(0, 10);
  }
  return patch;
}

const idOf = (r) => r?.Id ?? r?.id;
const indexById = (rows) => new Map(rows.map((r) => [idOf(r), r]));

async function buildBoardLive() {
  const [orders, positions, tasks, routes, inc, acc, nco, operations, opTypes, sections, opParams, pvals, jrows] = await Promise.all([
    ncList('orders'), ncList('positions'), ncList('tasks'), ncList('routes'),
    ncList('incoming_control'), ncList('acceptance_control'), ncList('nonconformity'),
    ncList('operations'), ncList('op_types'), ncList('sections'), ncList('op_params'), ncList('task_param_values'),
    ncListSoft('journal'),
  ]);
  const employees = await ncListSoft('employees');
  const routeByMk = new Map(routes.map((r) => [String(r['№ МК']), r]));
  const routeById = new Map(routes.map((r) => [r.Id ?? r.id, r]));
  const opById = indexById(operations), otById = indexById(opTypes), secById = indexById(sections);
  const paramById = indexById(opParams), pvById = indexById(pvals), posById = indexById(positions);
  const empById = indexById(employees);
  const journalByTask = new Map();
  for (const j of jrows) {
    const k = String(j['№ задачи'] || '');
    if (!journalByTask.has(k)) journalByTask.set(k, []);
    journalByTask.get(k).push(j);
  }

  // обогащение задачи данными из маршрутной карты (участок/операция/параметры)
  function enrichTask(t) {
    const op = String(t['Операция (№ МК / № оп.)'] || '');
    const operation = opById.get(t.operations_id) || {};
    const opType = otById.get(t.op_types_id) || {};
    const section = secById.get(t.sections_id) || {};
    const position = posById.get(t.positions_id) || {};
    const mk = op.split(' оп.')[0] || '';
    const route = routeByMk.get(mk) || {};
    const secCode = section['Код'] || '', secName = section['Участок'] || '';
    // допущенные исполнители участка (связь «Сотрудники участка»): для выпадающего списка в журнале §7
    const executors = (section['Сотрудники участка'] || [])
      .map((x) => { const f = empById.get(idOf(x)); return (f && f['ФИО']) || x['ФИО'] || ''; })
      .filter(Boolean);
    const jrowsT = (journalByTask.get(String(t['№ задачи'] || '')) || [])
      .map((j) => ({ id: idOf(j), unit: j['№ единицы'] ?? '', executor: j['Исполнитель'] || '',
        blankNo: j['№ заготовки / приёмки'] || '', self: j['Самоконтроль'] || '', otk: j['Контроль ОТК'] || '',
        date: j['Дата'] || '', note: j['Примечание'] || '' }))
      .sort((a, b) => (Number(a.unit) || 0) - (Number(b.unit) || 0));
    // параметры: значения задачи (если есть), иначе набор из типа операции (без значения)
    //  норматив/допуск — план (read-only для рабочего), факт — то, что забил рабочий.
    //  fact с фолбэком на старое «Значение» (до миграции 003); value оставлен для совместимости.
    let params = (t['Значения параметров'] || []).map((x) => pvById.get(idOf(x))).filter(Boolean)
      .map((p) => ({ pid: idOf(p), name: p['Параметр'], unit: p['Единица'] || '',
        norm: p['Норматив'] ?? '', tol: p['Допуск'] ?? '',
        fact: (p['Факт'] ?? p['Значение']) ?? '', verdict: p['Вердикт'] || '',
        value: (p['Факт'] ?? p['Значение']) ?? '' }));
    if (!params.length) {
      params = (opType['Параметры'] || []).map((x) => paramById.get(idOf(x))).filter(Boolean)
        .map((p) => ({ pid: null, name: p['Параметр'], unit: p['Единица'] || '',
          norm: p['Норматив'] ?? '', tol: p['Допуск'] ?? '', fact: '', verdict: '', value: '' }));
    }
    return {
      id: idOf(t), num: t['№ задачи'], op,
      title: opType['Наименование'] || '',
      section: secCode ? (secName ? `${secCode} · ${secName}` : secCode) : '',
      sectionCode: secCode, sectionName: secName,
      opTypeCode: opType['Код типа'] || '', opNum: operation['№ операции'] ?? '',
      status: t['Статус'] || 'В очереди', priority: t['Приоритет'], plan: t['Дата плановая'],
      equip: t['Оборудование'] || operation['Оборудование'] || '',
      ri: opType['РИ'] || '', normTime: operation['Норма времени (ч)'] ?? '',
      materials: t['Входящие материалы'] || operation['Входящие материалы'] || '',
      control: {
        point: operation['Точка контроля'] || '', what: operation['Что контролировать'] || '',
        tol: operation['Допуски'] || '', si: operation['СИ'] || '',
      },
      params, executors,
      // Ф.14 §1–§2 контекст
      qtyPlan: position['Кол-во'] ?? '',
      partName: position['Наименование / обозначение'] || route['Наименование'] || '',
      drawing: position['Чертёж / ТУ'] || '',
      applicability: route['Тип продукции'] || '',
      journal: jrowsT,
      factDate: t['Дата факт.'] || '', factQty: t['Кол-во факт.'] ?? '', factTime: t['Время факт. (ч)'] ?? '',
      selfControl: !!t['Самоконтроль (С)'], otk: !!t['Контроль ОТК'], note: t['Примечание'] || '',
    };
  }

  const ordersOut = orders.map((o) => {
    const numPz = String(o['№ ПЗ'] || '');
    const pos = positions.filter((p) => String(p['Позиция'] || '').startsWith(numPz)).map((p) => {
      // K-72 / Узел 8: id + текущая привязка к МК (routes_id) — для контрола «Маршрут (МК)» в карточке ПЗ
      const prid = (p.routes_id != null) ? Number(p.routes_id) : null;
      return {
        id: p.Id ?? p.id, numPos: p['№ позиции'], name: p['Наименование / обозначение'], drawing: p['Чертёж / ТУ'],
        qty: p['Кол-во'], unit: p['Ед.'], status: p['Статус'],
        routeId: prid, mk: (routeById.get(prid) || {})['№ МК'] || '',
      };
    });
    const tk = tasks.filter((t) => String(t['№ задачи'] || '').startsWith(numPz)).map(enrichTask);
    const mks = [...new Set(tk.map((t) => t.op.split(' оп.')[0]).filter(Boolean))];
    // DEF-04: статус карточки ПЗ — производный от хода задач (не сырое поле БД)
    const derivedStatus = derivePzStatus(tk.map((t) => t.status), o['Статус']);
    return {
      id: o.Id ?? o.id, numPz, customer: o['Заказчик / Инициатор'], orderType: o['Тип заказа'],
      status: derivedStatus, statusStored: o['Статус'], priority: o['Приоритет'], plan: o['Плановый срок'],
      positions: pos, tasks: tk, routes: mks.map((mk) => ({ mk, name: routeByMk.get(mk)?.['Наименование'] || '' })),
    };
  });
  return {
    mode: 'live', base: _tm?.base, statuses: STATUSES, orders: ordersOut,
    controls: {
      // pz/date — точные имена колонок NocoDB (сверены по meta 2026-06-24)
