  for (const r of raw) {
    const k = r.odCanon.toFixed(1);
    let g = byCanon.get(k);
    if (!g) { g = { odCanon: r.odCanon, odIn: r.odIn, exacts: new Set(), walls: new Set() }; byCanon.set(k, g); }
    if (!g.odIn && r.odIn) g.odIn = r.odIn;
    if (Number.isFinite(r.odExact)) g.exacts.add(r.odExact);
    g.walls.add(r.wall);
  }
  return [...byCanon.values()].map((g) => ({
    odCanon: g.odCanon, odIn: g.odIn,
    odExacts: [...g.exacts].sort((a, b) => a - b),
