// K-49: управление ручными назначениями ролей (только Админ).
//  GET  /api/admin/roles → { overrides:[{userId,role,name}], roles:[…] }
//  POST /api/admin/roles { userId, role|null } → задать (role) или снять (null) назначение.
async function bitrixUserName(id) {
  try {
    const r = await bitrixCall('user.get', { ID: id });
    const u = Array.isArray(r) ? r[0] : (r && r.result && r.result[0]);
    if (!u) return null;
    return [u.LAST_NAME, u.NAME, u.SECOND_NAME].filter(Boolean).join(' ').trim() || null;
  } catch { return null; }
}
async function handleRolesGet(req, res) {
  const s = sessionFromReq(req);
  if (!s || !s.isAdmin) return sendJson(res, 403, { error: 'Управление ролями доступно только администратору.' });
  const ids = Object.keys(ROLE_OVERRIDES);
  const names = await Promise.all(ids.map((id) => bitrixUserName(id))); // best-effort; null при недоступности
  const overrides = ids.map((id, i) => ({ userId: id, role: ROLE_OVERRIDES[id], name: names[i] || null }));
  return sendJson(res, 200, { overrides, roles: ASSIGNABLE_ROLES });
}
async function handleRolesPost(req, res) {
  const s = sessionFromReq(req);
  if (!s || !s.isAdmin) return sendJson(res, 403, { error: 'Управление ролями доступно только администратору.' });
  const body = await readBody(req);
  const userId = String(body.userId || '').trim();
  if (!userId || !/^\d+$/.test(userId)) return sendJson(res, 400, { error: 'Нужен числовой userId Bitrix.' });
  const raw = body.role;
  if (raw == null || raw === '' || (Array.isArray(raw) && raw.length === 0)) {
    delete ROLE_OVERRIDES[userId];                       // снять назначение
  } else {
    const arr = (Array.isArray(raw) ? raw : [raw]).map((x) => String(x).trim()).filter(Boolean);
    const uniq = [...new Set(arr)];
    for (const r of uniq) if (!ASSIGNABLE_ROLES.includes(r)) return sendJson(res, 400, { error: 'Неизвестная роль: ' + r, allowed: ASSIGNABLE_ROLES });
    ROLE_OVERRIDES[userId] = uniq.length === 1 ? uniq[0] : uniq; // одну — строкой (совместимость), несколько — массивом
  }
  if (!persistRoleOverrides()) return sendJson(res, 500, { error: 'Не удалось сохранить назначение (ошибка записи файла).' });
  const name = await bitrixUserName(userId);
  return sendJson(res, 200, { ok: true, userId, role: (userId in ROLE_OVERRIDES) ? ROLE_OVERRIDES[userId] : null, name: name || null });
}

// ════════════════════════════════════════════════════════════════════════════
//  Каталог канон-номенклатуры (K-54, migrate-032) — канон + алиасы + история цен.
//  Forward-tolerant: таблиц может ещё не быть (до APPLY) → ncListSoft вернёт [].
//  Стиль 1:1 с разделом «Склад» (buildWarehouseLive/Card, upsert + best-effort link).
// ════════════════════════════════════════════════════════════════════════════
const CAT_CATEGORIES = ['Металл', 'Материалы', 'Инструмент', 'Крепёж / сварка', 'Газы', 'ЛКМ', 'Прочее'];
const CAT_PRICE_SOURCES = ['Счёт', 'Заказ', 'ЗнЗ', 'Прайс', 'Прочее'];
const catLinkId = (v) => { if (v == null) return null; if (Array.isArray(v)) return v.length ? catLinkId(v[0]) : null; if (typeof v === 'object') return v.Id ?? v.id ?? null; return null; };
function catCanonRow(r) {
  return {
    id: r.Id ?? r.id,
    name: String(r['Каноническое наименование'] || '').trim(),
    kind: r['Тип'] || '', grade: r['Марка / материал'] || '', size: r['Типоразмер'] || '',
    iso: r['ISO-обозначение'] || '', category: r['Категория'] || '',
    unit: whLinkVal(r['Единицы измерения']), note: r['Примечание'] || '',
  };
}
function catAliasRow(r) {
  return {
    id: r.Id ?? r.id, canonId: catLinkId(r['Номенклатура-канон']),
    name: String(r['Наименование'] || '').trim(), source: r['Источник / производитель'] || '',
    sourceUnit: r['Единица в источнике'] || '', factor: r['Коэффициент к базовой'] ?? '',
    note: r['Примечание'] || '',
  };
}
function catPriceRow(r) {
  return {
    id: r.Id ?? r.id, canonId: catLinkId(r['Номенклатура-канон']),
    date: r['Дата'] || '', supplier: r['Поставщик'] || '',
    price: whNum(r['Цена']), unit: r['Единица'] || '', qty: whNum(r['Кол-во']),
    priceBase: whNum(r['Цена в базовой ед']), sourceName: r['Наименование в источнике'] || '',
    source: r['Источник'] || '', note: r['Примечание'] || '', title: r['Заголовок'] || '',
  };
}
// метрика цены по канону: разброс «от X до Y ₽/ед» (по «Цена в базовой ед», фолбэк «Цена»)
function catPriceStats(rows) {
  const vals = rows.map((p) => (p.priceBase || p.price)).filter((n) => Number.isFinite(n) && n > 0);
  const sorted = rows.slice().sort((a, b) => String(a.date).localeCompare(String(b.date)));
  const last = sorted.length ? (sorted[sorted.length - 1].priceBase || sorted[sorted.length - 1].price) : null;
  if (!vals.length) return { count: rows.length, min: null, max: null, last };
  return { count: rows.length, min: Math.min(...vals), max: Math.max(...vals), last };
}
async function buildCatalogLive() {
  const [canon, aliases, prices] = await Promise.all([
    ncListSoft('catalog_canon'), ncListSoft('catalog_aliases'), ncListSoft('catalog_prices'),
  ]);
  const al = aliases.map(catAliasRow), pr = prices.map(catPriceRow);
  const items = canon.map((r) => {
    const c = catCanonRow(r);
    const stats = catPriceStats(pr.filter((p) => String(p.canonId) === String(c.id)));
    return {
      ...c, aliasCount: al.filter((a) => String(a.canonId) === String(c.id)).length,
      priceCount: stats.count, priceMin: stats.min, priceMax: stats.max, priceLast: stats.last,
    };
  }).sort((a, b) => a.name.localeCompare(b.name, 'ru'));
  const kpis = { canon: items.length, aliases: al.length, prices: pr.length, noAlias: items.filter((i) => !i.aliasCount).length };
  return { mode: 'live', items, kpis, categories: CAT_CATEGORIES, priceSources: CAT_PRICE_SOURCES };
}
async function buildCatalogCard(id) {
  const [canon, aliases, prices] = await Promise.all([
    ncListSoft('catalog_canon'), ncListSoft('catalog_aliases'), ncListSoft('catalog_prices'),
  ]);
  const r = canon.find((x) => String(x.Id ?? x.id) === String(id));
  if (!r) return null;
  const c = catCanonRow(r);
  const myAliases = aliases.map(catAliasRow).filter((a) => String(a.canonId) === String(c.id));
  const myPrices = prices.map(catPriceRow).filter((p) => String(p.canonId) === String(c.id))
    .sort((a, b) => String(b.date).localeCompare(String(a.date)));
  return { mode: 'live', item: c, aliases: myAliases, prices: myPrices, priceStats: catPriceStats(myPrices), categories: CAT_CATEGORIES, priceSources: CAT_PRICE_SOURCES };
}
// upsert канона + best-effort привязка базовой единицы (dict_units)
async function catalogSaveCanon(body) {
  const name = String(body.name || '').trim();
  if (!name) throw new Error('Укажите каноническое наименование.');
  const cat = String(body.category || '').trim();
  if (cat && !CAT_CATEGORIES.includes(cat)) throw new Error(`Недопустимая категория «${cat}».`);
  const row = { 'Каноническое наименование': name };
  if (body.kind != null) row['Тип'] = String(body.kind || '').trim();
  if (body.grade != null) row['Марка / материал'] = String(body.grade || '').trim();
  if (body.size != null) row['Типоразмер'] = String(body.size || '').trim();
  if (body.iso != null) row['ISO-обозначение'] = String(body.iso || '').trim();
  if (cat) row['Категория'] = cat;
  if (body.note != null) row['Примечание'] = String(body.note || '').trim();
  let canonId = body.id ?? null;
  if (canonId != null && canonId !== '') { await ncUpdate('catalog_canon', canonId, row); }
  else {
    // DEF-26: перед create проверяем дубль по «Каноническое наименование» (нормализация как в
    // catalogLookup: trim + toLowerCase). Reject-400 в стиле прочих guard-валидаций каталога —
    // «одна карточка на изделие». Update-путь (пришёл id) не затрагиваем.
    const norm = name.toLowerCase();
    const dup = (await ncListSoft('catalog_canon')).find((r) => String(r['Каноническое наименование'] || '').trim().toLowerCase() === norm);
    if (dup) { const e = new Error(`Канон с наименованием «${name}» уже существует (Id=${dup.Id ?? dup.id}). Откройте существующую карточку.`); e.status = 400; throw e; }
    const cr = await ncCreateMany('catalog_canon', [row]); const c = Array.isArray(cr) ? cr[0] : cr; canonId = c.Id ?? c.id;
  }
  const unit = String(body.unit || '').trim();
  if (unit) {
    try {
      const u = (await ncListSoft('dict_units')).find((x) => String(x['Значение'] || '').trim() === unit);
      if (u) await ncLinkRecords('catalog_canon', 'Единицы измерения', canonId, [u.Id ?? u.id]);
    } catch { /* имя реципрока/связи может отличаться — не критично для MVP */ }
  }
  return { ok: true, id: canonId, name };
}
async function catalogSaveAlias(body) {
  const canonId = body.canonId ?? body.canon ?? null;
  if (canonId == null || canonId === '') throw new Error('Не указан канон (canonId) для алиаса.');
  const name = String(body.name || '').trim();
  if (!name) throw new Error('Укажите наименование-алиас.');
  const row = { 'Наименование': name };
  if (body.source != null) row['Источник / производитель'] = String(body.source || '').trim();
  if (body.sourceUnit != null) row['Единица в источнике'] = String(body.sourceUnit || '').trim();
  if (body.factor != null && body.factor !== '') row['Коэффициент к базовой'] = whNum(body.factor);
  if (body.note != null) row['Примечание'] = String(body.note || '').trim();
  let aliasId = body.id ?? null;
  if (aliasId != null && aliasId !== '') { await ncUpdate('catalog_aliases', aliasId, row); }
  else { const cr = await ncCreateMany('catalog_aliases', [row]); const a = Array.isArray(cr) ? cr[0] : cr; aliasId = a.Id ?? a.id; }
  try { await ncLinkRecords('catalog_aliases', 'Номенклатура-канон', aliasId, [canonId]); }
  catch { try { await ncLinkRecords('catalog_canon', 'Алиасы', canonId, [aliasId]); } catch { /* best-effort */ } }
  return { ok: true, id: aliasId, canonId };
}
async function catalogAddPrice(body) {
  const canonId = body.canonId ?? body.canon ?? null;
  if (canonId == null || canonId === '') throw new Error('Не указан канон (canonId) для записи цены.');
  const price = whNum(body.price);
  if (!(price > 0)) throw new Error('Укажите положительную цену.');
  const src = String(body.source || '').trim();
  if (src && !CAT_PRICE_SOURCES.includes(src)) throw new Error(`Недопустимый источник «${src}».`);
  const dateIso = body.date ? String(body.date).slice(0, 10) : whToday();
  const canon = (await ncListSoft('catalog_canon')).find((x) => String(x.Id ?? x.id) === String(canonId));
  const canonName = canon ? String(canon['Каноническое наименование'] || '').trim() : '';
  const supplier = String(body.supplier || '').trim();
  const unit = String(body.unit || '').trim();
  const qty = (body.qty != null && body.qty !== '') ? whNum(body.qty) : null;
  // нормализация к базовой ед: в MVP НЕ авто-конвертируем — берём явное priceBase, иначе цена/кол-во
  const priceBase = (body.priceBase != null && body.priceBase !== '') ? whNum(body.priceBase)
    : (qty && qty > 0 ? +(price / qty).toFixed(4) : price);
  const row = {
    'Заголовок': `${canonName || 'канон #' + canonId} · ${supplier || '—'} · ${whRuDate(dateIso)}`,
    'Дата': dateIso, 'Поставщик': supplier, 'Цена': price, 'Единица': unit, 'Цена в базовой ед': priceBase,
  };
  if (qty != null) row['Кол-во'] = qty;
  if (body.sourceName) row['Наименование в источнике'] = String(body.sourceName).trim();
  if (src) row['Источник'] = src;
  if (body.note) row['Примечание'] = String(body.note).trim();
  const cr = await ncCreateMany('catalog_prices', [row]);
  const pRow = Array.isArray(cr) ? cr[0] : cr;
  const priceId = pRow.Id ?? pRow.id;
  try { await ncLinkRecords('catalog_prices', 'Номенклатура-канон', priceId, [canonId]); }
  catch { try { await ncLinkRecords('catalog_canon', 'История цен', canonId, [priceId]); } catch { /* best-effort */ } }
  return { ok: true, id: priceId, canonId, priceBase };
}
// lookup «алиас → канон»: поиск по алиасам и каноническим наименованиям
async function catalogLookup(q) {
  const query = String(q || '').trim().toLowerCase();
  if (!query) return { query, matches: [] };
  const [canon, aliases] = await Promise.all([ncListSoft('catalog_canon'), ncListSoft('catalog_aliases')]);
  const canonById = new Map(canon.map((r) => [String(r.Id ?? r.id), catCanonRow(r)]));
  const matches = [];
  for (const a of aliases.map(catAliasRow)) {
    if (a.name.toLowerCase().includes(query)) {
      const c = canonById.get(String(a.canonId));
      matches.push({ via: 'alias', alias: a.name, source: a.source, sourceUnit: a.sourceUnit, canonId: a.canonId, canonName: c ? c.name : '', baseUnit: c ? c.unit : '' });
    }
  }
  for (const [, c] of canonById) {
    if (c.name.toLowerCase().includes(query)) matches.push({ via: 'canon', alias: c.name, canonId: c.id, canonName: c.name, baseUnit: c.unit });
  }
  return { query, matches: matches.slice(0, 50) };
}

const server = http.createServer(async (req, res) => {
  const url = new URL(req.url, `http://localhost:${PORT}`);
  const p = url.pathname;
  try {
    const svc = serviceCtx(req); // null для браузера; { service, actor } для MCP-агента (иначе 401)
    if (p.startsWith('/auth/')) { if (await handleAuth(req, res, p, url)) return; }
    // K-49 middleware (МЯГКИЙ режим): определяем сессию/роль и кладём в контекст запроса.
    //  НИЧЕГО не блокирует — существующие /api/* работают как раньше (роль лишь информативна).
    req.session = sessionFromReq(req);
    req.roles = sessionPortalRoles(req.session);           // мультироль: эффективный набор портальных ролей
    req.role = req.roles[0] || 'guest';                    // первичная (для сообщений/обратной совместимости)
    if (p === '/api/me') return handleMe(req, res);
    if (p === '/api/admin/view-as' && req.method === 'POST') { await handleViewAs(req, res); return; }
    if (p === '/api/admin/reset-view' && req.method === 'POST') { await handleResetView(req, res); return; }
    if (p === '/api/admin/roles' && req.method === 'GET') { await handleRolesGet(req, res); return; }
    if (p === '/api/admin/roles' && req.method === 'POST') { await handleRolesPost(req, res); return; }
    // K-49 Шаг 2: серверный enforcement (активен ТОЛЬКО при RBAC_ENFORCE ON; иначе no-op).
    if (await rbacEnforce(req, res, p)) return;
    if (p === '/api/health') return sendJson(res, 200, { ok: true, ...settingsView() });
    if (p === '/api/settings' && req.method === 'GET') return sendJson(res, 200, settingsView());
    if (p === '/api/settings' && req.method === 'POST') { saveSettings(await readBody(req)); return sendJson(res, 200, settingsView()); }
    if (p === '/api/dict' && req.method === 'GET') {
      if (!isLive()) return sendJson(res, 200, { mode: 'mock', dicts: [] });
      const out = [];
      for (const d of DICTS) { let n = 0; try { n = (await ncListSoft(d.key)).length; } catch {} out.push({ key: d.key, title: d.title, count: n }); }
      return sendJson(res, 200, { mode: 'live', dicts: out });
    }
    if (p === '/api/dict/rows' && req.method === 'GET') {
      const key = url.searchParams.get('key') || '';
      if (!isDict(key)) return sendJson(res, 400, { error: 'неизвестный справочник' });
      if (!isLive()) return sendJson(res, 200, { key, columns: [], rows: [], warning: 'LIVE недоступен — задайте токен NocoDB.' });
      try { const [columns, rows] = await Promise.all([dictColumns(key), ncList(key)]); return sendJson(res, 200, { key, columns, rows }); }
      catch (e) { return sendJson(res, 200, { key, columns: [], rows: [], warning: String(e.message || e) }); }
    }
    if (p === '/api/dict/rows' && req.method === 'POST') {
      const key = url.searchParams.get('key') || '';
      if (!isDict(key)) return sendJson(res, 400, { error: 'неизвестный справочник' });
      try { const body = await readBody(req); const r = await ncCreateMany(key, [await sanitizeDictRow(key, body)]); return sendJson(res, 200, { ok: true, row: Array.isArray(r) ? r[0] : r }); }
      catch (e) { return sendJson(res, 400, { error: String(e.message || e) }); }
