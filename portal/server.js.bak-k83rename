  if (dirValue) { const d = (await ncListSoft('dict_issue_directions')).find((r) => String(r['Значение'] || '').trim() === dirValue); if (d) await tryLink('dict_issue_directions', 'Проводки (направление)', d.Id ?? d.id); }
  if (itemId != null) await tryLink('warehouse_items', 'Движения', itemId);
