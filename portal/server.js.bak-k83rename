// POST создать/обновить карту наладки + пересоздать строки (образец saveRoute)
async function saveSetupCard(body) {
  const name = String(body.name || '').trim();
  if (!name) throw new Error('Не задано наименование карты наладки.');
  const machineId = (body.machineId != null && body.machineId !== '') ? Number(body.machineId) : null;
  if (!machineId || !Number.isFinite(machineId)) throw new Error('Не выбран станок (обязательное поле).');
  const status = SETUP_STATUSES.includes(String(body.status || '').trim()) ? String(body.status).trim() : 'Черновик';
  const linesIn = Array.isArray(body.lines) ? body.lines : [];

  const eqRows = await ncListSoft('equipment');
  const eq = eqRows.find((r) => String(r.Id ?? r.id) === String(machineId));
  if (!eq) throw new Error(`Станок id=${machineId} не найден в реестре оборудования.`);
  const e = eqShape(eq);

  // тип головки (снапшот): явно из тела (с UI) → иначе тип станка. Определяет геометрию и число позиций.
  const headTypeEff = String(body.headType || e.headType || '').trim();
  // N позиций: явно из тела (снапшот с UI) → иначе от типа головки + «Позиций револьвера» станка (плоская → 4)
  const revolverSlots = (body.revolverSlots != null && body.revolverSlots !== '') ? effRevolver(body.revolverSlots) : effSlots(headTypeEff, e.revolverSlots);

  const cardRow = { 'Наименование': name, 'Статус': status };
  cardRow['Модель-снапшот'] = [e.name, e.model].filter(Boolean).join(' · ') || e.invNo || '';
  // снапшот N (migrate-038); defensive ensure — карта помнит N даже если у станка потом изменят
  try { await ncEnsureColumn('setup_cards', 'Позиций револьвера (снапшот)', 'Decimal'); cardRow['Позиций револьвера (снапшот)'] = revolverSlots; }
  catch (eN) { console.warn('карта наладки: снапшот N не сохранён (колонка недоступна):', eN.message); }
  // снапшот типа головки (migrate-039); карта помнит геометрию (круг/плоскость) на момент создания
  try { await ncEnsureColumn('setup_cards', 'Тип головки (снапшот)', 'SingleLineText'); if (headTypeEff) cardRow['Тип головки (снапшот)'] = headTypeEff; }
  catch (eH) { console.warn('карта наладки: снапшот типа головки не сохранён (колонка недоступна):', eH.message); }
  // вид операции (migrate-040); подраздел карты. Явно из тела → иначе «Токарная».
  // Новые карты из токарного подраздела создаются с видом=Токарная (fallback).
  const operationKind = effOperationKind(body.operationKind);
  try { await ncEnsureColumn('setup_cards', 'Вид операции', 'SingleLineText'); cardRow['Вид операции'] = operationKind; }
  catch (eK) { console.warn('карта наладки: вид операции не сохранён (колонка недоступна):', eK.message); }
  if ('part' in body) cardRow['Деталь'] = String(body.part || '').trim();
  if ('author' in body) cardRow['Автор'] = String(body.author || '').trim();
  // блок «Зажим и кулачки» (migrate-041); defensive ensure — карта сохраняет фактические параметры операции.
  const jawIn = (body.jaw && typeof body.jaw === 'object') ? body.jaw : {};
  for (const [col, key, uidt] of SETUP_JAW_FIELDS) {
    if (!(key in jawIn)) continue;
    try { await ncEnsureColumn('setup_cards', col, uidt); cardRow[col] = String(jawIn[key] || '').trim(); }
    catch (eJ) { console.warn(`карта наладки: поле «${col}» не сохранено (колонка недоступна):`, eJ.message); }
  }

  let cardId = (body.id != null && body.id !== '') ? Number(body.id) : null;
  let no = '';
  if (cardId == null) {
    const year = new Date().getFullYear();
    no = await nextSetupNumber(year);
    cardRow['№'] = no;
    cardRow['Дата'] = new Date().toISOString().slice(0, 10);
    const cr = await ncCreateMany('setup_cards', [cardRow]);
    const c = Array.isArray(cr) ? cr[0] : cr; cardId = c.Id ?? c.id;
  } else {
    await ncUpdate('setup_cards', cardId, cardRow);
    const cards = await ncListSoft('setup_cards');
    no = (cards.find((x) => (x.Id ?? x.id) === cardId) || {})['№'] || '';
    // пересборка строк: удаляем прежние строки карты
    const oldLines = await ncListSoft('setup_card_lines');
    const oldIds = oldLines.filter((l) => setupLineOfCard(l, cardId)).map((l) => l.Id ?? l.id);
    if (oldIds.length) await ncDeleteMany('setup_card_lines', oldIds);
  }

  // связь «Станок» (mm, ровно один) — заменяем текущую
  try {
    const cur = await ncListLinked('setup_cards', 'Станок', cardId).catch(() => []);
    const curIds = cur.map((x) => Number(x.Id ?? x.id)).filter(Number.isFinite);
    const toRemove = curIds.filter((x) => x !== machineId);
    if (toRemove.length) await ncUnlinkRecords('setup_cards', 'Станок', cardId, toRemove);
    if (!curIds.includes(machineId)) await ncLinkRecords('setup_cards', 'Станок', cardId, [machineId]);
  } catch (e2) { console.error(`[${new Date().toISOString()}] setup-card machine link failed (${no}):`, (e2 && e2.message) || e2); }

  // связь «Комплект кулачков» (mm, ровно один; migrate-041) — заменяем текущую, если передан chuckSetId
  if (jawIn && 'chuckSetId' in jawIn) {
    const wantSet = (jawIn.chuckSetId != null && jawIn.chuckSetId !== '') ? Number(jawIn.chuckSetId) : null;
    try {
      const cur = await ncListLinked('setup_cards', 'Комплект кулачков', cardId).catch(() => []);
      const curIds = cur.map((x) => Number(x.Id ?? x.id)).filter(Number.isFinite);
      const toRemove = curIds.filter((x) => x !== wantSet);
      if (toRemove.length) await ncUnlinkRecords('setup_cards', 'Комплект кулачков', cardId, toRemove);
      if (wantSet != null && !curIds.includes(wantSet)) await ncLinkRecords('setup_cards', 'Комплект кулачков', cardId, [wantSet]);
    } catch (eJl) { console.error(`[${new Date().toISOString()}] setup-card jaw-set link failed (${no}):`, (eJl && eJl.message) || eJl); }
  }

  // пересоздание строк = ЗАПОЛНЕННЫЕ слоты револьвера. № п/п = номер слота (T1..TN);
  // пустые слоты («свободно») не хранятся — при загрузке UI/печать разворачивают N и
  // заполняют по номеру. Слот считается пустым, если нет ни державки/пластины, ни
  // вылета/параметров/примечания (сам факт номера слота строку не создаёт).
  let lineCount = 0;
  for (let i = 0; i < linesIn.length; i++) {
    const ln = linesIn[i];
    const slot = Number(ln.slot) > 0 ? Math.round(Number(ln.slot)) : (i + 1);
    const toolPos = String(ln.toolPos || '').trim() || ('T' + slot);
    const holderId = (ln.holderId != null && ln.holderId !== '') ? Number(ln.holderId) : null;
    const insertId = (ln.insertId != null && ln.insertId !== '') ? Number(ln.insertId) : null;
    const overhang = String(ln.overhang || '').trim();
    const params = String(ln.params || '').trim();
    const note = String(ln.note || '').trim();
    if (holderId == null && insertId == null && !overhang && !params && !note) continue; // пустой слот — не храним
    const lineRow = { '№ п/п': slot };
    if (toolPos) lineRow['Позиция инструмента'] = toolPos;
    if (overhang) lineRow['Вылет'] = overhang;
    if (params) lineRow['Параметры'] = params;
    if (note) lineRow['Примечание'] = note;
    const cr = await ncCreateMany('setup_card_lines', [lineRow]);
    const cl = Array.isArray(cr) ? cr[0] : cr; const lineId = cl.Id ?? cl.id;
    await ncLinkRecords('setup_cards', 'Строки карты наладки', cardId, [lineId]);
    if (holderId != null) { try { await ncLinkRecords('setup_card_lines', 'Державка', lineId, [holderId]); } catch (e3) { console.warn('карта наладки: связь строка→державка не создана:', e3.message); } }
    if (insertId != null) { try { await ncLinkRecords('setup_card_lines', 'Пластина', lineId, [insertId]); } catch (e4) { console.warn('карта наладки: связь строка→пластина не создана:', e4.message); } }
    lineCount++;
  }
  return { ok: true, id: cardId, no, lines: lineCount };
}
// DELETE карта наладки + её строки
async function deleteSetupCard(id) {
  const cardId = Number(id);
  if (!Number.isFinite(cardId)) { const e = new Error('Некорректный id карты наладки.'); e.status = 400; throw e; }
  const lines = await ncListSoft('setup_card_lines');
  const oldIds = lines.filter((l) => setupLineOfCard(l, cardId)).map((l) => l.Id ?? l.id);
  if (oldIds.length) await ncDeleteMany('setup_card_lines', oldIds);
  await ncDeleteMany('setup_cards', [cardId]);
  return { ok: true, id: cardId, deletedLines: oldIds.length };
}

// ── Библиотека комплектов кулачков (Этап 2c, migrate-041): «Комплекты кулачков»
//    (chuck_jaws). Справочник по образцу ISO-каталога (tool_inserts/holders):
//    upsert по № комплекта, эскиз/фото на диске портала. Совместимость — по
//    патрону привязанного станка (mm «Станок» → equipment). ──
const CJ_TYPES = ['Сырые', 'Расточенные', 'Закалённые', 'Твёрдые'];
const CJ_COUNTS = ['2', '3', '4', '6'];
const CJ_CONDITIONS = ['Годен', 'Износ', 'Списан'];
const CJ_PHOTO_ROOT = path.join(__dirname, '.data', 'chuck-jaws');
// каталог файлов комплекта: .data/chuck-jaws/<№ sanitized>/
function cjDir(setNo, create) {
  const safe = String(setNo || '').replace(/[\\/:*?"<>|]/g, '_').replace(/^\.+/, '').trim();
  if (!safe) return null;
  const dir = path.join(CJ_PHOTO_ROOT, safe);
