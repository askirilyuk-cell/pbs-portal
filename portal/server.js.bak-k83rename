    if (p === '/api/chuck-jaw/save' && req.method === 'POST') { // создать/обновить комплект кулачков (upsert по №)
      if (!isLive()) return sendJson(res, 501, { error: 'Заведение комплекта кулачков доступно только в LIVE-режиме: задайте токен NocoDB.' });
      try { return sendJson(res, 200, await chuckJawSave(await readBody(req))); }
      catch (e) { return sendJson(res, e.status || 400, { error: String(e.message || e) }); }
    }
    if (p === '/api/chuck-jaw/upload' && req.method === 'POST') { // эскиз/фото комплекта → rw .data/chuck-jaws
      if (!isLive()) return sendJson(res, 501, { error: 'Загрузка файлов доступна только в LIVE-режиме.' });
      const ct = String(req.headers['content-type'] || '');
      const bm = /boundary=(?:"([^"]+)"|([^;]+))/i.exec(ct);
      if (!/multipart\/form-data/i.test(ct) || !bm) return sendJson(res, 400, { error: 'Ожидается multipart/form-data.' });
      let raw; try { raw = await readRawBody(req, 64 * 1024 * 1024); } catch (e) { return sendJson(res, 413, { error: String(e.message || e) }); }
      const { fields, files } = parseMultipart(raw, (bm[1] || bm[2]).trim());
      const setNo = String(fields.setNo || fields.code || '').trim();
      if (!setNo) return sendJson(res, 400, { error: 'Не указан № комплекта (setNo).' });
      if (!files.length) return sendJson(res, 400, { error: 'Файлы не переданы.' });
      const dir = cjDir(setNo, true);
      if (!dir) return sendJson(res, 400, { error: `Не удалось создать папку файлов для ${setNo}.` });
      const saved = [], skipped = [];
      for (const f of files) {
        if (!TC_FILE_EXT.test(String(f.filename))) { skipped.push(String(f.filename)); continue; }
        const rel = saveFileUnique(dir, dir, path.basename(String(f.filename)), f.data);
        rel ? saved.push(rel) : skipped.push(String(f.filename));
      }
      return sendJson(res, 200, { ok: true, setNo, saved, skipped, files: cjFiles(setNo) });
    }
    if (p === '/api/chuck-jaw/file') { // отдача эскиза/фото комплекта (traversal-guard; dl=1 — скачивание)
      const setNo = url.searchParams.get('setNo') || '', rel = url.searchParams.get('rel') || '';
      const dir = cjDir(setNo);
      if (!dir) { res.writeHead(404); return res.end('Путь к файлу не задан'); }
      const target = path.normalize(path.join(dir, rel));
      if (target !== dir && !target.startsWith(dir + path.sep)) { res.writeHead(403); return res.end('Доступ запрещён'); }
      let st; try { st = fs.statSync(target); } catch { res.writeHead(404); return res.end('Файл не найден'); }
      if (!st.isFile()) { res.writeHead(404); return res.end('Не файл'); }
      const ext = (target.split('.').pop() || '').toLowerCase();
      const ctp = FILE_MIME[ext] || MIME['.' + ext] || 'application/octet-stream';
      const dl = url.searchParams.get('dl') === '1';
      const fn = encodeURIComponent(path.basename(target));
      res.writeHead(200, { 'Content-Type': ctp, 'Content-Disposition': `${dl ? 'attachment' : 'inline'}; filename*=UTF-8''${fn}`, 'Cache-Control': 'private, max-age=60' });
      const s = fs.createReadStream(target);
      s.on('error', () => { if (!res.headersSent) res.writeHead(500); res.end(); });
      return s.pipe(res);
    }
    // ── ISO-каталог режущего инструмента (Этап 2a): пластины (ISO 1832) + державки (ISO 5608) ──
    if (p === '/api/tool-catalog/inserts' || p === '/api/tool-catalog/holders') { // список + KPI
      const kind = p.endsWith('/holders') ? 'holders' : 'inserts';
      if (!isLive()) return sendJson(res, 200, { mode: 'mock', kind, items: [], kpis: {}, dict: {} });
      try { return sendJson(res, 200, await buildToolCatalog(kind)); }
      catch (e) { return sendJson(res, 200, { mode: 'mock', kind, items: [], kpis: {}, dict: {}, warning: String(e.message || e) }); }
    }
    if (p === '/api/tool-catalog/insert' || p === '/api/tool-catalog/holder') { // карточка позиции + файлы с диска
      const kind = p.endsWith('/holder') ? 'holders' : 'inserts';
      if (!isLive()) return sendJson(res, 200, { mode: 'mock' });
      try { const d = await buildToolCatalogCard(kind, url.searchParams.get('id')); return d ? sendJson(res, 200, d) : sendJson(res, 404, { error: 'позиция каталога не найдена' }); }
      catch (e) { return sendJson(res, 200, { mode: 'mock', warning: String(e.message || e) }); }
    }
    if ((p === '/api/tool-catalog/insert/save' || p === '/api/tool-catalog/holder/save') && req.method === 'POST') {
      if (!isLive()) return sendJson(res, 501, { error: 'Заведение позиции ISO-каталога доступно только в LIVE-режиме: задайте токен NocoDB.' });
      const holders = p.startsWith('/api/tool-catalog/holder');
      try { return sendJson(res, 200, await (holders ? toolHolderSave : toolInsertSave)(await readBody(req))); }
      catch (e) { return sendJson(res, e.status || 400, { error: String(e.message || e) }); }
    }
    if ((p === '/api/tool-catalog/insert/upload' || p === '/api/tool-catalog/holder/upload') && req.method === 'POST') { // эскиз ISO-схемы / фото → rw .data/tool-catalog
      if (!isLive()) return sendJson(res, 501, { error: 'Загрузка файлов доступна только в LIVE-режиме.' });
      const kind = p.startsWith('/api/tool-catalog/holder') ? 'holders' : 'inserts';
      const ct = String(req.headers['content-type'] || '');
      const bm = /boundary=(?:"([^"]+)"|([^;]+))/i.exec(ct);
      if (!/multipart\/form-data/i.test(ct) || !bm) return sendJson(res, 400, { error: 'Ожидается multipart/form-data.' });
      let raw; try { raw = await readRawBody(req, 64 * 1024 * 1024); } catch (e) { return sendJson(res, 413, { error: String(e.message || e) }); }
      const { fields, files } = parseMultipart(raw, (bm[1] || bm[2]).trim());
      const iso = String(fields.iso || fields.code || '').trim();
      if (!iso) return sendJson(res, 400, { error: 'Не указан ISO-код позиции (iso).' });
      if (!files.length) return sendJson(res, 400, { error: 'Файлы не переданы.' });
      const dir = tcDir(kind, iso, true);
      if (!dir) return sendJson(res, 400, { error: `Не удалось создать папку файлов для ${iso}.` });
      const saved = [], skipped = [];
      for (const f of files) {
        if (!TC_FILE_EXT.test(String(f.filename))) { skipped.push(String(f.filename)); continue; }
        const rel = saveFileUnique(dir, dir, path.basename(String(f.filename)), f.data);
        rel ? saved.push(rel) : skipped.push(String(f.filename));
      }
      return sendJson(res, 200, { ok: true, kind, iso, saved, skipped, files: tcFiles(kind, iso) });
    }
    if (p === '/api/tool-catalog/insert/file' || p === '/api/tool-catalog/holder/file') { // отдача эскиза/фото (traversal-guard; dl=1 — скачивание)
      const kind = p.startsWith('/api/tool-catalog/holder') ? 'holders' : 'inserts';
      const iso = url.searchParams.get('iso') || '', rel = url.searchParams.get('rel') || '';
      const dir = tcDir(kind, iso);
      if (!dir) { res.writeHead(404); return res.end('Путь к файлу не задан'); }
      const target = path.normalize(path.join(dir, rel));
      if (target !== dir && !target.startsWith(dir + path.sep)) { res.writeHead(403); return res.end('Доступ запрещён'); }
      let st; try { st = fs.statSync(target); } catch { res.writeHead(404); return res.end('Файл не найден'); }
      if (!st.isFile()) { res.writeHead(404); return res.end('Не файл'); }
      const ext = (target.split('.').pop() || '').toLowerCase();
      const ctp = FILE_MIME[ext] || MIME['.' + ext] || 'application/octet-stream';
      const dl = url.searchParams.get('dl') === '1';
      const fn = encodeURIComponent(path.basename(target));
      res.writeHead(200, { 'Content-Type': ctp, 'Content-Disposition': `${dl ? 'attachment' : 'inline'}; filename*=UTF-8''${fn}`, 'Cache-Control': 'private, max-age=60' });
      const s = fs.createReadStream(target);
      s.on('error', () => { if (!res.headersSent) res.writeHead(500); res.end(); });
      return s.pipe(res);
    }
    // ── Раздел «Логистика» — Заявки на перевозку (ЗПер). Файловое хранилище. ──
    if (p === '/api/logistics' && req.method === 'GET') {
      const st = logiRead();
      return sendJson(res, 200, { mode: 'file', shipments: st.shipments || [], types: LOGI_TYPES, statuses: LOGI_STATUSES });
    }
    // список ПЗ + готовые позиции для конструктора упак. листа (масса теор. — из реестра чертежей)
    if (p === '/api/logistics/orders' && req.method === 'GET') {
      let board; try { board = isLive() ? await buildBoardLive() : boardMock(); } catch { board = boardMock(); }
      const masses = drawMassRead();
      const orders = (board.orders || []).map((o) => ({
        id: o.id, numPz: o.numPz, customer: o.customer, status: o.status,
        positions: (o.positions || []).map((ps) => ({
          id: ps.id, numPos: ps.numPos, name: ps.name, drawing: ps.drawing, qty: ps.qty, unit: ps.unit, status: ps.status,
          massTheor: (masses[drawKey(ps.drawing)] || {}).mass ?? '',
        })),
      }));
      return sendJson(res, 200, { mode: board.mode || 'mock', orders });
    }
    // создать / изменить заявку (весь объект целиком, включая упак. листы)
    if (p === '/api/logistics/save' && req.method === 'POST') {
      try {
        const body = await readBody(req);
        const st = logiRead();
        let prev = null;
        if (body.id != null) prev = st.shipments.find((s) => String(s.id) === String(body.id)) || null;
        const norm = logiNormShipment(body, prev);
        if (!prev) { norm.id = 'ship' + Date.now().toString(36); norm.num = logiNextNum(st); st.shipments.push(norm); }
        else { Object.assign(prev, norm); }
        // побочно: сохранить теор. массы деталей из упак. листов в реестр чертежей (заводится один раз)
        for (const upl of norm.packingLists) for (const pk of upl.places) for (const it of pk.items) {
          if (it.drawing && it.massTheor !== '' && it.massTheor != null) drawMassSet(it.drawing, it.massTheor);
        }
        logiWrite(st);
        return sendJson(res, 200, { ok: true, shipment: prev || norm });
      } catch (e) { return sendJson(res, 400, { error: String(e.message || e) }); }
    }
    if (p === '/api/logistics/delete' && req.method === 'POST') {
      try {
        const body = await readBody(req); const st = logiRead();
        const n = st.shipments.length; st.shipments = st.shipments.filter((s) => String(s.id) !== String(body.id));
        logiWrite(st); return sendJson(res, 200, { ok: true, removed: n - st.shipments.length });
      } catch (e) { return sendJson(res, 400, { error: String(e.message || e) }); }
    }
    // смена статуса + ЗАГЛУШКА связи с производством («отгружено» в ПЗ — на доработке, см. отчёт)
    if (p === '/api/logistics/status' && req.method === 'POST') {
      try {
        const body = await readBody(req); const st = logiRead();
        const s = st.shipments.find((x) => String(x.id) === String(body.id));
        if (!s) throw new Error('Заявка не найдена.');
        if (!LOGI_STATUSES.includes(String(body.status))) throw new Error('Недопустимый статус.');
        s.status = String(body.status); s.updatedTs = new Date().toISOString();
        // TODO(связь с производством): при «Передано перевозчику»/«В пути»/«Доставлено» проставить
        // в ПЗ статус «Отгружен». Пока ЗАГЛУШКА — фиксируем намерение локально, без записи в NocoDB.
        let pzStub = [];
        if (['Передано перевозчику', 'В пути', 'Доставлено'].includes(s.status)) {
          pzStub = [...new Set((s.packingLists || []).map((u) => u.orderPz).filter(Boolean))];
          s.pzShippedStub = pzStub;
        }
        logiWrite(st);
        return sendJson(res, 200, { ok: true, status: s.status, pzShipStub: pzStub });
      } catch (e) { return sendJson(res, 400, { error: String(e.message || e) }); }
    }
    // реестр масс деталей по чертежам (карточка чертежа заполняется один раз — ТЗ §7)
    if (p === '/api/drawing-mass' && req.method === 'GET') {
      const m = drawMassRead();
      return sendJson(res, 200, { masses: Object.values(m).sort((a, b) => String(a.designation).localeCompare(String(b.designation))) });
    }
    if (p === '/api/drawing-mass' && req.method === 'POST') {
      try {
        const body = await readBody(req);
        if (!String(body.designation || '').trim()) throw new Error('Не задан чертёж / обозначение.');
        drawMassSet(body.designation, body.mass);
        return sendJson(res, 200, { ok: true });
      } catch (e) { return sendJson(res, 400, { error: String(e.message || e) }); }
    }
    // печатный упаковочный лист (HTML для печати/сохранения в PDF)
    if (p === '/api/logistics/packing/print' && req.method === 'GET') {
      const st = logiRead();
      const s = st.shipments.find((x) => String(x.id) === String(url.searchParams.get('ship') || ''));
      if (!s) { res.writeHead(404, { 'Content-Type': 'text/plain; charset=utf-8' }); return res.end('Заявка не найдена.'); }
      const pl = (s.packingLists || []).find((u) => String(u.id) === String(url.searchParams.get('pl') || ''));
      if (!pl) { res.writeHead(404, { 'Content-Type': 'text/plain; charset=utf-8' }); return res.end('Упаковочный лист не найден.'); }
      const html = buildPackingListHtml(s, pl);
      res.writeHead(200, { 'Content-Type': 'text/html; charset=utf-8', 'Content-Disposition': `inline; filename*=UTF-8''${encodeURIComponent('Упаковочный лист ' + (pl.plNo || s.num) + '.html')}`, 'Cache-Control': 'no-store' });
      return res.end(html);
    }
    return serveStatic(res, p);
  } catch (e) { sendJson(res, e.status || 500, { error: String(e.message || e) }); }
});

server.listen(PORT, () => console.log(`Портал ИСМ ПБС → http://localhost:${PORT}  [${isLive() ? 'LIVE' : 'MOCK'}]`));

// K-48: устойчивость однопроцессного портала. Одна незамеченная rejection в фоне
// (напр. глотнутый await в best-effort-ветке) не должна ронять весь процесс — логируем,
// но НЕ убиваем на unhandledRejection. uncaughtException тоже логируем (процесс Node
// может остаться в неопределённом состоянии, но для портала предпочтительнее не падать молча).
process.on('unhandledRejection', (reason) => {
  console.error(`[${new Date().toISOString()}] unhandledRejection:`, reason);
});
process.on('uncaughtException', (err) => {
  console.error(`[${new Date().toISOString()}] uncaughtException:`, err);
});
