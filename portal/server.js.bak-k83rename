    // влияние на статус позиции: ГОДЕН → «Выполнено» (в пределах существующего enum позиции)
    if (verdict === 'ГОДЕН') { try { await ncUpdate('positions', positionId, { 'Статус': 'Выполнено' }); positionStatus = 'Выполнено'; } catch (e) { /* soft */ } }
  }
