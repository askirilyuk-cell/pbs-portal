  if (body.numZkz) orderRow['№ ЗКЗ'] = String(body.numZkz).trim();

  const createdOrder = await ncCreateMany('orders', [orderRow]);
  const co = Array.isArray(createdOrder) ? createdOrder[0] : createdOrder;
