async function whIssueImpl(body) {
  const object = String(body.object || '').trim();
  if (!object) { const e = new Error('ГЕЙТ 2 (§4.3): расход запрещён без объекта отнесения (object).'); e.status = 409; throw e; }
  const qty = Number(body.qty);
  if (!Number.isFinite(qty) || qty <= 0) throw new Error('Укажите положительное количество расхода (qty).');
  const items = await ncListSoft('warehouse_items');
  const it = (body.itemId != null && body.itemId !== '' && items.find((r) => String(r.Id ?? r.id) === String(body.itemId)))
    || (body.code && items.find((r) => String(r['Код позиции'] || '').trim() === String(body.code).trim()));
  if (!it) throw new Error('Позиция не найдена (укажите itemId или code существующей позиции).');
  const code = String(it['Код позиции'] || '').trim();
  const itemId = it.Id ?? it.id;
  const dir = String(body.direction || '').trim();
  if (dir && !WH_DIRECTIONS.includes(dir)) throw new Error(`Недопустимое направление расхода «${dir}» (${WH_DIRECTIONS.join(' / ')}).`);
  const dateIso = body.date ? String(body.date).slice(0, 10) : whToday();
  const price = (body.price != null && body.price !== '') ? whNum(body.price) : whNum(it['Цена учётная, руб.']); // K-48: NaN-гвард
  // K-47: read-modify-write остатка строго последовательно по коду позиции — иначе два
  // параллельных расхода оба «видят» один остаток и уводят склад в минус мимо §5.3-контроля.
  return withKeyLock(`wh:${code}`, async () => {
    // §5.3: мягкий контроль — если остаток уходит в минус, не блок, а флаг + предупреждение.
    // Остаток читаем ВНУТРИ замка, актуальным на момент проводки.
    const { balance: cur } = whBalanceFor(code, await ncListSoft('warehouse_movements'));
    const after = cur - qty;
    const negative = after < 0;
    const row = {
      'Проводка': `${code} · расход · ${dir || '—'} · ${whRuDate(dateIso)}`,
      'Дата': dateIso, 'Кол-во': qty, 'Объект отнесения': object,
      'Документ-основание': String(body.basis || (dir === 'Производство' ? 'МК / ПЗ' : 'Ф.5–СХ')).trim(),
      'Цена, руб.': price, 'Сумма, руб.': +(qty * price).toFixed(2),
      'Отрицательный остаток': negative,
    };
    if (body.batch) row['Партия / плавка'] = String(body.batch).trim();
    if (body.note) row['Примечание'] = String(body.note).trim();
    const cr = await ncCreateMany('warehouse_movements', [row]);
    const mv = Array.isArray(cr) ? cr[0] : cr;
    const movementId = mv.Id ?? mv.id;
    await whLinkMovement(movementId, { itemId, typeValue: 'Расход', dirValue: dir || null });
    const balance = await whRecalcItemBalance(code, itemId);
    const out = { ok: true, movementId, itemId, code, direction: dir || null, balance, negative };
    if (negative) out.warning = `Отрицательный остаток: списание ${qty} при остатке ${cur} → ${after}. Проводка проведена (мягкий контроль §5.3), проставлен флаг «Отрицательный остаток».`;
    return out;
  });
}
// POST инвентаризация Ф.3–СХ (§4.5): факт vs учётный, авто-расхождение → заготовка НП (ДП-У.2)
async function whInventory(body) {
