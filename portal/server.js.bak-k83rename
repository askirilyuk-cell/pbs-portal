    note: 'Опись рассчитана (учётный − факт). Персист описи и авто-НП (ДП-У.2) — отдельный маршрут (TODO).',
  };
}
// GET отчёт Ф.4–СХ (§4.7–4.8): свод расхода по направлениям за период; ручной мост в 1С по «Код 1С»
async function buildWarehouseF4(fromIso, toIso) {
  const movements = await ncListSoft('warehouse_movements');
  const inRange = (d) => { const s = String(d).slice(0, 10); if (fromIso && s < fromIso) return false; if (toIso && s > toIso) return false; return true; };
  const rows = movements.map(whParseMovement).filter((m) => m.type === 'out' && inRange(m.date));
  const buckets = {};
  for (const d of [...WH_DIRECTIONS, '(без направления)']) buckets[d] = { direction: d, amount: 0, count: 0 };
  for (const m of rows) { const k = WH_DIRECTIONS.includes(m.dir) ? m.dir : '(без направления)'; buckets[k].amount += m.amount; buckets[k].count += 1; }
