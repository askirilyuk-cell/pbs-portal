  if (code1c) row['Код 1С'] = code1c; else row['Ждёт код 1С'] = true;
  if (body.grade) row['Марка / ГОСТ'] = String(body.grade).trim();
  if (body.storage) row['Место хранения'] = String(body.storage).trim();
  if (body.minStock != null && body.minStock !== '') row['Мин. остаток'] = Number(body.minStock);
  if (body.price != null && body.price !== '') row['Цена учётная, руб.'] = whNum(body.price); // K-48: не пускать NaN → null
