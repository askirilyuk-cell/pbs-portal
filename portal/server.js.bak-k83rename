    || (iso && rows.find((r) => String(r['ISO-код'] || '').trim().toUpperCase() === iso.toUpperCase()));
  const patch = {};
  const put = (col, v) => { const s = (v == null ? '' : String(v)).trim(); if (s) patch[col] = s; };
  put('Производитель', body.maker); put('Примечание', body.note);
  if (TC_HOLDER_TYPES.includes(String(body.holderType || '').trim())) patch['Тип державки'] = String(body.holderType).trim();
  if (TC_STATUSES.includes(String(body.status || '').trim())) patch['Статус'] = String(body.status).trim();
  let id, code, created;
  if (existing) {
    id = existing.Id ?? existing.id; code = String(existing['ISO-код'] || '').trim();
    if (iso && iso.toUpperCase() !== code.toUpperCase()) { patch['ISO-код'] = iso; code = iso; }
    if (Object.keys(patch).length) await ncUpdate('tool_holders', id, patch);
    created = false;
  } else {
    const cr = await ncCreateMany('tool_holders', [{ 'ISO-код': iso, 'Статус': 'Активна', ...patch }]);
    const c = Array.isArray(cr) ? cr[0] : cr; id = c.Id ?? c.id; code = iso; created = true;
  }
  // синхронизация связи «Совместимые пластины» (mm) — только если compatIds передан
  if (Array.isArray(body.compatIds)) {
    const want = body.compatIds.map(Number).filter(Number.isFinite);
    try {
      const cur = await ncListLinked('tool_holders', 'Совместимые пластины', id).catch(() => []);
      const curIds = cur.map((x) => Number(x.Id ?? x.id)).filter(Number.isFinite);
      const toAdd = want.filter((x) => !curIds.includes(x));
      const toRemove = curIds.filter((x) => !want.includes(x));
      if (toAdd.length) await ncLinkRecords('tool_holders', 'Совместимые пластины', id, toAdd);
      if (toRemove.length) await ncUnlinkRecords('tool_holders', 'Совместимые пластины', id, toRemove);
    } catch (e) { console.error(`[${new Date().toISOString()}] tool-holder compat link failed (${code}):`, (e && e.message) || e); }
  }
  return { ok: true, id, iso: code || iso, created };
}

