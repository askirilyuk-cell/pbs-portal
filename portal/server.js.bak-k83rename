// ============================================================================
//  Раздел «Склад» (K-07, ДП–СХ–1.0 §4.1–4.8) — бэкенд поверх модели migrate-023.
//  FORWARD-TOLERANT (как K-05): таблиц ещё может не быть (APPLY будет позже) →
//  ncListSoft отдаёт [], GET-эндпоинты возвращают 200/пустое, POST — 400/409 с
//  внятным текстом, но НИКОГДА не 500 из-за отсутствия таблиц.
//  Ядро §4.4: Остаток = Σприход − Σрасход по журналу движения. Имена полей 1:1
//  с migrate-023 («Код позиции», «Проводка», «Кол-во», «Сумма, руб.» и т.д.).
// ============================================================================
const WH_DIRECTIONS = ['Производство', 'Ремонт', 'Испытание', 'Прочее'];
const whNum = (v) => { const n = Number(v); return Number.isFinite(n) ? n : 0; };
// --- K-47: сериализация движений остатков + идемпотентность (in-process) -----
// Проблема: read-modify-write остатка без транзакции — два параллельных расхода по одной
// позиции оба проходят «qty ≤ остаток» и уводят склад/инструмент в минус. Решение: простой
// per-key async-mutex (цепочка промисов на ключ = код позиции/инструмента). Операции по
// ОДНОМУ коду строго последовательны; по РАЗНЫМ кодам — параллельно, без деградации.
const _mvLocks = new Map(); // key -> Promise (хвост цепочки)
function withKeyLock(key, fn) {
  const prev = _mvLocks.get(key) || Promise.resolve();
  // fn выполняется после prev независимо от её исхода (ошибка предыдущей операции не рвёт цепочку)
  const run = prev.then(() => fn(), () => fn());
  const tail = run.catch(() => {}); // хвост «глотает» ошибку только для целей упорядочивания
  _mvLocks.set(key, tail);
  tail.finally(() => { if (_mvLocks.get(key) === tail) _mvLocks.delete(key); });
  return run;
}
// Идемпотентность (in-process): двойной клик / сетевой ретрай с тем же clientOpId не должен
// создавать дубль проводки. Регистрируем ин-флайт-промис СИНХРОННО на входе → конкурентный
// дубль получает ТОТ ЖЕ промис (то же тело ответа, тот же movementId), одно исполнение.
// ВНИМАНИЕ: durable-идемпотентность (переживающая рестарт процесса) требует поля clientOpId
// в таблице журнала NocoDB + миграции — здесь НЕ реализована (см. отчёт). Кэш ограничен по размеру.
const _opCache = new Map(); // clientOpId -> Promise<result>
const _OP_CACHE_MAX = 500;
function withClientOpId(clientOpId, fn) {
  const id = (clientOpId == null ? '' : String(clientOpId)).trim();
  if (!id) return fn();
  const hit = _opCache.get(id);
  if (hit) return hit; // повтор в пределах жизни процесса → тот же результат, без дубля
  const p = Promise.resolve().then(() => fn());
  _opCache.set(id, p);
  if (_opCache.size > _OP_CACHE_MAX) { const first = _opCache.keys().next().value; _opCache.delete(first); }
  // при ошибке — снять из кэша, чтобы честный повтор после сбоя мог пройти заново
  p.catch(() => { if (_opCache.get(id) === p) _opCache.delete(id); });
  return p;
}
const whToday = () => new Date().toISOString().slice(0, 10);
const whRuDate = (iso) => { const [y, m, d] = String(iso).slice(0, 10).split('-'); return (d && m && y) ? `${d}.${m}.${y}` : String(iso); };
// ГЕЙТ 1 (§4.1): «принято» для акта входного контроля Ф.3–Д.1. Заключение (SingleSelect
// «Входного контроля») = ГОДЕН / ГОДЕН С ЗАМЕЧАНИЯМИ → на склад; НЕ ГОДЕН → брак, отказ.
const whAccepted = (verdict) => {
  const v = String(verdict || '').trim().toUpperCase();
  if (!v) return false;
  if (v.startsWith('НЕ ГОДЕН') || v.startsWith('НЕГОДЕН')) return false;
  return v.startsWith('ГОДЕН') || v.includes('ПРИНЯТ'); // + легаси-текст «принято»
};
// значение link-поля NocoDB (объект/массив/строка) → отображаемая строка «Значение»
function whLinkVal(v) {
  if (v == null) return '';
  if (Array.isArray(v)) return whLinkVal(v[0]);
  if (typeof v === 'object') return String(v['Значение'] || v['Код позиции'] || v['title'] || v['Title'] || '');
  return String(v);
}
// движение журнала → нормализованная запись. Тип/направление/код позиции берём из
// «Проводки» (её же и пишем: «СХ-0001 · приход · <напр.> · ДД.ММ.ГГГГ»), с фолбэком
// на link-поля справочников и на знак «Кол-во» — устойчиво к формату.
function whParseMovement(m) {
  const raw = String(m['Проводка'] || '');
  const parts = raw.split('·').map((s) => s.trim()).filter(Boolean);
  const low = raw.toLowerCase();
  const linkedType = whLinkVal(m['Типы движения']).toLowerCase();
  const type = /приход/.test(linkedType) ? 'in'
    : /расход/.test(linkedType) ? 'out'
    : /приход/.test(low) ? 'in'
    : /расход/.test(low) ? 'out'
    : (whNum(m['Кол-во']) < 0 ? 'out' : 'in');
  const linkedDir = whLinkVal(m['Направления расхода']);
  const dir = linkedDir || parts.find((x) => WH_DIRECTIONS.includes(x)) || '';
  return {
    id: m.Id ?? m.id, code: parts[0] || '', type, dir,
    qty: Math.abs(whNum(m['Кол-во'])), date: m['Дата'] || '',
    batch: m['Партия / плавка'] || '', expiry: m['Срок годности'] || '',
    basis: m['Документ-основание'] || '', object: m['Объект отнесения'] || '',
    price: whNum(m['Цена, руб.']), amount: whNum(m['Сумма, руб.']),
    negative: m['Отрицательный остаток'] === true || m['Отрицательный остаток'] === 1,
    note: m['Примечание'] || '', title: raw,
  };
}
// §4.4: остаток позиции по коду = Σприход − Σрасход
function whBalanceFor(code, movements) {
  let inn = 0, out = 0;
  for (const m of movements) { const p = whParseMovement(m); if (p.code !== code) continue; if (p.type === 'in') inn += p.qty; else out += p.qty; }
  return { balance: inn - out, sumIn: inn, sumOut: out };
}
// заготовка «Создать ЗнЗ (Ф.6–К)» для сигнала на закупку (ГЕЙТ 3 §4.4). Фактическое
// создание ЗнЗ (мост склад→ДП-К, связь ЗКЗ↔ЗнЗ) — отдельный эндпоинт (TODO).
function whZnzDraft(p) {
  return {
    form: 'Ф.6–К', material: p.name, code1c: p.code1c || '', unit: p.unit || '',
    qtyNeeded: Math.max(0, whNum(p.minStock) - whNum(p.balance)),
    reason: `Остаток ${p.balance} ≤ мин. ${p.minStock} — сигнал склада (§4.4)`,
    todo: 'create-znz-endpoint', // переиспользовать procurement_requests / связь ДП-К
  };
}
// GET-модель раздела (Экран 1): номенклатура + остатки + KPI + сигналы на закупку
async function buildWarehouseLive() {
  const [items, movements] = await Promise.all([ncListSoft('warehouse_items'), ncListSoft('warehouse_movements')]);
  const parsed = movements.map(whParseMovement);
  const positions = items.map((it) => {
    const code = String(it['Код позиции'] || '').trim();
    const mv = parsed.filter((m) => m.code === code);
    const sumIn = mv.filter((m) => m.type === 'in').reduce((s, m) => s + m.qty, 0);
    const sumOut = mv.filter((m) => m.type === 'out').reduce((s, m) => s + m.qty, 0);
    const balance = sumIn - sumOut;
    const min = whNum(it['Мин. остаток']);
    const own = !(it['Давальческое'] === true || it['Давальческое'] === 1); // §4.2 давальческое — вне собств. остатка
    return {
      id: it.Id ?? it.id, code, name: it['Наименование'] || '', grade: it['Марка / ГОСТ'] || '',
      code1c: it['Код 1С'] || '', awaiting1c: it['Ждёт код 1С'] === true || it['Ждёт код 1С'] === 1,
      unit: whLinkVal(it['Единицы измерения']), category: whLinkVal(it['Категории материалов']),
      minStock: min, balance, sumIn, sumOut, storage: it['Место хранения'] || '',
      own, customerOwned: !own, price: whNum(it['Цена учётная, руб.']), note: it['Примечание'] || '',
      belowMin: own && min > 0 && balance <= min,
    };
  });
  const ownItems = positions.filter((p) => p.own);
  const kpis = {
    positions: ownItems.length, customerOwned: positions.length - ownItems.length,
    belowMin: positions.filter((p) => p.belowMin).length, movements: movements.length,
  };
  const signals = positions.filter((p) => p.belowMin)
    .map((p) => ({ id: p.id, code: p.code, name: p.name, balance: p.balance, minStock: p.minStock, unit: p.unit, znzDraft: whZnzDraft(p) }));
  return { mode: 'live', items: positions, kpis, signals };
}
// GET карточка позиции (Экран 1, деталь): реквизиты + журнал движения по позиции
async function buildWarehouseCard(id) {
