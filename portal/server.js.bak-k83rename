// upsert пластины (уникальность по ISO-коду — на уровне эндпоинта, т.к. NocoDB CE ненадёжно ставит DB-unique)
async function toolInsertSave(body) {
  const iso = String(body.iso || '').trim();
  if (!iso && (body.id == null || body.id === '')) { const e = new Error('Укажите ISO-код пластины (iso).'); e.status = 400; throw e; }
  const rows = await ncListSoft('tool_inserts');
  const existing = (body.id != null && body.id !== '' && rows.find((r) => String(r.Id ?? r.id) === String(body.id)))
    || (iso && rows.find((r) => String(r['ISO-код'] || '').trim().toUpperCase() === iso.toUpperCase()));
  const patch = {};
  const put = (col, v) => { const s = (v == null ? '' : String(v)).trim(); if (s) patch[col] = s; };
  put('Сплав / марка', body.grade); put('Производитель', body.maker); put('Примечание', body.note);
  if (TC_INSERT_PROC.includes(String(body.procType || '').trim())) patch['Тип обработки'] = String(body.procType).trim();
  if (TC_STATUSES.includes(String(body.status || '').trim())) patch['Статус'] = String(body.status).trim();
  let id, code, created;
  if (existing) {
    id = existing.Id ?? existing.id; code = String(existing['ISO-код'] || '').trim();
    if (iso && iso.toUpperCase() !== code.toUpperCase()) { patch['ISO-код'] = iso; code = iso; }
    if (Object.keys(patch).length) await ncUpdate('tool_inserts', id, patch);
    created = false;
  } else {
    const cr = await ncCreateMany('tool_inserts', [{ 'ISO-код': iso, 'Статус': 'Активна', ...patch }]);
    const c = Array.isArray(cr) ? cr[0] : cr; id = c.Id ?? c.id; code = iso; created = true;
  }
  return { ok: true, id, iso: code || iso, created };
}
// upsert державки + синхронизация mm-связи «Совместимые пластины» (compatIds — массив Id пластин)
async function toolHolderSave(body) {
  const iso = String(body.iso || '').trim();
