// ISO → ДД.ММ.ГГГГ / ДД.ММ; число → «585 600 ₽»
const salesDate = (d) => { const m = /^(\d{4})-(\d{2})-(\d{2})/.exec(String(d || '')); return m ? `${m[3]}.${m[2]}.${m[1]}` : (d ? String(d) : ''); };
