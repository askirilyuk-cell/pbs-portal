async function createCounterparty(body) {
  const name = String(body.name || '').trim();
  if (!name) throw new Error('Не указано наименование контрагента.');
  const inn = String(body.inn || '').trim();
  const role = String(body.role || 'Заказчик').trim();
  if (!['Заказчик', 'Поставщик', 'Партнёр'].includes(role)) throw new Error(`Недопустимая роль «${role}».`);
  const existing = await ncListSoft('sales_counterparties');
  // дедуп по ИНН (если задан): возвращаем существующего, при необходимости дополняем роль
  if (inn) {
    const dup = existing.find((c) => String(c['ИНН'] || '').trim() === inn);
    if (dup) {
      const roles = String(dup['Роль'] || '').split(',').map((s) => s.trim()).filter(Boolean);
      if (!roles.includes(role)) { roles.push(role); await ncUpdate('sales_counterparties', dup.Id ?? dup.id, { 'Роль': roles.join(',') }); }
      return { ok: true, existed: true, id: dup.Id ?? dup.id, name: dup['Наименование'] || name, inn, region: dup['Регион'] || '', roles };
    }
  }
  const row = { 'Наименование': name, 'Роль': role };
  const put = (col, v) => { const s = String(v == null ? '' : v).trim(); if (s) row[col] = s; };
  put('ИНН', inn); put('КПП', body.kpp); put('ОГРН', body.ogrn); put('Краткое наименование', body.shortName);
  put('Регион', body.region); put('Отрасль', body.industry); put('Тип', body.type);
  put('Контактное лицо', body.contact); put('Тел./Email', body.contacts);
  put('Связь с холдингом', body.holding); put('Примечание', body.note);
  const created = await ncCreateMany('sales_counterparties', [row]);
  const c = Array.isArray(created) ? created[0] : created;
  return { ok: true, existed: false, id: c.Id ?? c.id, name, inn, region: String(body.region || '').trim(), roles: [role] };
}

