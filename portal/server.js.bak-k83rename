    sendJson(res, 200, { auth: true, userId: s.userId, fio: s.fio, position: s.position, depts: s.depts, roles: s.roles, roleLabels: s.roles.map((r) => ROLE_LABELS[r] || r), isAdmin: s.roles.includes('admin') });
    return true;
  }
  if (p === '/auth/logout') {
    // GET (ссылка) → 302 на главную; POST (fetch) → JSON. Разлогин в обоих случаях.
    const s = sessionFromReq(req);
    if (s) { delete sessions[s.sid]; persistSessions(); }
    setCookie(res, 'pbs_sid', '', { maxAge: 0 });
    if (req.method === 'POST') { sendJson(res, 200, { ok: true }); return true; }
    res.writeHead(302, { Location: '/' }); res.end(); return true;
  }
  if (p === '/auth/admin') {
    // K-49 админ-обход: локальный вход по токену из runtime (на случай сбоя SSO).
    const token = url.searchParams.get('token') || '';
    if (!c.ADMIN_BYPASS_TOKEN) { res.writeHead(503, { 'Content-Type': 'text/plain; charset=utf-8' }); res.end('Админ-обход не настроен (нет ADMIN_BYPASS_TOKEN в runtime).'); return true; }
    if (token !== c.ADMIN_BYPASS_TOKEN) { console.warn('[auth] админ-обход: неверный токен'); res.writeHead(403, { 'Content-Type': 'text/plain; charset=utf-8' }); res.end('Неверный токен админ-обхода.'); return true; }
    const sid = crypto.randomBytes(24).toString('hex');
    const next = url.searchParams.get('next') || '/';
    sessions[sid] = {
      userId: '11', fio: 'Администратор (локальный вход)', position: '', email: '', depts: [],
      roles: ['admin'], role: 'Администратор', isAdmin: true, bypass: true, exp: Date.now() + SESSION_TTL,
    };
    persistSessions();
    setCookie(res, 'pbs_sid', sid, { maxAge: Math.floor(SESSION_TTL / 1000) });
    console.log('[auth] админ-обход: выдана сессия Администратора');
    res.writeHead(302, { Location: next.startsWith('/') ? next : '/' }); res.end(); return true;
  }
  return false;
}
// K-49: /api/me — карточка текущего пользователя (мягкий режим: гость — норм).
function handleMe(req, res) {
  const s = sessionFromReq(req);
  const enforce = rbacEnforceOn();
  if (!s) return sendJson(res, 200, { authenticated: false, role: 'guest', effectiveRole: 'guest', isAdmin: false, enforce, live: isLive(), access: {}, roles: PORTAL_ROLES.filter((r) => r !== 'guest') });
  const role = s.role || 'Сотрудник';
  const effectiveRoles = sessionPortalRoles(s);        // мультироль: эффективный набор (учитывает «просмотр как» + живые overrides)
  const effectiveRole = effectiveRoles[0] || role;     // первичная (для отображения)
  return sendJson(res, 200, {
    authenticated: true, id: s.userId, name: s.fio, position: s.position || '',
    department: (s.depts && s.depts[0]) || null, departments: s.depts || [],
    role, effectiveRole, effectiveRoles, isAdmin: !!s.isAdmin, live: isLive(),
    viewAs: (s.isAdmin && s.effectiveRole && s.effectiveRole !== role) ? s.effectiveRole : null,
    roles: s.roles || [], bypass: !!s.bypass,
    // K-49 Шаг 2/3: флаг enforcement + ОБЪЕДИНЁННАЯ карта доступа набора ролей (для скрытия/read-only на фронте).
    enforce, access: rbacAccessMapMulti(effectiveRoles), portalRoles: PORTAL_ROLES.filter((r) => r !== 'guest'),
  });
}
// K-49 переключатель ролей (только Админ): POST /api/admin/view-as {role} → effectiveRole в сессию.
async function handleViewAs(req, res) {
