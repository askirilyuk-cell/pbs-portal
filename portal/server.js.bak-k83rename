  await ncDeleteMany('invoices', [id]);
  return { ok: true, id, deleted: true };
}
// загрузка скан-файла счёта в хранилище NocoDB → attachment-объект для поля «Файл-скан».
// Проксируем multipart в /api/v2/storage/upload; degrade-safe — при сбое клиент
// создаёт счёт без скана.
async function uploadInvoiceScan(file) {
  const c = cfg();
  if (!c.NC_TOKEN) throw new Error('Не задан токен NocoDB.');
  const ext = String(file.filename || '').split('.').pop().toLowerCase();
  const MIME = { pdf: 'application/pdf', jpg: 'image/jpeg', jpeg: 'image/jpeg', png: 'image/png', webp: 'image/webp', gif: 'image/gif', heic: 'image/heic', tif: 'image/tiff', tiff: 'image/tiff' };
  const fd = new FormData();
  const blob = new Blob([file.data], { type: MIME[ext] || 'application/octet-stream' });
  fd.append('file', blob, file.filename || 'scan');
  const res = await fetch(`${c.NC_URL}/api/v2/storage/upload`, { method: 'POST', headers: { 'xc-token': c.NC_TOKEN }, body: fd });
  if (!res.ok) throw new Error(`NocoDB upload ${res.status}: ${await res.text()}`);
  const arr = await res.json();
  return Array.isArray(arr) ? arr : [arr];
}

// ── K-83 OCR: автозаполнение полей счёта по скану (Yandex Cloud OCR, recognizeText) ──
// Синхронный API = 1 страница/изображение за вызов. Ключ и распознанный текст НИКОГДА
// не логируются. Любая ошибка → { ok:false, reason } без исключения — форма прикрепления
// счёта просто остаётся без автозаполнения (degrade-safe, не блокирует прикрепление).
const OCR_MIME = { pdf: 'application/pdf', jpg: 'image/jpeg', jpeg: 'image/jpeg', png: 'image/png' };
// извлечь result.textAnnotation.fullText устойчиво к вариациям структуры ответа
function ocrExtractFullText(data) {
  try {
    if (Array.isArray(data)) { for (const it of data) { const t = ocrExtractFullText(it); if (t) return t; } return ''; }
    if (data && typeof data === 'object') {
      const ta = (data.result && data.result.textAnnotation) || data.textAnnotation;
      if (ta && typeof ta.fullText === 'string') return ta.fullText;
      if (typeof data.fullText === 'string') return data.fullText;
    }
  } catch { /* noop */ }
  return '';
}
const OCR_MONTHS = { 'января': '01', 'февраля': '02', 'марта': '03', 'апреля': '04', 'мая': '05', 'июня': '06', 'июля': '07', 'августа': '08', 'сентября': '09', 'октября': '10', 'ноября': '11', 'декабря': '12' };
// дата из текста счёта ("от 12.03.2026" / "от 12 марта 2026") → YYYY-MM-DD, иначе null
function ocrParseRuDate(s) {
  s = String(s || '').trim();
  let m = /^(\d{1,2})[.\s](\d{1,2})[.\s](\d{2,4})$/.exec(s);
  if (m) { let [, d, mo, y] = m; if (y.length === 2) y = '20' + y; return `${y.padStart(4, '0')}-${mo.padStart(2, '0')}-${d.padStart(2, '0')}`; }
  m = /^(\d{1,2})\s+([а-яё]+)\s+(\d{4})$/i.exec(s);
  if (m) { const mm = OCR_MONTHS[m[2].toLowerCase()]; if (mm) return `${m[3]}-${mm}-${m[1].padStart(2, '0')}`; }
  return null;
