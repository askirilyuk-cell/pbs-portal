// ── K-83 этап 1a: интеграция с payment-portal (Реестр оплат), кнопка «Отправить на оплату» ──
// Контракт: docs/INTEGRATION_ISM.md. Server-to-server через ingest-API шлюза (ключ
// X-API-Key НЕ уходит во фронт — все вызовы с бэкенда). Ключ читается из runtime
// (PAYMENT_INGEST_KEY); нет ключа → эндпойнты возвращают 501 (не падаем). Идемпотентность
// на стороне портала обеспечивается externalRef=№ЗнЗ (повторный клик безопасен, §7).
const PAY_TYPES = ['AVANS', 'POSTOPLATA'];
const paymentConfigured = () => !!cfg().PAYMENT_INGEST_KEY;
// ошибка с HTTP-кодом для аккуратного проброса клиенту
const payErr = (status, msg) => { const e = new Error(msg); e.status = status; return e; };

// Низкоуровневый вызов ingest-API: fetch к ${PAYMENT_API_BASE}/api/v1/ingest${path} с X-API-Key.
// Успех → { status, data }. Не-2xx → бросает Error с .status (400/401/404/409/422/…) и .payload.
async function ingestCall(method, path, body) {
  const c = cfg();
  if (!c.PAYMENT_INGEST_KEY) throw payErr(501, 'Интеграция с оплатой не настроена (нет ключа PAYMENT_INGEST_KEY в «Настройках»).');
  const url = `${c.PAYMENT_API_BASE}/api/v1/ingest${path}`;
  let res;
  try {
    res = await fetch(url, {
      method,
      headers: { 'X-API-Key': c.PAYMENT_INGEST_KEY, ...(body ? { 'Content-Type': 'application/json' } : {}) },
      body: body ? JSON.stringify(body) : undefined,
    });
  } catch (e) { throw payErr(502, 'Не удалось связаться с сервисом оплат: ' + String(e.message || e)); }
  const text = await res.text();
  let data = null; try { data = text ? JSON.parse(text) : null; } catch { data = text; }
  if (!res.ok) {
    const detail = (data && typeof data === 'object')
      ? (data.error || data.message || JSON.stringify(data))
      : (data || `HTTP ${res.status}`);
    const e = payErr(res.status, String(detail)); e.payload = data; throw e;
  }
  return { status: res.status, data };
}

// Справочник отделов/проектов (для выпадашек формы), отфильтрован по нашему legalEntityId. Кэш ~5 мин.
let _payRef = null, _payRefExp = 0;
async function payReference() {
  if (_payRef && Date.now() < _payRefExp) return _payRef;
  const leid = Number(cfg().PAYMENT_LEGAL_ENTITY_ID);
  const { data } = await ingestCall('GET', '/reference');
  const legalEntity = (data.legalEntities || []).find((e) => Number(e.id) === leid) || null;
  const departments = (data.departments || []).filter((d) => Number(d.legalEntityId) === leid)
    .map((d) => ({ id: d.id, code: d.code || '', name: d.name || '' }));
  const projects = (data.projects || []).filter((pr) => Number(pr.legalEntityId) === leid)
    .map((pr) => ({ id: pr.id, name: pr.name || '' }));
  _payRef = { legalEntityId: leid, legalEntity, departments, projects };
  _payRefExp = Date.now() + 5 * 60 * 1000;
  return _payRef;
}

// email инициатора для payment-portal (обязателен, §2): из сессии, иначе через Bitrix по userId.
async function bitrixUserEmail(id) {
  try {
    const r = await bitrixCall('user.get', { ID: id });
    const u = Array.isArray(r) ? r[0] : (r && r.result && r.result[0]);
    return (u && String(u.EMAIL || '').trim()) || null;
  } catch { return null; }
}
async function resolveInitiatorEmail(session) {
  const s = session || {};
  const direct = String(s.email || '').trim();
  if (direct) return direct;
  if (s.userId) { const e = await bitrixUserEmail(s.userId); if (e) return e; }
  return null;
}

// Сохранить статус оплаты из ответа портала в запись ЗнЗ (поля migrate-046). Best-effort/degrade-safe.
// Используется только для СТАРЫХ оплат «на всю ЗнЗ» (без invoiceId) — обратная совместимость.
async function savePaymentToZnz(znzId, payment) {
  if (!payment) return;
  const patch = {};
  if (payment.id != null) patch['Оплата Id'] = String(payment.id);
  if (payment.status != null) patch['Оплата статус'] = String(payment.status);
  if (payment.externalRef != null) patch['Оплата ExternalRef'] = String(payment.externalRef);
  if (payment.amount != null) { const a = Number(payment.amount); if (Number.isFinite(a)) patch['Оплата сумма'] = a; }
  if (payment.updatedAt != null) patch['Оплата обновлено'] = String(payment.updatedAt);
  if (!Object.keys(patch).length) return;
  try { await ncUpdate('procurement_requests', znzId, patch); }
  catch (e) { console.warn('K-83: статус оплаты не сохранён в ЗнЗ (колонок может не быть до migrate-046):', e.message); }
}

// K-83 этап 2: маппинг статуса payment-portal (PAID/REJECTED/APPROVED/…) в русский статус
// оплаты счёта — словарь «Статус оплаты» ограничен INVOICE_PAY_STATUSES, а внешние коды
// в него не входят, поэтому переводим: PAID→Оплачено, REJECTED→Отклонено, всё
// остальное (APPROVED/PENDING_APPROVAL/PARTIALLY_PAID/DEFERRED/неизвестно) → Ожидает оплаты.
function payStatusToInvoiceStatus(status) {
  const t = String(status || '').trim().toUpperCase();
  if (t === 'PAID') return 'Оплачено';
  if (t === 'REJECTED') return 'Отклонено';
  return 'Ожидает оплаты';
}
// Сохранить статус оплаты СЧЁТА (per-invoice externalRef, K-83 этап 2, владелец уточнил модель:
// каждый счёт = отдельная заявка на оплату) в «Счета-К»: «Оплата ExternalRef», «Оплата ID»,
// «Статус оплаты» (маппинг выше), «Оплата обновлена». Best-effort/degrade-safe — до создания
// новых колонок в таблице просто не пишет (см. каталог try/catch).
async function savePaymentToInvoice(invoiceId, payment) {
  if (!payment) return;
  const patch = {
    'Статус оплаты': payStatusToInvoiceStatus(payment.status),
    'Оплата обновлена': new Date().toISOString(),
  };
  if (payment.externalRef != null) patch['Оплата ExternalRef'] = String(payment.externalRef);
  if (payment.id != null) patch['Оплата ID'] = String(payment.id);
  try { await ncUpdate('invoices', invoiceId, patch); }
  catch (e) { console.warn('K-83: статус оплаты не сохранён в счёте (колонок «Оплата …» может ещё не быть):', e.message); }
}

// K-83 доп.: скачать байты NocoDB-вложения (attachment-объект «Файл-скан») по его url/path —
// нужно, чтобы автоматически продублировать скан счёта в платёжный портал (см. createPayment).
// Формат объекта из /api/v2/storage/upload варьируется (path относительный либо signedUrl/url
// уже абсолютные) — пробуем оба варианта; xc-token добавляем на случай защищённого пути.
async function downloadNcAttachment(att) {
  const c = cfg();
  const raw = (att && (att.signedUrl || att.url || att.path)) || '';
  if (!raw) throw new Error('У вложения нет ссылки на файл.');
  const full = /^https?:\/\//i.test(raw) ? raw : `${c.NC_URL}${raw.startsWith('/') ? '' : '/'}${raw}`;
  const res = await fetch(full, { headers: c.NC_TOKEN ? { 'xc-token': c.NC_TOKEN } : {} });
  if (!res.ok) throw new Error(`Не удалось скачать вложение (${res.status}).`);
  return Buffer.from(await res.arrayBuffer());
}

// Создать заявку на оплату (POST /payments). Собирает payload по §2 контракта из тела формы + записи ЗнЗ.
// session — текущая сессия портала (для initiatorEmail). Возвращает { ok, idempotent, payment }.
//
// K-83 этап 2 (правка модели, утв. владельцем): каждый СЧЁТ — отдельная заявка на оплату
// в платёжном портале (идемпотентность по externalRef, §7 контракта). № ЗнЗ — внутренняя
// цеховая заявка, это другая сущность. Если body.invoiceId задан — externalRef строится
// как «<№ЗнЗ>/<№счёта>» и статус/id оплаты пишутся НА СЧЁТ (savePaymentToInvoice), колонки
// ЗнЗ (migrate-046) при этом не трогаем — они относятся к старому флоу «оплата на всю ЗнЗ».
// Без invoiceId — прежнее поведение (externalRef = № ЗнЗ, статус в ЗнЗ) для совместимости
// со старыми оплатами, отправленными до этой правки.
async function createPayment(body, session) {
  if (!paymentConfigured()) throw payErr(501, 'Интеграция с оплатой не настроена (нет ключа PAYMENT_INGEST_KEY в «Настройках»).');
  const c = cfg();
  // 1) заявка ЗнЗ (родитель счёта; для old-флоу — сама единица оплаты)
  const znzId = Number(body.znzId ?? body.znz_id);
  if (!Number.isFinite(znzId)) throw payErr(400, 'Не указана заявка ЗнЗ (znzId).');
  const reqs = await ncListSoft('procurement_requests');
  const znz = reqs.find((x) => String(x.Id ?? x.id) === String(znzId));
  if (!znz) throw payErr(404, 'Заявка ЗнЗ не найдена.');
  const znzNo = String(znz['№ ЗнЗ'] || '').trim();

  // 1а) счёт (K-83 этап 2) — если invoiceId передан, оплата привязывается к КОНКРЕТНОМУ счёту
  const invoiceIdRaw = body.invoiceId ?? body.invoice_id;
  let invoice = null;
  if (invoiceIdRaw != null && String(invoiceIdRaw).trim() !== '') {
    const invId = Number(invoiceIdRaw);
    if (!Number.isFinite(invId)) throw payErr(400, 'Некорректный идентификатор счёта (invoiceId).');
    const invRows = await ncListSoft('invoices');
    invoice = invRows.find((x) => String(x.Id ?? x.id) === String(invId));
    if (!invoice) throw payErr(404, 'Счёт не найден.');
    if (Number(invoice['ЗнЗ Id']) !== znzId) throw payErr(400, 'Счёт не относится к указанной заявке ЗнЗ.');
  }

  // externalRef = ключ идемпотентности: «№ЗнЗ» (без счёта) либо «№ЗнЗ/№счёта» (per-invoice)
  let externalRef;
  if (invoice) {
    if (!znzNo) throw payErr(400, 'У заявки нет № ЗнЗ (externalRef) — оплату отправить нельзя.');
    const invId = invoice.Id ?? invoice.id;
    const invNo = String(invoice['№ счёта'] || '').trim() || `inv${invId}`;
    externalRef = `${znzNo}/${invNo}`;
  } else {
    externalRef = znzNo;
    if (!externalRef) throw payErr(400, 'У заявки нет № ЗнЗ (externalRef) — оплату отправить нельзя.');
  }

  // 2) initiatorEmail — обязателен по контракту (§2), 422 при отсутствии
  const initiatorEmail = await resolveInitiatorEmail(session);
  if (!initiatorEmail) throw payErr(422, 'Email инициатора не найден: войдите под своей учётной записью Bitrix (нужен e-mail в профиле).');

  // 3) валидации формы (§2) — сумма/контрагент дефолтятся из счёта, если не пришли в body
  const departmentId = Number(body.departmentId);
  if (!Number.isFinite(departmentId)) throw payErr(400, 'Не выбран отдел (departmentId).');
  let amount = Number(body.amount);
  if (!Number.isFinite(amount) && invoice && invoice['Сумма, ₽'] != null) amount = Number(invoice['Сумма, ₽']);
  if (!Number.isFinite(amount) || amount <= 0) throw payErr(400, 'Сумма должна быть больше 0.');
  const paymentType = String(body.paymentType || '').trim().toUpperCase();
  if (!PAY_TYPES.includes(paymentType)) throw payErr(400, 'Тип оплаты: AVANS (предоплата) или POSTOPLATA (постоплата).');

  const payload = {
    externalRef, externalSource: 'ISM',
    legalEntityId: Number(c.PAYMENT_LEGAL_ENTITY_ID),
    departmentId, initiatorEmail,
    amount, currency: 'RUB', paymentType,
  };
  if (body.projectId != null && String(body.projectId).trim() !== '') payload.projectId = Number(body.projectId);

  // контрагент: id ИЛИ name(+inn); если не пришёл в body — дефолт «Поставщик» счёта
  const cp = body.counterparty || {};
  const cpId = cp.id;
  let cpName = String(cp.name || '').trim();
  if (!cpName && (cpId == null || String(cpId).trim() === '') && invoice) cpName = String(invoice['Поставщик'] || '').trim();
  if (cpId != null && String(cpId).trim() !== '') payload.counterparty = { id: Number(cpId) };
  else {
    if (!cpName) throw payErr(400, 'Укажите контрагента (наименование или id).');
    payload.counterparty = { name: cpName };
    const inn = String(cp.inn || '').trim(); if (inn) payload.counterparty.inn = inn;
  }

  if (paymentType === 'AVANS') {
    const ap = Number(body.avansPercent);
    if (!Number.isFinite(ap) || ap < 1 || ap > 100) throw payErr(400, 'Для предоплаты укажите процент аванса (1..100).');
    payload.avansPercent = ap;
  } else { // POSTOPLATA
    const d = String(body.expectedPaymentDate || '').slice(0, 10);
    if (!d) throw payErr(400, 'Для постоплаты укажите ожидаемую дату оплаты.');
    payload.expectedPaymentDate = d;
  }
  // опциональные поля (invoiceNumber/invoiceDate — дефолт из счёта, если не пришли в body)
  if (body.supplyDate) payload.supplyDate = String(body.supplyDate).slice(0, 10);
  const invNo = String(body.invoiceNumber || '').trim() || (invoice ? String(invoice['№ счёта'] || '').trim() : '');
  if (invNo) payload.invoiceNumber = invNo;
  const invDate = body.invoiceDate ? String(body.invoiceDate).slice(0, 10) : (invoice && invoice['Дата счёта'] ? String(invoice['Дата счёта']).slice(0, 10) : '');
  if (invDate) payload.invoiceDate = invDate;
  const contractNo = String(body.contractNumber || '').trim(); if (contractNo) payload.contractNumber = contractNo;
  if (body.contractDate) payload.contractDate = String(body.contractDate).slice(0, 10);
  let desc = String(body.description || '').trim();
  if (!desc && invoice) desc = invDate ? `Оплата по счёту ${invNo || externalRef} от ${invDate}` : `Оплата по счёту ${invNo || externalRef}`;
  if (desc) payload.description = desc;

  // 4) вызов (обрабатываем оба кода — 201 создано / 200 idempotent)
  const { data } = await ingestCall('POST', '/payments', payload);
  const payment = (data && data.payment) ? data.payment : data;
  let fileAttached = false;
  if (invoice) {
    await savePaymentToInvoice(invoice.Id ?? invoice.id, payment);
    // K-83 доп.: владелец просит автоматически дублировать скан счёта в платёжный портал
