async function createSalesRequest(body) {
  const customer = String(body.customer || '').trim();
  if (!customer) throw new Error('Не указан заказчик.');
  const name = String(body.name || '').trim();
  if (!name) throw new Error('Не указано наименование запроса.');
  const received = body.received ? String(body.received).slice(0, 10) : new Date().toISOString().slice(0, 10);
  const year = Number(received.slice(0, 4)) || new Date().getFullYear();
  const numZp = await nextNumber('sales_requests', '№ запроса', 'ЗП', year);
  let ism = String(body.ism || '').trim() || 'ДА';
  if (!['ДА', 'НЕТ', 'ЧАСТИЧНО'].includes(ism)) throw new Error(`Недопустимое значение «${ism}» для «В области ИСМ».`);

  let kind = String(body.kind || '').trim() || 'Запрос предложений';
  if (!['Запрос предложений', 'Тендер'].includes(kind)) throw new Error(`Недопустимое значение «${kind}» для «Вид обращения».`);
  const row = { '№ запроса': numZp, 'Дата поступления': received, 'Заказчик': customer, 'Наименование запроса': name, 'В области ИСМ': ism, 'Вид обращения': kind, 'Статус': String(body.status || 'Новый').trim() || 'Новый' };
  const put = (col, v) => { const s = String(v == null ? '' : v).trim(); if (s) row[col] = s; };
  put('Контактное лицо', body.contact); put('Тел./Email', body.contacts); put('Источник', body.source);
  put('Тип запроса', body.type); put('Продуктовая линейка', body.line); put('Ед.изм.', body.unit);
  put('Ответственный', body.owner); put('Принял запрос', body.acceptedBy); put('Примечание', body.note);
  put('Ссылка на тендер', body.tenderUrl);
  // двухосевая классификация (migrate-014): характер сделки + продуктовые теги + ВЭД-флаг
  put('Характер сделки', body.dealNature);
  if (body.foreignTrade === true || body.foreignTrade === 'true') row['ВЭД'] = true;
  const pc = Array.isArray(body.productClass)
    ? body.productClass.map((s) => String(s || '').trim()).filter(Boolean).join('; ')
    : String(body.productClass || '').trim();
  if (pc) row['Продуктовая классификация'] = pc;
  // K-22 (фикс 1): «Продуктовая линейка» деривится из ведущей продуктовой группы
  // (код → Лn), если оператор не задал её явно (форма регистрации line не шлёт).
  if (!row['Продуктовая линейка']) { const derived = lineFromProductClass(pc); if (derived) row['Продуктовая линейка'] = derived; }
  if (body.deadline) row['Срок подачи'] = String(body.deadline).replace('T', ' ').slice(0, 16); // дата+время «ГГГГ-ММ-ДД ЧЧ:ММ»
  if (body.qty != null && body.qty !== '') row['Кол-во'] = Number(body.qty);

  const created = await ncCreateMany('sales_requests', [row]);
  const c = Array.isArray(created) ? created[0] : created;
  // создать на NAS папку запроса + 6 подпапок этапов (если задан путь к записям)
  let folderCreated = false;
  if (cfg().RECORDS) { try { folderCreated = !!createSalesFolderTree(numZp); } catch {} }
  return { ok: true, numZp, id: c.Id ?? c.id, folderCreated };
}

