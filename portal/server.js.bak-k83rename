function ocrParseRuNumber(s) { const n = Number(String(s || '').replace(/\s+/g, '').replace(',', '.')); return Number.isFinite(n) ? n : null; }
// K-83 доп.: «чистое» имя поставщика — только орг.форма + название, без ИНН/КПП/адреса/
// прочих реквизитов, которые OCR обычно захватывает вместе со строкой поставщика.
const OCR_ORGFORM_RE = /(ООО|АО|ПАО|ЗАО|ОАО|ИП)\s*[«"']?\s*([^«»"',\n\r;]{2,60})/;
// «СПЛОШНЫМИ ЗАГЛАВНЫМИ» длиннее 4 букв → «Первая заглавная» (короткие аббревиатуры типа
// ППР не трогаем — не с чем сравнивать регистр, если букв ≤4).
function ocrTitleCaseIfShouty(name) {
  const s = String(name || '').trim();
  const letters = s.replace(/[^A-ZА-ЯЁa-zа-яё]/g, '');
  const isShouty = letters.length > 4 && letters === letters.toUpperCase() && letters !== letters.toLowerCase();
  if (!isShouty) return s;
  return s.toLowerCase().replace(/(^|[\s-])([а-яёa-z])/gi, (m0, sep, ch) => sep + ch.toUpperCase());
}
// извлечь «орг.форма + чистое название» из фрагмента текста (строка/весь текст), иначе null
function ocrCleanSupplierFrom(fragment) {
  const m = OCR_ORGFORM_RE.exec(String(fragment || ''));
  if (!m) return null;
  const name = ocrTitleCaseIfShouty(m[2].trim().replace(/[«»"']+$/g, '').trim());
  return name ? `${m[1]} ${name}` : null;
}
// best-effort парсинг реквизитов счёта из распознанного текста (регэкспы по ТЗ K-83)
function parseInvoiceOcrText(text) {
  const t = String(text || '');
  const out = { number: null, date: null, supplier: null, inn: null, amount: null, vatRate: 22, vatAmount: null };
  let m = /сч[её]т(?:\s+на\s+оплату)?\s*№?\s*([A-Za-zА-Яа-я0-9\-/]+)/i.exec(t);
  if (m) out.number = m[1];
  m = /от\s+(\d{1,2}[.\s]\d{1,2}[.\s]\d{2,4}|\d{1,2}\s+[а-яё]+\s+\d{4})/i.exec(t);
  if (m) out.date = ocrParseRuDate(m[1]);
  m = /ИНН\s*:?\s*(\d{10,12})/i.exec(t);
  if (m) out.inn = m[1];
  // K-83 доп.: приоритет — строка после «Поставщик:»/«Исполнитель:», иначе строка с «ИНН»,
  // иначе весь текст; из найденного фрагмента вырезаем ТОЛЬКО орг.форму + название.
  let supplierFrag = null;
