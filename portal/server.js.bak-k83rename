    res = await fetch('https://ocr.api.cloud.yandex.net/ocr/v1/recognizeText', {
      method: 'POST',
      headers: { 'Authorization': `Api-Key ${c.YC_OCR}`, 'x-data-logging-enabled': 'false', 'Content-Type': 'application/json' },
      body: JSON.stringify({ mimeType, languageCodes: ['ru', 'en'], model: 'page', content: buffer.toString('base64') }),
