  let data; try { data = await res.json(); } catch { return { ok: false, reason: 'parse' }; }
  const fullText = ocrExtractFullText(data);
  if (!fullText) return { ok: false, reason: 'empty' };
  return { ok: true, fields: parseInvoiceOcrText(fullText), textLen: fullText.length };
}

// ── K-86 этап 3: позиции заявки ЗнЗ (Заявки ЗнЗ 1:N Позиции, «Позиции ЗнЗ», migrate-045) ──
// DEGRADE-SAFE: до APPLY миграции таблицы «Позиции ЗнЗ» нет → GET отдаст пустой
// список (UI покажет старую одиночную позицию из полей заявки), POST/PATCH/DELETE —
// дружелюбную ошибку «секция появится после миграции». Аддитивно.
const znzNumOrNull = (v) => (v != null && v !== '') ? Number(v) : null;
async function znzItemsTableReady() { try { await tid('znz_items'); return true; } catch { return false; } }
function znzItemShape(r) {
  return {
    id: r.Id ?? r.id,
    name: r['Наименование'] || '', qty: r['Кол-во'] ?? '', unit: r['Ед.изм.'] || '',
    category: r['Категория'] || '', catalogCode: r['Каталог-код'] || '', note: r['Примечание'] || '',
    znzNum: r['ЗнЗ (№)'] || '', znzId: znzNumOrNull(r['ЗнЗ Id']),
  };
}
// список позиций по заявке ЗнЗ (по денормализ. «ЗнЗ Id»); degrade-safe (нет таблицы → [])
async function listItemsForZnz(znzId) {
  const id = Number(znzId);
  if (!Number.isFinite(id)) throw new Error('Некорректный идентификатор заявки (znzId).');
  const rows = await ncListSoft('znz_items');
  return rows.map(znzItemShape).filter((x) => x.znzId === id)
    .sort((a, b) => (Number(a.id) || 0) - (Number(b.id) || 0));
}
// карта znzId → число позиций (для колонки/бейджа реестра ЗнЗ)
function itemsCountByZnz(itemRows) {
  const m = new Map();
  for (const r of itemRows) { const zid = znzNumOrNull(r['ЗнЗ Id']); if (zid == null) continue; m.set(zid, (m.get(zid) || 0) + 1); }
  return m;
}
// строка позиции из тела запроса (валидация); znz — запись заявки для денормализации
function znzItemRowFromBody(body, znz) {
  const name = String(body.name || '').trim();
  if (!name) throw new Error('Не указано наименование позиции.');
  const row = { 'Наименование': name, 'ЗнЗ (№)': znz['№ ЗнЗ'] || '', 'ЗнЗ Id': Number(znz.Id ?? znz.id) };
  if (body.qty != null && String(body.qty).trim() !== '') { const q = Number(body.qty); if (!Number.isFinite(q) || q < 0) throw new Error('Некорректное количество позиции.'); row['Кол-во'] = q; }
  const unit = String(body.unit || '').trim(); if (unit) row['Ед.изм.'] = unit;
  const category = String(body.category || '').trim(); if (category) row['Категория'] = category;
  const cc = String(body.catalogCode || body.catalog_code || '').trim(); if (cc) row['Каталог-код'] = cc;
  const note = String(body.note || '').trim(); if (note) row['Примечание'] = note;
  return row;
}
async function createZnzItem(body) {
  if (!(await znzItemsTableReady())) throw new Error('Раздел «Позиции» появится после применения миграции (таблица «Позиции ЗнЗ» ещё не создана).');
  const znzId = Number(body.znzId ?? body.znz_id);
