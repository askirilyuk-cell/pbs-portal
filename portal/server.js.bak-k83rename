// сохранение позиций конструктора КП (upsert + удаление снятых). K-33: без гейта ЛОВ.
async function saveKpItems(body) {
  const zp = String(body.zp || '').trim();
  if (!zp) throw new Error('Не указан № запроса (ЗП).');
  const reqRow = await findSalesRequest(zp);
  if (!reqRow) throw new Error(`Запрос «${zp}» не найден.`);
  // K-33 (ДпП): конструктор КП доступен без ЛОВ — гейт §5.2 снят. ЛОВ опциональна.
  const c = cfg();
  const incoming = Array.isArray(body.positions) ? body.positions.filter((p) => p && String(p.name || '').trim()) : [];
  const existing = await kpItemsFor(zp);
  const existingIds = new Set(existing.map((r) => r.Id ?? r.id));
  const keepIds = new Set();
  const creates = [], updates = [];
  incoming.forEach((p, i) => {
    const posNum = kpNum(p.posNum) || (i + 1);
    const ci = computeKpItem(p, c.KP_PROFIT_PCT);
    const cfg = resolveLineConfig(p.line, p.lineCode);
    const isBm = cfg && cfg.model === 'bimetal';
    const row = {
      'Позиция': `${zp} · поз. ${posNum}`, 'ЗП': zp, '№ позиции': posNum,
      'Наименование / обозначение': String(p.name).trim(),
      'Продуктовая линейка': String(p.line || '').trim(), 'Код линейки': String(p.lineCode || (cfg && cfg.code) || '').trim(),
      'Ед.изм.': String(p.unit || '').trim(),
      // входы модели Л2 «Биметалл» (столбцы появляются после migrate-024 APPLY; до
      // APPLY NocoDB молча игнорит неизвестные поля — материалы уже посчитаны в ci).
      'Площадь наплавки, дм²': isBm && p.bmArea !== '' && p.bmArea != null ? kpNum(p.bmArea) : null,
      'Толщина слоя, мм': isBm && p.bmThickness !== '' && p.bmThickness != null ? kpNum(p.bmThickness) : null,
      'Тип наплавки': isBm ? String(p.bmMaterial || '').trim() : '',
      'Кол-во': ci.qty, 'Материалы, руб.': ci.materials, 'Трудозатраты, руб.': ci.labor,
      'Энергия/расходники, руб.': ci.energy, 'Накладные, руб.': ci.overhead, 'Себестоимость ед., руб.': ci.costUnit,
      'Плановая прибыль, %': ci.profitPct, 'Цена за ед., руб.': ci.priceUnit, 'Сумма позиции, руб.': ci.lineSum,
      'Примечание': String(p.note || '').trim(),
    };
    const id = (p.id != null && p.id !== '') ? Number(p.id) : null;
    if (id != null && existingIds.has(id)) { keepIds.add(id); updates.push({ Id: id, ...row }); }
    else creates.push(row);
  });
  const delIds = existing.map((r) => r.Id ?? r.id).filter((id) => !keepIds.has(id));
  if (updates.length) await ncUpdateMany('sales_kp_items', updates);
  let createdIds = [];
  if (creates.length) {
    const created = await ncCreateMany('sales_kp_items', creates);
    createdIds = (Array.isArray(created) ? created : [created]).map((r) => r.Id ?? r.id).filter((x) => x != null);
    if (createdIds.length) { try { await ncLinkRecords('sales_requests', 'Позиции КП', reqRow.Id ?? reqRow.id, createdIds); } catch (e) { console.warn('КП: связь ЗП→позиции не создана:', e.message); } }
  }
  if (delIds.length) await ncDeleteMany('sales_kp_items', delIds);
  const view = await buildKp(zp);
  return { ok: true, ...view, saved: incoming.length, created: createdIds.length, updated: updates.length, deleted: delIds.length };
}
// отправка КП заказчику (§5.3.7): статус, № КП, сумма/дата в Ф.1–З.1. Гейт 2 — подпись по порогу.
async function sendKp(body) {
  const zp = String(body.zp || '').trim();
  if (!zp) throw new Error('Не указан № запроса (ЗП).');
  const reqRow = await findSalesRequest(zp);
  if (!reqRow) throw new Error(`Запрос «${zp}» не найден.`);
  // K-33 (ДпП): отправка КП не привязана к ЛОВ — гейт §5.2 снят. ЛОВ опциональна.
  const c = cfg();
  const calc = (await kpItemsFor(zp)).map((r) => computeKpItem(shapeKpItem(r), c.KP_PROFIT_PCT));
  if (!calc.length) throw new Error('В КП нет позиций — добавьте хотя бы одну (§5.3.1).');
  const totals = computeKpTotals(calc, c.KP_VAT_RATE);
  if (totals.subtotal <= 0) throw new Error('Сумма КП равна нулю — заполните цены позиций.');
  const signer = kpSigner(totals.subtotal, c.KP_SIGN_THRESHOLD);
  // Гейт 2 §5.3.5: отправка только после подписи по порогу. confirmSign моделирует состоявшуюся подпись.
  if (body.confirmSign !== true && body.confirmSign !== 'true') {
    const e = new Error(`Требуется подпись: сумма ${totals.subtotal.toLocaleString('ru-RU')} ₽ без НДС → подписывает ${signer} (§5.3.5, порог ${kpNum(c.KP_SIGN_THRESHOLD).toLocaleString('ru-RU')} ₽).`);
    e.status = 409; e.signer = signer; e.subtotal = totals.subtotal; throw e;
  }
  const today = new Date().toISOString().slice(0, 10);
  const year = Number(today.slice(0, 4));
  let numKp = String(reqRow['№ КП'] || '').trim();
  if (!numKp) numKp = await nextNumber('sales_requests', '№ КП', 'КП', year);
  // срок действия КП (§5.3.1): из тела (validUntil) либо +30 дней по умолчанию
  const validUntil = body.validUntil ? String(body.validUntil).slice(0, 10)
    : new Date(Date.now() + 30 * 864e5).toISOString().slice(0, 10);
  const patch = {
    'Статус': 'КП отправлено', '№ КП': numKp, 'Сумма КП, руб.': totals.subtotal, 'Дата КП': today,
    'Результат КП': 'Отправлено', 'Дата отправки КП': today, 'Срок действия КП': validUntil,
  };
  await ncUpdate('sales_requests', reqRow.Id ?? reqRow.id, patch);
  return { ok: true, zp, numKp, signer, subtotal: totals.subtotal, vat: totals.vat, total: totals.total, validUntil, status: 'КП отправлено' };
}
// исход КП (§5.3.7/§5.4) — проставляется вручную продажами; двигает статус ЗП по канону.
async function setKpResult(body) {
  const zp = String(body.zp || '').trim();
  if (!zp) throw new Error('Не указан № запроса (ЗП).');
  const rawResult = String(body.result || '').trim();
  // DEF-36: пустое значение / «— не задан —» = ВАЛИДНЫЙ СБРОС результата КП (очистка из UI).
  // Ранее пустое → 400 и результат нельзя было снять. Теперь reset очищает «Результат КП».
  const isReset = rawResult === '' || rawResult === '— не задан —' || rawResult.toLowerCase() === 'не задан';
  const result = isReset ? '' : rawResult;
  if (!isReset && !KP_RESULT_VALUES.includes(result)) throw new Error(`Недопустимый результат КП «${result}». Допустимо: ${KP_RESULT_VALUES.join(', ')}.`);
  const reqRow = await findSalesRequest(zp);
  if (!reqRow) throw new Error(`Запрос «${zp}» не найден.`);
  const patch = { 'Результат КП': result }; // '' → снять результат
  if (!isReset && (result === 'Проиграли' || result === 'Отказались')) patch['Статус'] = 'Проигран'; // терминал (канон migrate-021)
  // K-66: «Выиграли частично» — фиксируем сумму (и опц. объём/примечание) выигранной
  // части, чтобы дальнейший ЗКЗ формировался на неё. Поля из migrate-033 (до APPLY
  // NocoDB молча игнорит неизвестные колонки — логика result не ломается).
  if (result === KP_RESULT_PARTIAL) {
    if (body.wonPartSum != null && body.wonPartSum !== '') {
      const s = Number(body.wonPartSum);
      if (Number.isFinite(s)) patch['Сумма выигранной части'] = s;
    }
    if (body.wonPartNote != null) patch['Объём/примечание выигранной части'] = String(body.wonPartNote).trim();
  }
  await ncUpdate('sales_requests', reqRow.Id ?? reqRow.id, patch);
  const effWon = ('Сумма выигранной части' in patch) ? patch['Сумма выигранной части'] : reqRow['Сумма выигранной части'];
  return { ok: true, zp, result, orderGate: kpOrderGateOpen(result, effWon), partial: result === KP_RESULT_PARTIAL };
}
