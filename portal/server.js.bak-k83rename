// ── Вложения операций МК (Этап 1 доработки МК): «Программа обработки (ЧПУ)» и «Карта наладки (PDF)» ──
// Пишем на диск под rw-монтом /app (__dirname=/app/portal → .data/mk-files), НЕ в ro /records (см. METAL_PHOTO_ROOT).
// Ключ вложений — стабильная пара «№ МК» + «№ операции»: Id операции пересоздаётся при каждом saveRoute
// (операции удаляются и заводятся заново), поэтому имена файлов в БД не храним — состав выводим прямо с
// диска, как фото деловых остатков. Механизм общий для ЛЮБОЙ операции (особенно нужен токарной).
const MK_FILE_ROOT = path.join(__dirname, '.data', 'mk-files');
const MK_OP_KINDS = { nc: 'nc', setup: 'setup' };            // nc = ЧПУ-программа, setup = карта наладки
const MK_NC_EXT = /\.[a-z0-9]{1,10}$/i;                       // ЧПУ-программа: любой разумный тип (.nc/.txt/.mpf/.pdf…)
const MK_SETUP_EXT = /\.(pdf|png|jpe?g|gif|webp|bmp|tiff?|heic)$/i; // карта наладки: PDF / изображение
function _mkSafe(s) { return String(s == null ? '' : s).replace(/[\\/:*?"<>|]/g, '_').replace(/^\.+/, '').trim(); }
function mkOpDir(mk, opNum, kind, create) {
  const safeMk = _mkSafe(mk); const n = String(opNum == null ? '' : opNum).replace(/[^\d]/g, '');
  const k = MK_OP_KINDS[String(kind || '')]; if (!safeMk || !n || !k) return null;
  const dir = path.join(MK_FILE_ROOT, safeMk, 'op' + n, k);
  if (create) { try { fs.mkdirSync(dir, { recursive: true }); } catch {} }
  return dir;
}
function mkOpFiles(mk, opNum, kind) {
  try { const dir = mkOpDir(mk, opNum, kind); if (!dir) return []; return fs.readdirSync(dir).filter((f) => { try { return fs.statSync(path.join(dir, f)).isFile(); } catch { return false; } }).sort(); }
  catch { return []; }
}

// опции select МК (совпадают с ORDER_OPTS['Тип продукции'], но объявлены раньше него — литералом)
const MK_PRODUCT_TYPES = ['РТИ', 'Биметалл', 'Оснастка ОК', 'ЗИП ПВО', 'Механообработка', 'Металлоконструкции'];
const MK_STATUS = ['Черновик', 'Утверждена', 'В производстве'];
// автонумер № МК: МК-{КОМ|СБР}-ГГГГ-NNN (сквозной по типу+году; см. assign-mk-number.mjs)
async function nextMkNumber(type, year) {
  const rows = await ncListSoft('routes');
  const re = new RegExp(`^МК-${type}-(\\d{4})-(\\d+)$`);
  let max = 0;
  for (const r of rows) { const m = re.exec(String(r['№ МК'] || '')); if (m && m[1] === String(year)) max = Math.max(max, Number(m[2])); }
  return `МК-${type}-${year}-${String(max + 1).padStart(3, '0')}`;
}

// создать/обновить маршрутную карту вместе с операциями и входящими компонентами
async function saveRoute(body) {
  const type = String(body.type || '').trim();
  if (!['КОМ', 'СБР'].includes(type)) throw new Error('Тип МК должен быть КОМ или СБР.');
  const name = String(body.name || '').trim();
  if (!name) throw new Error('Не задано наименование изделия / компонента.');
  const opsIn = Array.isArray(body.operations) ? body.operations : [];

  const routeRow = { 'Тип МК': type, 'Наименование': name };
  if (body.designation) routeRow['Изделие / обозначение'] = String(body.designation).trim();
  const pt = String(body.productType || '').trim();
  if (pt) { if (!MK_PRODUCT_TYPES.includes(pt)) throw new Error(`Недопустимый тип продукции «${pt}».`); routeRow['Тип продукции'] = pt; }
  if (body.revision) routeRow['Ревизия'] = String(body.revision).trim();
  // K-81 доводка (migrate-043): «Материал» изделия — degrade-safe (колонка создаётся при первом сохранении, как «Чертежи КД»)
  if ('material' in body) {
    try { await ncEnsureColumn('routes', 'Материал', 'SingleLineText'); routeRow['Материал'] = String(body.material || '').trim(); }
    catch (e) { console.warn('МК: колонка «Материал» недоступна — материал не сохранён:', e.message); }
  }
  const smk = String(body.statusMk || 'Черновик').trim();
  if (!MK_STATUS.includes(smk)) throw new Error(`Недопустимый статус МК «${smk}».`);
  routeRow['Статус МК'] = smk;
  // K-34: связь МК → проект ОКР (децим. №) + привязка чертежей КД (реестр)
  if ('projectDecNo' in body) routeRow['Проект разработки (децим. №)'] = String(body.projectDecNo || '').trim();
  if ('kdDrawings' in body) {
    const arr = Array.isArray(body.kdDrawings) ? body.kdDrawings : [];
    const clean = arr.map((d) => ({
      doc: String(d.doc || '').trim(), name: String(d.name || '').trim(),
      vid: String(d.vid || '').trim(), rel: String(d.rel || '').trim(),
      proj: String(d.proj || body.projectDecNo || '').trim(),
    })).filter((d) => d.doc);
    try { await ncEnsureColumn('routes', 'Чертежи КД', 'LongText'); routeRow['Чертежи КД'] = clean.length ? JSON.stringify(clean) : ''; }
    catch (e) { console.warn('МК: колонка «Чертежи КД» недоступна — привязка чертежей не сохранена:', e.message); }
  }

  // резолвим наименования типов операций (для fallback имени операции)
  const opTypes = await ncListSoft('op_types');
  const otById = new Map(opTypes.map((t) => [t.Id ?? t.id, t]));

  let routeId = (body.id != null && body.id !== '') ? Number(body.id) : null;
  let mk = '';
  if (routeId == null) {
    const year = new Date().getFullYear();
    mk = await nextMkNumber(type, year);
    routeRow['№ МК'] = mk;
    routeRow['Статус'] = 'Действует';
    const cr = await ncCreateMany('routes', [routeRow]);
    const c = Array.isArray(cr) ? cr[0] : cr; routeId = c.Id ?? c.id;
  } else {
    await ncUpdate('routes', routeId, routeRow);
    const routes = await ncListSoft('routes');
    mk = (routes.find((x) => (x.Id ?? x.id) === routeId) || {})['№ МК'] || '';
    // пересборка операций: удаляем прежние операции маршрута + их компоненты
    const [ops, comps] = await Promise.all([ncListSoft('operations'), ncListSoft('components_in')]);
    const oldOpIds = new Set(ops.filter((o) => o.routes_id === routeId).map((o) => o.Id ?? o.id));
    const oldCompIds = comps.filter((c) => oldOpIds.has(c.operations_id)).map((c) => c.Id ?? c.id);
    if (oldCompIds.length) await ncDeleteMany('components_in', oldCompIds);
    if (oldOpIds.size) await ncDeleteMany('operations', [...oldOpIds]);
  }

  // K-81 редизайн Ф.13 (migrate-042): оснастка из справочника + № привязанной карты наладки.
  // СТРОГО АДДИТИВНО и degrade-safe: колонки создаём один раз и только если хоть одна операция их использует
  // (нет churn'а схемы на пустых сохранениях; работает и ДО применения миграции — как «Чертежи КД»).
  let hasTooling = false, hasSetupNo = false;
  if (opsIn.some((o) => String(o && o.tooling || '').trim())) {
    try { await ncEnsureColumn('operations', 'Оснастка', 'LongText'); hasTooling = true; }
    catch (e) { console.warn('МК: колонка «Оснастка» недоступна — оснастка не сохранена:', e.message); }
  }
  if (opsIn.some((o) => String(o && o.setupCardNo || '').trim())) {
    try { await ncEnsureColumn('operations', 'Карта наладки (№)', 'SingleLineText'); hasSetupNo = true; }
    catch (e) { console.warn('МК: колонка «Карта наладки (№)» недоступна — привязка не сохранена:', e.message); }
  }

  let opCount = 0, compCount = 0;
  for (let i = 0; i < opsIn.length; i++) {
    const o = opsIn[i];
    const opTypeId = (o.opTypeId != null && o.opTypeId !== '') ? Number(o.opTypeId) : null;
    const ctrl = ['нет', 'С', 'ОТК'].includes(o.control) ? o.control : 'нет';
    const opName = String(o.name || '').trim() || (opTypeId ? String((otById.get(opTypeId) || {})['Наименование'] || '') : '');
    if (!opName && opTypeId == null) continue; // пустая строка операции — пропуск
    const opRow = { '№ операции': i + 1, 'Операция': opName, 'Точка контроля': ctrl };
    if (o.equipment) opRow['Оборудование'] = String(o.equipment).trim();
    if (o.materials) opRow['Входящие материалы'] = String(o.materials).trim();
    if (o.whatControl) opRow['Что контролировать'] = String(o.whatControl).trim();
    if (o.si) opRow['СИ'] = String(o.si).trim();
    if (o.tolerance) opRow['Допуски'] = String(o.tolerance).trim();
    if (o.norm != null && o.norm !== '') opRow['Норма времени (ч)'] = Number(o.norm);
    if (hasTooling && String(o.tooling || '').trim()) opRow['Оснастка'] = String(o.tooling).trim();
    if (hasSetupNo && String(o.setupCardNo || '').trim()) opRow['Карта наладки (№)'] = String(o.setupCardNo).trim();
    const cr = await ncCreateMany('operations', [opRow]);
    const co = Array.isArray(cr) ? cr[0] : cr; const opId = co.Id ?? co.id;
    await ncLinkRecords('routes', 'Операции маршрута', routeId, [opId]);
    if (opTypeId) { try { await ncLinkRecords('op_types', 'Операции (по типу)', opTypeId, [opId]); } catch (e) { console.warn('МК: связь операция→тип не создана:', e.message); } }
    for (const c of (Array.isArray(o.components) ? o.components : [])) {
      const cname = String(c.name || '').trim(); if (!cname) continue;
      const compRow = { 'Компонент': cname };
      if (c.qty != null && c.qty !== '') compRow['Кол-во'] = Number(c.qty);
      if (c.src) compRow['№ ПЗ-источника'] = String(c.src).trim();
      const ccr = await ncCreateMany('components_in', [compRow]);
      const cco = Array.isArray(ccr) ? ccr[0] : ccr; const compId = cco.Id ?? cco.id;
      await ncLinkRecords('operations', 'Входящие компоненты', opId, [compId]);
      compCount++;
    }
    opCount++;
  }
  return { ok: true, id: routeId, mk, operations: opCount, components: compCount };
}

// генерация карт задач (Ф.14) из МК: по позициям, привязанным к маршруту (routes_id),
// создаём Задачу на участок по каждой операции + копируем «Значения параметров задачи»
// из типа операции. Идемпотентно по «№ задачи» = ПЗ/позиция-опN (порт generate-tasks.mjs).
async function generateTasksFromRoute(routeId) {
  const rid = Number(routeId);
  const [routes, positions, orders, ops, opTypes, params, tasks] = await Promise.all([
    ncListSoft('routes'), ncListSoft('positions'), ncListSoft('orders'),
    ncListSoft('operations'), ncListSoft('op_types'), ncListSoft('op_params'), ncListSoft('tasks'),
  ]);
  const route = routes.find((x) => (x.Id ?? x.id) === rid);
  if (!route) throw new Error('Маршрут не найден.');
  const mk = route['№ МК'] || 'МК';
  const orderById = new Map(orders.map((o) => [o.Id ?? o.id, o]));
  const otById = new Map(opTypes.map((t) => [t.Id ?? t.id, t]));
  const pById = new Map(params.map((p) => [p.Id ?? p.id, p]));
  const routeOps = ops.filter((o) => o.routes_id === rid)
    .sort((a, b) => (Number(a['№ операции']) || 0) - (Number(b['№ операции']) || 0));
  if (!routeOps.length) throw new Error('В маршруте нет операций — сначала заведите операции.');
  const linkedPos = positions.filter((p) => p.routes_id === rid);
  if (!linkedPos.length) throw new Error('К маршруту не привязана ни одна позиция ПЗ. Привяжите маршрут к позиции заказа (поле «Маршрут» позиции), затем повторите.');
  const existingNums = new Set(tasks.map((t) => String(t['№ задачи'])));

  let created = 0, skipped = 0;
  const perPos = [];
  for (const pos of linkedPos) {
    const posId = pos.Id ?? pos.id;
    const posNum = pos['№ позиции'] || String(posId);
    const order = orderById.get(pos.orders_id) || {};
    const numPz = order['№ ПЗ'] || 'ПЗ';
    let posCreated = 0;
    for (const op of routeOps) {
      const opId = op.Id ?? op.id;
      const opNum = op['№ операции'] ?? '?';
      const taskNum = `${numPz}/${posNum}-оп${opNum}`;
      if (existingNums.has(taskNum)) { skipped++; continue; }
      const opTypeId = op.op_types_id ?? null;
      const ot = otById.get(opTypeId) || {};
      const ctrl = op['Точка контроля'] || 'нет';
      const taskRow = {
        '№ задачи': taskNum,
        'Операция (№ МК / № оп.)': `${mk} оп.${opNum}`,
        'Статус': 'В очереди',
        'Приоритет': order['Приоритет'] || 'Нормальный',
        'Дата плановая': pos['Срок готовности'] || order['Плановый срок'] || null,
        'Входящие материалы': op['Входящие материалы'] || '',
        'Оборудование': op['Оборудование'] || '',
        'Самоконтроль (С)': ctrl === 'С',
        'Контроль ОТК': ctrl === 'ОТК',
      };
      const tcr = await ncCreateMany('tasks', [taskRow]);
      const tco = Array.isArray(tcr) ? tcr[0] : tcr; const taskId = tco.Id ?? tco.id;
      existingNums.add(taskNum);
      // связи задачи (заполняют FK на дочерней записи)
      await ncLinkRecords('orders', 'Задачи', order.Id ?? order.id, [taskId]).catch(() => {});
      await ncLinkRecords('positions', 'Задачи', posId, [taskId]).catch(() => {});
      await ncLinkRecords('operations', 'Задачи (по операции)', opId, [taskId]).catch(() => {});
      if (opTypeId) {
        await ncLinkRecords('op_types', 'Задачи (по типу)', opTypeId, [taskId]).catch(() => {});
        const secId = (_linkIds(ot['Участки'])[0]) ?? ot.sections_id;
        if (secId) await ncLinkRecords('sections', 'Задачи на участки', secId, [taskId]).catch(() => {});
        // копируем параметры типа операции в значения параметров задачи
        for (const pid of _linkIds(ot['Параметры'])) {
          const p = pById.get(pid) || {};
          const pvr = await ncCreateMany('task_param_values', [{
            'Параметр': p['Параметр'] || '', 'Единица': p['Единица'] || '',
            'Обязательный': !!p['Обязательный'], 'Норматив': p['Норматив'] || '', 'Допуск': p['Допуск'] || '', 'Факт': '',
          }]);
          const pv = Array.isArray(pvr) ? pvr[0] : pvr;
          await ncLinkRecords('tasks', 'Значения параметров', taskId, [pv.Id ?? pv.id]).catch(() => {});
        }
      }
      created++; posCreated++;
    }
    perPos.push({ pz: numPz, pos: posNum, created: posCreated });
  }
  return { ok: true, mk, created, skipped, positions: perPos };
}

// K-72 / Узел 8: привязка позиции ПЗ к маршрутной карте (МК). Без связи
// positions.routes_id генерация задач Ф.14 не находит позиций и производство не
// стартует. Связь ставим со стороны «Маршрутов» (hm «Позиции (по маршруту)»,
// реципрок — bt «Маршруты» на позиции). Идемпотентно: повтор той же связи — no-op;
// смена маршрута — сначала отвязка старого, затем привязка нового; пустой routeId —
// отвязка. body: { positionId|posId, routeId|route }  (routeId пустой/null → отвязать).
async function linkPositionRoute(body) {
  const posId = Number(body.positionId ?? body.posId);
  if (!Number.isFinite(posId)) throw new Error('Не указан id позиции.');
  const rawRoute = body.routeId ?? body.route ?? null;
  const [positions, routes] = await Promise.all([ncListSoft('positions'), ncListSoft('routes')]);
  const pos = positions.find((x) => (x.Id ?? x.id) === posId);
  if (!pos) throw new Error('Позиция не найдена.');
  const curRid = (pos.routes_id != null) ? Number(pos.routes_id) : null;
  const posNum = pos['№ позиции'] || String(posId);
  // отвязка (routeId пустой/null)
  if (rawRoute == null || rawRoute === '') {
    if (curRid == null) return { ok: true, positionId: posId, posNum, routeId: null, already: true };
    await ncUnlinkRecords('routes', 'Позиции (по маршруту)', curRid, [posId]);
    return { ok: true, positionId: posId, posNum, routeId: null, unlinked: true };
  }
  const routeId = Number(rawRoute);
  if (!Number.isFinite(routeId)) throw new Error('Некорректный id маршрута.');
  const route = routes.find((x) => (x.Id ?? x.id) === routeId);
  if (!route) throw new Error('Маршрут не найден.');
  const mk = route['№ МК'] || '';
  if (curRid === routeId) return { ok: true, positionId: posId, posNum, routeId, mk, already: true };
  // смена маршрута — снимаем прежнюю связь, чтобы FK гарантированно перецепился
  if (curRid != null) { try { await ncUnlinkRecords('routes', 'Позиции (по маршруту)', curRid, [posId]); } catch (e) { console.warn('привязка МК: старую связь снять не удалось:', e.message); } }
  await ncLinkRecords('routes', 'Позиции (по маршруту)', routeId, [posId]);
  return { ok: true, positionId: posId, posNum, routeId, mk };
}

// раздел «Закупки» (ДП–К): заявки ЗнЗ + заказы поставщикам + РОП-поставщики + ЛОП.
// Поставщики — срез «Контрагентов» (роль «Поставщик» или есть РОП-поля). Даты — ISO
// (формат на клиенте). Эталон redesign-procurement.html (#s1–#s5).
async function buildProcurementLive() {
  // «Контрагенты» читаем жёстко: ошибка соединения с NocoDB → исключение → эндпоинт
  // отдаёт mock+warning (а не ложное «из базы · 0»). ЗнЗ/заказы/ЛОП — мягко (могут
  // отсутствовать до миграции или быть пусты).
  const cps = await ncList('sales_counterparties');
  const [preq, pord, sev, pinv, pitems] = await Promise.all([
    ncListSoft('procurement_requests'), ncListSoft('procurement_orders'), ncListSoft('supplier_evaluations'),
    ncListSoft('invoices'),    // K-86 этап 2: счета (degrade-safe — [] до миграции)
    ncListSoft('znz_items'),   // K-86 этап 3: позиции ЗнЗ (degrade-safe — [] до миграции)
  ]);
  const numOrNull = (v) => (v != null && v !== '') ? Number(v) : null;
  const invByZnz = invoicesSumByZnz(pinv);   // znzId → { sum, count }
  const itemsByZnz = itemsCountByZnz(pitems); // znzId → число позиций
  const requests = preq.map((r) => {
    const zid = r.Id ?? r.id;
    const inv = invByZnz.get(Number(zid)) || null;
    return {
    id: zid,
    numZnz: r['№ ЗнЗ'] || '', created: r['Дата'] || '', type: r['Тип'] || '', trigger: r['Триггер'] || '',
    initiatorDept: r['Подразделение-инициатор'] || '', initiator: r['Инициатор'] || '', category: r['Категория'] || '',
    name: r['Наименование'] || '', qty: r['Кол-во'] ?? '', unit: r['Ед.изм.'] || '', urgency: r['Срочность'] || '',
    rationale: r['Обоснование'] || '', budget: numOrNull(r['Ориент. бюджет, ₽']), orderSum: numOrNull(r['Сумма заказа, ₽']),
    // K-86 этап 2: сумма привязанных счетов + их число (колонка СУММА реестра ЗнЗ)
    invoicesSum: inv ? inv.sum : null, invoicesCount: inv ? inv.count : 0,
    status: r['Статус'] || '', approval: r['Согласование (§4)'] || '', supplier: r['Выбранный поставщик'] || '',
    // K-86 этап 3: денормализ. Id поставщика из реестра + число позиций заявки
    supplierId: numOrNull(r['Поставщик Id']), itemsCount: itemsByZnz.get(Number(zid)) || 0,
    sourceRef: r['Триггер-источник (ЗКЗ/ПЗ/склад)'] || '', stz: r['Режим ОЭЗ/СТЗ'] || '',
    duePlan: r['Срок поставки план'] || '', dueFact: r['Срок поставки факт'] || '', owner: r['Ответственный'] || '', note: r['Примечание'] || '',
    // K-83 этап 1a: сохранённый статус оплаты (degrade-safe — пусто до migrate-046)
    paymentId: r['Оплата Id'] || '', paymentStatus: r['Оплата статус'] || '',
    paymentAmount: numOrNull(r['Оплата сумма']), paymentUpdatedAt: r['Оплата обновлено'] || '',
  }; }).sort((a, b) => String(b.numZnz).localeCompare(String(a.numZnz), 'ru'));
  const orders = pord.map((o) => ({
    numPo: o['№ заказа'] || '', created: o['Дата'] || '', supplier: o['Поставщик'] || '', subject: o['Предмет'] || '',
    qty: o['Кол-во'] ?? '', unit: o['Ед.изм.'] || '', sum: numOrNull(o['Сумма, ₽']), docReq: o['Требуемые документы'] || '',
    payTerms: o['Условия оплаты'] || '', duePlan: o['Срок поставки план'] || '', dueFact: o['Срок поставки факт'] || '',
    status: o['Статус'] || '', note: o['Примечание'] || '',
  }));
  const suppliers = cps
    .filter((c) => String(c['Роль'] || '').includes('Поставщик') || c['Категория РОП'] || (c['Балл РОП'] != null && c['Балл РОП'] !== ''))
    .map((c) => ({
      id: c.Id ?? c.id, name: c['Наименование'] || '', inn: c['ИНН'] || '',
      contact: c['Контактное лицо'] || '', contacts: c['Тел./Email'] || '', region: c['Регион'] || '',
      productCat: c['Категория продукции'] || '', score: numOrNull(c['Балл РОП']), category: c['Категория РОП'] || '',
      reassess: c['Дата переоценки'] || '', status: c['Статус в РОП'] || '',
    }))
    .sort((a, b) => (b.score ?? -1) - (a.score ?? -1));
  const evaluations = sev.map((e) => ({
    supplier: e['Поставщик'] || '', date: e['Дата оценки'] || '', type: e['Тип оценки'] || '',
    price: numOrNull(e['Цена (макс 25)']), quality: numOrNull(e['Качество (макс 25)']), terms: numOrNull(e['Сроки (макс 20)']),
    docs: numOrNull(e['Документация (макс 15)']), eco: numOrNull(e['Эколог./ОТ (макс 15)']), total: numOrNull(e['Итог балл']),
    category: e['Категория'] || '', assessor: e['Оценку провёл'] || '', approver: e['Утвердил'] || '', note: e['Примечание'] || '',
  }));
  return { mode: 'live', requests, orders, suppliers, evaluations };
}

// --- создание заявки на закупку ЗнЗ (цеховая Ф.4–К / плановая Ф.1–К) ----------
// Быстрая форма цеха (планшет у станка) + плановая заявка снабжения. Автономер
// ЗнЗ-ГГГГ-NNN, запись в «Заявки ЗнЗ» (procurement_requests). Guard-валидации →
// исключение (роут отдаёт 400). Best-effort уведомление в Bitrix-чат цеховых
// заявок (notifyZnzCreated) — его сбой/отсутствие НЕ влияет на успех создания.
async function createZnzRequest(body) {
  // K-86 этап 3: многопозиционная заявка. Клиент шлёт positions[] (наименование/
  // кол-во/ед.изм./категория/каталог-код/примечание). Legacy-клиент (одна позиция
  // в полях name/qty/unit) поддерживается: если positions нет — работаем как раньше.
  // Обратная совместимость/degrade: первая позиция дублируется в поля заявки
  // «Наименование/Кол-во/Ед.изм./Категория», чтобы реестр/карта показывали заявку
  // и до применения миграции (когда таблицы «Позиции ЗнЗ» ещё нет).
  const positionsIn = (Array.isArray(body.positions) ? body.positions : []).map((p) => ({
    name: String(p.name || '').trim(),
    qty: (p.qty == null || String(p.qty).trim() === '') ? null : Number(p.qty),
    unit: String(p.unit || '').trim(),
    category: String(p.category || '').trim(),
    catalogCode: String(p.catalogCode || p.catalog_code || '').trim(),
    note: String(p.note || '').trim(),
  })).filter((p) => p.name);
  const first = positionsIn[0] || null;

  let name = String(body.name || (first ? first.name : '') || '').trim();
  if (!name) throw new Error('Не указано наименование заявки.');
  // многопозиционная заявка: имя в реестре = первая позиция + счётчик остальных,
  // чтобы заявка не выглядела «как будто одна позиция» (правка Александра 22.07)
  if (positionsIn.length > 1 && !/\(\+ещё \d+\)$/.test(name)) name = `${name} (+ещё ${positionsIn.length - 1})`;
  const qtyRaw = (body.qty != null && String(body.qty).trim() !== '') ? body.qty : (first ? first.qty : null);
  if (qtyRaw == null || String(qtyRaw).trim() === '') throw new Error('Не указано количество.');
  const qty = Number(qtyRaw);
  if (!Number.isFinite(qty) || qty <= 0) throw new Error('Некорректное количество (должно быть > 0).');
  const initiator = String(body.initiator || '').trim();
  if (!initiator) throw new Error('Не указан заявитель (инициатор).');

  // тип: по умолчанию цеховая (Ф.4–К, планшет у станка); плановая — Ф.1–К
  const typeIn = String(body.type || '').trim();
  const type = /план|Ф\.?1/i.test(typeIn) ? 'Плановая (Ф.1–К)' : 'Цеховая (Ф.4–К)';

  const created = body.date ? String(body.date).slice(0, 10) : new Date().toISOString().slice(0, 10);
  const year = Number(created.slice(0, 4)) || new Date().getFullYear();
  const numZnz = await nextNumber('procurement_requests', '№ ЗнЗ', 'ЗнЗ', year);

  const status = 'Новая';
  const row = {
    '№ ЗнЗ': numZnz, 'Дата': created, 'Тип': type, 'Наименование': name,
    'Кол-во': qty, 'Инициатор': initiator, 'Статус': status,
  };
  const unit = String(body.unit || (first ? first.unit : '') || '').trim(); if (unit) row['Ед.изм.'] = unit;
  const category = String(body.category || (first ? first.category : '') || '').trim(); if (category) row['Категория'] = category;
  const dept = String(body.initiatorDept || '').trim(); if (dept) row['Подразделение-инициатор'] = dept;
  const supplier = String(body.supplier || '').trim(); if (supplier) row['Выбранный поставщик'] = supplier;
  const urgency = String(body.urgency || '').trim(); if (urgency) row['Срочность'] = urgency;
  const rationale = String(body.rationale || '').trim(); if (rationale) row['Обоснование'] = rationale;
  const sourceRef = String(body.sourceRef || '').trim(); if (sourceRef) row['Триггер-источник (ЗКЗ/ПЗ/склад)'] = sourceRef;
  if (body.duePlan) row['Срок поставки план'] = String(body.duePlan).slice(0, 10);
  // референс/ссылка (напр. atmt.ru) + основание/комментарий → в «Примечание»
  const noteParts = [];
  const ref = String(body.reference || '').trim(); if (ref) noteParts.push('Ссылка/референс: ' + ref);
  const note = String(body.note || '').trim(); if (note) noteParts.push(note);
  if (noteParts.length) row['Примечание'] = noteParts.join('\n');

  const createdRows = await ncCreateMany('procurement_requests', [row]);
  const cr = Array.isArray(createdRows) ? createdRows[0] : createdRows;
  const id = cr && (cr.Id ?? cr.id);

  // K-86 этап 3: денормализ. Id выбранного поставщика из реестра «Контрагенты»
  // (best-effort, degrade-safe: колонки «Поставщик Id» нет до migrate-045 → ошибка глотается).
  const supplierId = Number(body.supplierId ?? body.supplier_id);
  if (Number.isFinite(supplierId) && supplierId > 0 && id != null) {
    try { await ncUpdate('procurement_requests', id, { 'Поставщик Id': supplierId }); }
    catch (e) { console.warn('ЗнЗ «Поставщик Id» не записан (колонки может не быть до миграции):', e.message); }
  }

  // K-86 этап 3: позиции заявки в таблице «Позиции ЗнЗ» (degrade-safe: нет таблицы →
  // пропуск, заявка остаётся 1-позиционной по полям name/qty/unit). Best-effort —
  // сбой сохранения позиций НЕ роняет создание заявки (legacy-поля уже записаны).
  let itemsCreated = 0;
  if (positionsIn.length && id != null) {
    try {
      if (await znzItemsTableReady()) {
        const itemRows = positionsIn.map((p) => {
          const ir = { 'Наименование': p.name, 'ЗнЗ (№)': numZnz, 'ЗнЗ Id': id };
          if (p.qty != null && Number.isFinite(p.qty)) ir['Кол-во'] = p.qty;
          if (p.unit) ir['Ед.изм.'] = p.unit;
          if (p.category) ir['Категория'] = p.category;
          if (p.catalogCode) ir['Каталог-код'] = p.catalogCode;
          if (p.note) ir['Примечание'] = p.note;
          return ir;
        });
        const cItems = await ncCreateMany('znz_items', itemRows);
        itemsCreated = Array.isArray(cItems) ? cItems.length : itemRows.length;
        try {
          const itemIds = (Array.isArray(cItems) ? cItems : []).map((x) => x.Id ?? x.id).filter((v) => v != null);
          if (itemIds.length) await ncLinkRecords('procurement_requests', 'Позиции', id, itemIds);
        } catch { /* soft — реципрок-связи может ещё не быть */ }
      }
    } catch (e) { console.warn('ЗнЗ позиции не сохранены:', e.message); }
  }

  // best-effort уведомление в Bitrix-чат (не влияет на успех создания)
  let notified;
  try { notified = await notifyZnzCreated({ numZnz, type, name, qty, unit, initiator, category, supplier }); }
  catch (e) { console.warn('ЗнЗ уведомление не отправлено:', e.message); notified = { ok: false, error: String(e.message || e) }; }

  return { ok: true, numZnz, id, status, type, itemsCreated, notified };
}

// --- K-86 смена статуса ЗнЗ по этапам (DEF-30) -------------------------------
// Порядок этапов ЗнЗ (Ф.1–К/Ф.4–К → ДП–К): Новая → Согласована → Поиск поставщика
// → Размещена → В пути → Принята → Закрыта. Переход разрешён ТОЛЬКО на соседний
// шаг (±1): вперёд по циклу или на один шаг назад (откат оператора). Аддитивно —
// create/list/PDF не затрагиваются; в NocoDB пишем только поле «Статус».
// TODO K-86 гейт по роли: отдельной роли «снабжение»/«руководитель» в RBAC пока
// нет — авторизацию перехода (кто согласует/размещает) добавить при уточнении схемы.
const ZNZ_STATUS_FLOW = ['Новая', 'Согласована', 'Поиск поставщика', 'Размещена', 'В пути', 'Принята', 'Закрыта'];
async function updateZnzStatus(body) {
  const idRaw = body.id ?? body.Id;
  if (idRaw == null || String(idRaw).trim() === '') throw new Error('Не указан идентификатор заявки (id).');
  const id = Number(idRaw);
  if (!Number.isFinite(id)) throw new Error('Некорректный идентификатор заявки.');
  const target = String(body.status || '').trim();
  if (!target) throw new Error('Не указан целевой статус.');
  const ti = ZNZ_STATUS_FLOW.indexOf(target);
  if (ti < 0) throw new Error(`Недопустимый статус: ${target}`);
  const rows = await ncListSoft('procurement_requests');
  const row = rows.find((x) => String(x.Id ?? x.id) === String(id));
  if (!row) throw new Error('Заявка ЗнЗ не найдена.');
  const from = String(row['Статус'] || '').trim() || 'Новая';
  const ci = ZNZ_STATUS_FLOW.indexOf(from);
  if (ci < 0) throw new Error(`Текущий статус вне цикла: «${from}».`);
  if (target === from) return { ok: true, id, from, to: target, unchanged: true };
  if (Math.abs(ti - ci) !== 1) throw new Error(`Переход «${from}» → «${target}» не разрешён: только соседний этап.`);
  await ncUpdate('procurement_requests', id, { 'Статус': target });
  return { ok: true, id, from, to: target };
}

// ── K-86 этап 2: счета поставщиков (ЗнЗ 1:N Счета, таблица «Счета-К», migrate-044) ──
// DEGRADE-SAFE во всём: до APPLY миграции таблицы «Счета-К» нет → ncListSoft вернёт [],
// GET отдаст пустой список, POST/PATCH — понятную ошибку «секция появится после
// миграции». Аддитивно: реестр/карта/статусы ЗнЗ не затрагиваются.
const INVOICE_PAY_STATUSES = ['Черновик', 'На согласовании', 'Ожидает оплаты', 'Оплачено', 'Отклонено'];
const INVOICE_VAT_RATES = ['22%', '20%', '10%', '0%', 'Без НДС']; // K-83: дефолт 22%, если OCR не распознал ставку
const invNumOrNull = (v) => (v != null && v !== '') ? Number(v) : null;
// разбор поля «Позиции счёта (Ids)» (LongText JSON-массив id позиций ЗнЗ) в число[]; degrade-safe
function invoiceItemIdsParse(v) {
  if (v == null || v === '') return [];
  try { const a = typeof v === 'string' ? JSON.parse(v) : v; return Array.isArray(a) ? a.map(Number).filter(Number.isFinite) : []; }
  catch { return []; }
}
// нормализовать вход itemIds из тела запроса (массив или JSON-строка) в число[] | null
function invoiceItemIdsFromBody(v) {
  if (v == null) return null;
  let arr = v;
  if (typeof arr === 'string') { try { arr = JSON.parse(arr); } catch { arr = arr.split(',').map((s) => s.trim()).filter(Boolean); } }
  if (!Array.isArray(arr)) return null;
  return arr.map((x) => Number(x)).filter((n) => Number.isFinite(n));
}
// нормализованная карточка счёта для клиента
function invoiceShape(r) {
  return {
    id: r.Id ?? r.id,
    invoiceNo: r['№ счёта'] || '', supplier: r['Поставщик'] || '', inn: r['ИНН поставщика'] || '',
    amount: invNumOrNull(r['Сумма, ₽']), vatRate: r['Ставка НДС'] || '', vatAmount: invNumOrNull(r['Сумма НДС, ₽']),
    payStatus: r['Статус оплаты'] || '', date: r['Дата счёта'] || '', note: r['Комментарий'] || '',
    znzNum: r['ЗнЗ (№)'] || '', znzId: invNumOrNull(r['ЗнЗ Id']),
    scan: eqAttach(r['Файл-скан']),
    itemIds: invoiceItemIdsParse(r['Позиции счёта (Ids)']), // K-83: позиции заявки, покрытые этим счётом ([] = не задано/весь охват)
    // K-83 этап 2: статус заявки на оплату ЭТОГО счёта (per-invoice externalRef)
    payExternalRef: r['Оплата ExternalRef'] || '', payId: r['Оплата ID'] || '', payUpdatedAt: r['Оплата обновлена'] || '',
  };
}
// проверить, что таблица «Счета-К» существует (для дружелюбной ошибки записи)
async function invoicesTableReady() {
  try { await tid('invoices'); return true; } catch { return false; }
}
// список счетов по заявке ЗнЗ (по денормализ. «ЗнЗ Id»); degrade-safe (нет таблицы → [])
async function listInvoicesForZnz(znzId) {
  const id = Number(znzId);
  if (!Number.isFinite(id)) throw new Error('Некорректный идентификатор заявки (znzId).');
  const rows = await ncListSoft('invoices');
  return rows.map(invoiceShape).filter((x) => x.znzId === id)
    .sort((a, b) => String(a.invoiceNo).localeCompare(String(b.invoiceNo), 'ru'));
}
// карта znzId → { sum, count } по всем счетам (для колонки СУММА реестра ЗнЗ)
function invoicesSumByZnz(invoiceRows) {
  const m = new Map();
  for (const r of invoiceRows) {
    const zid = invNumOrNull(r['ЗнЗ Id']); if (zid == null) continue;
    const amt = invNumOrNull(r['Сумма, ₽']) || 0;
    const cur = m.get(zid) || { sum: 0, count: 0 };
    cur.sum += amt; cur.count += 1; m.set(zid, cur);
  }
  return m;
}
// создать счёт на заявку ЗнЗ. body: { znzId, invoiceNo, supplier, amount, vatRate,
// vatAmount, date, payStatus, note, scan? }. scan — массив attachment-объектов NocoDB
// (из /api/procurement/invoices/upload), опционально.
async function createInvoice(body) {
  if (!(await invoicesTableReady())) throw new Error('Раздел «Счета» появится после применения миграции (таблица «Счета-К» ещё не создана).');
  const znzId = Number(body.znzId ?? body.znz_id);
  if (!Number.isFinite(znzId)) throw new Error('Не указана заявка ЗнЗ (znzId).');
  // резолвим № ЗнЗ из реестра (денормализация для читаемости + связь)
  const reqs = await ncListSoft('procurement_requests');
  const znz = reqs.find((x) => String(x.Id ?? x.id) === String(znzId));
  if (!znz) throw new Error('Заявка ЗнЗ не найдена.');

  const invoiceNo = String(body.invoiceNo || '').trim();
  if (!invoiceNo) throw new Error('Не указан № счёта.');
  const amountRaw = body.amount;
  const amount = (amountRaw == null || String(amountRaw).trim() === '') ? null : Number(amountRaw);
  if (amount != null && (!Number.isFinite(amount) || amount < 0)) throw new Error('Некорректная сумма счёта.');

  const payStatus = String(body.payStatus || '').trim() || 'Черновик';
  if (!INVOICE_PAY_STATUSES.includes(payStatus)) throw new Error(`Недопустимый статус оплаты: ${payStatus}`);
  const vatRate = String(body.vatRate || '').trim();
  if (vatRate && !INVOICE_VAT_RATES.includes(vatRate)) throw new Error(`Недопустимая ставка НДС: ${vatRate}`);

  const row = {
    '№ счёта': invoiceNo,
    'Статус оплаты': payStatus,
    'ЗнЗ (№)': znz['№ ЗнЗ'] || '', 'ЗнЗ Id': znzId,
  };
  const supplier = String(body.supplier || '').trim(); if (supplier) row['Поставщик'] = supplier;
  const inn = String(body.inn || '').trim(); if (inn) row['ИНН поставщика'] = inn;
  if (amount != null) row['Сумма, ₽'] = amount;
  if (vatRate) row['Ставка НДС'] = vatRate;
  const vatAmount = (body.vatAmount == null || String(body.vatAmount).trim() === '') ? null : Number(body.vatAmount);
  if (vatAmount != null && Number.isFinite(vatAmount)) row['Сумма НДС, ₽'] = vatAmount;
  if (body.date) row['Дата счёта'] = String(body.date).slice(0, 10);
  const note = String(body.note || '').trim(); if (note) row['Комментарий'] = note;
  if (Array.isArray(body.scan) && body.scan.length) row['Файл-скан'] = body.scan;
  // K-83: позиции заявки, которые покрывает счёт (одна/несколько/все — чекбоксы в форме)
  const itemIds = invoiceItemIdsFromBody(body.itemIds);
  if (itemIds && itemIds.length) row['Позиции счёта (Ids)'] = JSON.stringify(itemIds);

  const created = await ncCreateMany('invoices', [row]);
  const cr = Array.isArray(created) ? created[0] : created;
  const id = cr && (cr.Id ?? cr.id);

  // нативная связь ЗнЗ→Счёт (best-effort; фильтрация всё равно идёт по «ЗнЗ Id»)
  try { await ncLinkRecords('procurement_requests', 'Счета', znzId, [id]); } catch { /* soft — связи может ещё не быть */ }
  // best-effort автозавод поставщика в «Контрагенты» (снабженцу не нужно заводить его вручную)
  await upsertSupplierFromInvoice(supplier, inn, invoiceNo);

  return { ok: true, id, invoiceNo, znzId, payStatus };
}
// обновить счёт (смена статуса оплаты и/или полей). body: { id, payStatus?, ... }
async function updateInvoice(body) {
  if (!(await invoicesTableReady())) throw new Error('Раздел «Счета» появится после применения миграции (таблица «Счета-К» ещё не создана).');
  const id = Number(body.id ?? body.Id);
  if (!Number.isFinite(id)) throw new Error('Не указан идентификатор счёта (id).');
  const rows = await ncListSoft('invoices');
  const row = rows.find((x) => String(x.Id ?? x.id) === String(id));
  if (!row) throw new Error('Счёт не найден.');

  const patch = {};
  if (body.payStatus != null && String(body.payStatus).trim() !== '') {
    const ps = String(body.payStatus).trim();
    if (!INVOICE_PAY_STATUSES.includes(ps)) throw new Error(`Недопустимый статус оплаты: ${ps}`);
    patch['Статус оплаты'] = ps;
  }
  if (body.invoiceNo != null && String(body.invoiceNo).trim() !== '') patch['№ счёта'] = String(body.invoiceNo).trim();
  if (body.supplier != null) patch['Поставщик'] = String(body.supplier).trim();
  if (body.inn != null) patch['ИНН поставщика'] = String(body.inn).trim();
  if (body.amount != null && String(body.amount).trim() !== '') { const a = Number(body.amount); if (Number.isFinite(a) && a >= 0) patch['Сумма, ₽'] = a; }
  if (body.vatRate != null && String(body.vatRate).trim() !== '') { const vr = String(body.vatRate).trim(); if (!INVOICE_VAT_RATES.includes(vr)) throw new Error(`Недопустимая ставка НДС: ${vr}`); patch['Ставка НДС'] = vr; }
  if (body.vatAmount != null && String(body.vatAmount).trim() !== '') { const va = Number(body.vatAmount); if (Number.isFinite(va)) patch['Сумма НДС, ₽'] = va; }
  if (body.date != null && String(body.date).trim() !== '') patch['Дата счёта'] = String(body.date).slice(0, 10);
  if (body.note != null) patch['Комментарий'] = String(body.note).trim();
  if (Array.isArray(body.scan)) patch['Файл-скан'] = body.scan;
  if (body.itemIds !== undefined) { const itemIds = invoiceItemIdsFromBody(body.itemIds) || []; patch['Позиции счёта (Ids)'] = JSON.stringify(itemIds); }
  if (!Object.keys(patch).length) return { ok: true, id, unchanged: true };

  await ncUpdate('invoices', id, patch);
  // best-effort автозавод/обновление поставщика в «Контрагенты», если правили имя/ИНН
  if (patch['Поставщик'] != null || patch['ИНН поставщика'] != null) {
    const nm = patch['Поставщик'] != null ? patch['Поставщик'] : String(row['Поставщик'] || '');
    const innV = patch['ИНН поставщика'] != null ? patch['ИНН поставщика'] : String(row['ИНН поставщика'] || '');
    await upsertSupplierFromInvoice(nm, innV, patch['№ счёта'] || row['№ счёта'] || '');
  }
  return { ok: true, id, patched: Object.keys(patch) };
}
// K-83 доп. (упрощённый ввод счетов): best-effort автозавод поставщика в «Контрагенты»
// (sales_counterparties) при сохранении счёта — снабженцу не нужно вручную заводить
// контрагента. Дедуп: точное совпадение по ИНН, иначе — по Наименованию (без учёта
// регистра); не нашли — создаём с Ролью «Поставщик». Ошибка НЕ ломает сохранение счёта.
async function upsertSupplierFromInvoice(name, inn, invoiceNo) {
  const nm = String(name || '').trim();
  const innT = String(inn || '').trim();
  if (!nm && !innT) return;
  try {
    const rows = await ncListSoft('sales_counterparties');
    let dup = null;
    if (innT) dup = rows.find((c) => String(c['ИНН'] || '').trim() === innT);
    if (!dup && nm) dup = rows.find((c) => String(c['Наименование'] || '').trim().toLowerCase() === nm.toLowerCase());
    if (dup) {
      const roles = String(dup['Роль'] || '').split(',').map((s) => s.trim()).filter(Boolean);
      if (!roles.includes('Поставщик')) { roles.push('Поставщик'); await ncUpdate('sales_counterparties', dup.Id ?? dup.id, { 'Роль': roles.join(',') }); }
      return;
    }
    const row = { 'Наименование': nm || innT, 'Роль': 'Поставщик', 'Примечание': `Автосоздан из счёта ${invoiceNo || '—'} (портал)` };
    if (innT) row['ИНН'] = innT;
    await ncCreateMany('sales_counterparties', [row]);
  } catch (e) { console.warn('K-83: контрагент-поставщик не автосоздан/не обновлён (best-effort):', e.message); }
}
// удалить счёт. Счёт с уже созданной заявкой на оплату («Оплата ExternalRef» заполнен)
// удалять нельзя — иначе на портале Алексея останется заявка без записи-источника здесь.
// «Файл-скан» в хранилище NocoDB НЕ трогаем (остаётся, просто теряет привязку к счёту).
async function deleteInvoice(body) {
  if (!(await invoicesTableReady())) throw new Error('Раздел «Счета» появится после применения миграции (таблица «Счета-К» ещё не создана).');
  const id = Number(body.id ?? body.Id);
  if (!Number.isFinite(id)) throw new Error('Не указан идентификатор счёта (id).');
