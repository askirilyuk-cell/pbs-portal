  const acts = await ncListSoft('incoming_control');
  const act = acts.find((r) => String(r.Id ?? r.id) === actRef) || acts.find((r) => String(r['№ акта'] || '').trim() === actRef);
  if (!act) { const e = new Error(`ГЕЙТ 1 (§4.1): акт входного контроля Ф.3–Д.1 «${actRef}» не найден — приход запрещён.`); e.status = 409; throw e; }
