// поиск папки проекта в DESIGN_ROOT по децим.№ (basename === decNo или decNo + разделитель).
// opts.create=true → создать по образцу раскладки, если папка ещё не заведена вручную.
function designProjectFolder(decNo, opts) {
  opts = opts || {};
  const root = cfg().DESIGN_ROOT;
  if (!root) return null;
  const dec = String(decNo || '').trim();
  if (!/^[A-Za-zА-Яа-я]{2,4}\d{4}$/.test(dec)) return null;
  const SKIP = /^(@eaDir|#recycle|#snapshot|\.)/i;
  const boundary = new RegExp('^' + dec + '($|[\\s\\-_])', 'i');
  let found = null;
  const walk = (dir, depth) => {
    if (found || depth > 4) return;
    let ents; try { ents = fs.readdirSync(dir, { withFileTypes: true }); } catch { return; }
    for (const e of ents) {
      if (found) return;
      if (!e.isDirectory() || SKIP.test(e.name)) continue;
      const full = path.join(dir, e.name);
      if (boundary.test(e.name)) { found = full; return; }
      walk(full, depth + 1);
    }
  };
  walk(root, 0);
  if (found || !opts.create) return found;
  // fallback-создание: <root>/<grp dir>/<subCode dir>/<decNo name>
  const name = String(opts.name || '').replace(/[\\/:*?"<>|]/g, '_').trim();
  const findOrMake = (parent, code) => {
    let ents = []; try { ents = fs.readdirSync(parent, { withFileTypes: true }); } catch {}
    const re = new RegExp('^' + code + '($|[\\s\\-_])', 'i');
    const hit = ents.find((e) => e.isDirectory() && re.test(e.name));
    if (hit) return path.join(parent, hit.name);
    const dir = path.join(parent, code);
    try { fs.mkdirSync(dir, { recursive: true }); return dir; } catch { return null; }
  };
  let base = root;
  const grp = String(opts.grp || '').trim();
  const subCode = String(opts.subCode || '').trim();
  if (grp) { base = findOrMake(base, grp); if (!base) return null; }
  if (subCode && subCode !== grp) { base = findOrMake(base, subCode); if (!base) return null; }
  const projDir = path.join(base, name ? `${dec} ${name}` : dec);
  try { fs.mkdirSync(projDir, { recursive: true }); return projDir; } catch { return null; }
}
// рекурсивный список файлов папки проекта (как walkSalesFiles, по DESIGN_ROOT)
function walkDesignFiles(folder) {
  const out = [];
  const SKIP = /^(@eaDir|#recycle|#snapshot|\.)/i;
  const walk = (dir) => {
    let ents; try { ents = fs.readdirSync(dir, { withFileTypes: true }); } catch { return; }
    for (const e of ents) {
      if (SKIP.test(e.name)) continue;
      const full = path.join(dir, e.name);
      if (e.isDirectory()) { walk(full); continue; }
      if (/^(desktop\.ini|thumbs\.db)$/i.test(e.name) || /\.tmp$/i.test(e.name)) continue;
      const rel = path.relative(folder, full).split(path.sep).join('/');
      let size = 0; try { size = fs.statSync(full).size; } catch {}
      out.push({ rel, name: e.name, ext: (e.name.split('.').pop() || '').toLowerCase(), stage: rel.includes('/') ? rel.split('/')[0] : '', size });
    }
  };
  walk(folder);
  return out.sort((a, b) => a.rel.localeCompare(b.rel, 'ru'));
}
