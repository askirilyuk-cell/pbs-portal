// ============================================================================
//  ISO-каталог режущего инструмента (Этап 2a, migrate-036): пластины (ISO 1832)
//  и державки (ISO 5608). MVP по ISO-коду (минимум полей, декод — следующий этап).
//  FORWARD-TOLERANT: таблиц может не быть → ncListSoft отдаёт [], GET 200/пусто,
//  write-эндпоинты гардятся isLive(). Файлы (эскиз ISO-схемы + фото) — на rw-диске
//  портала (.data/tool-catalog), отдаются только traversal-guard GET. Имена — с диска.
// ============================================================================
const TC_INSERT_PROC = ['Точение', 'Фрезерование', 'Растачивание', 'Отрезка', 'Резьба'];
const TC_HOLDER_TYPES = ['Токарная наружная', 'Расточная', 'Канавочная', 'Резьбовая'];
const TC_STATUSES = ['Активна', 'Архив'];
const TC_PHOTO_ROOT = path.join(__dirname, '.data', 'tool-catalog');
const TC_FILE_EXT = /\.(pdf|png|jpe?g|gif|webp|bmp|tiff?)$/i;
// каталог файлов позиции: .data/tool-catalog/{inserts|holders}/<ISO sanitized>/
function tcDir(kind, iso, create) {
  const bucket = kind === 'holders' ? 'holders' : 'inserts';
  const safe = String(iso || '').replace(/[\\/:*?"<>|]/g, '_').replace(/^\.+/, '').trim();
  if (!safe) return null;
  const dir = path.join(TC_PHOTO_ROOT, bucket, safe);
  if (create) { try { fs.mkdirSync(dir, { recursive: true }); } catch {} }
  return dir;
}
function tcFiles(kind, iso) {
  try { const dir = tcDir(kind, iso); if (!dir) return []; return fs.readdirSync(dir).filter((f) => TC_FILE_EXT.test(f)).sort(); }
  catch { return []; }
}
// mm/link-поле NocoDB → массив id связанных записей (устойчиво к объекту/массиву)
function tcLinkIds(v) {
  if (v == null) return [];
  const arr = Array.isArray(v) ? v : [v];
  return arr.map((x) => (x && typeof x === 'object') ? (x.Id ?? x.id) : null).filter((x) => x != null);
}
// точное чтение связанных записей через links-эндпоинт (list-поле не всегда разворачивает mm)
async function ncListLinked(key, linkTitle, rowId) {
  const c = cfg();
