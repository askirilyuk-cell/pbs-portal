// агрегатный статус листа: все разделы «Готов» → «Готова к решению» (если решение ещё не вынесено)
async function lovRecalcSheet(sectionId) {
  const { sheets, secById } = await lovData();
  const sheet = sheets.find((sh) => (sh['Разделы'] || []).some((x) => String(idOfRow(x)) === String(sectionId)));
  if (!sheet) return;
  if (DECISION_STATUS_VALUES.includes(sheet['Статус'])) return; // решение уже вынесено — не трогаем
  const mine = (sheet['Разделы'] || []).map((x) => secById[idOfRow(x)]).filter(Boolean);
  const allReady = mine.length && mine.every((s) => s['Статус'] === 'Готов');
  const want = allReady ? 'Готова к решению' : 'Оценка';
  if (sheet['Статус'] !== want) { try { await ncUpdate('lov_sheets', idOfRow(sheet), { 'Статус': want }); } catch {} }
}
// решение ДпП (этап 2) — только ДпП/админ
async function lovDecision(body, session) {
