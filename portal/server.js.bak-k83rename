}
// вызов Yandex Cloud OCR (recognizeText, синхронно, 1 страница/изображение) + парсинг.
// Любая ошибка — degrade-safe { ok:false, reason }; ключ/текст никогда не логируются.
async function ocrRecognizeInvoice(buffer, mimeType) {
  const c = cfg();
  if (!c.YC_OCR) return { ok: false, reason: 'no-key' };
