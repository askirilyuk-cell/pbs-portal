// --- поиск файла документа на NAS («Сервер ПБС») по коду ---------------------
// нормализация кода/имени: убираем регистр, пробелы, разные тире → латиница не трогаем
const docNorm = (s) => String(s || '').toLowerCase().replace(/[\s_]+/g, '').replace(/[–—−]/g, '-');
let _docFileIdx = null, _docFileIdxKey = '';
// строит индекс {нормкод → relPath} обходом DOCS_ROOT (ограничение глубины/кол-ва)
function docsFileIndex() {
  const root = cfg().DOCS_ROOT;
  if (!root) return {};
  if (_docFileIdx && _docFileIdxKey === root) return _docFileIdx;
  const idx = {}; let seen = 0;
  const exts = /\.(pdf|docx?|xlsx?|pptx?|odt|ods|odp|rtf)$/i;
  const SKIP_DIR = /^(@eaDir|#recycle|#snapshot|\.)/i; // служебные папки Synology
  const walk = (dir, depth) => {
    if (depth > 6 || seen > 20000) return;
    let ents; try { ents = fs.readdirSync(dir, { withFileTypes: true }); } catch { return; }
    for (const e of ents) {
      if (SKIP_DIR.test(e.name)) continue;
      const full = path.join(dir, e.name);
      if (e.isDirectory()) { walk(full, depth + 1); continue; }
      seen++;
      if (!exts.test(e.name)) continue;
      const rel = path.relative(root, full).split(path.sep).join('/');
      const nn = docNorm(e.name);
      // привязываем к первому встреченному файлу для каждого кода-подстроки делаем при запросе
      idx[rel] = nn; // храним rel→норм.имя, матч кода — при запросе
    }
  };
  try { walk(root, 0); } catch {}
  _docFileIdx = idx; _docFileIdxKey = root;
  return idx;
}
// находит rel-путь файла по коду. Приоритет: точное совпадение с версией («…дп-д.1-1.1…»),
// иначе — по базовому коду без версии («…ф.2-л.1…», т.к. в части имён форм версии нет).
// При прочих равных берём файл с более коротким путём (активная папка, не 07-Архив).
function docsResolveFile(code) {
  const full = docNorm(code);            // напр. «дп-д.1-1.1» (с версией, если она в коде)
  const bare = full.replace(/-\d+\.\d+$/, ''); // напр. «дп-д.1»
  if (!bare) return null;
  const hasVer = full.length > bare.length;
  const idx = docsFileIndex();
  let exact = null, loose = null;
  for (const rel in idx) {
    const nn = idx[rel];
    if (hasVer && nn.includes(full) && (!exact || rel.length < exact.length)) exact = rel;
    if (nn.includes(bare) && (!loose || rel.length < loose.length)) loose = rel;
  }
  return exact || loose;
}
