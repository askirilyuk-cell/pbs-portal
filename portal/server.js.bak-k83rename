const DOCS_FILE_FIELDS = ['Файл', 'Файл (NAS)', 'Файл документа', 'PDF на NAS', 'Путь', 'Путь на NAS'];
async function buildDocs() {
  const c = cfg();
  // без fields= — берём все колонки таблицы (схема «ИСМ ПБС» может отличаться/расширяться)
  const url = `${c.NC_URL}/api/v2/tables/${await ismDocsTid()}/records?limit=1000`;
  const res = await fetch(url, { headers: { 'xc-token': c.NC_TOKEN } });
  if (!res.ok) throw new Error(`NocoDB ${res.status}: ${await res.text()}`);
  return ((await res.json()).list || []).filter((r) => r['Код']).map((r) => {
    let file = '';
    for (const f of DOCS_FILE_FIELDS) { if (r[f]) { file = String(r[f]); break; } }
    // «UNC мастера» — путь файла под управлением портала: «draft:<имя>» (черновик) или rel под DOCS_ROOT (опубликован)
    const unc = String(r['UNC мастера'] || '');
    let fileRel = '', draft = '';
    if (unc.startsWith('draft:')) draft = unc.slice(6);
    else if (unc) {
      // «UNC мастера» бывает Windows-UNC «\\host\share\03-…\file» или уже rel «03-…/file» → приводим к rel под DOCS_ROOT
      let rel = unc.replace(/\\/g, '/');
      const m = rel.match(/(0[1-7]-[^/]*?-ПБС\/.*)$/);
      rel = m ? m[1] : rel.replace(/^\/+[^/]+\/[^/]+\//, '');
      const root = cfg().DOCS_ROOT;
      // если файл по указанному пути есть — используем; иначе фолбэк на поиск по коду
      fileRel = (root && fs.existsSync(path.join(root, rel))) ? rel : (docsResolveFile(r['Код']) || '');
    }
    else fileRel = file || docsResolveFile(r['Код']) || ''; // фолбэк: поиск по коду на NAS
    const fileExt = ((draft || fileRel).split('.').pop() || '').toLowerCase();
    return {
      id: r.Id, code: r['Код'] || '', name: r['Название'] || '', type: r['Тип'] || '', section: r['Раздел'] || '',
      ver: r['Версия'] || '', status: r['Статус'] || '', format: r['Формат'] || '',
      approvedDate: r['Дата утверждения'] || '', approvedBy: r['Утверждён'] || '', file, fileRel, fileExt, draft, unc,
    };
  }).sort((a, b) => String(a.code).localeCompare(String(b.code), 'ru'));
}
