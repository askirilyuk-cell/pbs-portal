function designFileIndex() {
  const root = cfg().DESIGN_ROOT;
  if (!root) return {};
  if (_kdFileIdx && _kdFileIdxKey === root) return _kdFileIdx;
  const idx = {}; let seen = 0;
  const SKIP_DIR = /^(@eaDir|#recycle|#snapshot|\.)/i;
  const walk = (dir, depth) => {
    if (depth > 7 || seen > 40000) return;
    let ents; try { ents = fs.readdirSync(dir, { withFileTypes: true }); } catch { return; }
    for (const e of ents) {
      if (SKIP_DIR.test(e.name)) continue;
      const full = path.join(dir, e.name);
      if (e.isDirectory()) { walk(full, depth + 1); continue; }
      seen++;
      if (!/\.pdf$/i.test(e.name)) continue;
      const rel = path.relative(root, full).split(path.sep).join('/');
      idx[rel] = e.name;
    }
  };
  try { walk(root, 0); } catch {}
  _kdFileIdx = idx; _kdFileIdxKey = root;
  return idx;
}
function invalidateDesignIndex() { _kdFileIdx = null; _kdFileIdxKey = ''; }
// все release-PDF для данного децимального № документа
function designResolveKdFiles(docNo) {
  const base = String(docNo || '').trim();
  if (!base) return [];
  const idx = designFileIndex();
  const out = [];
  for (const rel in idx) {
    const stem = idx[rel].replace(/\.pdf$/i, '');
    if (stem !== base && !stem.startsWith(base + ' ')) continue; // граница по пробелу
    const after = stem.slice(base.length).trim();
    let kind = 'чертёж';
    if (/^СБ(\s|$)/i.test(after)) kind = 'СБ';        // кириллица не \w → \b не работает, матчим по пробелу
    else if (/^СП(\s|$)/i.test(after)) kind = 'СП';
    out.push({ kind, rel });
  }
  // приоритет вывода: СБ, чертёж, СП
  const ord = { 'СБ': 0, 'чертёж': 1, 'СП': 2 };
  return out.sort((a, b) => (ord[a.kind] ?? 9) - (ord[b.kind] ?? 9));
}
// --- загрузка КД/чертежей в папку проекта (по образцу /api/sales/upload) -------
// Раскладка записей РКД: <DESIGN_ROOT>/<Группа dir>/<Подгруппа dir>/<децим.№ …>/<этап>/…
// Чертежи КД → 03-КД: тот же release-контур, откуда designFileIndex() читает выпущенные
// PDF, поэтому загруженный сюда PDF сразу появляется ссылкой в дереве/реестре КД.
const DESIGN_STAGES = ['03-КД', '04-ТД', '01-ТЗ', '09-Извещения об изменениях', '11-КД заказчика', '13-Переписка'];
