const headShape = (t) => (isFlatHead(t) ? 'flat' : 'round');
// эффективное число позиций с учётом типа головки:
//   Плоская → 4; Круглая/не задан → effRevolver(«Позиций револьвера») (пусто → 12).
const effSlots = (headType, revolverSlots) => (isFlatHead(headType) ? FLAT_SLOTS : effRevolver(revolverSlots));
// GET-модель раздела: участки → их оборудование (+ «без участка»), KPI, справочники
async function buildEquipmentLive() {
  const [rows, sections, tasks] = await Promise.all([ncListSoft('equipment'), ncListSoft('sections'), ncListSoft('tasks')]);
  // карта оборудование → задачи (по mm-полю «Оборудование (реестр)» со стороны задач, Ф.14)
  const tasksByEq = new Map();
  for (const t of tasks) for (const eid of eqLinkIds(t['Оборудование (реестр)'])) {
    if (!tasksByEq.has(eid)) tasksByEq.set(eid, []);
    tasksByEq.get(eid).push({ id: t.Id ?? t.id, no: t['№ задачи'] || '', status: t['Статус'] || '', op: t['Операция (№ МК / № оп.)'] || '' });
  }
  const secList = sections.map((s) => ({ id: s.Id ?? s.id, code: s['Код'] || '', name: s['Участок'] || '', type: s['Тип'] || '', mainEquipment: s['Основное оборудование'] || '' }));
  const secName = new Map(secList.map((s) => [String(s.id), s.name]));
  const items = rows.map((r) => { const e = eqShape(r); if (!e.sectionName && e.sectionId != null) e.sectionName = secName.get(String(e.sectionId)) || ''; const tk = tasksByEq.get(e.id) || []; return { ...e, taskCount: tk.length, tasks: tk }; });
  const bySec = new Map(secList.map((s) => [String(s.id), []]));
  const orphan = [];
  for (const it of items) { const k = it.sectionId != null ? String(it.sectionId) : ''; if (bySec.has(k)) bySec.get(k).push(it); else orphan.push(it); }
  const groups = secList.map((s) => ({ section: s, equipment: bySec.get(String(s.id)) || [] }));
  if (orphan.length) groups.push({ section: { id: null, code: '', name: 'Без участка / прочее', type: '' }, equipment: orphan });
  const kpis = {
    total: items.length, inWork: items.filter((i) => i.status === 'В работе').length,
    repair: items.filter((i) => i.status === 'В ремонте').length,
    cnc: items.filter((i) => i.isCnc).length, supervised: items.filter((i) => i.isSupervised).length, sections: secList.length,
  };
  return { mode: 'live', items, groups, sections: secList, kpis, dict: { status: EQ_STATUS, category: EQ_CATEGORY, maint: EQ_MAINT } };
}
// GET карточка оборудования по id/inv_no + связанные задачи (Ф.14)
async function buildEquipmentCard(id) {
  const [rows, tasks, sections] = await Promise.all([ncListSoft('equipment'), ncListSoft('tasks'), ncListSoft('sections')]);
  const r = rows.find((x) => String(x.Id ?? x.id) === String(id) || String(x['Инв. №'] || '').trim() === String(id || '').trim());
  if (!r) return null;
  const e = eqShape(r);
  if (!e.sectionName && e.sectionId != null) { const s = sections.find((x) => String(x.Id ?? x.id) === String(e.sectionId)); if (s) e.sectionName = s['Участок'] || ''; }
  const rel = [];
  for (const t of tasks) if (eqLinkIds(t['Оборудование (реестр)']).map(String).includes(String(e.id)))
    rel.push({ id: t.Id ?? t.id, no: t['№ задачи'] || '', status: t['Статус'] || '', op: t['Операция (№ МК / № оп.)'] || '', planDate: t['Дата плановая'] || '', factDate: t['Дата факт.'] || '' });
  // K-52: docs дублируем на верхний уровень карточки — паспорт (eqDetailExtras) читает card.docs
  return { mode: 'live', item: e, tasks: rel, docs: e.docs };
}
// маппинг простых текстовых полей формы → колонки таблицы
const EQ_WRITE = {
  'Наименование': 'name', 'Тип/подкатегория': 'subtype', 'Модель': 'model', 'Изготовитель': 'manufacturer',
  'Зав. №': 'serialNo', 'Ответственный': 'responsible', 'Расположение': 'location', 'Примечание': 'notes',
  // K-52: «Данные о закупке» (текстовые). Пишутся только если UI их прислал; иначе не трогаются.
  'Поставщик': 'supplier', '№ договора': 'contractNo', 'Счёт-фактура': 'invoiceNo',
  'Закупку вёл': 'purchasedBy', 'Ссылка на закупку': 'procurementRef',
};
function eqBuildPatch(body) {
  const patch = {};
  for (const [title, key] of Object.entries(EQ_WRITE)) if (body[key] != null && body[key] !== '') patch[title] = String(body[key]).trim();
  // K-35: «Наименование» гарантированно пишется в патч при правке (страховка сверх EQ_WRITE — не даёт пустого патча/тихого no-op)
  if (body.name != null && String(body.name).trim() !== '') patch['Наименование'] = String(body.name).trim();
  if (EQ_CATEGORY.includes(body.category)) patch['Категория'] = body.category;
  if (EQ_STATUS.includes(body.status)) patch['Статус'] = body.status;
  if (EQ_MAINT.includes(body.maintClass)) patch['Категория ТО'] = body.maintClass;
  if (body.yearMade != null && body.yearMade !== '') patch['Год выпуска'] = Number(body.yearMade);
  if (body.powerKw != null && body.powerKw !== '') patch['Мощность, кВт'] = Number(body.powerKw);
  if (body.commissionedAt) patch['Дата ввода'] = String(body.commissionedAt).slice(0, 10);
  if (body.inspectionNext) patch['След. освидетельствование'] = String(body.inspectionNext).slice(0, 10);
  if (body.to1Last) patch['ТО-1 последнее'] = String(body.to1Last).slice(0, 10);
  if (body.to1Next) patch['ТО-1 следующее'] = String(body.to1Next).slice(0, 10);
  // K-52: даты/сумма закупки (пишутся только при наличии в body; требуют зааппленной миграции 029)
  if (body.deliveryDate) patch['Дата поставки'] = String(body.deliveryDate).slice(0, 10);
  if (body.warrantyUntil) patch['Гарантия до'] = String(body.warrantyUntil).slice(0, 10);
  if (body.cost != null && body.cost !== '') patch['Стоимость, ₽'] = Number(body.cost);
  if (body.isCnc != null) patch['ЧПУ'] = (body.isCnc === true || body.isCnc === 'true' || body.isCnc === 1);
  if (body.isSupervised != null) patch['Поднадзорное'] = (body.isSupervised === true || body.isSupervised === 'true' || body.isSupervised === 1);
  // migrate-039/041: токарные ТТХ станка (головка + патрон/шпиндель/державки; для карт наладки и кулачков)
  if (HEAD_TYPES.includes(String(body.headType || '').trim())) patch['Тип головки'] = String(body.headType).trim();
  if (body.revolverSlots != null && body.revolverSlots !== '') patch['Позиций револьвера'] = Number(body.revolverSlots);
  if (body.chuckTypeEq != null && String(body.chuckTypeEq).trim() !== '') patch['Патрон — тип'] = String(body.chuckTypeEq).trim();
  if (body.chuckDia != null && body.chuckDia !== '') patch['Ø патрона, мм'] = Number(body.chuckDia);
  if (body.spindleBore != null && body.spindleBore !== '') patch['Проходное отверстие шпинделя, мм'] = Number(body.spindleBore);
  if (body.holderSecExt != null && String(body.holderSecExt).trim() !== '') patch['Сечение державок (наружн.)'] = String(body.holderSecExt).trim();
  if (body.holderSecInt != null && String(body.holderSecInt).trim() !== '') patch['Сечение державок (внутр.), Ø'] = String(body.holderSecInt).trim();
  return patch;
}
// migrate-041: колонки токарных ТТХ станка — defensive ensure (карта наладки/кулачки тянут патрон отсюда).
// Идемпотентно (no-op если колонка есть). Тип головки/Позиций револьвера — уже созданы migrate-038/039.
async function eqEnsureTurningCols() {
  const cols = [['Патрон — тип', 'SingleLineText'], ['Ø патрона, мм', 'Decimal'], ['Проходное отверстие шпинделя, мм', 'Decimal'], ['Сечение державок (наружн.)', 'SingleLineText'], ['Сечение державок (внутр.), Ø', 'SingleLineText']];
  for (const [t, u] of cols) { try { await ncEnsureColumn('equipment', t, u); } catch (e) { console.warn('equipment: колонка ТТХ не создана:', t, e.message); } }
}
// создать/обновить оборудование (автонумер ОБ-NNN при создании) + привязка к участку
async function equipmentSave(body) {
  const rows = await ncListSoft('equipment');
  const existing = (body.id != null && body.id !== '' && rows.find((r) => String(r.Id ?? r.id) === String(body.id)))
    || (body.invNo && rows.find((r) => String(r['Инв. №'] || '').trim() === String(body.invNo).trim()));
  // migrate-041: гарантируем колонки токарных ТТХ, если UI прислал их (иначе PATCH их проигнорит)
  if (['chuckTypeEq', 'chuckDia', 'spindleBore', 'holderSecExt', 'holderSecInt'].some((k) => body[k] != null && body[k] !== '')) await eqEnsureTurningCols();
  const patch = eqBuildPatch(body);
  const secId = (body.sectionId ?? body.section ?? '');
  const secProvided = secId !== '' && secId != null;
  let id, invNo, created;
  if (existing) {
    id = existing.Id ?? existing.id; invNo = String(existing['Инв. №'] || '').trim();
    if (Object.keys(patch).length) await ncUpdate('equipment', id, patch);
    else if (!secProvided) { const e = new Error('Нет распознанных изменений для сохранения.'); e.status = 400; throw e; } // K-35: не отдавать ложный ok при пустом патче
    created = false;
  } else {
    const name = String(body.name || '').trim();
    if (!name) throw new Error('Укажите наименование оборудования (name).');
    invNo = await eqNextInvNo();
    const cr = await ncCreateMany('equipment', [{ 'Инв. №': invNo, ...patch, 'Наименование': name }]);
    const c = Array.isArray(cr) ? cr[0] : cr; id = c.Id ?? c.id;
    created = true;
  }
  // привязка к участку (hm со стороны «Участки» → поле «Оборудование»); best-effort
  if (secProvided) { try { await ncLinkRecords('sections', 'Оборудование', secId, [id]); } catch { /* реципрок/связь может отличаться — не критично */ } }
  return { ok: true, id, invNo, created };
}

// Планирование ТО (K-35, вкладка «Обслуживание»): плановое/внеплановое.
// FORWARD-TOLERANT: отдельной таблицы журнала ТО может ещё не быть — эффект пишем в
// существующий реестр «Оборудование» (плановое → «ТО-1 следующее/последнее»;
// внеплановое → статус «В ремонте»). НИКОГДА не 500 при отсутствии полей.
async function equipmentMaintenance(body) {
  const kind = body.kind === 'unplanned' ? 'unplanned' : 'planned';
  const eqId = body.equipmentId ?? body.id;
  if (eqId == null || eqId === '') { const e = new Error('Не указано оборудование (equipmentId).'); e.status = 400; throw e; }
  if (!body.responsible) { const e = new Error('Укажите ответственного (responsible).'); e.status = 400; throw e; }
  const patch = {};
  if (kind === 'planned') {
    if (!body.planDate) { const e = new Error('Укажите плановую дату ТО (planDate).'); e.status = 400; throw e; }
    patch['ТО-1 следующее'] = String(body.planDate).slice(0, 10);
    if (body.lastDate) patch['ТО-1 последнее'] = String(body.lastDate).slice(0, 10);
  } else {
    if (!body.reason) { const e = new Error('Для внепланового ТО укажите причину (reason).'); e.status = 400; throw e; }
    patch['Статус'] = 'В ремонте';
  }
  const rows = await ncListSoft('equipment');
  const r = rows.find((x) => String(x.Id ?? x.id) === String(eqId) || String(x['Инв. №'] || '').trim() === String(eqId).trim());
  if (!r) { const e = new Error('Оборудование не найдено.'); e.status = 404; throw e; }
  const id = r.Id ?? r.id;
  if (Object.keys(patch).length) await ncUpdate('equipment', id, patch);
  return { ok: true, kind, equipmentId: id, invNo: String(r['Инв. №'] || '').trim(), applied: Object.keys(patch), workType: body.workType || '' };
}

// ============================================================================
//  Модуль «Инструмент и оснастка» (K-39, контур ДП–О.3.1) — учёт режущего
//  инструмента поверх модели migrate-026 (таблицы «Инструмент и оснастка»,
//  «Журнал движения инструмента», «Места хранения инструмента»). Образец —
//  модуль «Склад» (K-07). FORWARD-TOLERANT: таблиц может не быть → ncListSoft
//  отдаёт [], GET → 200/пусто, POST → 400/409 с текстом, но НИКОГДА не 500.
//  Ядро: Остаток = Σ(Поступление + Возврат) − Σ(Выдача) по журналу движения.
//  Имена полей 1:1 с migrate-026 («Код», «Проводка», «Операция», «Кол-во» …).
// ============================================================================
const TOOL_OPS_QTY = ['Выдача', 'Пополнение', 'Возврат', 'Поступление']; // количественный (режущий/СИ-расходники): выдача −, остальные +
const TOOL_OPS_INV = ['Приёмка', 'Перемещение', 'Списание'];               // инвентарный (оснастка): статус/местоположение, без остатка
// K-55: движение между складом и цехом (для любой позиции) — меняет локацию, остаток не трогает.
const TOOL_OPS_LOC = ['Передача на участок', 'Возврат на склад'];
const TOOL_OPS = [...TOOL_OPS_QTY, ...TOOL_OPS_INV, ...TOOL_OPS_LOC];
const TOOL_TYPES = ['Расходный', 'Специальный'];
const TOOL_CATEGORIES = ['Резцы', 'Пластины', 'Свёрла', 'Развёртки', 'Фрезы', 'Диски отрезные', 'Метчики', 'Плашки', 'Пресс-формы', 'Оправки', 'Мерительный/СИ', 'Прочее'];
// нормализованная операция → знак остатка (выдача уменьшает; возврат/поступление увеличивают)
function toolParseMovement(m) {
  const raw = String(m['Проводка'] || '');
  const parts = raw.split('·').map((s) => s.trim()).filter(Boolean);
  const opField = String(m['Операция'] || (Array.isArray(m['Операция']) ? '' : '')).trim();
  const low = (opField || raw).toLowerCase();
  // K-55: локационные ops распознаём ПЕРВЫМИ — «Возврат на склад» содержит «возврат»,
  // иначе перехватился бы количественным «Возврат».
  const op = /передач.*участ|на участок/.test(low) ? 'Передача на участок'
    : /возврат.*склад|на склад/.test(low) ? 'Возврат на склад'
    : /выдач/.test(low) ? 'Выдача' : /пополн/.test(low) ? 'Пополнение' : /возврат/.test(low) ? 'Возврат'
    : /поступл/.test(low) ? 'Поступление' : /приёмк|приемк/.test(low) ? 'Приёмка' : /перемещ/.test(low) ? 'Перемещение'
    : /списан/.test(low) ? 'Списание' : (opField || '');
  // инвентарные и локационные ops остаток не двигают
  const inventory = TOOL_OPS_INV.includes(op) || TOOL_OPS_LOC.includes(op);
  const sign = inventory ? 0 : (op === 'Выдача' ? -1 : 1);
  return {
    id: m.Id ?? m.id, code: parts[0] || '', op, sign, inventory,
    qty: Math.abs(whNum(m['Кол-во'])), date: m['Дата'] || '',
    recipient: m['ФИО получателя'] || '', basis: m['Основание / комментарий'] || '',
    batch: m['Партия / СФ'] || '', from: m['Откуда'] || '', to: m['Куда'] || '',
    balanceAfter: whNum(m['Остаток после']), note: m['Примечание'] || '', title: raw,
  };
}
// K-47: остаток инструмента как производная от журнала (аналог whRecalcItemBalance для склада).
// Стартовый остаток задаётся в реестре при заведении и НЕ журналируется, поэтому чистого
// «Σ по журналу» недостаточно. Но running-баланс «Остаток после» последней количественной
// проводки embed'ит стартовый остаток → это и есть авторитетный текущий остаток. Возвращаем
// его (или null, если движений ещё нет — тогда источник истины = стартовый «Остаток» реестра).
function toolLastBalance(code, movements) {
  let best = null;
  for (const m of movements) {
    const p = toolParseMovement(m);
    if (p.inventory || p.code !== code) continue; // инвентарные ops остаток не двигают
    const id = Number(p.id) || 0;
    if (!best || id > best.id) best = { id, bal: p.balanceAfter };
  }
  return best ? best.bal : null;
}
// нормализованная карточка инструмента. «Остаток» (реестр) — running-баланс:
// исходно задаётся при заведении, далее ведётся операциями (выдача −, возврат/поступление +).
// Журнал — история движений с «Остаток после» построчно (как в образце Ф.1/Ф.2–О.3.1).
// K-55: единая локация позиции «где лежит / кому передан» —
//  «на складе, ячейка №…» ЛИБО «в цехе, участок/станок …».
//  Источники: новые поля «Тип локации»/«Участок / станок» (после migrate-030) +
//  legacy «Ячейка» (режущий/СИ) и «Местоположение» (оснастка на станке).
//  Forward-tolerant: новых полей ещё нет → выводим по legacy, не падаем.
function toolWhere(it) {
  const locType = String(it['Тип локации'] || '').trim();
  const shopArea = String(it['Участок / станок'] || '').trim();
  const cell = String(it['Ячейка'] || '').trim();
  const location = String(it['Местоположение'] || '').trim();
  if (locType === 'Цех') return { kind: 'shop', text: 'Цех · ' + (shopArea || location || 'участок не указан') };
  if (locType === 'Склад') return { kind: 'wh', text: 'Склад · ' + (cell ? ('ячейка ' + cell) : (location || 'ячейка не указана')) };
  // legacy-эвристика (до APPLY / для старых строк)
  if (shopArea) return { kind: 'shop', text: 'Цех · ' + shopArea };
  if (location && location.toLowerCase() !== 'склад') return { kind: 'shop', text: 'Цех · ' + location }; // оснастка на станке
  if (cell) return { kind: 'wh', text: 'Склад · ячейка ' + cell };
  if (location) return { kind: 'wh', text: 'Склад · ' + location };
  return { kind: '', text: '—' };
}
function toolShape(it) {
  const code = String(it['Код'] || '').trim();
  const type = whLinkVal(it['Тип']) || String(it['Тип'] || '');
  const category = whLinkVal(it['Категория']) || String(it['Категория'] || '');
  const min = whNum(it['Мин. остаток']);
  const balance = whNum(it['Остаток']);
  // поверка/калибровка (СИ, ДП–О.4): просрочка = «След. поверка» в прошлом; «скоро» = ≤ 30 дней
  const calDate = it['Дата поверки'] ? String(it['Дата поверки']).slice(0, 10) : '';
  const calNext = it['След. поверка'] ? String(it['След. поверка']).slice(0, 10) : '';
  const today = whToday();
  const soonIso = new Date(Date.now() + 30 * 864e5).toISOString().slice(0, 10);
  const isSi = category === 'Мерительный/СИ';
  const status = whLinkVal(it['Статус']) || String(it['Статус'] || '');
  const rigKind = whLinkVal(it['Вид оснастки']) || String(it['Вид оснастки'] || '');
  const special = type === 'Специальный';
  // подраздел: si · оснастка (rig) · режущий (cut)
  const rig = special; // спец. инструмент = пресс-формы/оснастка (инвентарный)
  const calOverdue = !!calNext && calNext < today;
  const calSoon = !!calNext && !calOverdue && calNext <= soonIso;
  // 3-уровневая подсветка остатка (режущий): ≤0 красный, ≤мин жёлтый, иначе зелёный
  const stockLevel = balance <= 0 ? 'empty' : (min > 0 && balance <= min ? 'low' : 'ok');
  const w = toolWhere(it); // K-55: локация (склад·ячейка / цех·участок)
  return {
    id: it.Id ?? it.id, code, name: it['Наименование'] || '', type, category,
    subcategory: it['Подкатегория'] || '', gost: it['ГОСТ / Каталог'] || '', unit: it['Ед. изм.'] || '',
    minStock: min, balance, stockLevel, cell: it['Ячейка'] || '', note: it['Примечание'] || '',
    special, isSi, rig, subdivision: isSi ? 'si' : (rig ? 'osn' : 'cut'),
    belowMin: min > 0 && balance <= min,
    invNo: it['Инв. №'] || '', accuracyRange: it['Диапазон / класс точности'] || '', status,
