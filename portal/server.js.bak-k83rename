  // шапку берём из связанного ЗП: сперва по прямой связи (надёжно), затем фолбэк по № ЛОВ.
  // связь «Запросы продаж» приходит одиночным объектом (не массивом); дублируется в sales_requests_id.
  const linkedRaw = sheet['Запросы продаж'];
  const linked = Array.isArray(linkedRaw) ? linkedRaw[0] : linkedRaw;
  const linkedId = (linked && idOfRow(linked)) ?? sheet['sales_requests_id'];
  const req = (reqById && (reqById[linkedId] ?? reqById[String(linkedId)])) || reqByLov[sheet['№ ЛОВ']] || null;
  return {
    id: idOfRow(sheet), numLov: sheet['№ ЛОВ'] || '', date: sheet['Дата'] || '', due: sheet['Срок оценки'] || '',
    complexity: sheet['Сложность'] || '', status: sheet['Статус'] || '', decision: sheet['Решение ДпП'] || '',
    conditions: sheet['Условия'] || '', decidedBy: sheet['Кто решил'] || '', decidedDate: sheet['Дата решения'] || '',
    verdict: sheet['Вердикт'] || '',
    risksCheck: (() => { try { return JSON.parse(sheet['Риски (чек-лист)'] || '{}'); } catch { return {}; } })(),
    termAuto: lovTermDays(sections),
    termDays: (sheet['Сводный срок, раб.дн'] != null && sheet['Сводный срок, раб.дн'] !== '') ? Number(sheet['Сводный срок, раб.дн']) : lovTermDays(sections),
    zp: req ? (req['№ запроса'] || '') : '', customer: req ? (req['Заказчик'] || '') : '',
    product: req ? (req['Наименование запроса'] || '') : '', dealNature: req ? (req['Характер сделки'] || '') : '',
    risks: {
      personnel: sheet['Риск: персонал'] || '', equipment: sheet['Риск: оборудование'] || '', materials: sheet['Риск: материалы'] || '',
      terms: sheet['Риск: сроки'] || '', logistics: sheet['Риск: валютно-логистич.'] || '', other: sheet['Прочие риски'] || '',
    },
    sections,
  };
}
async function lovData() {
  const [sheets, sections, requests] = await Promise.all([ncListSoft('lov_sheets'), ncListSoft('lov_sections'), ncListSoft('sales_requests')]);
  const secById = Object.fromEntries(sections.map((s) => [idOfRow(s), s]));
  const reqById = Object.fromEntries(requests.map((r) => [idOfRow(r), r]));
  const reqByLov = {}; for (const r of requests) if (r['№ ЛОВ']) reqByLov[r['№ ЛОВ']] = r;
  return { sheets, secById, reqByLov, reqById };
}
// связанный с листом ЛОВ запрос ЗП (для проброса статуса/результата оценки)
async function requestForSheet(sheetId) {
  const { sheets, reqByLov, reqById } = await lovData();
  const sheet = sheets.find((s) => String(idOfRow(s)) === String(sheetId));
  if (!sheet) return null;
  const linkedRaw = sheet['Запросы продаж'];
  const linked = Array.isArray(linkedRaw) ? linkedRaw[0] : linkedRaw;
  const linkedId = (linked && idOfRow(linked)) ?? sheet['sales_requests_id'];
  return (reqById[linkedId] ?? reqById[String(linkedId)]) || reqByLov[sheet['№ ЛОВ']] || null;
}
// проброс вердикта ЛОВ в карточку ЗП: дата оценки + результат + движение статуса (D2)
async function propagateLovToRequest(sheetId, rejected) {
  const reqRow = await requestForSheet(sheetId);
  if (!reqRow) return;
  const patch = { 'Дата оценки': new Date().toISOString().slice(0, 10), 'Результат оценки': rejected ? 'Невыполнимо' : 'Выполнимо' };
  const cur = String(reqRow['Статус'] || '');
  if (rejected) patch['Статус'] = 'Отклонён';
  else if (cur === 'Новый' || cur === 'На оценке (ЛОВ)') patch['Статус'] = 'На оценке (ЛОВ)';
  try { await ncUpdate('sales_requests', idOfRow(reqRow), patch); } catch (e) { console.warn('ЛОВ→ЗП проброс не удался:', e.message); }
}
