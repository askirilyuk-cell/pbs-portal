// ============================================================================
//  Раздел «Учёт остатков металла» (migrate-035) — учёт металлопроката (лист/круг)
//  поверх канон-номенклатуры (категория «Металл»). Образец — модуль «Инструмент»
//  (K-39). FORWARD-TOLERANT: таблиц может не быть → ncListSoft отдаёт [], GET →
//  200/пусто, POST → 400/409 с текстом, но НИКОГДА не 500.
//  Ядро: Остаток (кг) — running-баланс «Остаток после» по журналу (как toolLastBalance);
//  Резерв (кг) — производная журнала (Σ Резерв − Σ Снятие резерва); Доступно = Остаток − Резерв.
//  Операции: Приход (+) · Расход (− ≤ Доступно) · Списание (− ≤ Остаток) · Инвентаризация
//  (= факт.) · Резерв (+резерв ≤ Доступно) · Снятие резерва (−резерв ≤ Резерв). Оприходование ДО.
//  Плотность стали 7.85 г/см³ — норма для «≈ N листов/прутков» (двойной показ: кг + расчётно).
// ============================================================================
const METAL_OPS = ['Приход', 'Расход', 'Списание', 'Инвентаризация', 'Резерв', 'Снятие резерва'];
const METAL_OPS_PHYS = ['Приход', 'Расход', 'Списание', 'Инвентаризация']; // меняют физический остаток (пишут «Остаток после»)
const METAL_OPS_RES = ['Резерв', 'Снятие резерва'];                        // меняют только резерв
const METAL_ROLL_TYPES = ['Лист', 'Круг', 'Труба'];
const METAL_DENSITY = 7.85; // г/см³ (сталь) — норма пересчёта кг ↔ мерная единица (справочно)
const METAL_REMNANT_STATUSES = ['Доступен', 'Зарезервирован', 'Использован'];
// нормализованная проводка журнала металла (ключ позиции — поле «Код», фолбэк — parts[0] «Проводки»)
function metalParseMovement(m) {
  const raw = String(m['Проводка'] || '');
  const parts = raw.split('·').map((s) => s.trim()).filter(Boolean);
  const op = String(m['Операция'] || '').trim();
  const phys = METAL_OPS_PHYS.includes(op);
  const res = METAL_OPS_RES.includes(op);
  // знак к физическому остатку: приход +, расход/списание −, инвентаризация — абсолют (set), резерв — 0
  const sign = op === 'Приход' ? 1 : (op === 'Расход' || op === 'Списание') ? -1 : 0;
  return {
    id: m.Id ?? m.id, code: String(m['Код'] || parts[0] || '').trim(), op, sign, phys, res,
    qty: Math.abs(whNum(m['Кол-во'])), date: m['Дата'] || '',
    balanceAfter: whNum(m['Остаток после']), format: m['Раскрой / формат'] || '',
    units: whNum(m['Кол-во ед.']), supplier: m['Поставщик'] || '', invoiceNo: m['№ счёта'] || '',
    heatNo: m['№ сертификата / плавки'] || '', pzLine: m['Позиция ПЗ'] || '', part: m['Деталь'] || '',
    basis: m['Основание / комментарий'] || '', author: m['Автор'] || '', title: raw,
  };
}
// текущий физический остаток позиции = «Остаток после» последней физической проводки
// (embed'ит стартовый остаток + инвентаризацию). null → движений нет → источник = «Остаток» реестра.
function metalLastBalance(code, movements) {
  let best = null;
  for (const m of movements) {
    const p = metalParseMovement(m);
    if (!p.phys || p.code !== code) continue;
    const id = Number(p.id) || 0;
    if (!best || id > best.id) best = { id, bal: p.balanceAfter };
  }
  return best ? best.bal : null;
}
// текущий резерв позиции = Σ(Резерв) − Σ(Снятие резерва) по журналу; если резервных проводок нет — из реестра.
function metalReserveFor(code, movements, regReserve) {
  let has = false, r = 0;
  for (const m of movements) {
    const p = metalParseMovement(m);
    if (!p.res || p.code !== code) continue;
    has = true; r += (p.op === 'Резерв' ? p.qty : -p.qty);
  }
  return has ? Math.max(0, r) : whNum(regReserve);
}
// расчётный перевод кг → погонные метры для круга/трубы (правка 1).
// ρ=7850 кг/м³ (углеродистая/низколег. сталь). Ø/стенку парсим из Типоразмера.
// Круг:  P(кг/м)=ρ·π·d²/4 ;  Труба: P=ρ·π·(D²−(D−2t)²)/4. Лист — не переводим (null).
const METAL_RHO = METAL_DENSITY * 1000; // 7850 кг/м³
function metalMeters(rollType, size, balanceKg) {
  const bal = Number(balanceKg) || 0;
  if (bal <= 0) return null;
  const s = String(size || '').replace(/,/g, '.');
  let kgPerM = 0;
  if (rollType === 'Круг') {
    const md = s.match(/[Ø⌀ø]\s*(\d+(?:\.\d+)?)/) || s.match(/(\d+(?:\.\d+)?)/);
    const d = md ? parseFloat(md[1]) : 0;               // диаметр, мм
    if (!(d > 0)) return null;
    const dm = d / 1000;
    kgPerM = METAL_RHO * Math.PI * dm * dm / 4;
  } else if (rollType === 'Труба') {
    const mt = s.match(/(\d+(?:\.\d+)?)\s*[×xXхХ*]\s*(\d+(?:\.\d+)?)/); // Ø57×3.5 → D, t (мм)
    if (!mt) return null;                               // нет стенки → метры не выдумываем
    const D = parseFloat(mt[1]), t = parseFloat(mt[2]);
    if (!(D > 0) || !(t > 0)) return null;
    const inner = D - 2 * t;
    if (!(inner > 0)) return null;
    const Dm = D / 1000, im = inner / 1000;
    kgPerM = METAL_RHO * Math.PI * (Dm * Dm - im * im) / 4;
  } else {
    return null;                                        // Лист — оставляем кг / ≈ листов
  }
  if (!(kgPerM > 0)) return null;
  return bal / kgPerM;
}
// сумма веса деловых остатков «в наличии» (не «Использован»), привязанных к позиции (правка 2)
function metalRemnantBreakdown(posId, remnants) {
  let kg = 0, n = 0;
  for (const r of (remnants || [])) {
    const st = whLinkVal(r['Статус']) || String(r['Статус'] || '');
    if (st === 'Использован') continue;                 // деталь ушла в дело — уже не остаток
    if (String(catLinkId(r['Остаток металла'])) === String(posId)) { kg += whNum(r['Вес']); n += 1; }
  }
  return { remnantKg: Math.round(kg), remnantCount: n };
}
// нормализованная карточка остатка металла (двойной показ: кг + ≈ мерных единиц по норме пересчёта)
function metalShape(it, movements, remnants) {
  const code = String(it['Код'] || '').trim();
  const rollType = whLinkVal(it['Тип проката']) || String(it['Тип проката'] || '');
  const id = it.Id ?? it.id;
  const jb = metalLastBalance(code, movements);
  const balance = jb != null ? jb : whNum(it['Остаток']);
  const reserved = metalReserveFor(code, movements, it['Резерв']);
  const available = balance - reserved;
  const min = whNum(it['Мин. остаток']);
  const norm = whNum(it['Норма пересчёта']); // кг на 1 мерную ед.
  const units = norm > 0 ? balance / norm : null; // ≈ листов/прутков (null — норма не задана)
  const meters = metalMeters(rollType, it['Типоразмер'] || '', balance); // ≈ пог. метров (круг/труба), null иначе
  const { remnantKg, remnantCount } = metalRemnantBreakdown(id, remnants); // структура остатка: доля обрезков
  const belowMin = min > 0 && available <= min; // дефицит считаем по доступному (за вычетом резерва)
  const stockLevel = available <= 0 ? 'empty' : (belowMin ? 'low' : 'ok');
  const canonId = catLinkId(it['Номенклатура-канон']);
  return {
    id, code, grade: String(it['Марка'] || '').trim(), rollType,
    size: it['Типоразмер'] || '', gost: it['ГОСТ'] || '', unit: it['Ед. изм.'] || 'кг',
    balance, reserved, available, minStock: min, norm, units, meters, remnantKg, remnantCount,
    unitLabel: rollType === 'Круг' ? 'прутков' : (rollType === 'Труба' ? 'м' : 'листов'),
    belowMin, stockLevel, warehouse: it['Склад по умолчанию'] || '', cell: it['Ячейка'] || '',
    note: it['Примечание'] || '', canonId,
  };
}
// GET-модель раздела: реестр остатков + KPI + сигналы дефицита + доступно
async function buildMetalLive() {
  const [items, movements, remnants] = await Promise.all([ncListSoft('metal_stock'), ncListSoft('metal_movements'), ncListSoft('metal_remnants')]);
