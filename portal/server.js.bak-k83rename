  return { ok: true, idempotent: !!(data && data.idempotent), payment, ...(invoice ? { fileAttached } : {}) };
}

// Опрос статуса заявки на оплату (GET /payments?externalRef=…&externalSource=ISM), обновляет
// сохранённый статус — на СЧЁТЕ (invoiceId задан, K-83 этап 2) или в записи ЗнЗ (старый флоу,
// без invoiceId — совместимость). Возвращает { ok, count, payment }.
async function refreshPaymentStatus(znzId, invoiceId) {
  if (!paymentConfigured()) throw payErr(501, 'Интеграция с оплатой не настроена (нет ключа PAYMENT_INGEST_KEY в «Настройках»).');
  const id = Number(znzId);
  if (!Number.isFinite(id)) throw payErr(400, 'Некорректный идентификатор заявки (znzId).');
  const reqs = await ncListSoft('procurement_requests');
  const znz = reqs.find((x) => String(x.Id ?? x.id) === String(id));
  if (!znz) throw payErr(404, 'Заявка ЗнЗ не найдена.');

  let invoice = null, externalRef;
  if (invoiceId != null && String(invoiceId).trim() !== '') {
    const invId = Number(invoiceId);
    if (!Number.isFinite(invId)) throw payErr(400, 'Некорректный идентификатор счёта (invoiceId).');
    const invRows = await ncListSoft('invoices');
    invoice = invRows.find((x) => String(x.Id ?? x.id) === String(invId));
    if (!invoice) throw payErr(404, 'Счёт не найден.');
    externalRef = String(invoice['Оплата ExternalRef'] || '').trim();
    if (!externalRef) throw payErr(400, 'По этому счёту оплата ещё не отправлялась (нет Оплата ExternalRef).');
  } else {
    externalRef = String(znz['№ ЗнЗ'] || '').trim();
    if (!externalRef) throw payErr(400, 'У заявки нет № ЗнЗ (externalRef).');
  }
  const { data } = await ingestCall('GET', `/payments?externalRef=${encodeURIComponent(externalRef)}&externalSource=ISM`);
  const payments = (data && data.payments) || [];
  const payment = payments[0] || null;
  if (payment) {
    if (invoice) await savePaymentToInvoice(invoice.Id ?? invoice.id, payment);
    else await savePaymentToZnz(id, payment);
  }
  return { ok: true, count: payments.length, payment };
}

// K-83 доп. (реестр «Заявки ЗнЗ», кнопка «⟳ Статусы оплат»): массовый опрос платёжного
// портала по ВСЕМ счетам с уже созданной оплатой («Оплата ExternalRef» заполнен) и
// нефинальным статусом (не «Оплачено»/«Отклонено» — см. INV_PAY_FINAL на клиенте и
// payStatusToInvoiceStatus выше). Чанками по 4, чтобы не заддосить портал Алексея.
// Возвращает { checked, updated, errors } — updated = у скольких счетов статус реально сменился.
async function refreshAllInvoicePayments() {
  if (!paymentConfigured()) throw payErr(501, 'Интеграция с оплатой не настроена (нет ключа PAYMENT_INGEST_KEY в «Настройках»).');
  if (!(await invoicesTableReady())) return { ok: true, checked: 0, updated: 0, errors: 0 };
  const rows = await ncListSoft('invoices');
  const pending = rows.filter((r) => String(r['Оплата ExternalRef'] || '').trim()
    && !['Оплачено', 'Отклонено'].includes(String(r['Статус оплаты'] || '').trim()));
  let updated = 0, errors = 0;
  const CHUNK = 4;
  for (let i = 0; i < pending.length; i += CHUNK) {
    const results = await Promise.allSettled(pending.slice(i, i + CHUNK).map(async (row) => {
      const id = row.Id ?? row.id;
      const externalRef = String(row['Оплата ExternalRef'] || '').trim();
      const before = String(row['Статус оплаты'] || '').trim();
      const { data } = await ingestCall('GET', `/payments?externalRef=${encodeURIComponent(externalRef)}&externalSource=ISM`);
      const payment = (data && data.payments && data.payments[0]) || null;
      if (!payment) return false;
      await savePaymentToInvoice(id, payment);
      return payStatusToInvoiceStatus(payment.status) !== before;
    }));
    for (const r of results) { if (r.status === 'fulfilled') { if (r.value) updated++; } else errors++; }
  }
  return { ok: true, checked: pending.length, updated, errors };
}

// K-83 этап 1b: mime-тип скана счёта по расширению имени файла (§4 контракта).
const PAY_FILE_MIME = { pdf: 'application/pdf', jpg: 'image/jpeg', jpeg: 'image/jpeg', png: 'image/png' };
function payMimeFor(fileName, fallback) {
  const ext = String(fileName || '').toLowerCase().split('.').pop();
  return PAY_FILE_MIME[ext] || fallback || 'application/octet-stream';
}
// Достаёт fileId из ответа Bitrix (шаг 2). Как в pbs_payment_client._extract_bitrix_file_id:
// приоритет result.ID / result.FILE_ID, затем плоские ключи, затем result-скаляр.
function extractBitrixFileId(data) {
  const pick = (o) => { for (const k of ['ID', 'FILE_ID', 'id', 'fileId']) { if (o && o[k] != null && o[k] !== '') return o[k]; } return null; };
  if (data && typeof data === 'object') {
    const res = data.result;
    if (res && typeof res === 'object') { const v = pick(res); if (v != null) return v; }
    if ((typeof res === 'string' || typeof res === 'number') && res !== '') return res;
    const v = pick(data); if (v != null) return v;
  }
  return null;
}
// 3-фазная загрузка скана счёта к заявке на оплату (§4 контракта, обход лимита 3.5 МБ шлюза).
//   Фаза 1: POST /payments/{id}/files/upload-init (наш шлюз, X-API-Key) → {uploadUrl, field}.
//   Фаза 2: multipart POST прямо в Bitrix по uploadUrl (БЕЗ X-API-Key) → fileId = result.ID.
//   Фаза 3: POST /payments/{id}/files/upload-complete (наш шлюз) — fileId СТРОКОЙ (int → 400).
// Заявка в статусе PAID/REJECTED залочена: шлюз вернёт 409 request_locked — пробрасываем .status.
async function uploadPaymentFile(paymentId, buffer, fileName, mimeType) {
  if (!paymentConfigured()) throw payErr(501, 'Интеграция с оплатой не настроена (нет ключа PAYMENT_INGEST_KEY в «Настройках»).');
  const pid = String(paymentId || '').trim();
  if (!pid) throw payErr(400, 'Не указан идентификатор заявки на оплату (paymentId).');
  if (!buffer || !buffer.length) throw payErr(400, 'Файл пуст или не передан.');
  const name = (String(fileName || '').trim()) || 'scan.pdf';
  const mime = mimeType || payMimeFor(name, 'application/pdf');
  // фаза 1 — upload-init через наш шлюз
  const { data: init } = await ingestCall('POST', `/payments/${encodeURIComponent(pid)}/files/upload-init`, { fileName: name });
  const uploadUrl = init && init.uploadUrl;
  const field = (init && init.field) || 'file';
  if (!uploadUrl) throw payErr(502, 'Сервис оплат не вернул ссылку для загрузки (uploadUrl).');
  // фаза 2 — прямой multipart POST в Bitrix, БЕЗ нашего X-API-Key (globalThis fetch/FormData/Blob, node18+)
  let b2;
  try {
    const fd = new FormData();
    fd.append(field, new Blob([buffer], { type: mime }), name);
    const r2 = await fetch(uploadUrl, { method: 'POST', body: fd });
    const t2 = await r2.text();
    try { b2 = t2 ? JSON.parse(t2) : null; } catch { b2 = t2; }
    if (!r2.ok) { const e = payErr(r2.status, 'Не удалось загрузить файл в хранилище Bitrix.'); e.payload = b2; throw e; }
  } catch (e) { if (e.status) throw e; throw payErr(502, 'Ошибка загрузки файла в хранилище: ' + String(e.message || e)); }
  const fileId = extractBitrixFileId(b2);
  if (fileId == null || fileId === '') { const e = payErr(502, 'Хранилище не вернуло идентификатор файла (fileId).'); e.payload = b2; throw e; }
  // фаза 3 — upload-complete через наш шлюз (fileId строкой)
  const { data: done } = await ingestCall('POST', `/payments/${encodeURIComponent(pid)}/files/upload-complete`, {
    fileId: String(fileId), fileName: name, sizeBytes: buffer.length, mimeType: mime,
  });
  return done;
}

