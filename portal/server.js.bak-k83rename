// ============================================================================
//  ОТК-приёмка — WRITE-путь (замыкает контур качества: DEF-02 Ф.4 + DEF-03 Ф.3)
//  До этого acceptance_control/incoming_control были READ-ONLY (GET-модель в
//  buildBoardLive, но актов нечем создать). Здесь — POST-создание акта приёмки
//  (Ф.4) и акта входного контроля (Ф.3) поверх существующих таблиц schema.json.
//  Имена полей 1:1 со schema.json (сверено). FORWARD-TOLERANT: доп. кол-во-поля
//  (migrate-034, ещё не APPLY) отбрасываются ncPickExisting, без 400/500; связи и
//  влияние на статус — best-effort в try/catch (пустые справочники не роняют POST).
//  Вердикт-энумы совпадают со schema.json «Заключение» (SingleSelect).
// ============================================================================
const INC_VERDICTS = ['ГОДЕН', 'ГОДЕН С ЗАМЕЧАНИЯМИ', 'НЕ ГОДЕН'];   // Ф.3 incoming_control
const ACC_VERDICTS = ['ГОДЕН', 'ГОДЕН С ОТКЛОНЕНИЕМ', 'НЕ ГОДЕН'];   // Ф.4 acceptance_control
const otkNum = (v) => { if (v === '' || v == null) return null; const n = Number(v); return Number.isFinite(n) && n >= 0 ? n : null; };
// оставить в строке только поля, реально существующие в таблице → forward-tolerant
// к не-применённой миграции 034 (новые кол-во-поля отбрасываются до APPLY, без ошибки)
async function ncPickExisting(key, row) {
  const meta = await ncTableMeta(key);
  const cols = new Set((meta.columns || []).map((c) => c.title));
  const out = {};
  for (const [k, v] of Object.entries(row)) if (cols.has(k) && v !== undefined) out[k] = v;
  return out;
}

