  if (accepted != null) row['Принято, шт.'] = accepted;                                          // migrate-034
  if (rejected != null) row['Брак, шт.'] = rejected;                                             // migrate-034
  const selPut = (col, v, allowed) => { const s = String(v || '').trim(); if (s && allowed.includes(s)) row[col] = s; };
  selPut('Внешний вид', body.appearance, ['Соответствует', 'Не соответствует']);
  selPut('Маркировка', body.marking, ['Нанесена', 'Не нанесена']);
