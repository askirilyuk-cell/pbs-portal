// K-12: строго 1 ЛОВ на 1 ЗП. Конкурентные вызовы создания по одному ЗП сериализуем in-memory
// замком, чтобы два «дабл-клика» не прошли оба проверку «ЛОВ ещё нет» (TOCTOU) и не создали дубль.
const lovCreateLocks = new Map(); // № ЗП → Promise текущего создания (никогда не реджектит)

// Ищем уже существующий лист ЛОВ для данного ЗП (главный ключ 1:1): по № ЛОВ (записанному в ЗП
// или детерминированному из № ЗП), иначе по прямой связи ЗП→лист. Возвращает строку lov_sheets|null.
async function findExistingLovSheet(reqRow, mZp) {
  const sheets = await ncListSoft('lov_sheets');
  const nums = new Set();
  const numInReq = String(reqRow['№ ЛОВ'] || '').trim();
  if (numInReq) nums.add(numInReq);
  if (mZp) nums.add(`ЛОВ-${mZp[1]}-${mZp[2]}`);
  if (nums.size) {
    const byNum = sheets.find((s) => nums.has(String(s['№ ЛОВ'] || '').trim()));
    if (byNum) return byNum;
  }
  // фолбэк: № ЛОВ в ЗП мог не проставиться (проброс обёрнут в try/catch), но связь/лист уже есть
  const linkRaw = reqRow['Лист оценки (ЛОВ)'];
  const linkArr = Array.isArray(linkRaw) ? linkRaw : (linkRaw ? [linkRaw] : []);
  if (linkArr.length) {
    const linkedId = idOfRow(linkArr[0]);
    const byLink = sheets.find((s) => String(idOfRow(s)) === String(linkedId));
    if (byLink) return byLink;
  }
  return null;
}

// «Запросить оценку»: создать лист ЛОВ + разделы по выбранным подразделениям, привязать к ЗП.
// Идемпотентно: если ЛОВ по ЗП уже есть — возвращаем существующий (existed:true), не плодим дубль.
async function createLovFromRequest(body) {
  const zp = String(body.zp || '').trim();
  if (!zp) throw new Error('Не указан № запроса (ЗП).');
  // сериализация по № ЗП: следующий вызов ждёт предыдущий (независимо от исхода), затем создаёт
  const prev = lovCreateLocks.get(zp) || Promise.resolve();
  const run = prev.then(() => createLovFromRequestUnlocked(zp, body));
  const guard = run.catch(() => {}); // в карту кладём безопасную версию, чтобы цепочка не рвалась
  lovCreateLocks.set(zp, guard);
  try { return await run; }
  finally { if (lovCreateLocks.get(zp) === guard) lovCreateLocks.delete(zp); }
}
async function createLovFromRequestUnlocked(zp, body) {
  const requests = await ncListSoft('sales_requests');
  const reqRow = requests.find((r) => String(r['№ запроса'] || '').trim() === zp);
  if (!reqRow) throw new Error(`Запрос «${zp}» не найден.`);
  // № ЛОВ детерминирован из № ЗП (1:1): ЗП-ГГГГ-NNN → ЛОВ-ГГГГ-NNN
  const mZp = /^ЗП-(\d{4})-(\d+)$/.exec(zp);
  // ГЛАВНЫЙ guard: ЛОВ уже существует → отдаём его Id/№, клиент откроет существующий (не создаём)
  const existing = await findExistingLovSheet(reqRow, mZp);
  if (existing) return { ok: true, numLov: String(existing['№ ЛОВ'] || reqRow['№ ЛОВ'] || '').trim(), id: idOfRow(existing), existed: true };
  // упрощённый поток: подразделения опциональны. Без них ЛОВ заполняет ДпП напрямую.
  let units = Array.isArray(body.units) ? body.units : [];
  units = units.map((u) => (typeof u === 'string' ? { code: u, name: u } : { code: String(u.code || '').trim(), name: String(u.name || u.code || '').trim() })).filter((u) => u.code);
  // № ЛОВ привязываем к № запроса: ЗП-ГГГГ-NNN → ЛОВ-ГГГГ-NNN (иначе — счётчик по году)
  const numLov = mZp ? `ЛОВ-${mZp[1]}-${mZp[2]}` : await nextNumber('lov_sheets', '№ ЛОВ', 'ЛОВ', new Date().getFullYear());
  const today = new Date().toISOString().slice(0, 10);
  const complexity = ['типовая', 'нестандартная'].includes(body.complexity) ? body.complexity : 'типовая';
  const sheetRow = { '№ ЛОВ': numLov, 'Дата': today, 'Статус': units.length ? 'Запрошена' : 'Оценка', 'Сложность': complexity };
  if (body.due) sheetRow['Срок оценки'] = String(body.due).slice(0, 10);
  const createdSheet = await ncCreateMany('lov_sheets', [sheetRow]);
  const sheetId = idOfRow(Array.isArray(createdSheet) ? createdSheet[0] : createdSheet);
  if (units.length) {
    const secRows = units.map((u) => ({ 'Подразделение (код)': u.code, 'Наименование подразделения': u.name, 'Статус': 'Не начат' }));
    const createdSecs = await ncCreateMany('lov_sections', secRows);
    const secIds = (Array.isArray(createdSecs) ? createdSecs : [createdSecs]).map(idOfRow).filter(Boolean);
    try { await ncLinkRecords('lov_sheets', 'Разделы', sheetId, secIds); } catch {}
  }
  try { await ncLinkRecords('sales_requests', 'Лист оценки (ЛОВ)', idOfRow(reqRow), [sheetId]); } catch (e) { console.warn('ЛОВ: связь ЗП→лист не создана:', e.message); }
  // № ЛОВ пробрасываем в ЗП; статус двигаем только с «Новый» (не откатываем более поздние).
  // «На оценке (ЛОВ)» — валидное значение SingleSelect (миграция K-04); прежнее «Оценка» роняло весь PATCH.
  const reqPatch = { '№ ЛОВ': numLov };
  if (String(reqRow['Статус'] || '') === 'Новый') reqPatch['Статус'] = 'На оценке (ЛОВ)';
  try { await ncUpdate('sales_requests', idOfRow(reqRow), reqPatch); } catch (e) { console.warn('ЛОВ: № ЛОВ/статус в ЗП не записаны:', e.message); }
  return { ok: true, numLov, id: sheetId };
}
// упрощённое сохранение ЛОВ (ДпП/админ): вердикт + риски-чеклист + комментарий
async function saveLov(body, session) {
  if (!session || !(session.roles.includes('dpp') || session.roles.includes('admin'))) throw new Error('Заключение ЛОВ выносит ДпП (или администратор).');
  if (!body.sheetId) throw new Error('Не указан лист ЛОВ.');
  const patch = { 'Кто решил': session.fio, 'Дата решения': new Date().toISOString().slice(0, 10) };
  if (body.verdict) {
    if (!['Выполнимо', 'Невыполнимо'].includes(body.verdict)) throw new Error('Недопустимый вердикт.');
    patch['Вердикт'] = body.verdict;
    patch['Статус'] = body.verdict === 'Выполнимо' ? 'Принято в работу' : 'Отклонено';
  }
  if (typeof body.comment === 'string') patch['Условия'] = body.comment;
  if (body.risks && typeof body.risks === 'object') patch['Риски (чек-лист)'] = JSON.stringify(body.risks);
  await ncUpdate('lov_sheets', body.sheetId, patch);
  if (body.verdict) await propagateLovToRequest(body.sheetId, body.verdict === 'Невыполнимо'); // D2: двигаем ЗП по вердикту
  return { ok: true };
}
