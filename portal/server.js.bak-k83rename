// --- мост ЗП → Проект разработки (ОКР), только запись (migrate-019) -----------
const DESIGN_GROUPS = ['ОК', 'СП', 'ПВО', 'РТИ', 'БМ', 'ЦХ'];
// децим.№ проекта = <код подгруппы><NNNN> (для групп без подгрупп, напр. БМ, — <код группы>)
async function nextProjectDecNo(subCode) {
  const rows = await ncListSoft('design_projects');
  const re = new RegExp(`^${subCode}(\\d{4})$`);
  let max = 0;
  for (const r of rows) { const m = re.exec(String(r['Децимальный номер'] || '').trim()); if (m) max = Math.max(max, Number(m[1])); }
  return `${subCode}${String(max + 1).padStart(4, '0')}`;
}
async function createProjectFromRequest(body) {
  const zp = String(body.zp || '').trim();
  if (!zp) throw new Error('Не указан № запроса (ЗП).');
  const requests = await ncListSoft('sales_requests');
  const reqRow = requests.find((r) => String(r['№ запроса'] || '').trim() === zp);
  if (!reqRow) throw new Error(`Запрос «${zp}» не найден.`);
  if (String(reqRow['Проект (децим.№)'] || '').trim()) throw new Error(`По запросу «${zp}» проект уже создан (${reqRow['Проект (децим.№)']}).`);
  const grp = String(body.group || '').trim();
  if (!DESIGN_GROUPS.includes(grp)) throw new Error('Не выбрана/недопустима группа изделия.');
  const subCode = String(body.subgroup || '').trim() || grp; // группа без подгрупп → код группы
  const name = String(body.name || reqRow['Наименование запроса'] || '').trim();
  if (!name) throw new Error('Не указано наименование изделия.');
  const decNo = await nextProjectDecNo(subCode);
  const row = {
    'Децимальный номер': decNo, 'Группа': grp, 'Подгруппа': String(body.subgroupName || subCode),
    'Наименование изделия': name, 'Инициатор': 'Заказчик', 'Дата открытия': new Date().toISOString().slice(0, 10),
    'Этап': 'Шаг 1', 'Запрос (ЗП)': zp,
  };
  const created = await ncCreateMany('design_projects', [row]);
  const projId = idOfRow(Array.isArray(created) ? created[0] : created);
  try { await ncLinkRecords('sales_requests', 'Проект разработки', idOfRow(reqRow), [projId]); } catch {}
  try { await ncUpdate('sales_requests', idOfRow(reqRow), { 'Проект (децим.№)': decNo }); } catch {}
  return { ok: true, decNo, id: projId };
}

// --- standalone-создание проекта разработки (продуктовая инициатива, без ЗП) ---
// Большинство ОКР по реестру Ф.3–П.1 — продуктовая инициатива (ДпП/ОП) без ЗП.
// Мост ЗП→Проект для них не подходит (требует ЗП и жёстко ставит Инициатор='Заказчик').
// Здесь: полный набор полей, децим.№ авто по подгруппе (max+1) с возможностью override,
// опциональная привязка к ЗП. Только запись (папку КД/чат — отдельным шагом «Запустить ОКР»).
async function createDesignProject(body) {
  const grp = String(body.group || '').trim();
  if (!DESIGN_GROUPS.includes(grp)) throw new Error('Не выбрана/недопустима группа изделия.');
  const subCode = String(body.subgroup || '').trim() || grp; // группа без подгрупп → код группы
  const name = String(body.name || '').trim();
  if (!name) throw new Error('Не указано наименование изделия.');
  // децим.№: явный override (валидируем формат и уникальность) либо авто max+1 по подгруппе
  let decNo = String(body.decNo || '').trim();
  if (decNo) {
    if (!/^[A-Za-zА-Яа-я]{2,4}\d{4}$/.test(decNo)) throw new Error('Децим.№ должен быть в формате «КОД+4 цифры», напр. ПЧ0003.');
    const rows = await ncListSoft('design_projects');
    if (rows.some((r) => String(r['Децимальный номер'] || '').trim() === decNo)) throw new Error(`Децим.№ «${decNo}» уже занят.`);
  } else {
    decNo = await nextProjectDecNo(subCode);
  }
  const s = (v) => String(v == null ? '' : v).trim();
  const row = {
    'Децимальный номер': decNo, 'Группа': grp, 'Подгруппа': s(body.subgroupName) || subCode,
    'Наименование изделия': name,
    'Тип продукции': s(body.productType),
    'Инициатор': s(body.initiator) || 'ДпП',
    'Связь с ПЗ / заказом': s(body.orderLink),
    'Дата открытия': s(body.opened) || new Date().toISOString().slice(0, 10),
    'Этап': s(body.stage) || 'Шаг 1',
  };
