const SALES_UPDATE_FIELDS = { status: 'Статус', note: 'Примечание', owner: 'Ответственный', stage: 'Этап' };
async function updateSalesRequest(body, svc) {
  const zp = String(body.zp || '').trim();
  const id = body.id != null && body.id !== '' ? Number(body.id) : null;
  if (!zp && id == null) throw new Error('Укажите № запроса (zp) или id.');
  const rows = await ncListSoft('sales_requests');
  const row = zp
    ? rows.find((r) => String(r['№ запроса'] || '').trim() === zp)
    : rows.find((r) => (r.Id ?? r.id) === id);
  if (!row) throw new Error(`Запрос «${zp || id}» не найден.`);
  const patch = {};
  for (const [key, col] of Object.entries(SALES_UPDATE_FIELDS)) {
    if (body[key] != null && body[key] !== '') patch[col] = String(body[key]).trim();
  }
  if (!Object.keys(patch).length) throw new Error('Нет полей для обновления (status/note/owner/stage).');
  // след автора-агента: дописываем в примечание, если он его не переопределил
  if (svc?.actor && patch['Примечание'] == null && body.appendNote) {
    const prev = String(row['Примечание'] || '').trim();
    patch['Примечание'] = (prev ? prev + '\n' : '') + `[${svc.actor}] ${body.appendNote}`;
  }
  await ncUpdate('sales_requests', row.Id ?? row.id, patch);
  return { ok: true, zp: row['№ запроса'], id: row.Id ?? row.id, patch };
}

// --- создание заказа продаж ЗКЗ из принятого запроса (Ф.1–З.1 §5.4, D4) --------
// K-33: ЛОВ не гейт. Остаётся Г3 (согласование КП заказчиком, §5.4).
// Идемпотентно: если заказ уже связан — ошибка, не дубль.
async function createOrderFromSalesRequest(body) {
  const zp = String(body.zp || '').trim();
  if (!zp) throw new Error('Не указан № запроса (ЗП).');
  const requests = await ncListSoft('sales_requests');
  const reqRow = requests.find((r) => String(r['№ запроса'] || '').trim() === zp);
  if (!reqRow) throw new Error(`Запрос «${zp}» не найден.`);
  const linkedRaw = reqRow['Заказ (ЗКЗ)'];
  const linked = Array.isArray(linkedRaw) ? linkedRaw[0] : linkedRaw;
  if (linked && (linked.Id ?? linked.id) != null) throw new Error(`По запросу «${zp}» заказ уже создан (${linked['№ заказа'] || 'ЗКЗ'}).`);
  // K-33 (ДпП): гейт по ЛОВ снят полностью — заказ не требует положительной оценки
  // выполнимости. Остаётся только Г3: согласование КП заказчиком (§5.4).
  const kpRes = String(reqRow['Результат КП'] || '');
  if (!KP_RESULT_ORDER_OK.has(kpRes)) {
    throw new Error('Заказ (ЗКЗ) можно создать только после согласования КП заказчиком: «Результат КП» ∈ {Согласовано, Выиграли} (Гейт 3 K-06, §5.4, ИСО 9001 п.8.2).');
  }
  // DEF-29 / K-66: при частичном выигрыше ЗКЗ формируется НА ВЫИГРАННУЮ ЧАСТЬ, поэтому её
  // сумма обязательна (> 0). Жёсткий гейт: клиентскую блокировку кнопки можно обойти.
  if (kpRes === KP_RESULT_PARTIAL) {
    const wonSumGate = Number(reqRow['Сумма выигранной части']);
    if (!(Number.isFinite(wonSumGate) && wonSumGate > 0)) {
      throw new Error('Результат «Выиграли частично»: сначала укажите сумму выигранной части (> 0) в конструкторе КП — ЗКЗ создаётся на выигранную часть (Гейт 3, K-66, DEF-29).');
    }
  }
  const year = new Date().getFullYear();
  const numZkz = await nextNumber('sales_orders', '№ заказа', 'ЗКЗ', year);
  const today = new Date().toISOString().slice(0, 10);
  const orderRow = {
    '№ заказа': numZkz, 'Дата поступления': today,
    'Заказчик': reqRow['Заказчик'] || '',
    'Наименование продукции / работ': reqRow['Наименование запроса'] || '',
    'Статус': 'Подтверждён', 'Ответственный': reqRow['Ответственный'] || '',
    'Примечание': `Создан из запроса ${zp}`,
  };
  if (reqRow['Характер сделки']) orderRow['Тип заказа'] = String(reqRow['Характер сделки']);
  if (reqRow['Кол-во'] != null && reqRow['Кол-во'] !== '') orderRow['Кол-во'] = Number(reqRow['Кол-во']);
  if (reqRow['Ед.изм.']) orderRow['Ед. изм.'] = String(reqRow['Ед.изм.']);
  // K-66: если КП выиграли ЧАСТИЧНО — заказ формируется на выигранную часть, а не на
  // весь КП. Сумма заказа = сумма выигранной части (если задана); отметка в примечании.
  if (kpRes === KP_RESULT_PARTIAL) {
    const wonSum = Number(reqRow['Сумма выигранной части']);
    const wonNote = String(reqRow['Объём/примечание выигранной части'] || '').trim();
    if (Number.isFinite(wonSum) && wonSum > 0) orderRow['Сумма, руб.'] = wonSum;
    orderRow['Примечание'] = `Создан из запроса ${zp} · частичный выигрыш`
      + (Number.isFinite(wonSum) && wonSum > 0 ? ` на ${wonSum.toLocaleString('ru-RU')} ₽` : '')
      + (wonNote ? ` (${wonNote})` : '');
  }
  const created = await ncCreateMany('sales_orders', [orderRow]);
  const co = Array.isArray(created) ? created[0] : created;
  const orderId = co.Id ?? co.id;
  // связь ЗП→ЗКЗ + продвижение статуса запроса; не роняем создание, если побочные записи не прошли
  try { await ncLinkRecords('sales_requests', 'Заказ (ЗКЗ)', idOfRow(reqRow), [orderId]); } catch (e) { console.warn('ЗКЗ: связь ЗП→заказ не создана:', e.message); }
  try { await ncUpdate('sales_requests', idOfRow(reqRow), { 'Статус': 'Принят (→ЗКЗ)' }); } catch (e) { console.warn('ЗКЗ: статус ЗП не обновлён:', e.message); }
  return { ok: true, numZkz, id: orderId };
}

// ============================================================================
//  Конструктор КП (K-05, ДП–З.1 §5.3) — гибрид: данные = позиции (у каждой своя
//  модель себестоимости по линейке), вывод = единый документ Ф.6–Л.1. Себестоимость
//  (§5.3.3) считается на сервере и НЕ печатается заказчику (§5.3.2). Гейты K-06:
//    Г1 — СНЯТ (K-33, ДпП): конструктор/отправка КП НЕ зависят от ЛОВ. ЛОВ опциональна.
//    Г2 — отправка КП по порогу подписи §5.3.5 (ДпП < порога ≤ ГД);
//    Г3 — заказ (ЗКЗ) при «Результат КП» ∈ {Согласовано, Выиграли} (§5.4).
//  Параметры (порог/НДС/прибыль) — из «Настроек» (K-05 этап 1), не хардкод.
// ============================================================================
const KP_RESULT_ORDER_OK = new Set(['Согласовано', 'Выиграли', 'Выиграли частично']); // §5.4 гейт ЗКЗ (K-66: частичный выигрыш тоже открывает заказ — на выигранную часть)
const KP_RESULT_VALUES = ['Отправлено', 'Согласовано', 'Выиграли', 'Выиграли частично', 'Проиграли', 'Отказались']; // канон migrate-021 + «Выиграли частично» (K-66, migrate-033)
const KP_RESULT_PARTIAL = 'Выиграли частично'; // K-66: тендер/КП выиграли не на весь объём — фиксируем сумму выигранной части
// DEF-29 / K-66: Г3 (§5.4) — заказ (ЗКЗ) открыт при «Результат КП» ∈ ORDER_OK; для
// «Выиграли частично» ДОПОЛНИТЕЛЬНО обязательна сумма выигранной части (> 0), т.к. ЗКЗ
// формируется именно на неё. wonPartSum — значение поля «Сумма выигранной части».
const kpOrderGateOpen = (kpRes, wonPartSum) => {
  const r = String(kpRes || '');
  if (!KP_RESULT_ORDER_OK.has(r)) return false;
  if (r === KP_RESULT_PARTIAL) { const s = Number(wonPartSum); return Number.isFinite(s) && s > 0; }
  return true;
};
const kpNum = (x) => { const n = Number(x); return Number.isFinite(n) ? n : 0; };
// ── Модель расчёта по продуктовой линейке (K-19 v1, ДП–З.1 §5.3.2) ────────────
//  Продуктовая линейка = конструкторская группа; КЛЮЧ = код группы
//  (dict_product_groups). Модель расчёта = КОНФИГ-ДАННЫЕ (не хардкод-ветвление):
//    { line, code, name, status, model?, articles[], params… }
//  Хранение конфигов: КАК ДАННЫЕ В КОДЕ (объект ниже). Проще отдельной таблицы,
//  версионируется вместе с server.js; отдаётся клиенту в payload buildKp
//  (d.lineConfigs/d.lines) — клиент рендерит поля ввода и считает по ТЕМ ЖЕ
//  числам (единый источник констант → парити client/server).
//  status: 'ready' — рабочая модель (Л2 Биметалл, РИ.20–Л.2);
//          'basic' — базовый конфиг (материалы+труд+энергия+накладные+прибыль);
//          'stub'  — «модель в разработке» (линейка выбирается, расчёт уточняется).
//  РАСШИРЕНИЕ: новая группа → строка в dict_product_lines + запись здесь по коду.
const BM_DENSITY = 0.0785;                          // кг/(дм²·мм) сталь ρ=7,85 г/см³ (m=ρ·S·t)
const BM_PRICE = { 'проволока': 400, 'лист': 75 };  // ₽/кг наплавочного материала (РИ.20–Л.2)
// базовые статьи затрат §5.3.3 (для 'basic'/'stub' — ручной ввод по статьям)
const KP_BASE_ARTICLES = [
  { key: 'materials', type: 'материал',  label: 'Материалы' },
  { key: 'labor',     type: 'труд',      label: 'Трудозатраты' },
  { key: 'energy',    type: 'энергия',   label: 'Энергия/расходники' },
  { key: 'overhead',  type: 'накладные', label: 'Накладные' },
];
const LINE_CONFIGS = {
  'ОК':  { line: 'Л1', code: 'ОК',  name: 'Оснастка обсадных колонн',        status: 'basic', articles: KP_BASE_ARTICLES },
  'БМ':  { line: 'Л2', code: 'БМ',  name: 'Биметаллические изделия',         status: 'ready', model: 'bimetal',
           density: BM_DENSITY, price: BM_PRICE,
           materialTypes: [{ key: 'проволока', label: 'Проволока', price: BM_PRICE['проволока'] }, { key: 'лист', label: 'Лист / плита', price: BM_PRICE['лист'] }],
           articles: KP_BASE_ARTICLES,
           note: 'Материалы наплавки считаются: масса = ρ·S·t (ρ=7,85 г/см³), стоимость = масса × цена типа наплавки. Труд/энергия/накладные — вручную.' },
  'ПВО': { line: 'Л3', code: 'ПВО', name: 'ЗИП к ПВО',                        status: 'basic', articles: KP_BASE_ARTICLES,
           naming: { subgroup: 'УВ', ri: 'РИ.3–Д.1.2', hint: 'Уплотнения ПВО (УВ): «‹тип› [, под трубу ⌀‹проход›] [, превентор ‹обозн.›] [, высокотемп. исполнение]»; децимальный ПБС.[ПВnn]-[проход]-УВ[тип]-[материал].УВ[проект]…' } },
  'СП':  { line: 'Л6', code: 'СП',  name: 'Оборудование для спуска колонн',   status: 'stub',  articles: KP_BASE_ARTICLES },
  'РТИ': { line: 'Л7', code: 'РТИ', name: 'РТИ общие',                        status: 'stub',  articles: KP_BASE_ARTICLES },
  'ЦХ':  { line: 'Л8', code: 'ЦХ',  name: 'Цеховое оборудование',             status: 'stub',  articles: KP_BASE_ARTICLES },
};
const LINE_BY_TAG = Object.fromEntries(Object.values(LINE_CONFIGS).map((c) => [c.line, c]));
// K-22: продуктовая линейка «Лn — Название» из кода ведущей (первой) продуктовой
// группы. Вход — строка «Продуктовой классификации» («ГР:ПОДГР; ГР; …», см.
// parseProductClass). Канон код группы → линейка = LINE_CONFIGS (ОК=Л1, БМ=Л2,
// ПВО=Л3, СП=Л6, РТИ=Л7, ЦХ=Л8). Формат «Лn — Название» совместим с сид-значениями,
// resolveLineConfig и buildSalesLive (там «— »→« · »). Нет известной группы → ''.
function lineFromProductClass(pc) {
  for (const tok of String(pc || '').split(';').map((s) => s.trim()).filter(Boolean)) {
    const code = (tok.split(':')[0] || '').trim();
    const c = LINE_CONFIGS[code];
    if (c) return `${c.line} — ${c.name}`;
  }
  return '';
}
// резолв конфига позиции: по коду группы, иначе по Лn-тегу в начале «Продуктовая
// линейка» (совместимо со старым сидом «Л2 — Биметалл / Наплавка» → Л2 → БМ).
function resolveLineConfig(lineStr, code) {
  const c = String(code || '').trim();
  if (c && LINE_CONFIGS[c]) return LINE_CONFIGS[c];
  const m = String(lineStr || '').match(/^\s*(Л\d+)/);
  return (m && LINE_BY_TAG[m[1]]) || null;
}
// себестоимость наплавки Л2 (РИ.20–Л.2): m[кг]=ρ·S·t; материалы=round(m·цена(тип)).
// S — площадь наплавки, дм²; t — толщина слоя, мм; тип — «проволока»|«лист».
function bimetalMaterials(cfg, p) {
  const area = kpNum(p.bmArea), thick = kpNum(p.bmThickness);
  const price = (cfg.price && cfg.price[String(p.bmMaterial || '').trim()]) || 0;
  const massKg = cfg.density * area * thick;
  return { massKg, price, materials: Math.round(massKg * price) };
}
const bmInputsReady = (p) => p.bmArea != null && p.bmArea !== '' && p.bmThickness != null && p.bmThickness !== '' && !!String(p.bmMaterial || '').trim();
// линейки для клиента (dropdown + константы моделей для парити-расчёта)
const kpLinesPayload = () => Object.values(LINE_CONFIGS).map((c) => ({
  line: c.line, code: c.code, name: c.name, status: c.status, model: c.model || null,
  value: `${c.line} — ${c.name}`, ...(c.price ? { price: c.price, density: c.density } : {}),
  ...(c.materialTypes ? { materialTypes: c.materialTypes } : {}), ...(c.note ? { note: c.note } : {}),
  ...(c.naming ? { naming: c.naming } : {}),
}));
// коды-справочники (группы/подгруппы) в форму клиента {code,name,group?,outside?} —
// единый шейпер, переиспользуется в /api/sales/dicts и в payload конструктора КП.
const shapeCodedDict = (rows) => rows.map((r) => ({
  code: String(r['Код'] || '').trim(), name: String(r['Значение'] || '').trim(),
  group: String(r['Группа'] || '').trim(), outside: r['Вне утв. Прил.А'] === true || r['Вне утв. Прил.А'] === 1,
  o: Number(r['Порядок']) || 0,
})).filter((x) => x.code).sort((a, b) => (a.o - b.o) || a.code.localeCompare(b.code, 'ru'))
  .map(({ code, name, group, outside }) => ({ code, name, ...(group ? { group } : {}), ...(outside ? { outside: true } : {}) }));
// реальные продуктовые группы/подгруппы для конструктора КП (dict_product_groups /
// dict_product_subgroups). Мягко: при ошибке чтения — пустые массивы (UI фолбэкнет на линейки).
async function kpProductCategories() {
  try {
    const [g, s] = await Promise.all([ncListSoft('dict_product_groups'), ncListSoft('dict_product_subgroups')]);
    return { productGroups: shapeCodedDict(g), productSubgroups: shapeCodedDict(s) };
  } catch { return { productGroups: [], productSubgroups: [] }; }
}
// K-33: справочная отметка «ЛОВ положителен» (§5.2). БОЛЬШЕ НЕ ГЕЙТ — используется
// только как lovOk в payload для необязательной подсказки в UI, ничего не блокирует.
function lovPositive(reqRow) {
  const ev = String(reqRow['Результат оценки'] || '');
  const st = String(reqRow['Статус'] || '');
  return ev === 'Выполнимо' || /Принят/.test(st) || st === 'КП отправлено';
}
// расчёт одной позиции КП (§5.3.3): себестоимость = материалы+труд+энергия+накладные;
// цена = ручная (если задана >0) либо себестоимость×(1+прибыль%); сумма = цена×кол-во.
function computeKpItem(p, defProfitPct) {
  // модель по линейке (§5.3.2): для 'ready' Л2 «Биметалл» материалы считаются из
  // площади/толщины/типа наплавки; иначе — ручной ввод по статьям (basic/stub).
  const cfg = resolveLineConfig(p.line, p.lineCode);
  let materials = kpNum(p.materials), bm = null;
  if (cfg && cfg.model === 'bimetal' && bmInputsReady(p)) { bm = bimetalMaterials(cfg, p); materials = bm.materials; }
  const labor = kpNum(p.labor), energy = kpNum(p.energy), overhead = kpNum(p.overhead);
  const costUnit = materials + labor + energy + overhead;
  const profitPct = (p.profitPct != null && p.profitPct !== '') ? kpNum(p.profitPct) : kpNum(defProfitPct);
  const priceInput = kpNum(p.priceUnit);
  const priceUnit = priceInput > 0 ? priceInput : Math.round(costUnit * (1 + profitPct / 100));
  const qty = kpNum(p.qty);
  const lineSum = Math.round(priceUnit * qty);
  return { materials, labor, energy, overhead, costUnit, profitPct, priceUnit, qty, lineSum,
    lineStatus: cfg ? cfg.status : null, lineModel: cfg ? cfg.model || null : null, bmMassKg: bm ? bm.massKg : null };
}
// сводные итоги КП. subtotal = Σ сумм позиций (без НДС) — база порога §5.3.5.
function computeKpTotals(items, vatRate) {
  const subtotal = items.reduce((a, i) => a + i.lineSum, 0);
  const costTotal = items.reduce((a, i) => a + i.costUnit * i.qty, 0);
  const vat = Math.round(subtotal * kpNum(vatRate) / 100);
  return { subtotal, vat, total: subtotal + vat, costTotal: Math.round(costTotal), margin: Math.round(subtotal - costTotal) };
}
// требуемый подписант КП по порогу §5.3.5 (сравнение без НДС): < порога → ДпП; ≥ → ГД.
const kpSigner = (subtotal, threshold) => (subtotal >= kpNum(threshold) ? 'ГД' : 'ДпП');

// позиции КП конкретного ЗП (фильтр по тексту «ЗП» — не зависит от авто-имени bt-колонки)
async function kpItemsFor(zp) {
  const all = await ncListSoft('sales_kp_items');
  return all.filter((r) => String(r['ЗП'] || '').trim() === zp)
    .sort((a, b) => (kpNum(a['№ позиции']) - kpNum(b['№ позиции'])) || ((a.Id ?? a.id) - (b.Id ?? b.id)));
}
// маппинг записи «Позиции КП» → форма конструктора (для фронта)
function shapeKpItem(r) {
  return {
    id: r.Id ?? r.id, posNum: kpNum(r['№ позиции']), name: r['Наименование / обозначение'] || '',
    line: r['Продуктовая линейка'] || '', lineCode: r['Код линейки'] || '', qty: r['Кол-во'] ?? '', unit: r['Ед.изм.'] || '',
    // входы модели Л2 «Биметалл» (persist после migrate-024; до APPLY — пусто, forward-tolerant)
    bmArea: r['Площадь наплавки, дм²'] ?? '', bmThickness: r['Толщина слоя, мм'] ?? '', bmMaterial: r['Тип наплавки'] || '',
    materials: r['Материалы, руб.'] ?? '', labor: r['Трудозатраты, руб.'] ?? '', energy: r['Энергия/расходники, руб.'] ?? '',
    overhead: r['Накладные, руб.'] ?? '', costUnit: r['Себестоимость ед., руб.'] ?? '', profitPct: r['Плановая прибыль, %'] ?? '',
    priceUnit: r['Цена за ед., руб.'] ?? '', lineSum: r['Сумма позиции, руб.'] ?? '', note: r['Примечание'] || '',
  };
}
// найти запись ЗП по номеру
async function findSalesRequest(zp) {
  const rows = await ncListSoft('sales_requests');
  return rows.find((r) => String(r['№ запроса'] || '').trim() === zp) || null;
}
// чтение конструктора КП: позиции + итоги (пересчёт на сервере) + состояние гейтов K-06
async function buildKp(zp) {
  const reqRow = await findSalesRequest(zp);
  if (!reqRow) throw new Error(`Запрос «${zp}» не найден.`);
  const c = cfg();
  const items = (await kpItemsFor(zp)).map(shapeKpItem);
  const calc = items.map((it) => computeKpItem(it, c.KP_PROFIT_PCT));
  const totals = computeKpTotals(calc, c.KP_VAT_RATE);
  const kpRes = String(reqRow['Результат КП'] || '');
  const { productGroups, productSubgroups } = await kpProductCategories();
  const pchProjects = await pchProjectsPayload();
