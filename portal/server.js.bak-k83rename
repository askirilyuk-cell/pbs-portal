  const row = { '№ протокола': num, 'Дата': date, 'Заключение': verdict, 'Контролёр ОТК': controller };
  const put = (col, v) => { const s = (v == null ? '' : String(v)).trim(); if (s) row[col] = s; };
  put('Заказ №', pz); put('МК №', body.mk); put('Наименование изделия', product);
  put('Чертёж №', body.drawing); put('Партия / серия', body.batch);
