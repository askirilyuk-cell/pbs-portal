// разбор поля «Продуктовая классификация» (коды «ГР:ПОДГР; ГР; …») в теги с подписями
function parseProductClass(raw, subName, grpName) {
  return String(raw || '').split(';').map((s) => s.trim()).filter(Boolean).map((tok) => {
    const [g, sub] = tok.split(':').map((x) => (x || '').trim());
    const groupCode = g, subCode = sub || '';
