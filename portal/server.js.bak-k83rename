// распаковка ZIP (zero-dep): central directory → записи {path,data}; deflate/store; имена UTF-8 (флаг) или CP866.
function unzipBuffer(buf) {
  let eocd = -1;
  for (let i = buf.length - 22; i >= 0 && i >= buf.length - 22 - 65536; i--) { if (buf.readUInt32LE(i) === 0x06054b50) { eocd = i; break; } }
  if (eocd < 0) throw new Error('не ZIP (нет EOCD)');
  const cdCount = buf.readUInt16LE(eocd + 10), cdOffset = buf.readUInt32LE(eocd + 16);
  const dosDec = (b) => { try { return new TextDecoder('ibm866').decode(b); } catch { return b.toString('latin1'); } };
  const out = []; let p = cdOffset;
  for (let n = 0; n < cdCount; n++) {
    if (p + 46 > buf.length || buf.readUInt32LE(p) !== 0x02014b50) break;
    const flags = buf.readUInt16LE(p + 8), method = buf.readUInt16LE(p + 10);
    const compSize = buf.readUInt32LE(p + 20), fnLen = buf.readUInt16LE(p + 28), extraLen = buf.readUInt16LE(p + 30), commLen = buf.readUInt16LE(p + 32);
    const localOff = buf.readUInt32LE(p + 42);
    const nameBuf = buf.slice(p + 46, p + 46 + fnLen);
    const name = (flags & 0x800) ? nameBuf.toString('utf8') : dosDec(nameBuf);
    p += 46 + fnLen + extraLen + commLen;
    if (!name || name.endsWith('/') || name.endsWith('\\')) continue; // папка
    if (buf.readUInt32LE(localOff) !== 0x04034b50) continue;
    const lFn = buf.readUInt16LE(localOff + 26), lEx = buf.readUInt16LE(localOff + 28);
    const dataStart = localOff + 30 + lFn + lEx;
    const comp = buf.slice(dataStart, dataStart + compSize);
    let data;
    if (method === 0) data = comp;
    else if (method === 8) { try { data = zlib.inflateRawSync(comp); } catch { continue; } }
    else continue; // неподдерживаемый метод сжатия
    out.push({ path: name.replace(/\\/g, '/'), data });
  }
  return out;
}
// рекурсивный список файлов запроса (фильтр служебных desktop.ini / *.tmp / dotfiles)
function walkSalesFiles(folder) {
  const out = [];
  const walk = (dir) => {
    let ents; try { ents = fs.readdirSync(dir, { withFileTypes: true }); } catch { return; }
    for (const e of ents) {
      if (e.name.startsWith('.')) continue;
      const full = path.join(dir, e.name);
      if (e.isDirectory()) { walk(full); continue; }
      if (/^(desktop\.ini|thumbs\.db)$/i.test(e.name) || /\.tmp$/i.test(e.name)) continue;
      const rel = path.relative(folder, full).split(path.sep).join('/');
      let size = 0; try { size = fs.statSync(full).size; } catch {}
      out.push({ rel, name: e.name, ext: (e.name.split('.').pop() || '').toLowerCase(), stage: rel.includes('/') ? rel.split('/')[0] : '', size });
    }
  };
  walk(folder);
  return out.sort((a, b) => a.rel.localeCompare(b.rel, 'ru'));
}
// office → PDF через Gotenberg (LibreOffice route) + дисковый кэш (по mtime+size)
async function officeToPdf(file) {
  const c = cfg();
  if (!c.GOTENBERG) throw new Error('Не задан адрес Gotenberg («Настройки»).');
  const st = fs.statSync(file);
  const key = crypto.createHash('sha1').update(file + '|' + st.mtimeMs + '|' + st.size).digest('hex');
  const cacheDir = path.join(__dirname, '.cache', 'office');
  const cached = path.join(cacheDir, key + '.pdf');
  try { if (fs.existsSync(cached)) return fs.readFileSync(cached); } catch {}
  const fd = new FormData();
  fd.append('files', new Blob([fs.readFileSync(file)]), path.basename(file));
  const r = await fetch(`${c.GOTENBERG.replace(/\/+$/, '')}/forms/libreoffice/convert`, { method: 'POST', body: fd });
  if (!r.ok) throw new Error(`Gotenberg ${r.status}: ${(await r.text().catch(() => '')).slice(0, 200)}`);
  const pdf = Buffer.from(await r.arrayBuffer());
  try { fs.mkdirSync(cacheDir, { recursive: true }); fs.writeFileSync(cached, pdf); } catch {}
  return pdf;
}
