  let am, maxAmt = null;
  while ((am = amtRe.exec(t))) { const v = ocrParseRuNumber(am[1]); if (v != null && (maxAmt == null || v > maxAmt)) maxAmt = v; }
  if (maxAmt != null) out.amount = maxAmt;
  m = /НДС\s*\(?(\d{1,2})\s*%/i.exec(t);
  if (m) { const vr = Number(m[1]); if (Number.isFinite(vr)) out.vatRate = vr; }
  m = /в\s*т\.?\s*ч\.?\s*НДС\D*([\d\s]+[.,]\d{2})/i.exec(t);
  if (m) out.vatAmount = ocrParseRuNumber(m[1]);
