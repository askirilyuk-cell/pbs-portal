  const it = (body.itemId != null && body.itemId !== '' && items.find((r) => String(r.Id ?? r.id) === String(body.itemId)))
    || (body.code && items.find((r) => String(r['Код позиции'] || '').trim() === String(body.code).trim()));
  if (it) return { it, created: false, code: String(it['Код позиции'] || '').trim() };
  const name = String(body.name || '').trim();
  if (!name) throw new Error('Новая позиция: укажите itemId/code существующей или name для создания.');
  const code = await whNextItemCode();
  const row = { 'Код позиции': code, 'Наименование': name };
