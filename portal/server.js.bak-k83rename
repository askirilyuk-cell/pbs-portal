// папка запроса с СОЗДАНИЕМ, если ещё нет (для приложения файлов к свежему ЗП)
function _atomicMkTree(dest, subdirs) {
  // PATCH 2026-07-13: собрать дерево под скрытым .tmp и переименовать в финальное имя →
  // Synology Drive регистрирует «чистое» rename-событие и тянет папку на клиенты
  // (прямой mkdir через docker-mount Drive не индексирует → tombstone на клиенте).
  const parent = path.dirname(dest);
  const tmp = path.join(parent, '.' + path.basename(dest) + '.tmp-' + process.pid + '-' + Date.now());
  try {
    fs.mkdirSync(tmp, { recursive: true }); chownSalesDir(tmp);
    for (const st of (subdirs || [])) { const sd = path.join(tmp, st); fs.mkdirSync(sd, { recursive: true }); chownSalesDir(sd); }
    fs.renameSync(tmp, dest); chownSalesDir(dest); return true;
  } catch (e) {
    try { fs.rmSync(tmp, { recursive: true, force: true }); } catch {}
    console.error(`[${new Date().toISOString()}] _atomicMkTree fail (${dest}): ${(e && e.message) || e}`);
    return false;
