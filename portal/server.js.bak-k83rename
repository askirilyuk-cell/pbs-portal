    // платёж всё равно создан, признак fileAttached уходит в ответ для UI.
    const scanAtt = Array.isArray(invoice['Файл-скан']) ? invoice['Файл-скан'][0] : null;
    const paymentId = payment && payment.id;
    if (scanAtt && paymentId != null) {
      try {
        const buf = await downloadNcAttachment(scanAtt);
        const fname = scanAtt.title || scanAtt.fileName || scanAtt.name || 'invoice-scan.pdf';
        await uploadPaymentFile(paymentId, buf, fname, payMimeFor(fname, scanAtt.mimetype || scanAtt.type || 'application/pdf'));
        fileAttached = true;
      } catch (e) { console.warn('K-83: скан счёта не передан в платёжный портал (приложите вручную):', e.message); }
    }
  } else {
